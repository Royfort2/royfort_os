<div class="product-reviews-stamped-singles hide" id="product-reviews-carousel">
    <template data-template="stamped-review-product">
        <div class="product-review">
            <div class="rating">@ratingStars</div>
            <div class="excerpt">@excerpt</div>
            <div class="name">@name</div>
        </div>
    </template>
    <div class="carousel">

    </div>
    <div class="text-center">
        <a href="#main-reviews" class="btn btn-invert">{{ 'general.reviews.read_all' | t }}</a>
    </div>
</div>