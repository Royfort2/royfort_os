{{ 'we-details-select.css' | asset_url | stylesheet_tag: preload: true }}

{%- liquid
  assign media_layout = section.settings.gallery_layout | default: 'carousel'
  assign mobile_thumbnails = section.settings.mobile_thumbnails | default: 'hide'
  assign enable_image_zoom = section.settings.enable_image_zoom | default: false
  assign enable_sticky_info = section.settings.enable_sticky_info

  assign product_class = 'product--' | append: section.settings.media_size
  assign product_class = product_class | append: ' product--' | append: media_layout
  assign product_class = product_class | append: ' product--media-has-' | append: product.media.size
  if product.media.size > 1
    assign product_class = product_class | append: ' product--media-has-many'
  endif

  case media_layout
    when 'grid-mix'
      assign media_modulo = product.media.size | modulo: 3
      if media_modulo == 2
        assign product_class = product_class | append: ' product--odd-media'
      endif
  endcase
-%}

{% style %}
  .product--medium {
    gap: 0 !important;
  }
  .product--medium > * {
    width: 50% !important;
    max-width: 100%;
  }
  .product--medium .product__info-wrapper {
    padding: 0 !important;
  }
  .product--medium .product__info-container {
    display: flex;
    justify-content: center;
    padding-inline: 2rem;
  }
  .product--medium .product__info-container .product__blocks {
    max-width: 40rem;
    padding-bottom: 8rem;
    overflow: hidden;
  }
  .product__block {
    --product-blocks-gap: 2rem !important;
    --product-blocks-gap-large: 2rem !important;
  }
  .product__block--badges {
    margin-bottom: 1.2rem !important;
  }
  .product__block--stamped_reviews {
    margin: 0 !important;
  }
  .product__block--stamped_reviews .stamped-product-reviews-badge:not(:empty) {
    margin-bottom: 1.2rem !important;
  }
  .product__block--title {
    margin: 0 !important;
  }
  .product__block--title .product__title {
    font-size: 3.2rem;
    font-style: normal;
    font-weight: 300;
    line-height: 120%;
  }
  .product__block--price {
    margin-top: 0 !important;
  }
  .product__block--price .f-price .f-price__regular,
  .product__block--price .f-price .f-price__sale {
    font-size: 1.6rem;
    font-style: normal;
    font-weight: 400;
    line-height: 150%;
    letter-spacing: -0.16px;
    text-transform: uppercase;
  }
  .product__block--price .f-price .f-price-item--sale {
    color: rgb(var(--color-button));
  }
  .product__block--price .f-price .f-price__sale .f-price-item--regular {
    color: #525252;
  }
  .product-form__input:not(:first-child) {
    margin-top: 2rem !important;
  }
  .product__block--variant_picker .product-form__input > label,
  .product__block--variant_picker .product-form__input > .form__label {
    font-size: 1.4rem;
    font-style: normal;
    font-weight: 400;
    line-height: 130%;
    text-transform: uppercase;
    margin-bottom: 0.6rem !important;
  }
  .product__block--variant_picker .variant-options__row:has(.swatch-color) {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 0.6rem;
    width: 100%;
  }
  .product__block--variant_picker .product-form__input--color .swatch-color,
  .product__block--variant_picker .product-form__input--swatch .swatch-color {
    width: 100% !important;
    min-height: unset !important;
    height: 2.4rem !important;
    min-width: unset !important;
  }
  .product-form__input--color .swatch-color:before,
  .product-form__input--swatch .swatch-color:before {
    content: none !important;
  }
  .product-form__input--color input[type='radio']:checked + label .swatch-color:after,
  .product-form__input--swatch input[type='radio']:checked + label .swatch-color:after {
    box-shadow: 0px 0px 0px 0.1rem var(--active-shadow-color) !important;
  }
  .product__block--variant_picker .product-form__input .option-name {
    color: #525252;
  }
  .product__block--collapsible_tab .accordion-details__summary {
    padding-block: 1.6rem;
  }
  .product__block--collapsible_tab .accordion-details__summary .h4 {
    font-size: 1.4rem;
    font-style: normal;
    font-weight: 400;
    line-height: 150%;
    letter-spacing: -0.14px;
    text-transform: uppercase;
  }

  .product__block--variant_picker {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  /* Lift whole block above later .product__block siblings (e.g. buy buttons) while custom select is open.
     Child .we-select z-index only applies inside this block’s stacking context. */
  .product__block--variant_picker:has(details.we-select-container[open]) {
    position: relative;
    z-index: 25;
  }
  .product-set-picker__accordion {
    margin-top: 0;
    border: none;
  }
  .product-set-picker__accordion .accordion-details__summary {
    padding-block: 0 0.6rem;
  }
  .product-set-picker__heading {
    margin: 0;
    font-size: 1.4rem;
    font-style: normal;
    font-weight: 400;
    line-height: 150%;
    letter-spacing: -0.14px;
    text-transform: uppercase;
  }
  .product-set-picker__list {
    padding-block-end: 0.8rem;
    padding-inline: 0;
  }
  .product__info-container .product__blocks:has(.product-set-picker__accordion) {
    overflow: visible;
  }
  .product-set-picker__item {
    margin-block-end: 1.2rem;
  }
  .product-set-picker__item:last-child {
    margin-block-end: 0;
  }
  .product-set-picker__card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    margin: 0;
    border: 0.1rem solid rgb(var(--color-border));
    border-radius: 0.2rem;
    background: rgb(var(--color-background));
    overflow: visible;
  }
  .product-set-picker__card-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1.2rem;
    width: 100%;
    margin: 0;
    padding: 1.2rem 1.2rem 1.2rem 1rem;
    cursor: pointer;
    text-align: start;
  }
  .product-set-picker__thumb {
    flex-shrink: 0;
    width: 8rem;
    height: 8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: rgb(var(--color-foreground) / 0.04);
  }
  .product-set-picker__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-set-picker__thumb-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background: rgb(var(--color-foreground) / 0.06);
  }
  .product-set-picker__info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .product-set-picker__title {
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 150%;
    letter-spacing: -0.14px;
    text-transform: uppercase;
    color: rgb(var(--color-foreground));
  }
  .product-set-picker__price {
    line-height: 1.2;
  }
  .product-set-picker__price .f-price {
    font-size: 1.4rem;
    font-weight: 400;
  }
  .product-set-picker__price .f-price-item--regular {
    color: rgb(var(--color-button));
  }
  .product-set-picker__checkbox-ui {
    flex-shrink: 0;
    width: 2.4rem;
    height: 2.4rem;
    border: 0.1rem solid rgb(var(--color-border));
    border-radius: 0.2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--animation-default), border-color var(--animation-default);
  }
  .product-set-picker__toggle:checked + .product-set-picker__card-row .product-set-picker__checkbox-ui {
    background-color: rgb(var(--color-foreground));
    border-color: rgb(var(--color-foreground));
  }
  .product-set-picker__toggle:checked + .product-set-picker__card-row .product-set-picker__checkbox-ui::after {
    content: '';
    width: 1rem;
    height: 0.55rem;
    border: 0 solid rgb(var(--color-background));
    border-inline-start-width: 0.15rem;
    border-block-end-width: 0.15rem;
    transform: rotate(-45deg) translate(0.05rem, -0.05rem);
  }
  .product-set-picker__expand {
    display: grid;
    grid-template-rows: 0fr;
    width: 100%;
    box-sizing: border-box;
    transition: grid-template-rows 0.35s cubic-bezier(0.3, 1, 0.3, 1);
  }
  .product-set-picker__card:has(.product-set-picker__toggle:checked) .product-set-picker__expand {
    grid-template-rows: 1fr;
    overflow: visible;
  }
  .product-set-picker__expand-inner {
    min-height: 0;
    overflow: hidden;
    padding-inline: 1.2rem;
    box-sizing: border-box;
  }
  .product-set-picker__expand-inner variant-selects {
    padding-block-end: 1.2rem;
  }
  .product-set-picker__card:has(.product-set-picker__toggle:checked) .product-set-picker__expand-inner {
    overflow: visible;
  }
  .product-set-picker__card:has(.product-set-picker__toggle:checked) {
    position: relative;
    z-index: 2;
  }
  .product-set-picker__card-row + .product-set-picker__expand .product-set-picker__expand-inner .product-form__input:first-child {
    margin-top: 0 !important;
  }

  .product__block--usp_swiper {
    margin-block: 4rem;
  }
  .product__usp-swiper-item {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    justify-content: center;
    align-items: center;
  }
  .product__usp-swiper-item img {
    width: 2rem;
    height: 2rem;
  }
  .product__usp-swiper-item-title {
    font-size: 1.4rem;
    font-style: normal;
    font-weight: 400;
    line-height: 150%;
    letter-spacing: -0.14px;
    text-transform: uppercase;
  }
  /* USP swiper block: same progress treatment as PDP / card (reuses .product__media-gallery-progress) */
  .product__block--usp_swiper .we-usp-swiper.swiper {
    position: relative;
    padding-block: 4rem;
  }
  .we-usp-swiper-button {
    padding: 0;
    border: none;
    border-radius: 0;
    position: absolute;
    height: auto;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
  }
  .we-usp-swiper-button-next {
    right: 0;
  }
  .we-usp-swiper-button-prev {
    left: 0;
  }

  .related-products-inline__heading {
    margin: 0 0 1.2rem;
    font-size: 1.6rem;
    font-style: normal;
    font-weight: 400;
    line-height: 120%;
    letter-spacing: -0.16px;
    text-transform: uppercase;
  }
  .related-products-inline__header {
    margin-bottom: 1.2rem;
    display: flex;
    justify-content: space-between;
    gap: 1.2rem;
  }
  .related-products-inline__header .slider-controls {
    display: flex;
    align-items: center;
    height: 100%;
  }
  .related-products-inline__header button {
    position: relative;
    border: none; 
    padding: 0;
    background: transparent;
    height: 100%;
    top: unset;
    left: unset;
    right: unset;
    border-radius: 0;
    transform: none;
    width: 2rem;
    margin: 0;
    display: flex;
    align-items: center;
  }
  .related-products-inline__header button:hover {
    background: transparent;
    color: rgb(var(--color-foreground));
  }
  .related-products-inline__header button::after,
  .related-products-inline__header button::before {
    content: none;
  }
  .related-products-inline__header .related-products-inline__heading {
    margin-bottom: 0;
  }
  .related-products-inline__slider .swiper-slide {
    height: auto;
  }

  @media (max-width: 767.98px) {
    .product--medium {
      gap: 1.6rem !important;
    }
    .product--medium > * {
      width: 100% !important;
    }
    .product--medium .product__info-container {
      padding-inline: var(--page-padding);
    }
    .product--medium .product__info-container .product__blocks {
      width: 100%;
      max-width: 100%;
      margin-inline: 0;
    }

    .related-products-inline__slider {
      margin-inline: calc(-1 * var(--page-padding));
    }
    .we-main-product-related__swiper {
      padding-inline: var(--page-padding);
    }
    .related-products-inline__header .slider-controls {
      display: none;
    }

    .product--medium .product__info-container .product__blocks {
      overflow: visible;
    }
  }
{% endstyle %}

<product-info
  id="MainProduct-{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  class="section block section-{{ section.id }} {% unless section.settings.media_size == 'medium' %}section--padding page-width{% endunless %} color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- assign has_models = product.media | where: 'media_type', 'model' | first -%}
  {%- if has_models -%}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}
  {%- if enable_image_zoom -%}
    <link
      id="Photoswipe"
      rel="stylesheet"
      href="{{ 'photoswipe-component.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'we-main-product-related.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'we-details-select.js' | asset_url }}" defer="defer"></script>

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <div class="product flex flex-wrap {{ product_class }}">
    {%- if product.media.size > 0 -%}
      <motion-element data-motion="fade-up" data-motion-delay="50" class="product__media-wrapper w-full relative">
        {% render 'product-media-gallery',
          enable_sticky_info: enable_sticky_info,
          media_layout: media_layout,
          mobile_thumbnails: mobile_thumbnails,
          variant_images: variant_images,
          enable_image_zoom: enable_image_zoom
        %}
      </motion-element>
    {%- endif -%}
    <motion-element data-motion="fade-up" data-motion-delay="100" class="block product__info-wrapper w-full">
      {% render 'product-information-blocks',
        enable_sticky_info: enable_sticky_info,
        update_browser_history: true,
        context: 'main-product'
      %}
    </motion-element>
  </div>
  <product-recently-viewed data-product-id="{{ product.id }}" class="hidden"></product-recently-viewed>
  {%- if enable_image_zoom -%}
    <script src="{{ 'photoswipe.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if product.media.size > 0 -%}
    <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if has_models -%}
    <script type="application/json" id="ProductJSON-{{ product.id }}">
      {{ product.media | where: 'media_type', 'model' | json }}
    </script>
    <script src="{{ 'product-model.js' | asset_url }}" defer></script>
  {%- endif -%}

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
</product-info>

