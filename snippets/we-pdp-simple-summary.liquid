{%- comment -%}
  Stock indicator + optional tag add-ons + Zwischensumme for single-product PDPs
  (no pdp_set_products metafield). Optional lines come from bundle_* product tags.
  Accepts:
  - product: {Object}
  - block: {Object} we_variant_picker block (for set_zwischensumme_title)
  - product_form_id, update_browser_history — for optional tag add-on pickers
{%- endcomment -%}
{%- liquid
  assign zw_v = product.selected_or_first_available_variant
  if product.selected_variant != blank
    assign zw_v = product.selected_variant
  endif
  assign zw_qr = zw_v.quantity_rule
  assign zw_q_min = zw_qr.min | default: 1
  if zw_q_min < 1
    assign zw_q_min = 1
  endif
  assign zw_sale_cents = zw_v.price | times: zw_q_min
  assign zw_compare_cents = zw_v.price
  if zw_v.compare_at_price > zw_v.price
    assign zw_compare_cents = zw_v.compare_at_price
  endif
  assign zw_compare_cents = zw_compare_cents | times: zw_q_min
  assign zw_has_compare = false
  assign zw_discount_pct = 0
  if zw_compare_cents > zw_sale_cents
    assign zw_has_compare = true
    assign zw_discount_pct = zw_compare_cents | minus: zw_sale_cents | times: 100 | divided_by: zw_compare_cents
  endif
  assign zw_title = block.settings.set_zwischensumme_title | default: 'Zwischensumme'
  assign we_line_available = zw_v.available | default: true
  assign we_delivery_time = product.metafields.custom.we_pdp_estimated_delivery_time.value
  assign we_instock_msg = 'Vorrätig - Versand am nächsten Werktag.'
  assign we_stock_modifier = ''
  if we_delivery_time != blank
    assign we_delivery_lower = we_delivery_time | downcase
    assign we_is_presale = false
    if we_delivery_lower contains 'woche' or we_delivery_lower contains 'week' or we_delivery_lower contains 'maß' or we_delivery_lower contains 'tagen'
      assign we_is_presale = true
    endif
    if we_is_presale
      assign we_instock_msg = 'Maßanfertigung - Lieferzeit: ' | append: we_delivery_time
      assign we_stock_modifier = ' pdp-set-stock--presale'
    endif
  endif
  capture we_tag_extra_ids
    render 'we-pdp-bundle-tag-extras', product: product, set_products: blank, mode: 'ids'
  endcapture
  assign we_tag_extra_ids = we_tag_extra_ids | strip
-%}
<div
  class="pdp-set-stock pdp-set-stock--instock{{ we_stock_modifier }}"
  data-pdp-set-stock-instock
  {% unless we_line_available %}
    hidden
  {% endunless %}
>
  <span class="pdp-set-stock__dot" aria-hidden="true"></span>
  <span>{{ we_instock_msg }}</span>
</div>
<div
  class="pdp-set-stock pdp-set-stock--oos"
  data-pdp-set-stock-oos
  {% if we_line_available %}
    hidden
  {% endif %}
>
  <span class="pdp-set-stock__dot" aria-hidden="true"></span>
  <span>Diese Variante ist ausverkauft. Wählen Sie gerne eine andere Farbe oder Größe.</span>
</div>
<button
  type="button"
  class="btn btn--secondary pdp-set-main-bis"
  data-pdp-set-main-bis
  data-pdp-set-main-bis-title="{{ product.title | escape }}"
  {% if we_line_available %}
    hidden
  {% endif %}
>
  Senden Sie mir eine E-Mail
</button>

{%- if we_tag_extra_ids != blank -%}
  <script src="{{ 'product-set-picker-price.js' | asset_url }}" defer="defer"></script>
  <div
    id="ProductSetWeTagExtras-{{ block.id }}-{{ section.id }}"
    class="product-set-picker__list"
  >
    {%- render 'we-pdp-bundle-tag-extras',
      product: product,
      set_products: blank,
      mode: 'products',
      block: block,
      product_form_id: product_form_id,
      update_browser_history: update_browser_history
    -%}
  </div>
{%- endif -%}

<div class="pdp-set-zwischensumme" data-pdp-set-zwischensumme>
  <script type="application/json" data-pdp-set-zwischensumme-meta>
    {
      "titles": {
        "{{ product.id }}": {{ product.title | json }}
        {%- render 'we-pdp-bundle-tag-extras', product: product, set_products: blank, mode: 'titles-json' -%}
      },
      "fromPrefix": {{ 'products.product.price.from_price_html' | t: price: '' | json }},
      "priceMinById": {
        "{{ product.id }}": {{ product.price_min }}
        {%- render 'we-pdp-bundle-tag-extras', product: product, set_products: blank, mode: 'prices-json' -%}
      }
    }
  </script>
  <div class="pdp-set-zwischensumme__header">
    <span class="pdp-set-zwischensumme__title">{{ zw_title }}</span>
    <div class="pdp-set-zwischensumme__prices">
      <span
        class="pdp-set-zwischensumme__compare{% unless zw_has_compare %} visually-hidden{% endunless %}"
        {% unless zw_has_compare %}
          hidden
        {% endunless %}
      >
        {%- if zw_has_compare -%}
          {{- zw_compare_cents | money -}}
        {%- endif -%}
      </span>
      <span class="pdp-set-zwischensumme__sale">{{ zw_sale_cents | money }}</span>
      <span
        class="pdp-set-zwischensumme__badge{% unless zw_has_compare %} visually-hidden{% endunless %}"
        {% unless zw_has_compare %}
          hidden
        {% endunless %}
      >
        {%- if zw_has_compare -%}-{{ zw_discount_pct }}%{%- endif -%}
      </span>
    </div>
  </div>
  <p class="pdp-set-zwischensumme__breakdown">
    {{- zw_q_min }}x {{ product.title }} ({{ zw_sale_cents | money }})
  </p>
</div>
