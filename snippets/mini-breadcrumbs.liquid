{% comment %}

UPDATE: Shopify's breadcrumbs don't support hierarchy, so we're implementing a JS one based on the main site navigation



BG: Mini Breadcrumbs. Only shows the page before the present one (but not the homepage). Won't include structured schema so no duplicate content. {% endcomment %}
{% comment %}
{% assign t = template | split: '.' | first %}
<nav class="mini-breadcrumbs">
    <ol>
        
    {% case t %}
    {% when 'page' %}

    <li>
        <a href="{{ page.url }}" title="{{page.title}}"><span aria-hidden="true">{% render 'icon-arrow-left' %}</span>{{ page.title }}</a>
    </li>

    {% when 'product' %}

    {% if collection.url %}
        <li>
            <a href="{{ collection.url }}" title="{{collection.title}}"><span aria-hidden="true">{% render 'icon-arrow-left' %}</span>{{ collection.title }}</a>
        </li>
    {% endif %}

    {% when 'collection' and collection.handle %}

    {% if current_tags %}
        <li>
            <a href="{{ collection.url }}" title="{{collection.title}}"><span aria-hidden="true">{% render 'icon-arrow-left' %}</span>{{ collection.title }}</a>
        </li>
    {% endif %}

    {% when 'blog' %}

    {% if current_tags %}
 
        <li>
            <a href="{{ blog.url }}" title="{{blog.title}}"><span aria-hidden="true">{% render 'icon-arrow-left' %}</span>{{ blog.title }}</a>
        </li>
        
    {% endif %}

    {% when 'article' %}

        <li>
            <a href="{{ blog.url }}" title="{{blog.title}}"><span aria-hidden="true">{% render 'icon-arrow-left' %}</span>{{ blog.title }}</a>
        </li>

    {% endcase %}

    </ol>
</nav>
{% endcomment %}




