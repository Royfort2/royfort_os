{%- liquid
  assign pcard_gallery_variant = color_variant
  assign variant = product.selected_or_first_available_variant
  assign swiper_variant = product.selected_or_first_available_variant
  assign gallery_color_name = ''
  if pcard_gallery_variant != blank
    assign swiper_variant = pcard_gallery_variant
    assign swatch_trigger_opt = settings.color_swatch_trigger | downcase
    for option in product.options_with_values
      assign option_name = option.name | downcase
      assign is_color_opt = false
      if swatch_trigger_opt contains option_name
        assign is_color_opt = true
      elsif swatch_trigger_opt contains 'color' and option_name contains 'colour'
        assign is_color_opt = true
      endif
      if is_color_opt
        assign gallery_color_name = pcard_gallery_variant.options[forloop.index0]
        break
      endif
    endfor
  endif
  assign we_pcard_color_for_media = gallery_color_name
  if we_pcard_color_for_media == blank
    assign swatch_trigger_opt2 = settings.color_swatch_trigger | downcase
    for option in product.options_with_values
      assign option_name = option.name | downcase
      assign is_color_opt2 = false
      if swatch_trigger_opt2 contains option_name
        assign is_color_opt2 = true
      elsif swatch_trigger_opt2 contains 'color' and option_name contains 'colour'
        assign is_color_opt2 = true
      endif
      if is_color_opt2
        assign we_pcard_color_for_media = swiper_variant.options[forloop.index0]
        break
      endif
    endfor
  endif
  assign compare_at_price = variant.compare_at_price
  assign price = variant.price
  assign on_sale = false
  if compare_at_price > price
    assign on_sale = true
  endif

  assign show_soldout = settings.pcard_show_badge_soldout
  assign show_on_sale_badge = settings.pcard_show_sale_badge
  assign show_color_swatches = settings.pcard_enable_color_swatches

  unless on_sale
    assign show_on_sale_badge = false
  endunless

  if show_vendor == null
    assign show_vendor = settings.pcard_show_vendor
  endif

  if show_type == null
    assign show_type = settings.pcard_show_type
  endif

  if show_product_option == null
    assign show_product_option = settings.pcard_show_color_swatch
  endif

  assign we_mf_temp_media = product.metafields.custom.we_temp_product_media.value
  assign we_use_mf_pcard = false
  if settings.use_metafield_media and we_mf_temp_media != blank and we_mf_temp_media.size > 0
    assign we_use_mf_pcard = true
  endif
-%}
{%- if we_use_mf_pcard -%}
  {%- liquid
    assign color_key_fc = we_pcard_color_for_media | default: '' | downcase | strip
    assign mf_pick_count = 0
    assign mf_pick_0 = blank
    assign mf_pick_1 = blank
  -%}
  {%- if color_key_fc != blank -%}
    {% paginate we_mf_temp_media by 180 %}
      {%- for media_item in we_mf_temp_media -%}
        {%- liquid
          if mf_pick_count >= 2
            break
          endif
          assign preview_mf = media_item
          if media_item.preview_image != blank
            assign preview_mf = media_item.preview_image
          endif
          assign alt_key_fc = preview_mf.alt | default: '' | downcase | strip
          assign alt_matches_fc = false
          if alt_key_fc != blank and color_key_fc != blank and alt_key_fc == color_key_fc
            assign alt_matches_fc = true
          endif
          if alt_matches_fc
            if mf_pick_count == 0
              assign mf_pick_0 = preview_mf
            elsif mf_pick_count == 1
              assign mf_pick_1 = preview_mf
            endif
            assign mf_pick_count = mf_pick_count | plus: 1
          endif
        -%}
      {%- endfor -%}
    {% endpaginate %}
  {%- endif -%}
  {%- if mf_pick_count == 0 -%}
    {% paginate we_mf_temp_media by 180 %}
      {%- for media_item in we_mf_temp_media -%}
        {%- liquid
          assign preview_fb = media_item
          if media_item.preview_image != blank
            assign preview_fb = media_item.preview_image
          endif
          if mf_pick_0 == blank
            assign mf_pick_0 = preview_fb
          elsif mf_pick_1 == blank and preview_fb != mf_pick_0
            assign mf_pick_1 = preview_fb
            break
          endif
        -%}
      {%- endfor -%}
    {% endpaginate %}
  {%- endif -%}
  {%- liquid
    assign featured_media = mf_pick_0
    assign first_media_type = 'image'
  -%}
{%- else -%}
  {%- liquid
    assign first_media_type = product.featured_media.media_type
    assign featured_media = product.featured_media
    if first_media_type == 'model' or first_media_type == 'video'
      assign featured_media = product.featured_media.preview_image
    endif
  -%}
{%- endif -%}
{%- liquid
  if we_use_mf_pcard and featured_media == blank
    assign first_media_type = product.featured_media.media_type
    assign featured_media = product.featured_media
    if first_media_type == 'model' or first_media_type == 'video'
      assign featured_media = product.featured_media.preview_image
    endif
  endif

  if image_ratio == blank
    assign image_ratio = settings.pcard_image_ratio | default: '1'
  endif
  if image_ratio == 'adapt'
    if featured_media != blank
      assign image_ratio = featured_media.aspect_ratio
    else
      assign image_ratio = '1'
    endif
  endif

  assign use_swiper = use_swiper | default: false
  assign swiper_interactive_swatches = false
  if use_swiper and show_color_swatches
    assign swiper_interactive_swatches = true
  endif

  assign use_swiper_effective = false
  if use_swiper and first_media_type != 'video' and first_media_type != 'external_video'
    assign use_swiper_effective = true
  endif

  assign second_image = ''
  if we_use_mf_pcard
    if use_swiper_effective == false and settings.pcard_show_second_img and mf_pick_1 != blank
      assign second_image = mf_pick_1
    endif
  elsif use_swiper_effective == false and settings.pcard_show_second_img and product.images.size > 1 and product.images[1] != blank
    assign second_image = product.images[1]
  endif

  if enable_quick_add == null
    assign enable_quick_add = settings.pcard_show_cart_button
  endif

  if enable_quick_view == null
    assign enable_quick_view = settings.pcard_show_quickview_button
  endif

  assign mobile_hide_quick_add = settings.pcard_mobile_hide_quick_add

  assign custom_tags = product.tags | where: 'label_right_'
  assign custom_tags_left = product.tags | where: 'label_left_'

  unless pcard_render_badges == false
    assign we_show_pcard_badges = true
  else
    assign we_show_pcard_badges = false
  endunless
-%}
{%- if we_show_pcard_badges -%}
  {%- capture we_mf_card_badges_html -%}
    {%- render 'we-card-product-metafield-badges',
      product: product,
      color_variant: color_variant,
      global_only: pcard_badges_global_only
    -%}
  {%- endcapture -%}
{%- else -%}
  {%- assign we_mf_card_badges_html = '' -%}
{%- endif -%}
{%- liquid
  assign we_mf_card_badges_html = we_mf_card_badges_html | strip
  assign we_mf_has_mf_badges = false
  if settings.use_metafields_for_badges_display and we_mf_card_badges_html != blank
    assign we_mf_has_mf_badges = true
  endif

  assign atc_button_tag = 'a'
  unless settings.pcard_choose_options_actions == 'product_page'
    assign atc_button_tag = 'button'
  endunless

  assign product_url = product.url

  if remove_params
    assign product_url = product_url | split: '?' | first
  endif

  if color_variant != blank
    capture product_url
      render 'we-first-available-color-variant-url', product: product, color_variant: color_variant
    endcapture
    assign product_url = product_url | strip
  endif

  assign card_wrapper_class = ''
  if custom_class != blank
    assign card_wrapper_class = card_wrapper_class | append: ' ' | append: custom_class
  endif
  if mobile_hide_quick_add
    assign card_wrapper_class = card_wrapper_class | append: ' mobile-hide-quick-add'
  endif

  assign quick_view_suffix = quick_view_suffix | default: ''
  assign quick_view_modal_id = 'QuickView-' | append: product.id | append: '-' | append: section.id | append: quick_view_suffix
  if color_variant != blank
    assign quick_view_modal_id = quick_view_modal_id | append: '-v' | append: color_variant.id
  endif

  assign loading = 'lazy'
  assign fetchpriority = 'low'
  if section_index < 3 and index == 1
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif

  assign image_sizes = image_sizes | default: '450px'
  assign image_widths = '70, 140, 165, 355, 450, 535, 710, 900, 1070, 1420'

  assign show_reviews = show_reviews | default: false

  assign we_pcard_append_second = false
  if use_swiper_effective
    if we_use_mf_pcard and we_mf_temp_media.size > 1
      assign we_pcard_append_second = true
    elsif product.images.size > 1
      assign we_pcard_append_second = true
    endif
  endif

  assign we_static_swatch_preview = false
  if use_swiper_effective == false and show_color_swatches and first_media_type != 'video' and first_media_type != 'external_video' and featured_media != blank
    assign we_static_swatch_preview = true
  endif

  assign we_static_append_second = false
  if we_use_mf_pcard
    if settings.pcard_show_second_img and we_mf_temp_media.size > 1
      assign we_static_append_second = true
    endif
  elsif settings.pcard_show_second_img and product.images.size > 1 and product.images[1] != blank
    assign we_static_append_second = true
  endif

  assign swatch_interactive_for_preview = false
  if use_swiper_effective and swiper_interactive_swatches
    assign swatch_interactive_for_preview = true
  elsif we_static_swatch_preview
    assign swatch_interactive_for_preview = true
  endif

  assign product_title = product.title
  if color_variant != blank and gallery_color_name != blank
    assign product_title = product.title | append: ' | ' | append: gallery_color_name
  endif
-%}
<div
  class="product-card we-product-card product-card-style-{{ settings.pcard_style }}{% if settings.pcard_style == 'card' %} color-{{ settings.pcard_color_scheme }}{% endif %}{{ card_wrapper_class }}{% if list_on_mobile %} product-card-list-on-mobile{% endif %}{% if use_swiper_effective %} we-product-card--swiper{% endif %}"
  data-we-product-id="{{ product.id }}"
>
  <div class="product-card__wrapper h-full">
    <div class="product-card__image-wrapper{% if second_image == blank %} product-card__image-wrapper--main-only{% endif %}{% if use_swiper_effective %} we-product-card__image-wrapper--swiper{% endif %} {% if list_on_mobile %}desktop-{% endif %}color-{{ settings.pcard_overlay_color_scheme }} bg-none">
      {%- render 'we-card-wishlist-button', product: product, variant: swiper_variant -%}
      {%- if use_swiper_effective -%}
        <we-product-card
          class="block w-full we-product-card__host"
          data-initial-variant-id="{{ swiper_variant.id }}"
        >
          <a
            class="we-product-card__media-link block"
            href="{{ product_url }}"
            aria-label="{{ product_title | escape }}"
            tabindex="-1"
          >
            <motion-element data-motion="zoom-out-sm" class="block">
              <div class="swiper we-product-card__swiper">
                <div class="swiper-wrapper">
                  {%- render 'we-pcard-variant-slides',
                    product: product,
                    variant: swiper_variant,
                    variant_color_name: we_pcard_color_for_media,
                    image_ratio: image_ratio,
                    image_widths: image_widths,
                    image_sizes: image_sizes,
                    loading: loading,
                    fetchpriority: fetchpriority,
                    we_pcard_append_second: we_pcard_append_second
                  -%}
                </div>
                <div class="swiper-pagination we-product-card__pagination"></div>
              </div>
            </motion-element>
          </a>
          {%- if swiper_interactive_swatches -%}
            {%- liquid
              assign swatch_trigger = settings.color_swatch_trigger | downcase
              assign variant_templates_done = false
              assign initial_swiper_template_done = false
            -%}
            {%- for option in product.options_with_values -%}
              {%- liquid
                assign option_name = option.name | downcase
                assign is_color = false
                if swatch_trigger contains option_name
                  assign is_color = true
                elsif swatch_trigger contains 'color' and option_name contains 'colour'
                  assign is_color = true
                endif
                unless is_color
                  continue
                endunless
                if variant_templates_done
                  continue
                endif
                assign variant_templates_done = true
                assign option_index = forloop.index0
                assign values = ''
                assign max_swatch_count = settings.pcard_maximum_swatches_to_show
                assign tmpl_swatch_count = 0
              -%}
              {%- for variant in product.variants -%}
                {%- liquid
                  assign value = variant.options[option_index]
                -%}
                {%- unless values contains value -%}
                  {%- liquid
                    assign values = values | join: ',' | append: ',' | append: value | split: ','
                    assign tmpl_swatch_count = tmpl_swatch_count | plus: 1
                  -%}
                  {%- if tmpl_swatch_count <= max_swatch_count -%}
                    <template data-variant-id="{{ variant.id }}">
                      {%- render 'we-pcard-variant-slides',
                        product: product,
                        variant: variant,
                        variant_color_name: value,
                        image_ratio: image_ratio,
                        image_widths: image_widths,
                        image_sizes: image_sizes,
                        loading: 'lazy',
                        fetchpriority: 'low',
                        we_pcard_append_second: we_pcard_append_second
                      -%}
                    </template>
                    {%- if variant.id == swiper_variant.id -%}
                      {%- assign initial_swiper_template_done = true -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endunless -%}
              {%- endfor -%}
            {%- endfor -%}
            {%- comment -%}
              Card media uses swiper_variant; preview templates only cover the first N unique colors.
              If the visible variant is not in that set (or another variant owns the same color slot),
              JS cannot reset or re-preview — always emit a template for the card’s variant id.
            {%- endcomment -%}
            {%- if initial_swiper_template_done == false -%}
              <template data-variant-id="{{ swiper_variant.id }}">
                {%- render 'we-pcard-variant-slides',
                  product: product,
                  variant: swiper_variant,
                  variant_color_name: we_pcard_color_for_media,
                  image_ratio: image_ratio,
                  image_widths: image_widths,
                  image_sizes: image_sizes,
                  loading: 'lazy',
                  fetchpriority: 'low',
                  we_pcard_append_second: we_pcard_append_second
                -%}
              </template>
            {%- endif -%}
          {%- endif -%}
        </we-product-card>
      {%- elsif we_static_swatch_preview -%}
        <we-product-card
          class="block w-full we-product-card__host"
          data-static="true"
          data-initial-variant-id="{{ product.selected_or_first_available_variant.id }}"
        >
          <a
            class="we-product-card__media-link block"
            href="{{ product_url }}"
            aria-label="{{ product_title | escape }}"
            tabindex="-1"
          >
            <motion-element data-motion="zoom-out-sm" class="block">
              <div class="we-product-card__static-inner">
                {%- render 'we-pcard-variant-static-stack',
                  product: product,
                  variant: product.selected_or_first_available_variant,
                  variant_color_name: we_pcard_color_for_media,
                  image_ratio: image_ratio,
                  image_widths: image_widths,
                  image_sizes: image_sizes,
                  loading: loading,
                  fetchpriority: fetchpriority,
                  we_pcard_append_second: we_static_append_second
                -%}
              </div>
            </motion-element>
          </a>
          {%- liquid
            assign swatch_trigger = settings.color_swatch_trigger | downcase
            assign variant_templates_done = false
          -%}
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign option_name = option.name | downcase
              assign is_color = false
              if swatch_trigger contains option_name
                assign is_color = true
              elsif swatch_trigger contains 'color' and option_name contains 'colour'
                assign is_color = true
              endif
              unless is_color
                continue
              endunless
              if variant_templates_done
                continue
              endif
              assign variant_templates_done = true
              assign option_index = forloop.index0
              assign values = ''
              assign max_swatch_count = settings.pcard_maximum_swatches_to_show
              assign tmpl_swatch_count = 0
            -%}
            {%- for variant in product.variants -%}
              {%- liquid
                assign value = variant.options[option_index]
              -%}
              {%- unless values contains value -%}
                {%- liquid
                  assign values = values | join: ',' | append: ',' | append: value | split: ','
                  assign tmpl_swatch_count = tmpl_swatch_count | plus: 1
                -%}
                {%- if tmpl_swatch_count <= max_swatch_count -%}
                  <template data-variant-id="{{ variant.id }}">
                    <div class="we-product-card__static-inner">
                      {%- render 'we-pcard-variant-static-stack',
                        product: product,
                        variant: variant,
                        variant_color_name: value,
                        image_ratio: image_ratio,
                        image_widths: image_widths,
                        image_sizes: image_sizes,
                        loading: 'lazy',
                        fetchpriority: 'low',
                        we_pcard_append_second: we_static_append_second
                      -%}
                    </div>
                  </template>
                {%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endfor -%}
        </we-product-card>
      {%- else -%}
        <a
          href="{{ product_url }}"
          class="we-product-card__media-link block"
          aria-label="{{ product_title | escape }}"
          tabindex="-1"
        >
          <motion-element data-motion="zoom-out-sm" class="block">
            {%- if featured_media -%}
              {%- unless first_media_type == 'video' or first_media_type == 'external_video' -%}
                {%- assign fm_w = featured_media.width | default: 2000 -%}
                <div
                  class="media-wrapper product-card__image product-card__image--main"
                  style="--aspect-ratio: {{ image_ratio }}"
                >
                  {%- assign first_image_widths = image_widths | append: ', ' | append: fm_w -%}
                  {{
                    featured_media
                    | image_url: width: fm_w
                    | image_tag:
                      loading: loading,
                      fetchpriority: fetchpriority,
                      class: 'motion-reduce',
                      widths: first_image_widths,
                      sizes: image_sizes,
                      is: 'image-lazy'
                  }}
                </div>
                {%- unless second_image == blank -%}
                  {%- assign second_w = second_image.width | default: 2000 -%}
                  <div
                    class="media-wrapper product-card__image product-card__image--second inset-full hidden md:block"
                    style="--aspect-ratio: {{ image_ratio }}"
                  >
                    {%- assign second_image_widths = image_widths | append: ', ' | append: second_w -%}
                    {{
                      second_image
                      | image_url: width: second_w
                      | image_tag:
                        loading: 'lazy',
                        class: 'motion-reduce',
                        widths: second_image_widths,
                        sizes: image_sizes,
                        is: 'image-lazy'
                    }}
                  </div>
                {%- endunless -%}
              {%- else -%}
                <div class="media media--adapt" style="--media-ratio: {{ image_ratio }};">
                  {% render 'video',
                    video: product.featured_media,
                    muted: true,
                    autoplay: true,
                    loop: true,
                    cover_image: featured_media,
                    show_play_button: false
                  %}
                </div>
              {%- endunless -%}
            {%- else -%}
              <div class="product-card__image product-card__image--main" style="--aspect-ratio: {{ image_ratio }};">
                {{- 'product-1' | placeholder_svg_tag: 'placeholder-svg' -}}
              </div>
            {%- endif -%}
          </motion-element>
        </a>
      {%- endif -%}
      {%- liquid
        assign we_plp_nf_badge = ''
        if we_show_pcard_badges
          capture we_plp_nf_badge
            unless settings.use_metafields_for_badges_display
              render 'we-plp-neue-farbe-badge', product: product, color_variant: color_variant
            endunless
          endcapture
          assign we_plp_nf_badge = we_plp_nf_badge | strip
        endif
      -%}
      {%- if we_show_pcard_badges -%}
        {%- if product.available == false or on_sale or custom_tags.size > 0 or custom_tags_left.size > 0 or we_plp_nf_badge != blank or we_mf_has_mf_badges -%}
        <div class="product-card__badge">
          {%- if product.available == false and show_soldout -%}
            <span class="f-badge f-badge--soldout" aria-hidden="true">
              {{- 'products.product.sold_out' | t -}}
            </span>
          {%- endif -%}
          {%- if show_on_sale_badge and product.available -%}
            {%- liquid
              assign sale_badge = ''
              assign amount = 0
              case settings.pcard_sale_badge_type
                when 'show_percentage'
                  if compare_at_price > price
                    assign amount = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price
                  endif
                  assign sale_badge = amount | times: -1 | append: '%'
                when 'show_amount'
                  if compare_at_price > price
                    assign amount = compare_at_price | minus: price | money
                  endif
                  assign sale_badge = 'products.product.price.save_price_html' | t: amount: amount
                else
                  assign sale_badge = 'products.product.on_sale' | t
              endcase
            -%}
            <span class="f-badge f-badge--sale" aria-hidden="true">{{- sale_badge -}}</span>
          {%- endif -%}
          {%- if settings.use_metafields_for_badges_display -%}
            {{- we_mf_card_badges_html -}}
          {%- else -%}
            {%- for tag in custom_tags -%}
              {% comment %} {%- liquid
                assign tag_content = tag | split: '__' | last
                assign type = tag_content | split: '_' | first
                assign tag_name = tag_content | split: '_' | last
              -%} {% endcomment %}
              {% assign tag_name = tag | split: 'label_right_' | last %}
              <span class="f-badge f-badge--custom">{{ tag_name }}</span>
            {%- endfor -%}
            {%- for tag in custom_tags_left -%}
              {% assign tag_name = tag | split: 'label_left_' | last %}
              <span class="f-badge f-badge--custom">{{ tag_name }}</span>
            {%- endfor -%}
          {%- endif -%}
          {%- unless settings.use_metafields_for_badges_display -%}
            {{- we_plp_nf_badge -}}
          {%- endunless -%}
        </div>
        {%- endif -%}
      {%- endif -%}
      {%- if product.metafields.custom.is_excluded_from_sale -%}
        <span class="product-card__footnote">{{ settings.pcard_excluded_from_sale_text }}</span>
      {% endif %}
      {%- if enable_quick_view -%}
        <button
          class="product-card__quickview btn btn--icon-circle {{ settings.quickview_button_style }} no-js-hidden"
          aria-label="{{ 'products.product.quick_view' | t }}"
          aria-controls="{{ quick_view_modal_id }}"
          aria-haspopup="dialog"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            focusable="false"
            role="presentation"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-magnifying-glass icon--large"
          >
            <path d="M10.875 18.75C15.2242 18.75 18.75 15.2242 18.75 10.875C18.75 6.52576 15.2242 3 10.875 3C6.52576 3 3 6.52576 3 10.875C3 15.2242 6.52576 18.75 10.875 18.75Z"/>
            <path d="M16.4434 16.4453L20.9997 21.0016"/>
          </svg>
        </button>
      {%- endif -%}
      {%- if enable_quick_add -%}
        {%- liquid
          assign product_form_id = 'quick-add-' | append: section.id | append: product.id
          assign qty_rules = false
          if variant.quantity_rule.min > 1 or variant.quantity_rule.max != null or variant.quantity_rule.increment > 1
            assign qty_rules = true
          endif
        -%}
        {%- if product.variants.size > 1 or qty_rules -%}
          <div class="product-card__actions product-card__main-actions we-product-card__main-actions">
            <{{ atc_button_tag }}
              {% if settings.pcard_choose_options_actions == 'product_page' %}
                href="{{- product_url -}}"
              {% else %}
                aria-controls="{{ quick_view_modal_id }}"
                aria-haspopup="dialog"
              {% endif %}
              class="product-card__atc product-card__action-button btn {{ settings.pcard_button_style }}"
            >
              <span class="product-card__atc-icon product-card__action-icon inline-flex">
                {% comment %} {%- render 'icon-cart', name: settings.cart_icon -%} {% endcomment %}
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <path d="M4.16669 10H15.8334M10 4.16669V15.8334" stroke="currentColor" stroke-linecap="square" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="product-card__atc-text product-card__action-text">
                {{- 'products.product.choose_options' | t -}}
              </span>
            </{{ atc_button_tag }}>
          </div>
        {%- else -%}
          {%- form 'product',
            product,
            id: product_form_id,
            class: 'product-card__actions product-card__main-actions we-product-card__main-actions',
            novalidate: 'novalidate',
            data-type: 'add-to-cart-form',
            is: 'product-form'
          -%}
            <input
              type="hidden"
              name="id"
              value="{{- variant.id -}}"
              class="product-variant-id"
              {% if variant.available == false %}
                disabled
              {% endif %}
            >
            <button
              id="{{ product_form_id }}-submit"
              type="submit"
              name="add"
              {% if variant.available == false %}
                disabled
              {% endif %}
              aria-label="{{ 'products.product.add_to_cart' | t }}"
              class="product-card__atc product-card__action-button btn {{ settings.pcard_button_style }}"
            >
              <span class="product-card__atc-icon product-card__action-icon inline-flex">
                {% comment %} {%- render 'icon-cart', name: settings.cart_icon -%} {% endcomment %}
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <path d="M4.16669 10H15.8334M10 4.16669V15.8334" stroke="currentColor" stroke-linecap="square" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="product-card__atc-text product-card__action-text">
                {%- if variant.available -%}
                  {{- 'products.product.add_to_cart' | t -}}
                {%- else -%}
                  {{- 'products.product.sold_out' | t -}}
                {%- endif -%}
              </span>
              {% render 'loading-spinner' %}
            </button>
          {%- endform -%}
        {%- endif -%}
      {%- endif -%}
    </div>
    <div class="product-card__info text-{{ settings.pcard_content_alignment }}">
      {%- if show_vendor -%}
        <p class="product-card__vendor text-sm m-0">
          <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
          {{ product.vendor }}
        </p>
      {%- endif -%}
      {%- if show_type -%}
        <p class="product-card__type text-sm m-0">
          <span class="visually-hidden">{{ 'accessibility.product_type' | t }}</span>
          {{ product.type }}
        </p>
      {%- endif -%}
      {%- if settings.public_key_stamped != blank and settings.stamped_store_hash != blank and show_reviews -%}
        {%- comment -%}
          Collection / grid badge (Stamped docs): class stamped-product-reviews-badge only — not stamped-main-badge (product page) or stamped-toggle.
        {%- endcomment -%}
        <div class="product-card__stamped we-product-card__stamped text-{{ settings.pcard_content_alignment }}">
          <span
            class="stamped-product-reviews-badge"
            data-id="{{ product.id }}"
            data-product-sku="{{ product.handle }}"
            data-product-type="{{ product.type | escape }}"
            data-product-title="{{ product.title | escape }}"
            style="display: block;"
          >
            {% render 'stamped-reviews-badge-zero' %}
          </span>
        </div>
      {%- endif -%}
      <span class="product-card__title text-pcard-title">
        <a href="{{ product_url }}">{{- product_title -}}</a>
      </span>
      {% render 'price', product: product, alignment: settings.pcard_content_alignment %}
      {%- if show_color_swatches -%}
        {%- render 'pcard-color-swatch',
          product: product,
          initial_variant: pcard_gallery_variant,
          swatch_interactive: swatch_interactive_for_preview,
          quick_view_modal_id: quick_view_modal_id
        -%}
      {%- endif -%}
    </div>
  </div>
  {%- if settings.pcard_choose_options_actions == 'open_popup' or enable_quick_view -%}
    {% render 'quick-view-modal', modal_id: quick_view_modal_id, product: product, product_url: product_url %}
  {%- endif -%}
</div>
