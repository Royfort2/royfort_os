{% render 'full-breadcrumbs' %}

<div class="account-outer-wrapper">

    <h1>{{'customer.account.title' | t }}</h1>
    <a class="log-out" href="/account/logout">{{'customer.account.log_out' | t }}</a>

    <section class="account-main">

        <aside class="account-sidebar">
            {% render 'account-sidebar' %}
        </aside>

        <div class="address-container">

            <div class="default-address-wrapper">
                {% for address in customer.addresses %}
                    {% if address == customer.default_address %}
                        <div class="customer-address default-address">
                            <div class="address-block">
                                <div class="title">{{ 'customer.addresses.default' | t }}</div>
                                <div class="address">{{ address | format_address }}</div>
                            </div>

                            <div class="button-wrapper">
                                <button class="btn btn-secondary edit-address" data-form-id="{{address.id}}">{{ 'customer.addresses.edit' | t }}</button>
                                <button type="button" class="btn btn-secondary btn-danger address-delete" data-form-id="{{ address.id }}" data-confirm-message="{{ 'customer.addresses.delete_confirm' | t }}">{{ 'customer.addresses.delete' | t }}</button>
                            </div>
                        </div>
                    {% endif %} 
                {% endfor %}     
            </div>

            <div class="address-wrapper">
                {% for address in customer.addresses %}
                    {% if address == customer.default_address %}
                        {% continue %}
                    {% else %}
                        <div class="customer-address">
                            <div class="address-block">
                                <div class="title">{{ 'customer.addresses.address_title' | t }}</div>
                                <div class="address">{{ address | format_address }}</div>
                            </div>

                            <div class="button-wrapper">
                                <button class="btn btn-secondary edit-address" data-form-id="{{address.id}}">{{ 'customer.addresses.edit' | t }}</button>
                                <button type="button" class="btn btn-secondary btn-danger address-delete" data-form-id="{{ address.id }}" data-confirm-message="{{ 'customer.addresses.delete_confirm' | t }}">{{ 'customer.addresses.delete' | t }}</button>
                                {% form 'customer_address', address %}
                                    <input checked type="checkbox" id="address_default_address_{{form.id}}" name="address[default]" value="1">
                                    <button type="submit" class="btn btn-tertiary btn-default">{{ 'customer.addresses.set_default' | t }}</button>
                                {% endform %}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}      
            </div>

            <button type="button" class="btn btn-secondary address-new-toggle address-new-primary">{{ 'customer.addresses.add_new' | t }}</button>
        </div>

        {% for address in customer.addresses %}
            <div class="edit-address-wrapper" data-address="{{ address.id }}">
                <div id="EditAddress_{{ address.id }}">
                    {% form 'customer_address', address %}

                        <div class="title">{{ 'customer.addresses.edit_address' | t }}</div>

                        <div class="form-group">
                            <input type="text" name="address[first_name]" id="AddressFirstName_{{ form.id }}"
                                value="{{ form.first_name }}" autocapitalize="words" placeholder="{{ 'customer.edit.first_name' | t }}">
                        </div>

                        <div class="form-group">
                            <input type="text" name="address[last_name]" id="AddressLastName_{{ form.id }}"
                                value="{{ form.last_name }}" autocapitalize="words" placeholder="{{ 'customer.edit.last_name' | t }}">
                        </div>

                        <div class="form-group">
                            <input type="text" name="address[company]" id="AddressCompany_{{ form.id }}"
                                value="{{ form.company }}" autocapitalize="words" placeholder="{{ 'customer.edit.company' | t }}">
                        </div>

                        <div class="form-group">

                            <input type="text" name="address[address1]" id="AddressAddress1_{{ form.id }}"
                                value="{{ form.address1 }}" autocapitalize="words" placeholder="{{ 'customer.edit.address1' | t }}">
                        </div>

                        <div class="form-group">
                            <input type="text" name="address[address2]" id="AddressAddress2_{{ form.id }}"
                                value="{{ form.address2 }}" autocapitalize="words" placeholder="{{ 'customer.edit.address2' | t }}">
                        </div>

                        <div class="form-group">
                            <input type="text" name="address[city]" id="AddressCity_{{ form.id }}"
                                value="{{ form.city }}" autocapitalize="words" placeholder="{{ 'customer.edit.city' | t }}">
                        </div>

                        <div class="form-group">
                            <select name="address[country]" id="AddressCountry_{{ form.id }}"
                                class="address-country-option" data-form-id="{{ form.id }}"
                                data-default="{{ form.country }}">
                                {{ country_option_tags }}
                            </select>
                        </div>
                        
                        <div id="AddressProvinceContainer_{{ form.id }}" style="display: none">
                            <select
                            name="address[province]"
                            id="AddressProvince_{{ form.id }}"
                            data-default="{{ form.province }}">
                            </select>
                        </div>
                
                        <div class="form-group">
                            <input type="text" name="address[zip]" id="AddressZip_{{ form.id }}"
                                value="{{ form.zip }}" autocapitalize="characters" placeholder="{{ 'customer.edit.zip' | t }}" maxlength="8">
                        </div>

                        <div class="form-group">
                            <input type="tel" name="address[phone]" id="AddressPhone_{{ form.id }}"
                                value="{{ form.phone }}" placeholder=" {{ 'customer.edit.phone' | t }}">
                        </div>

                        <div class="form-group set-default">
                            <label>
                                {{ form.set_as_default_checkbox }}
                                <span>{{ 'customer.addresses.set_default_label' | t }}</span>
                            </label>
                        </div>

                        <div class="button-wrapper">
                            <button type="button" class="btn btn-secondary cancel__edit">{{ 'customer.addresses.cancel' | t }}</button>
                            <button type="submit" class="btn btn-secondary">{{ 'customer.addresses.update' | t }}</button>
                        </div>
                    {% endform %}
                </div>
            </div>
        {% endfor %}  

        <div class="new-address-wrapper">
            <div id="AddressNewForm">
                {% form 'customer_address', customer.new_address %}
                
                <div class="title">{{ 'customer.addresses.add_new_title' | t }}</div>

                <div class="form-group">
                    <label for="AddressCompanyNew" class="sr-only">
                        {{ 'customer.addresses.company' | t }}
                    </label>
                    <input type="text" name="address[company]" id="AddressCompanyNew" value="{{ form.company }}"
                        placeholder="{{ 'customer.addresses.company' | t }}" autocapitalize="words" required>
                </div>

                <div class="form-group">
                    <label for="AddressFirstNameNew" class="sr-only">
                        {{ 'customer.addresses.first_name' | t }}
                    </label>
                    <input type="text" name="address[first_name]" id="AddressFirstNameNew"
                        value="{{ form.first_name }}" placeholder="{{ 'customer.addresses.first_name' | t }}"
                        autocapitalize="words" required>
                </div>

                <div class="form-group">
                    <label for="AddressLastNameNew" class="sr-only">
                        {{ 'customer.addresses.last_name' | t }}
                    </label>
                    <input type="text" name="address[last_name]" id="AddressLastNameNew"
                        value="{{ form.last_name }}" placeholder="{{ 'customer.addresses.last_name' | t }}"
                        autocapitalize="words" required>
                </div>

                <div class="form-group">
                    <label for="AddressAddress1New" class="sr-only">
                        {{ 'customer.addresses.address1' | t }}
                    </label>
                    <input type="text" name="address[address1]" id="AddressAddress1New"
                        value="{{ form.address1 }}" placeholder="{{ 'customer.addresses.address1' | t }}"
                        autocapitalize="words" required>
                </div>

                <div class="form-group">
                    <label for="AddressAddress2New" class="sr-only">
                        {{ 'customer.addresses.address2' | t }}
                    </label>
                    <input type="text" name="address[address2]" id="AddressAddress2New"
                        value="{{ form.address2 }}" placeholder="{{ 'customer.addresses.address2' | t }}"
                        autocapitalize="words">
                </div>

                <div class="form-group">
                    <label for="AddressCityNew" class="sr-only">
                        {{ 'customer.addresses.city' | t }}
                    </label>
                    <input type="text" name="address[city]" id="AddressCityNew" value="{{ form.city }}"
                        placeholder="{{ 'customer.addresses.city' | t }}" autocapitalize="words" required>
                </div>

                <div class="form-group">
                    <label for="AddressCountryNew" class="sr-only">
                        {{ 'customer.addresses.country' | t }}
                    </label>
                    <select name="address[country]" id="AddressCountryNew" data-default="{{ form.country }}">
                        {{ country_option_tags }}
                    </select>
                </div>

                <div class="form-group">
                    <div id="AddressProvinceContainerNew" style="display: none">
                        <label for="AddressProvinceNew">
                            {{ 'customer.addresses.province' | t }}
                        </label>
                        <select name="address[province]" id="AddressProvinceNew"
                            data-default="{{ form.province }}">
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label for="AddressZipNew" class="sr-only">
                        {{ 'customer.addresses.zip' | t }}
                    </label>
                    <input type="text" name="address[zip]" id="AddressZipNew" value="{{ form.zip }}"
                        placeholder="{{ 'customer.addresses.zip' | t }}" autocapitalize="characters" required maxlength="8">
                </div>

                <div class="form-group">
                    <label for="AddressPhoneNew" class="sr-only">
                        {{ 'customer.addresses.phone' | t }}
                    </label>
                    <input type="tel" name="address[phone]" id="AddressPhoneNew" value="{{ form.phone }}"
                        placeholder=" {{ 'customer.addresses.phone' | t }}">
                </div>

                <div class="form-group set-default">
                    <label>
                        {{ form.set_as_default_checkbox }}
                        <span>{{ 'customer.addresses.set_default_label' | t }}</span>
                    </label>
                </div>

                <div class="button-wrapper">
                    <button type="button" class="btn btn-secondary address-new-toggle-back">{{ 'customer.addresses.cancel' | t }}</button>
                    <button type="submit" class="btn btn-secondary">{{ 'customer.addresses.add' | t }}</button>
                    <div class="small-text">{{ 'customer.addresses.mandatory' | t }}</div>
                </div>
                {% endform %}
            </div>
        </div>
    </section>
</div>