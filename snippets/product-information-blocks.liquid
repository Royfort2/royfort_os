                picker_id_suffix: product.id,
                option_name_suffix: product.id | prepend: '-',
                pdp_set_bundle_context: false
              %}
            {%- else -%}
              {% render 'product-variant-picker',
                product: product,
                block: block,
                product_form_id: product_form_id,
                update_url: update_browser_history,
                pdp_set_bundle_context: false
              %}
            {%- endif -%}
            {% if pdp_set_active %}
              {% assign first_product = product.metafields.custom.pdp_set_products.value | first %}
              {% assign first_option_name_suffix = first_product.id | prepend: '-' %}
