    padding: 0;
    background: transparent;
    height: 100%;
    top: unset;
    left: unset;
    right: unset;
    border-radius: 0;
    transform: none;
    width: 2rem;
    margin: 0;
    display: flex;
    align-items: center;
  }
  .related-products-inline__header button:hover {
    background: transparent;
    color: rgb(var(--color-foreground));
  }
  .related-products-inline__header button::after,
  .related-products-inline__header button::before {
    content: none;
  }
  .related-products-inline__header .related-products-inline__heading {
    margin-bottom: 0;
  }
  .related-products-inline__slider .swiper-slide {
    height: auto;
  }


  @media (max-width: 989.98px) {
    .product--medium {
      gap: 0 !important;
    }
    .product--medium > * {
      width: 100% !important;
      max-width: 100% !important;
    }
    .product--medium .product__info-container {
      padding-inline: var(--page-padding);
    }
    .product--medium .product__info-container .product__blocks {
      width: 100%;
      max-width: 100%;
      margin-inline: 0;
      padding-top: 10px;
      display: flex;
      flex-direction: column;
    }

    product-info[id^='MainProduct-'] .product--medium .product__block--badges {
      display: none;
    }

    product-info[id^='MainProduct-'] .product--medium .product__blocks > .product__block {
      order: 10;
    }

    product-info[id^='MainProduct-'] .product--medium .product__block--title {
      order: 1;
    }

    product-info[id^='MainProduct-'] .product--medium .product__block--price {
      order: 2;
    }

    product-info[id^='MainProduct-'] .product--medium .product__block--stamped_reviews {
      order: 3;
      margin-top: 0;
    }

    product-info[id^='MainProduct-'] .product--medium .product__block--we_variant_picker,
    product-info[id^='MainProduct-'] .product--medium .product__block--variant_picker {
      order: 4;
    }

    product-info[id^='MainProduct-'] .product--medium .product__block--buy_buttons {
      order: 5;
    }

    product-info[id^='MainProduct-'] .product__block--buy_buttons .product-form__buttons,
    product-info[id^='MainProduct-'] .product__block--buy_buttons .product-form__submit {
      width: 100%;
    }
    product-info[id^='MainProduct-'] .product__block--buy_buttons .product-form__submit {
      flex: 1 1 100%;
    }

    product-info[id^='MainProduct-'] .product--medium .product__block--icon_info_text {
      order: 6;
    }

    product-info[id^='MainProduct-'] .product__media-gallery-viewer.blocks-radius,
    product-info[id^='MainProduct-'] .product__media-gallery-viewer.blocks-radius .product__media-container {
      border-radius: 0;
      overflow: hidden;
    }

    .related-products-inline__slider {
      margin-inline: calc(-1 * var(--page-padding));
    }
    .we-main-product-related__swiper {
      padding-inline: var(--page-padding);
    }
    .related-products-inline__header .slider-controls {
      display: none;
    }

    /*
      Mobile: gallery is sticky so it stays pinned while the product info block scrolls up over it
      (higher z-index + solid background). align-self: flex-start lets sticky work inside the flex column.
    */
    product-info[id^='MainProduct-'] .product:not(.product--media-has-0) {
      overflow: visible;
    }
    product-info[id^='MainProduct-'] .product:not(.product--media-has-0) .product__media-wrapper {
      display: block;
      position: static;
      align-self: flex-start;
      width: 100%;
      padding-inline: 0;
      box-sizing: border-box;
    }
    product-info[id^='MainProduct-'] .product:not(.product--media-has-0) .product__media-gallery.sticky-element {
      position: static;
    }
    product-info[id^='MainProduct-'] .product:not(.product--media-has-0) .product__info-container.sticky-element {
      position: static;
    }
    product-info[id^='MainProduct-'] .product:not(.product--media-has-0) .product__media-gallery-viewer {
      position: sticky;
      top: 0;
      z-index: 0;
      transition: none;
    }
    product-info[id^='MainProduct-'] .product:not(.product--media-has-0) .product__media-gallery-viewer-wrap,
    product-info[id^='MainProduct-'] .product:not(.product--media-has-0) .product__media-gallery-viewer {
      margin-inline: 0;
      padding-inline: 0;
      width: 100%;
      max-width: 100%;
    }
    product-info[id^='MainProduct-'] .product:not(.product--media-has-0) .product__media-gallery-progress {
      position: relative;
      z-index: 3;
      margin-inline: var(--page-padding);
      width: auto;
      max-width: none;
      box-sizing: border-box;
    }
    product-info[id^='MainProduct-'] .product:not(.product--media-has-0) .product__info-wrapper {
      position: relative;
      z-index: 1;
      margin-top: 0;
      padding-top: 0;
      background: rgb(var(--color-background));
      box-shadow: none;
    }
  }
{% endstyle %}

<product-info
  id="MainProduct-{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  class="section block section-{{ section.id }} {% unless section.settings.media_size == 'medium' %}section--padding page-width{% endunless %} color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  {%- unless product.has_only_default_variant -%}
    <script type="application/json" data-product-variants-for-url>
      {{- product.variants | json -}}
    </script>
    <script type="application/json" data-we-color-name-groups>
      {%- render 'we-color-name-groups-json' -%}
    </script>
  {%- endunless -%}
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- assign has_models = product.media | where: 'media_type', 'model' | first -%}
  {%- if has_models -%}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}
  {%- if enable_image_zoom -%}
    <link
      id="Photoswipe"
      rel="stylesheet"
      href="{{ 'photoswipe-component.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  <script src="{{ 'product-form-line-items.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'we-main-product-related.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'we-details-select.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'we-variant-dropdown-meta.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'we-quantity-selector-cap.js' | asset_url }}" defer="defer"></script>

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  {%- liquid
    assign we_show_gallery = false
    if product.media.size > 0
      assign we_show_gallery = true
    endif
    if settings.use_metafield_media and we_mf_list_top != blank and we_mf_list_top.size > 0
      assign we_show_gallery = true
    endif
  -%}
  <div class="product flex flex-wrap {{ product_class }}">
    {%- if we_show_gallery -%}
      <motion-element data-motion="fade-up" data-motion-delay="50" class="product__media-wrapper w-full relative">
        {% render 'product-media-gallery',
          enable_sticky_info: enable_sticky_info,
          media_layout: media_layout,
          mobile_thumbnails: mobile_thumbnails,
          variant_images: variant_images,
          enable_image_zoom: enable_image_zoom,
          gallery_aspect_ratio: '1 / 1'
        %}
      </motion-element>
    {%- endif -%}
    <motion-element data-motion="fade-up" data-motion-delay="100" class="block product__info-wrapper w-full">
      {% render 'product-information-blocks',
        enable_sticky_info: enable_sticky_info,
        update_browser_history: true,
        context: 'main-product'
      %}
    </motion-element>
  </div>
  <product-recently-viewed data-product-id="{{ product.id }}" class="hidden"></product-recently-viewed>
  {%- if enable_image_zoom -%}
    <script src="{{ 'photoswipe.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if we_show_gallery -%}
    <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if has_models -%}
    <script type="application/json" id="ProductJSON-{{ product.id }}">
      {{ product.media | where: 'media_type', 'model' | json }}
    </script>
    <script src="{{ 'product-model.js' | asset_url }}" defer></script>
  {%- endif -%}

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
</product-info>

