{% render 'full-breadcrumbs' %}

<div class="account-wrapper login-wrapper">

  <div id="resetPassword">

    {% form 'reset_customer_password' %}

        {% assign resetPasswordError = false %}
        {% if form.errors %}
          <div class="form-error">
            <div class="title">{{'customer.login.error' | t }}</div>
            {% for field in form.errors %}
              {% if form.errors.messages[field] contains "Password" %}
                <div class="message">{{'customer.reset_password.reset_password_message' | t }}</div>
                {% assign resetPasswordError = true %}
                {% break %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        <h1>{{ 'customer.reset_password.title' | t }}</h1>
        <p class="reset-text">{{ 'customer.reset_password.subtext' | t: email: email }}</p>

        <div class="inner-form-wrapper">
          <div class="form-group">
            <label for="Password" class="label-hidden">
              {{ 'customer.reset_password.password' | t }}
            </label>
            <input type="password"
              name="customer[password]"
              id="Password"
              class="{% if resetPasswordError == true %}input-error{% endif %}"
              placeholder="{{ 'customer.reset_password.password' | t }}">
          </div>

          <div class="form-group password-validation">
              <label for="CreatePassword" class="label-hidden">
                {{ 'customer.reset_password.password_confirm' | t }}
              </label>
              <input type="password"
                name="customer[password_confirmation]"
                id="CreatePassword"
                class="{% if resetPasswordError == true %}input-error{% endif %}"
                placeholder="{{ 'customer.reset_password.password_confirm' | t }}">
          </div>

          <div class="button-wrapper">
            <input type="submit" class="btn btn-account" value="{{ 'customer.reset_password.submit' | t }}">
          </div>
        </div>
    {% endform %}
  </div>

</div>
