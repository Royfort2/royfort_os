<nav class="pagination {{class}}">
    <ul class="pagination-items">
    {% if paginate.previous.is_link %}
        {%- capture prev_text %} {{ 'collections.pagination.previous' | t }} {% endcapture -%}
        <li class="pagination-btn prev"><a href="{{ paginate.previous.url }}">{% render 'icon-chevron-left' %}{% unless prev_text contains 'translation missing' %}{{ prev_text }}{% endunless %}</a></li>
    {% endif %}
    {% for part in paginate.parts %}
        <li class="pagination-link{% if paginate.current_page == part.title %} current{% endif %}">{% if part.url != blank %}<a href="{{part.url}}">{{part.title}}</a>{% else %}<span class="pagination-item">{{part.title}}</span>{% endif %}</li>
    {% endfor %}

    {%- capture pagination_info %} {{ 'shopify.pagination.pagination_info' | t }} {% endcapture -%}
    <li class="small-pagination-info">{% unless pagination_info contains 'translation missing' %}{{ pagination_info | replace: "%current_page%", paginate.current_page | replace: "%pages%", paginate.pages }}{% endunless %}</li>
    {% if paginate.next.is_link %}
        {%- capture next_text %} {{ 'collections.pagination.next' | t }} {% endcapture -%}
        <li class="pagination-btn next"><a href="{{ paginate.next.url }}">{% unless next_text contains 'translation missing' %}{{ next_text }}{% endunless %}{% render 'icon-chevron-right' %}</a></li>
    {% endif %}
    </ul>
</nav>