{{ 'collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'we-collection-variant-card-count.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'we-collection-grid-row-height.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'we-facet-fab-visibility.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign current_filter_size = 0
  assign columns_desktop = section.settings.columns_desktop
  assign columns_tablet = 3
  assign columns_tablet_large = 4
  assign columns_mobile = section.settings.columns_mobile | times: 1

  for filter in collection.filters
    assign current_filter_size = current_filter_size | plus: filter.active_values.size
  endfor

  assign enable_sorting = section.settings.enable_sorting
  assign enable_filtering = section.settings.enable_filtering
  assign enable_sorting_desktop = enable_sorting
  if section.settings.enable_sorting_only_on_mobile
    assign enable_sorting_desktop = false
  endif
  assign filter_type = section.settings.filter_type
  assign show_toolbar = false
  if enable_filtering or enable_sorting
    assign show_toolbar = true
  endif

  assign default_grid_mobile = 'f-grid-' | append: columns_mobile | append: '-cols'

  assign is_metro = false
  if section.settings.grid_layout == 'metro'
    assign is_metro = true
  endif

  assign variant_color_allowlist = ''
  assign restrict_variant_cards_by_color = false
  assign collection_plp_badge_filter = ''
  if section.settings.render_variants
    assign collection_plp_badge_filter = collection.metafields.custom.plp_badge_name_to_display.value | default: '' | strip
    assign facet_swatch_t = settings.color_swatch_trigger | downcase
    for vcf in collection.filters
      if vcf.active_values.size == 0
        continue
      endif
      assign vcf_pn = vcf.param_name | default: '' | downcase
      unless vcf_pn contains 'filter.v.option.'
        continue
      endunless
      assign vcf_opt_key = vcf_pn | split: '.' | last
      assign vcf_label = vcf.label | downcase
      assign vcf_is_color = false
      if vcf_opt_key == 'farbe' or vcf_opt_key == 'colour' or vcf_opt_key == 'color'
        assign vcf_is_color = true
      elsif facet_swatch_t != blank
        if facet_swatch_t contains vcf_label
          assign vcf_is_color = true
        elsif facet_swatch_t contains 'color' and vcf_label contains 'colour'
          assign vcf_is_color = true
        endif
      endif
      if vcf_is_color
        assign restrict_variant_cards_by_color = true
        for vcf_val in vcf.active_values
          assign vcf_piece = vcf_val.label | strip | downcase
          assign vcf_tok = '|' | append: vcf_piece | append: '|'
          unless variant_color_allowlist contains vcf_tok
            assign variant_color_allowlist = variant_color_allowlist | append: vcf_tok
          endunless
          assign vcf_piece = vcf_val.value | strip | downcase
          assign vcf_tok = '|' | append: vcf_piece | append: '|'
          unless variant_color_allowlist contains vcf_tok
            assign variant_color_allowlist = variant_color_allowlist | append: vcf_tok
          endunless
        endfor
      endif
    endfor

    assign variant_count_color_facets_suffixes = ''
    for vfs in collection.filters
        assign vfs_pn = vfs.param_name | default: '' | downcase
        unless vfs_pn contains 'filter.v.option.'
          continue
        endunless
        assign vfs_opt_key = vfs_pn | split: '.' | last
        assign vfs_label = vfs.label | downcase
        assign vfs_color_facet = false
        if vfs_opt_key == 'farbe' or vfs_opt_key == 'colour' or vfs_opt_key == 'color'
          assign vfs_color_facet = true
        elsif facet_swatch_t != blank
          if facet_swatch_t contains vfs_label
            assign vfs_color_facet = true
          elsif facet_swatch_t contains 'color' and vfs_label contains 'colour'
            assign vfs_color_facet = true
          endif
        endif
        if vfs_color_facet
          assign vfs_token = vfs_opt_key | prepend: '"' | append: '"'
          unless variant_count_color_facets_suffixes contains vfs_token
            if variant_count_color_facets_suffixes != blank
              assign variant_count_color_facets_suffixes = variant_count_color_facets_suffixes | append: ','
            endif
            assign variant_count_color_facets_suffixes = variant_count_color_facets_suffixes | append: vfs_token
          endunless
        endif
      endfor
      if variant_count_color_facets_suffixes == blank
        assign variant_count_color_facets_suffixes = '"farbe","colour","color"'
      endif

    assign ssr_variant_card_total = nil
    assign ssr_compute_full_variant_total = false
    if is_metro == false
      if collection.products_count <= 50 or collection_plp_badge_filter != blank
        assign ssr_compute_full_variant_total = true
      endif
    endif
    if ssr_compute_full_variant_total
      assign ssr_acc = 0
      assign ssr_sw = settings.color_swatch_trigger | downcase
      for srp in collection.products
        assign srp_coi = nil
        for srp_opt in srp.options_with_values
          assign srp_on = srp_opt.name | downcase
          assign srp_ic = false
          if ssr_sw contains srp_on
            assign srp_ic = true
          elsif ssr_sw contains 'color' and srp_on contains 'colour'
            assign srp_ic = true
          endif
          if srp_ic
            assign srp_coi = forloop.index0
            break
          endif
        endfor
        if srp_coi == nil
          assign ssr_acc = ssr_acc | plus: 1
        else
          assign srp_uc = ''
          for srp_v in srp.variants
            assign srp_cv = srp_v.options[srp_coi]
            if restrict_variant_cards_by_color and variant_color_allowlist != blank
              assign srp_tok = '|' | append: srp_cv | strip | downcase | append: '|'
              unless variant_color_allowlist contains srp_tok
                continue
              endunless
            endif
            unless srp_uc contains srp_cv
              if collection_plp_badge_filter != blank
                capture ssr_plp_badge_pass
                  render 'we-plp-variant-passes-badge-filter', product: srp, variant: srp_v, color_option_index: srp_coi, collection_badge_target: collection_plp_badge_filter
                endcapture
                assign ssr_plp_badge_pass = ssr_plp_badge_pass | strip
                unless ssr_plp_badge_pass == 'true'
                  continue
                endunless
              endif
              assign srp_uc = srp_uc | append: srp_cv | append: ','
              assign ssr_acc = ssr_acc | plus: 1
            endunless
          endfor
        endif
      endfor
      assign ssr_variant_card_total = ssr_acc
    endif
  endif
-%}
{%- if is_metro -%}
  {%- render 'product-grid-metro-style',
    section_id: section.id,
    columns_desktop: columns_desktop,
    columns_tablet_large: columns_tablet_large,
    columns_tablet: columns_tablet,
    columns_mobile: columns_mobile
  -%}
{%- endif -%}
{%- capture image_sizes -%}
(max-width: 767px) calc((100vw - 38px) / {{ columns_mobile }}),
(max-width: 1279px) calc((100vw - 90px) / {{ columns_tablet }}),
{%- if enable_filtering -%}
  calc({{ settings.page_width}}px / {{ columns_desktop | plus: 1 }})
{%- else -%}
{{ settings.page_width | divided_by: columns_desktop }}px
{%- endif -%}
{%- endcapture -%}

{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}

<div
  class="section--padding color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="collection page-width">
    {%- paginate collection.products by section.settings.products_per_page -%}
      <div class="collection__content flex">
        {%- if collection.all_products_count > 0 -%}
          <div
            class="hidden{% if enable_filtering and filter_type == 'vertical' %} xl:block{% endif %}"
            id="FacetFiltersContainer"
          >
            <div class="sticky-element z-10">
              {%- render 'facets', context: 'vertical', results: collection -%}
            </div>
          </div>
        {%- endif -%}
        <div class="flex flex-col flex-grow{% if show_toolbar %} show-toolbar{% endif %}" id="ProductGridWrapper">
          <div class="sticky-element grid gap-5 z-10" style="--sticky-offset: 0px;">
            {%- if enable_filtering or enable_sorting -%}
              <div class="collection__toolbar flex items-center justify-between gap-3">
                <div class="gap-3 flex items-center justify-between{% if filter_type == 'vertical' or enable_filtering == false %} xl:flex-grow{% endif %}">
                  {%- if collection.all_products_count > 0 -%}
                    <div data-facet-loading>
                      {%- render 'loading-spinner' -%}
                      <p
                        id="ProductCount"
                        class="m-0"
                        role="status"
                        {% if section.settings.render_variants %}
                          data-variant-card-count
                          data-color-trigger="{{ settings.color_swatch_trigger | escape }}"
                          data-products-json-href="{{ collection.url | append: '/products.json' }}"
                          data-variant-count-facet-suffixes="[{{- variant_count_color_facets_suffixes -}}]"
                          {% if variant_color_allowlist != blank %}
                            data-variant-count-allowlist="{{ variant_color_allowlist | escape }}"
                          {% endif %}
                          {% unless is_metro %}
                            {% if ssr_compute_full_variant_total %}
                              data-ssr-variant-card-total="{{ ssr_variant_card_total }}"
                            {% endif %}
                          {% endunless %}
                        {% endif %}
                      >
                        {% if section.settings.render_variants %}
                          {{ 'products.facets.product_count_html' | t: count: 0 }}
                        {% else %}
                          {%- liquid
                            if collection.results_count
                              echo 'products.facets.filters_selected' | t: terms: collection.terms, count: collection.results_count
                            elsif collection.products_count == collection.all_products_count
                              echo 'products.facets.product_count_simple' | t: count: collection.products_count
                            else
                              echo 'products.facets.product_count' | t: product_count: collection.products_count, count: collection.all_products_count
                            endif
                          -%}
                        {% endif %}
                      </p>
                    </div>
                  {%- endif -%}
                  {%- if enable_sorting and collection.all_products_count > 0 -%}
                    <div
                      class="flex items-center gap-3{% unless enable_sorting_desktop %} md:hidden{% endunless %}"
                      id="SortByContainer"
                    >
                      {%- render 'facet-short',
                        results: collection,
                        icon_size: 'extra-small',
                        label_class: 'font-body-bolder'
                      -%}
                    </div>
                  {%- endif -%}
                </div>

                {%- if filter_type == 'drawer' and collection.all_products_count > 0 and enable_filtering -%}
                  {%- render 'facets-drawer', results: collection, enable_sorting: enable_sorting, classes: 'we-facet-drawer--mobile-fab' -%}
                {%- endif -%}

                {%- if filter_type == 'vertical' and collection.all_products_count > 0 and enable_filtering -%}
                  <div class="flex xl:hidden">
                    {%- render 'facets-drawer', results: collection, enable_sorting: enable_sorting -%}
                  </div>
                {%- endif -%}

                <layout-switcher class="flex md:hidden gap-2" style="--buttons-width: 4rem;">
                  {%- for per_row in (1..2) -%}
                    {%- assign layout = 'f-grid-' | append: per_row | append: '-cols' -%}
                    <button
                      class="btn btn--icon{% if layout == default_grid_mobile %} btn--active{% endif %}"
                      data-layout-mode="grid-{{ per_row }}"
                      aria-label="{{ 'accessibility.layout_switcher' | t: col: per_row }}"
                    >
                      {%- render 'icon-grid-column', layout: per_row, classes: 'pointer-events-none' -%}
                    </button>
                  {%- endfor -%}
                </layout-switcher>
              </div>
            {%- endif -%}
          </div>
          {%- liquid
            if enable_filtering
              render 'facets-active', results: collection
            endif
          -%}
          <div id="ProductGridContainer">
            {%- if collection.products.size == 0 -%}
              <div class="empty-state flex flex-col items-center justify-center gap-6 text-center">
                {%- if collection.all_products_count > 0 -%}
                  <div class="gap-3 flex flex-col items-center justify-center text-center">
                    {%- render 'icon-empty-state' -%}
                    <p class="h4">{{ 'collections.general.no_results' | t }}</p>
                    <p class="m-0">{{ 'collections.general.use_fewer_filters' | t }}</p>
                  </div>
                  <a class="btn btn--primary" href="{{ collection.url }}" is="facet-remove">
                    {{- 'products.facets.clear_all' | t -}}
                  </a>
                {%- else -%}
                  <div class="gap-3 flex flex-col items-center justify-center text-center">
                    {%- render 'icon-empty-state' -%}
                    <p class="h4">{{ 'collections.general.empty' | t }}</p>
                  </div>
                  <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">
                    {{ 'collections.general.continue_shopping' | t }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
            <grid-list
              id="ProductsList"
              class="grid-list products-list f-grid lg:f-grid-{{ columns_tablet_large }}-cols xl:f-grid-{{ columns_desktop }}-cols  f-grid--gap-custom {{ default_grid_mobile }}"
            >
              {%- liquid
                assign grid_card_position = paginate.current_offset
                if section.settings.render_variants
                  assign cards_before = 0
                  assign swatch_trigger = settings.color_swatch_trigger | downcase
                  assign prev_coll = collections[collection.handle]
                  if prev_coll != blank
                    for product in prev_coll.products limit: paginate.current_offset
                      if is_metro
                        assign cards_before = cards_before | plus: 1
                      else
                        assign promo_color_option_index = nil
                        for option in product.options_with_values
                          assign option_name = option.name | downcase
                          assign is_color = false
                          if swatch_trigger contains option_name
                            assign is_color = true
                          elsif swatch_trigger contains 'color' and option_name contains 'colour'
                            assign is_color = true
                          endif
                          if is_color
                            assign promo_color_option_index = forloop.index0
                            break
                          endif
                        endfor
                        if promo_color_option_index == nil
                          assign cards_before = cards_before | plus: 1
                        else
                          assign promo_unique_colors = ''
                          for variant in product.variants
                            assign color_value = variant.options[promo_color_option_index]
                            if restrict_variant_cards_by_color and variant_color_allowlist != blank
                              assign promo_cv_low = '|' | append: color_value | strip | downcase | append: '|'
                              unless variant_color_allowlist contains promo_cv_low
                                continue
                              endunless
                            endif
                            unless promo_unique_colors contains color_value
                              if collection_plp_badge_filter != blank
                                capture promo_plp_badge_pass
                                  render 'we-plp-variant-passes-badge-filter', product: product, variant: variant, color_option_index: promo_color_option_index, collection_badge_target: collection_plp_badge_filter
                                endcapture
                                assign promo_plp_badge_pass = promo_plp_badge_pass | strip
                                unless promo_plp_badge_pass == 'true'
                                  continue
                                endunless
                              endif
                              assign promo_unique_colors = promo_unique_colors | append: color_value | append: ','
                              assign cards_before = cards_before | plus: 1
                            endunless
                          endfor
                        endif
                      endif
                    endfor
                  endif
                  assign grid_card_position = cards_before
                endif
              -%}
              {%- for product in collection.products -%}
                {% unless section.settings.render_variants %}
                  <div class="f-column card">
                    {%- if is_metro -%}
                      {%- render 'card-product-metro',
                        product: product,
                        image_sizes: image_sizes,
                        section_id: section.id,
                        section_index: 2,
                        index: forloop.index,
                        index0: forloop.index0,
                        desktop_breakpoint: 1280,
                        columns_desktop: columns_desktop,
                        columns_tablet: columns_tablet,
                        columns_mobile: columns_mobile
                      -%}
                    {%- else -%}
                      {%- render 'we-card-product',
                        product: product,
                        image_sizes: image_sizes,
                        section_id: section.id,
                        section_index: 2,
                        index: forloop.index,
                        use_swiper: section.settings.pcard_use_swiper,
                        show_reviews: section.settings.show_reviews
                      -%}
                    {%- endif -%}
                  </div>
                  {%- assign grid_card_position = grid_card_position | plus: 1 -%}
                  {%- unless is_metro -%}
                    {%- render 'we-collection-promo-grid-slot',
                      section: section,
                      grid_card_position: grid_card_position,
                      product_offset: paginate.current_offset,
                      columns_mobile: columns_mobile,
                      columns_tablet_large: columns_tablet_large,
                      columns_desktop: columns_desktop,
                      enable_filtering: enable_filtering
                    -%}
                  {%- endunless -%}
                {% else %}
                  {%- if is_metro -%}
                    <div class="f-column card">
                      {%- render 'card-product-metro',
                        product: product,
                        image_sizes: image_sizes,
                        section_id: section.id,
                        section_index: 2,
                        index: forloop.index,
                        index0: forloop.index0,
                        desktop_breakpoint: 1280,
                        columns_desktop: columns_desktop,
                        columns_tablet: columns_tablet,
                        columns_mobile: columns_mobile
                      -%}
                    </div>
                    {%- assign grid_card_position = grid_card_position | plus: 1 -%}
                  {%- else -%}
                    {%- liquid
                      assign color_option_index = nil
                      assign swatch_trigger = settings.color_swatch_trigger | downcase
                      for option in product.options_with_values
                        assign option_name = option.name | downcase
                        assign is_color = false
                        if swatch_trigger contains option_name
                          assign is_color = true
                        elsif swatch_trigger contains 'color' and option_name contains 'colour'
                          assign is_color = true
                        endif
                        if is_color
                          assign color_option_index = forloop.index0
                          break
                        endif
                      endfor
                    -%}
                    {%- if color_option_index == nil -%}
                      <div class="f-column card">
                        {%- render 'we-card-product',
                          product: product,
                          image_sizes: image_sizes,
                          section_id: section.id,
                          section_index: 2,
                          index: forloop.index,
                          use_swiper: section.settings.pcard_use_swiper,
                          show_reviews: section.settings.show_reviews
                        -%}
                      </div>
                      {%- assign grid_card_position = grid_card_position | plus: 1 -%}
                      {%- render 'we-collection-promo-grid-slot',
                        section: section,
                        grid_card_position: grid_card_position,
                        product_offset: paginate.current_offset,
                        columns_mobile: columns_mobile,
                        columns_tablet_large: columns_tablet_large,
                        columns_desktop: columns_desktop,
                        enable_filtering: enable_filtering
                      -%}
                    {%- else -%}
                      {% assign unique_colors = '' %}
                      {% for variant in product.variants %}
                        {% assign color_value = variant.options[color_option_index] %}
                        {% if restrict_variant_cards_by_color and variant_color_allowlist != blank %}
                          {% assign wc_cv_tok = '|' | append: color_value | strip | downcase | append: '|' %}
                          {% unless variant_color_allowlist contains wc_cv_tok %}
                            {% continue %}
                          {% endunless %}
                        {% endif %}
                        {% unless unique_colors contains color_value %}
                          {% if collection_plp_badge_filter != blank %}
                            {% capture plp_badge_pass %}
                              {% render 'we-plp-variant-passes-badge-filter',
                                product: product,
                                variant: variant,
                                color_option_index: color_option_index,
                                collection_badge_target: collection_plp_badge_filter
                              %}
                            {% endcapture %}
                            {% assign plp_badge_pass = plp_badge_pass | strip %}
                            {% unless plp_badge_pass == 'true' %}
                              {% continue %}
                            {% endunless %}
                          {% endif %}
                          {% assign unique_colors = unique_colors | append: color_value | append: ',' %}
                        {% else %}
                          {% continue %}
                        {% endunless %}

                        <div class="f-column card">
                          {%- render 'we-card-product',
                            product: product,
                            color_variant: variant,
                            image_sizes: image_sizes,
                            section_id: section.id,
                            section_index: 2,
                            index: forloop.index,
                            use_swiper: section.settings.pcard_use_swiper,
                            show_reviews: section.settings.show_reviews
                          -%}
                        </div>
                        {%- assign grid_card_position = grid_card_position | plus: 1 -%}
                        {%- render 'we-collection-promo-grid-slot',
                          section: section,
                          grid_card_position: grid_card_position,
                          product_offset: paginate.current_offset,
                          columns_mobile: columns_mobile,
                          columns_tablet_large: columns_tablet_large,
                          columns_desktop: columns_desktop,
                          enable_filtering: enable_filtering
                        -%}
                      {% endfor %}
                    {%- endif -%}
                  {%- endif -%}
                {% endunless %}
              {%- endfor -%}
            </grid-list>
            {%- liquid
              if paginate.pages > 1
                if section.settings.render_variants
                  render 'pagination', paginate: paginate, type: section.settings.pagination, page_result_count: collection.products.size, variant_cards_shown: grid_card_position, variant_card_progress: true, color_trigger: settings.color_swatch_trigger, products_json_href: collection.url, append: '/products.json'
                else
                  render 'pagination', paginate: paginate, type: section.settings.pagination, page_result_count: collection.products.size
                endif
              endif
            -%}
          </div>
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "collection-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "[Read How-to](https://foxecom.link/LgqT3v8)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 1,
      "default": 15,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "checkbox",
      "id": "render_variants",
      "label": "[we] Render variants",
      "default": false
    },
    {
      "type": "select",
      "id": "grid_layout",
      "options": [
        {
          "value": "standard",
          "label": "t:sections.product-tabs.settings.grid_layout.options__1.label"
        },
        {
          "value": "metro",
          "label": "t:sections.product-tabs.settings.grid_layout.options__2.label"
        }
      ],
      "default": "standard",
      "info": "t:sections.product-tabs.settings.grid_layout.info",
      "label": "t:sections.product-tabs.settings.grid_layout.label"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "t:sections.main-collection-product-grid.settings.pagination.label",
      "options": [
        {
          "value": "infinite",
          "label": "t:sections.main-collection-product-grid.settings.pagination.options__1.label"
        },
        {
          "value": "load_more",
          "label": "t:sections.main-collection-product-grid.settings.pagination.options__2.label"
        },
        {
          "value": "number",
          "label": "t:sections.main-collection-product-grid.settings.pagination.options__3.label"
        }
      ],
      "default": "number"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_color_swatch",
      "label": "t:settings_schema.color_swatches.settings.enable_color_swatch.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pcard_use_swiper",
