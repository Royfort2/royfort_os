{%- liquid
  assign tab_count = 0
  for block in section.blocks
    assign heading = block.settings.heading
    assign content = block.settings.content
    assign page = block.settings.page
    if heading != blank
      if content != blank or page.content != blank or request.design_mode
        assign tab_count = tab_count | plus: 1
      endif
    endif
  endfor
-%}
<div
  id="WeSiteSection-{{ section.id }}"
  class="we-site-product-info-tabs section section--padding color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width we-site-product-detail-inner">
    {%- if tab_count > 0 -%}
      <tabs-component class="we-site-product-info-tabs__desktop">
        <div
          class="we-site-product-info-tabs__titles"
          role="tablist"
          aria-label="{{ section.settings.aria_label | escape }}"
        >
          {%- assign tab_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign heading = block.settings.heading
              assign content = block.settings.content
              assign page = block.settings.page
              assign tab_valid = false
              if heading != blank
                if content != blank or page.content != blank or request.design_mode
                  assign tab_valid = true
                endif
              endif
            -%}
            {%- if tab_valid -%}
              <button
                type="button"
                class="we-site-product-info-tabs__title font-heading btn--plain"
                role="tab"
                id="WeSiteTab-{{ block.id }}"
                aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}"
                data-index="{{ tab_index }}"
                {{ block.shopify_attributes }}
              >
                {{ heading | escape }}
              </button>
              {%- assign tab_index = tab_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="we-site-product-info-tabs__panels">
          {%- assign tab_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign heading = block.settings.heading
              assign content = block.settings.content
              assign page = block.settings.page
              assign tab_valid = false
              if heading != blank
                if content != blank or page.content != blank or request.design_mode
                  assign tab_valid = true
                endif
              endif
            -%}
            {%- if tab_valid -%}
              <div
                class="we-site-product-info-tabs__panel rte"
                role="tabpanel"
                id="WeSiteTabPanel-{{ block.id }}"
                aria-labelledby="WeSiteTab-{{ block.id }}"
                {% unless tab_index == 0 %}
                  hidden
                {% endunless %}
              >
                {%- if page.content != blank -%}
                  {{ page.content }}
                {%- elsif content != blank -%}
                  {{ content }}
                {%- elsif request.design_mode -%}
                  <p>Add tab content in the block settings.</p>
                {%- endif -%}
              </div>
              {%- assign tab_index = tab_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </tabs-component>

      <div class="we-site-product-info-tabs__mobile accordion-parent">
        {%- for block in section.blocks -%}
          {%- liquid
            assign heading = block.settings.heading
            assign content = block.settings.content
            assign page = block.settings.page
            assign tab_valid = false
            if heading != blank
              if content != blank or page.content != blank or request.design_mode
                assign tab_valid = true
              endif
            endif
          -%}
          {%- if tab_valid -%}
            <details
              class="accordion-details"
              is="accordion-group"
              {% if block.settings.default_open %}
                open
                aria-expanded="true"
              {% else %}
                aria-expanded="false"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <summary class="accordion-details__summary flex items-center justify-between">
                <h2 class="h4 inline-richtext">{{ heading | escape }}</h2>
                {%- render 'icon-plus-toggle', size: 'small' -%}
              </summary>
              <div class="accordion-details__content rte">
                {%- if page.content != blank -%}
                  {{ page.content }}
                {%- elsif content != blank -%}
                  {{ content }}
                {%- elsif request.design_mode -%}
                  <p>Add tab content in the block settings.</p>
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="we-site-product-info-tabs__empty">Add tabs using the blocks on the left.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "[we] Product info tabs",
  "tag": "section",
  "class": "we-site-product-info-tabs-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Tabs aria label",
      "default": "Produktinformationen"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Tab"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Tab content here.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Content from page",
          "info": "When set, page content is shown instead of the richtext above."
        },
        {
          "type": "checkbox",
          "id": "default_open",
          "label": "Open by default on mobile",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "[we] Product info tabs",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "heading": "Beschreibung",
            "content": "<p>Produktbeschreibung hier einfügen.</p>",
            "default_open": true
          }
        },
        {
          "type": "tab",
          "settings": {
            "heading": "Produktdetails",
            "content": "<p>Produktdetails hier einfügen.</p>"
          }
        },
        {
          "type": "tab",
          "settings": {
            "heading": "Versand & Rückgabe",
            "content": "<p>Versand- und Rückgabeinformationen hier einfügen.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
