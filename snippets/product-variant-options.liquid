{% comment %}
  Renders product variant options

  Accepts:
  - product: {Object} product object.
  - option: {Object} current product_option object.
  - block: {Object} block object.
  - picker_type: {String} type of picker to dispay


  Usage:
  {% render 'product-variant-options',
    product: product,
    option: option,
    block: block
    picker_type: picker_type
  %}
  Optional: pdp_line_variant_for_selection, we_override_option_selection, pdp_allow_sold_out_selection (passed to variant-option-value)
{% endcomment %}
{%- liquid
  assign option_id_namespace = option_id_namespace | default: section.id
  assign option_name_suffix = option_name_suffix | default: ''
  assign product_form_id = 'product-form-' | append: section.id
  assign image_size = block.settings.button_size | times: 1.5
  assign skip_value_selected = skip_value_selected | default: false
  assign pdp_allow_sold_out_selection = pdp_allow_sold_out_selection | default: false
  assign use_main_color_rows = false
  if settings.main_colors != blank
    if picker_type == 'color' or picker_type == 'swatch'
      assign use_main_color_rows = true
    endif
  endif
-%}

{%- if use_main_color_rows -%}
  {%- liquid
    assign main_tokens = settings.main_colors | split: ','
    assign secondary_count = 0
  -%}
  {%- for value in option.values -%}
    {%- liquid
      assign value_norm = value | strip | downcase
      assign is_main = false
    -%}
    {%- for token in main_tokens -%}
      {%- assign token_norm = token | strip | downcase -%}
      {%- capture we_color_eq -%}{%- render 'we-color-names-equivalent', name_a: value, name_b: token -%}{%- endcapture -%}
      {%- assign we_color_eq = we_color_eq | strip -%}
      {%- if value_norm == token_norm or we_color_eq == '1' -%}
        {%- assign is_main = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- unless is_main -%}
      {%- assign secondary_count = secondary_count | plus: 1 -%}
    {%- endunless -%}
  {%- endfor -%}

  {%- liquid
    assign main_match_count = 0
  -%}
  {%- for token in main_tokens -%}
    {%- assign token_norm = token | strip | downcase -%}
    {%- for value in option.values -%}
      {%- assign value_norm = value | strip | downcase -%}
      {%- capture we_color_eq -%}{%- render 'we-color-names-equivalent', name_a: value, name_b: token -%}{%- endcapture -%}
      {%- assign we_color_eq = we_color_eq | strip -%}
      {%- if value_norm == token_norm or we_color_eq == '1' -%}
        {%- assign main_match_count = main_match_count | plus: 1 -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}

  {%- if main_match_count > 0 -%}
    {%- assign we_main_rendered_marker = '||' -%}
    <div class="variant-options__row we-variant-options__row we-variant-options__row--main flex flex-wrap gap-4">
      {%- for token in main_tokens -%}
        {%- assign token_norm = token | strip | downcase -%}
        {%- for value in option.values -%}
          {%- assign value_norm = value | strip | downcase -%}
          {%- capture we_color_eq -%}{%- render 'we-color-names-equivalent', name_a: value, name_b: token -%}{%- endcapture -%}
          {%- assign we_color_eq = we_color_eq | strip -%}
          {%- if value_norm == token_norm or we_color_eq == '1' -%}
            {%- assign value_marker = '||' | append: value | append: '||' -%}
            {%- unless we_main_rendered_marker contains value_marker -%}
              {%- assign we_main_rendered_marker = we_main_rendered_marker | append: value | append: '||' -%}
              {% render 'product-variant-option-value',
                section: section,
                block: block,
                option: option,
                value: value,
                picker_type: picker_type,
                product_form_id: product_form_id,
                image_size: image_size,
                value_index: forloop.index0,
                id_namespace: option_id_namespace,
                option_name_suffix: option_name_suffix,
                skip_value_selected: skip_value_selected,
                pdp_line_variant_for_selection: pdp_line_variant_for_selection,
                we_override_option_selection: we_override_option_selection,
                pdp_allow_sold_out_selection: pdp_allow_sold_out_selection
              %}
            {%- endunless -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if secondary_count > 0 -%}
    <div class="variant-options__row we-variant-options__row we-variant-options__row--secondary flex flex-wrap gap-4">
      {%- for value in option.values -%}
        {%- liquid
          assign value_norm = value | strip | downcase
          assign is_main = false
        -%}
        {%- for token in main_tokens -%}
          {%- assign token_norm = token | strip | downcase -%}
          {%- capture we_color_eq -%}{%- render 'we-color-names-equivalent', name_a: value, name_b: token -%}{%- endcapture -%}
          {%- assign we_color_eq = we_color_eq | strip -%}
          {%- if value_norm == token_norm or we_color_eq == '1' -%}
            {%- assign is_main = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- unless is_main -%}
          {% render 'product-variant-option-value',
            section: section,
            block: block,
            option: option,
            value: value,
            picker_type: picker_type,
            product_form_id: product_form_id,
            image_size: image_size,
            value_index: forloop.index0,
            id_namespace: option_id_namespace,
            option_name_suffix: option_name_suffix,
            skip_value_selected: skip_value_selected,
            pdp_line_variant_for_selection: pdp_line_variant_for_selection,
            we_override_option_selection: we_override_option_selection,
            pdp_allow_sold_out_selection: pdp_allow_sold_out_selection
          %}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
{%- else -%}
  {%- for value in option.values -%}
    {% render 'product-variant-option-value',
      section: section,
      block: block,
      option: option,
      value: value,
      picker_type: picker_type,
      product_form_id: product_form_id,
      image_size: image_size,
      value_index: forloop.index0,
      id_namespace: option_id_namespace,
      option_name_suffix: option_name_suffix,
      skip_value_selected: skip_value_selected,
      pdp_line_variant_for_selection: pdp_line_variant_for_selection,
      we_override_option_selection: we_override_option_selection,
      pdp_allow_sold_out_selection: pdp_allow_sold_out_selection
    %}
  {%- endfor -%}
{%- endif -%}
