        <span class="colour-text">{{'collections.general.more_colours' | t}}</span>
        {% render 'icon-colour-wheel'%}{% endcapture %}
    {% endif %}
  {% endfor %}
{% endif%}


{% for tag in product.tags %}
  {% if tag contains 'label_right' %}
    {% assign labelRightContent = tag | remove: "label_right_" | replace: "_", " " | capitalize %}
    {% assign labelRightClass = tag | remove: "label_right_" | downcase %}
  {% endif %}
  {% if tag contains 'label_left' %}
    {% assign labelLeftContent = tag | remove: "label_left_" | replace: "_", " " | capitalize %}
    {% assign labelLeftClass = tag | remove: "label_left_" | downcase %}
  {% endif %}
{% endfor %}

{% if product.metafields.global["label_left"] %}
