{% comment %}
  Prints one variant id (digits) for a set line product so its color option matches the bundle
  variant from the URL (?variant=), when the line product uses the same color option name (swatch trigger).

  Parameters:
  - bundle_product: {Object} main set/bundle product (page product)
  - line_product: {Object} any product from pdp_set_products
{% endcomment %}
{%- liquid
  assign fallback_id = line_product.selected_or_first_available_variant.id
-%}
{%- if bundle_product.selected_variant == blank -%}
  {{- fallback_id -}}
{%- else -%}
  {%- assign bv = bundle_product.selected_variant -%}
  {%- assign swatch_trigger = settings.color_swatch_trigger | downcase -%}
  {%- assign bundle_color_idx = nil -%}
  {%- for option in bundle_product.options_with_values -%}
    {%- assign on = option.name | downcase -%}
    {%- assign is_color = false -%}
    {%- if swatch_trigger contains on -%}
      {%- assign is_color = true -%}
    {%- elsif swatch_trigger contains 'color' and on contains 'colour' -%}
      {%- assign is_color = true -%}
    {%- endif -%}
    {%- if is_color -%}
      {%- assign bundle_color_idx = forloop.index0 -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if bundle_color_idx == nil -%}
    {{- fallback_id -}}
  {%- else -%}
    {%- case bundle_color_idx -%}
      {%- when 0 -%}
        {%- assign bundle_color_val = bv.option1 -%}
      {%- when 1 -%}
        {%- assign bundle_color_val = bv.option2 -%}
      {%- when 2 -%}
        {%- assign bundle_color_val = bv.option3 -%}
      {%- else -%}
        {%- assign bundle_color_val = '' -%}
    {%- endcase -%}
    {%- if bundle_color_val == blank -%}
      {{- fallback_id -}}
    {%- else -%}
      {%- assign line_color_idx = nil -%}
      {%- for option in line_product.options_with_values -%}
        {%- assign on = option.name | downcase -%}
        {%- assign is_color = false -%}
        {%- if swatch_trigger contains on -%}
          {%- assign is_color = true -%}
        {%- elsif swatch_trigger contains 'color' and on contains 'colour' -%}
          {%- assign is_color = true -%}
        {%- endif -%}
        {%- if is_color -%}
          {%- assign line_color_idx = forloop.index0 -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if line_color_idx == nil -%}
        {{- fallback_id -}}
      {%- else -%}
        {%- assign matched_id = nil -%}
        {%- for v in line_product.variants -%}
          {%- case line_color_idx -%}
            {%- when 0 -%}
              {%- assign vc = v.option1 -%}
            {%- when 1 -%}
              {%- assign vc = v.option2 -%}
            {%- when 2 -%}
              {%- assign vc = v.option3 -%}
            {%- else -%}
              {%- assign vc = '' -%}
          {%- endcase -%}
          {%- if vc == bundle_color_val and v.available -%}
            {%- assign matched_id = v.id -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if matched_id == nil -%}
          {%- for v in line_product.variants -%}
            {%- case line_color_idx -%}
              {%- when 0 -%}
                {%- assign vc = v.option1 -%}
              {%- when 1 -%}
                {%- assign vc = v.option2 -%}
              {%- when 2 -%}
                {%- assign vc = v.option3 -%}
              {%- else -%}
                {%- assign vc = '' -%}
            {%- endcase -%}
            {%- if vc == bundle_color_val -%}
              {%- assign matched_id = v.id -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if matched_id == nil -%}
          {{- fallback_id -}}
        {%- else -%}
          {{- matched_id -}}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
