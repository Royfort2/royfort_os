<div class="pbb-screen-top">
    <span role="button" class="pbb-close">
        <svg xmlns="http://www.w3.org/2000/svg" class="" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
    </span>
    <span role="button" class="pbb-back">
        <svg xmlns="http://www.w3.org/2000/svg" class="" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
    </span>
    
    <div class="pbb-summary">
        <h2 class="pbb-step-title">{{ "pdp.bundle.summary_title" | t }}</h2>
        <div class="pbb-step-breadcrumb">{{ "pdp.bundle.summary_intro" | t }}</div>
        <div class="pbb-summary-items"></div>
    </div>
</div>
<div class="pbb-screen-bottom">
    <div class="pbb-subtotal">
        <div>{{ "pdp.bundle.subtotal" | t }}</div>
        <div class="pbb-subtotal-amount">£0.00</div>
    </div>
    <div class="pbb-subtotal-overview"></div>
    <div class="" style="width:100%; display:flex; align-items: center; justify-content:space-between; max-width:346px; margin:10px auto 0 auto;">
        <button type="button" class="btn btn-primary w-full btn-slim pbb-checkout">{{ "pdp.bundle.add_to_bag" | t }}</button>
    </div>
</div>