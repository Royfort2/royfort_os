<div class="about-us-content-three">
    <div class="left-block">
        {% if section.settings.title %}<div class="title">{{section.settings.title}}</div>{% endif %}
        {% if section.settings.text_block_one %}<div class="description rte">{{section.settings.text_block_one}}</div>{% endif %}
        <div class="mobile-image">
            <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ section.settings.mobile_image_one | img_url: '760x' }}" class="lazyload img-fluid" alt="{{ section.settings.mobile_image_one.alt }}">
        </div>
        {% if section.settings.text_block_two %}<div class="description rte">{{section.settings.text_block_two}}</div>{% endif %}
        <div class="mobile-image">
            <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ section.settings.mobile_image_two | img_url: '760x' }}" class="lazyload img-fluid" alt="{{ section.settings.mobile_image_two.alt }}">
        </div>
        {% if section.settings.text_block_three %}<div class="description rte">{{section.settings.text_block_three}}</div>{% endif %}
        {% if section.settings.subtitle %}<div class="subtitle">{{section.settings.subtitle}}</div>{% endif %}
        {% if section.settings.cta_text != blank and section.settings.cta_url != blank %}
            <a class="btn btn-about" href="{{section.settings.cta_url}}">{{section.settings.cta_text }}</a>
        {% endif %}
    </div>
    <div class="right-block">
        <div class="inner-image-wrapper">
            <picture>
                <source media="(max-width: 767px)" data-srcset="{{ section.settings.mobile_image | img_url: '767x' }}">
                <source media="(min-width: 992px)" data-srcset="{{ section.settings.desktop_image | img_url: '720x' }}">
                <source media="(min-width: 1440px)" data-srcset="{{ section.settings.desktop_image | img_url: '960x' }}">
                <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ section.settings.desktop_image | img_url: '960x' }}" class="lazyload img-fluid" alt="{{ section.settings.desktop_image.alt }}">
            </picture>
        </div>
    </div>
</div>

{% schema %}
{
"name":   "Content Block Three",
"settings": [
    {
		"type": 		"text",
		"id": 			"title",
      	"label": 		"Title"
    },
    {
		"type": 		"richtext",
		"id": 			"text_block_one",
      	"label": 		"Text Block 1"
    },
    {
		"type": 		"richtext",
		"id": 			"text_block_two",
      	"label": 		"Text Block 2"
    },
    {
		"type": 		"richtext",
		"id": 			"text_block_three",
      	"label": 		"Text Block 3"
    },
    {
		"type": 		"richtext",
		"id": 			"subtitle",
      	"label": 		"Subtitle"
    },
    {
		"type": 		"text",
		"id": 			"cta_text",
      	"label": 		"CTA Text"
    },
    {
		"type": 		"url",
		"id": 			"cta_url",
      	"label": 		"CTA URL"
    },
    {
        "type": "image_picker",
        "id": "desktop_image",
        "label": "Desktop Image",
        "info": "Image aspect ratio should be 1:1"
    },
    {
        "type": "image_picker",
        "id": "mobile_image",
        "label": "Mobile Image - For the above image.",
        "info": "Image aspect ratio should be 1:1."
    },
    {
        "type": "image_picker",
        "id": "mobile_image_one",
        "label": "Mobile Image 1 - Content Block",
        "info": "Image aspect ratio should be 1:1. This appears amongst content blocks at mobile."
    },
    {
        "type": "image_picker",
        "id": "mobile_image_two",
        "label": "Mobile Image 2 - Content Block",
        "info": "Image aspect ratio should be 1:1. This appears amongst content blocks at mobile."
    }
]
}
{% endschema %}