{% comment %}
  Renders a list of product's price (regular, sale)

  Accepts:
  - product: {Object} Product Liquid object (optional)
  - use_variant: {Boolean} Renders selected or first variant price instead of overall product pricing (optional)
  - show_sale_badge: {Boolean} Renders 'Sale' badge if the product matches the condition (optional)
  - show_soldout_badge: {Boolean} Renders 'Sold Out' badge if the product matches the condition (optional)
  - price_class: {String} Adds a price class to the price element (optional)

  Usage:
  {% render 'price', product: product %}
{% endcomment %}
{%- liquid
  assign we_set_pricing = false
  assign selected_variant = product.selected_or_first_available_variant
  if use_variant
    assign target = selected_variant
  else
    assign target = product
  endif

  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999
  assign available = target.available | default: false

  assign price_min = product.price_min
  assign price_max = product.price_max
  assign available = target.available | default: false
  assign money_price = price | money
  assign money_price_min = price_min | money
  assign money_price_max = price_max | money
  if settings.currency_code_enabled
    assign money_price = price | money_with_currency
    assign money_price_min = price_min | money_with_currency
    assign money_price_max = price_max | money_with_currency
  endif
  if target == product and product.price_varies
    assign money_price = 'products.product.price.from_price_html' | t: price: money_price
  endif

  if product.metafields.custom.pdp_set_products != blank
    assign we_set_pricing = true
    comment
      Set bundles: x,y = price_min of 1st/2nd pdp_set_products entries; d = set_discount_amount (%).
      Compare (strikethrough) = x+y; sale = (x+y)*(100-d)/100. Shown as: from sale (x+y).
      Ignore bundle product target.compare_at_price_varies (else theme hides <s> or adds f-price--no-compare).
      product-set-cart-items.js updates #price on PDP when pickers change.
    endcomment
    assign we_set_plist = product.metafields.custom.pdp_set_products.value
    assign we_set_two_min_sum = 0
    for we_sp in we_set_plist limit: 2
      assign we_set_two_min_sum = we_set_two_min_sum | plus: we_sp.price_min
    endfor
    assign we_set_disc_pct = product.metafields.custom.set_discount_amount | default: 0 | plus: 0
    assign compare_at_price = we_set_two_min_sum
    assign we_set_price_factor = 100 | minus: we_set_disc_pct
    assign price = we_set_two_min_sum | times: we_set_price_factor | divided_by: 100
    assign money_price = price | money
    if settings.currency_code_enabled
      assign money_price = price | money_with_currency
    endif
    assign money_price_min = money_price
    assign money_price = 'products.product.price.from_price_html' | t: price: money_price
  endif
-%}
<script>
  console.log('product', '{{ product.title }}');
  console.log('we_set_two_min_sum', '{{ we_set_two_min_sum }}');
  console.log('we_set_disc_pct', '{{ we_set_disc_pct }}');
  console.log('we_set_price_factor', '{{ we_set_price_factor }}');
  console.log('price', '{{ price }}');
  console.log('money_price', '{{ money_price }}');
  console.log('money_price_min', '{{ money_price_min }}');
  console.log('money_price_max', '{{ money_price_max }}');
  console.log('money_price_from', '{{ money_price_from }}');
</script>
<div
  class="
    f-price
    {%- if alignment %} f-price--{{ alignment }}{% endif -%}
    {%- if price_class %} {{ price_class }}{% endif -%}
    {%- if available == false %} f-price--sold-out {% endif -%}
    {%- if compare_at_price > price and product.quantity_price_breaks_configured? != true %} f-price--on-sale {% endif -%}
    {%- if we_set_pricing != true and target.price_varies == false and target.compare_at_price_varies %} f-price--no-compare{% endif -%}
    {%- if compare_at_price > price and product.quantity_price_breaks_configured? %} volume-pricing--sale-badge{% endif -%}
  "
>
  {%- comment -%}
    Explanation of description list:
      - div.price__regular: Displayed when there are no variants on sale
      - div.price__sale: Displayed when a variant is a sale
  {%- endcomment -%}
  <div class="f-price__regular{% if price_regular_class %} {{ price_regular_class }}{% endif %}">
    {%- if product.quantity_price_breaks_configured? -%}
      {%- if we_set_pricing -%}
        <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
        <span class="f-price-item f-price-item--regular">
          <s>
            {% if settings.currency_code_enabled %}
              {{ compare_at_price | money_with_currency }}
            {% else %}
              {{ compare_at_price | money }}
            {% endif %}
          </s>
        </span>
      {%- else -%}
        {%- unless product.price_varies == false and product.compare_at_price_varies == true %}
          <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
          <span class="f-price-item f-price-item--regular">
            <s>
              {% if settings.currency_code_enabled %}
                {{ compare_at_price | money_with_currency }}
              {% else %}
                {{ compare_at_price | money }}
              {% endif %}
            </s>
          </span>
        {%- endunless -%}
      {%- endif -%}
      <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
      <span class="f-price-item f-price-item--regular">
        {{- 'products.product.volume_pricing.price_range' | t: minimum: money_price_min, maximum: money_price_max -}}
      </span>
    {%- else -%}
      <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
      <span class="f-price-item f-price-item--regular">
        {{ money_price }}
      </span>
    {%- endif -%}
  </div>
  <div class="f-price__sale{% if price_sale_class %} {{ price_sale_class }}{% endif %}">
    <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.sale_price' | t }}</span>
    <span class="f-price-item f-price-item--sale">
      {{ money_price }}
    </span>
    {%- if we_set_pricing -%}
      <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
      <span class="f-price-item f-price-item--regular">
        <s>
          {% if settings.currency_code_enabled %}
            {{ compare_at_price | money_with_currency }}
          {% else %}
            {{ compare_at_price | money }}
          {% endif %}
        </s>
      </span>
    {%- else -%}
      {%- unless target.price_varies == false and target.compare_at_price_varies %}
        <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
        <span class="f-price-item f-price-item--regular">
          <s>
            {% if settings.currency_code_enabled %}
              {{ compare_at_price | money_with_currency }}
            {% else %}
              {{ compare_at_price | money }}
            {% endif %}
          </s>
        </span>
      {%- endunless -%}
    {%- endif -%}
  </div>
  <div class="f-price__unit-wrapper{% if selected_variant.unit_price_measurement == nil %} hidden{% endif %}">
    <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
    <div class="f-price__unit">
      {%- capture unit_price_separator -%}
        <span aria-hidden="true">/</span><span class="visually-hidden">{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
      {%- endcapture -%}
      {%- capture unit_price_base_unit -%}
        <span data-unit-price-base-unit>
            {%- if selected_variant.unit_price_measurement -%}
              {%- if selected_variant.unit_price_measurement.reference_value != 1 -%}
                {{- selected_variant.unit_price_measurement.reference_value -}}
              {%- endif -%}
              {{ selected_variant.unit_price_measurement.reference_unit }}
            {%- endif -%}
          </span>
      {%- endcapture -%}
      <span data-unit-price>{{ selected_variant.unit_price | money }}</span>
      {{- unit_price_separator -}}
      {{- unit_price_base_unit -}}
    </div>
  </div>

  {% if show_sale_badge or show_soldout_badge %}
    <div class="f-price__badges">
      {% if show_sale_badge %}
        {% liquid
          assign sale_badge = ''
          assign amount = 0
          case sale_badge_type
            when 'percentage'
              if compare_at_price > price
                assign amount = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price | append: '%'
              endif
              assign sale_badge = 'products.product.price.save_price_html' | t: amount: amount
            when 'fixed_amount'
              if compare_at_price > price
                assign amount = compare_at_price | minus: price | money
              endif
              assign sale_badge = 'products.product.price.save_price_html' | t: amount: amount
            else
              assign sale_badge = 'products.product.on_sale' | t
          endcase
        %}
        <div class="f-price__badge-sale" data-type="{{ sale_badge_type }}">
          <span class="f-badge f-badge--sale">{{ sale_badge }}</span>
        </div>
      {% endif %}
      {% if show_soldout_badge %}
        <div class="f-price__badge-sold-out">
          <span class="f-badge f-badge--soldout">{{ 'products.product.sold_out' | t }}</span>
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>
