        "checksum": "bd3470b9ab0f537c6992fa0145f738a00cb31b9393cd3bbefa645cbf50e2079c_1_1_0_0__1",
        "ggAmE0FQphP_text": "<p>Vermittelt Feng-Shui-Wissen in strukturierten Kursen und praxisnahen Formaten zur direkten Anwendung im eigenen Zuhause.</p>",
        "ggC21NI-Chf_text": "Podcast Host",
        "ggNwYVZkAHW_text": "<p>Teilt Impulse rund um Raumenergie, Gestaltung und Wirkung von Wohn- und Lebensräumen in verständlichen, alltagsnahen Gesprächen.</p>",
        "gggrXR-hten_text": "Autorin &amp; Kursleiterin"
      },
