{% comment %}
  Renders a list of product's price (regular, sale)

  Accepts:
  - product: {Object} Product Liquid object (optional)
  - use_variant: {Boolean} Renders selected or first variant price instead of overall product pricing (optional)
  - show_sale_badge: {Boolean} Renders 'Sale' badge if the product matches the condition (optional)
  - show_soldout_badge: {Boolean} Renders 'Sold Out' badge if the product matches the condition (optional)
  - price_class: {String} Adds a price class to the price element (optional)

  Usage:
  {% render 'price', product: product %}
{% endcomment %}
{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  if use_variant
    assign target = selected_variant
  else
    assign target = product
  endif

  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999
  assign available = target.available | default: false

  assign price_min = product.price_min
  assign price_max = product.price_max
  assign available = target.available | default: false
  assign money_price = price | money
  assign money_price_min = price_min | money
  assign money_price_max = price_max | money
  if settings.currency_code_enabled
    assign money_price = price | money_with_currency
    assign money_price_min = price_min | money_with_currency
    assign money_price_max = price_max | money_with_currency
  endif
  if target == product and product.price_varies
    assign money_price = 'products.product.price.from_price_html' | t: price: money_price
  endif

  if product.metafields.custom.pdp_set_products != blank
    if section
      assign pdp_section_has_we_variant_picker = false
      assign pdp_section_has_variant_picker = false
      for sb in section.blocks
        if sb.type == 'we_variant_picker'
          assign pdp_section_has_we_variant_picker = true
        endif
        if sb.type == 'variant_picker'
          assign pdp_section_has_variant_picker = true
        endif
      endfor
      assign pdp_zw_omit_main = false
      if pdp_section_has_we_variant_picker and pdp_section_has_variant_picker == false
        assign pdp_zw_omit_main = true
      endif

      assign zw_sale_cents = 0
      assign zw_compare_cents = 0
      assign set_products_zw = product.metafields.custom.pdp_set_products.value

      if pdp_zw_omit_main
        for sp in set_products_zw limit: 2
          capture we_set_line_vid_c
            render 'we-pdp-first-set-line-variant-id', bundle_product: product, line_product: sp
          endcapture
          assign we_set_line_vid_str = we_set_line_vid_c | strip
          assign zw_v = sp.selected_or_first_available_variant
          if we_set_line_vid_str != blank
            assign we_set_line_vid_num = we_set_line_vid_str | plus: 0
            for v in sp.variants
              if v.id == we_set_line_vid_num
                assign zw_v = v
                break
              endif
            endfor
          endif
          assign zw_qr = zw_v.quantity_rule
          assign zw_q_min = zw_qr.min | default: 1
          if zw_q_min < 1
            assign zw_q_min = 1
          endif
          assign zw_line_sale = zw_v.price | times: zw_q_min
          assign zw_sale_cents = zw_sale_cents | plus: zw_line_sale
          assign unit_cmp = zw_v.price
          if zw_v.compare_at_price > zw_v.price
            assign unit_cmp = zw_v.compare_at_price
          endif
          assign zw_line_cmp = unit_cmp | times: zw_q_min
          assign zw_compare_cents = zw_compare_cents | plus: zw_line_cmp
        endfor
      else
        assign zw_first = set_products_zw | first
        assign zw_main_v = product.selected_or_first_available_variant
        assign zw_main_qr = zw_main_v.quantity_rule
        assign zw_main_q_min = zw_main_qr.min | default: 1
        if zw_main_q_min < 1
          assign zw_main_q_min = 1
        endif
        assign zw_main_sale_cents = zw_main_v.price | times: zw_main_q_min
        assign zw_main_compare_cents = zw_main_sale_cents
        if zw_main_v.compare_at_price > zw_main_v.price
          assign zw_main_compare_cents = zw_main_v.compare_at_price | times: zw_main_q_min
        endif
        capture zw_first_vid_c
          render 'we-pdp-first-set-line-variant-id', bundle_product: product, line_product: zw_first
        endcapture
        assign zw_first_vid_str = zw_first_vid_c | strip
        assign zw_v = zw_first.selected_or_first_available_variant
        if zw_first_vid_str != blank
          assign zw_first_vid_num = zw_first_vid_str | plus: 0
          for v in zw_first.variants
            if v.id == zw_first_vid_num
              assign zw_v = v
              break
            endif
          endfor
        endif
        assign zw_qr = zw_v.quantity_rule
        assign zw_q_min = zw_qr.min | default: 1
        if zw_q_min < 1
          assign zw_q_min = 1
        endif
        assign zw_first_sale_cents = zw_v.price | times: zw_q_min
        assign zw_first_compare_cents = zw_first_sale_cents
        if zw_v.compare_at_price > zw_v.price
          assign zw_first_compare_cents = zw_v.compare_at_price | times: zw_q_min
        endif
        assign zw_sale_cents = zw_main_sale_cents | plus: zw_first_sale_cents
        assign zw_compare_cents = zw_main_compare_cents | plus: zw_first_compare_cents
      endif

      if product.metafields.custom.set_discount_amount > 0
        assign zw_amount_difference = 100 | minus: product.metafields.custom.set_discount_amount
        assign zw_sale_cents = zw_compare_cents | times: zw_amount_difference | divided_by: 100
      endif

      assign compare_at_price = zw_compare_cents
      assign price = zw_sale_cents
      assign money_price = price | money
      if settings.currency_code_enabled
        assign money_price = price | money_with_currency
      endif
      assign money_price_min = money_price
    elsif product.metafields.custom.set_discount_amount > 0
      assign price_set_product_1 = 0
      assign price_set_product_2 = 0
      for set_product in product.metafields.custom.pdp_set_products.value
        if forloop.first
          assign price_set_product_1 = set_product.price_min
        endif
        if forloop.index == 2
          assign price_set_product_2 = set_product.price_min
        endif
      endfor
      assign set_compare_at_total = price_set_product_1 | plus: price_set_product_2
      assign compare_at_price = set_compare_at_total
      assign discount_amount = product.metafields.custom.set_discount_amount
      assign amount_difference = 100 | minus: discount_amount
      assign price = set_compare_at_total | times: amount_difference | divided_by: 100
      assign money_price = price | money
      if settings.currency_code_enabled
        assign money_price = price | money_with_currency
      endif
      assign money_price_min = money_price
      assign money_price = 'products.product.price.from_price_html' | t: price: money_price
    endif
  endif
-%}
<div
  class="
    f-price
    {%- if alignment %} f-price--{{ alignment }}{% endif -%}
    {%- if price_class %} {{ price_class }}{% endif -%}
    {%- if available == false %} f-price--sold-out {% endif -%}
    {%- if compare_at_price > price and product.quantity_price_breaks_configured? != true %} f-price--on-sale {% endif -%}
    {%- if target.price_varies == false and target.compare_at_price_varies %} f-price--no-compare{% endif -%}
    {%- if compare_at_price > price and product.quantity_price_breaks_configured? %} volume-pricing--sale-badge{% endif -%}
  "
>
  {%- comment -%}
    Explanation of description list:
      - div.price__regular: Displayed when there are no variants on sale
      - div.price__sale: Displayed when a variant is a sale
  {%- endcomment -%}
  <div class="f-price__regular{% if price_regular_class %} {{ price_regular_class }}{% endif %}">
    {%- if product.quantity_price_breaks_configured? -%}
      {%- unless product.price_varies == false and product.compare_at_price_varies == true %}
        <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
        <span class="f-price-item f-price-item--regular">
          <s>
            {% if settings.currency_code_enabled %}
              {{ compare_at_price | money_with_currency }}
            {% else %}
              {{ compare_at_price | money }}
            {% endif %}
          </s>
        </span>
      {%- endunless -%}
      <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
      <span class="f-price-item f-price-item--regular">
        {{- 'products.product.volume_pricing.price_range' | t: minimum: money_price_min, maximum: money_price_max -}}
      </span>
    {%- else -%}
      <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
      <span class="f-price-item f-price-item--regular">
        {{ money_price }}
      </span>
    {%- endif -%}
  </div>
  <div class="f-price__sale{% if price_sale_class %} {{ price_sale_class }}{% endif %}">
    <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.sale_price' | t }}</span>
    <span class="f-price-item f-price-item--sale">
      {{ money_price }}
    </span>
    {%- unless target.price_varies == false and target.compare_at_price_varies %}
      <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
      <span class="f-price-item f-price-item--regular">
        <s>
          {% if settings.currency_code_enabled %}
            {{ compare_at_price | money_with_currency }}
          {% else %}
            {{ compare_at_price | money }}
          {% endif %}
        </s>
      </span>
    {%- endunless -%}
  </div>
  <div class="f-price__unit-wrapper{% if selected_variant.unit_price_measurement == nil %} hidden{% endif %}">
    <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
    <div class="f-price__unit">
      {%- capture unit_price_separator -%}
        <span aria-hidden="true">/</span><span class="visually-hidden">{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
      {%- endcapture -%}
      {%- capture unit_price_base_unit -%}
        <span data-unit-price-base-unit>
            {%- if selected_variant.unit_price_measurement -%}
              {%- if selected_variant.unit_price_measurement.reference_value != 1 -%}
                {{- selected_variant.unit_price_measurement.reference_value -}}
              {%- endif -%}
              {{ selected_variant.unit_price_measurement.reference_unit }}
            {%- endif -%}
          </span>
      {%- endcapture -%}
      <span data-unit-price>{{ selected_variant.unit_price | money }}</span>
      {{- unit_price_separator -}}
      {{- unit_price_base_unit -}}
    </div>
  </div>

  {% if show_sale_badge or show_soldout_badge %}
    <div class="f-price__badges">
      {% if show_sale_badge %}
        {% liquid
          assign sale_badge = ''
          assign amount = 0
          case sale_badge_type
            when 'percentage'
              if compare_at_price > price
                assign amount = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price | append: '%'
              endif
              assign sale_badge = 'products.product.price.save_price_html' | t: amount: amount
            when 'fixed_amount'
              if compare_at_price > price
                assign amount = compare_at_price | minus: price | money
              endif
              assign sale_badge = 'products.product.price.save_price_html' | t: amount: amount
            else
              assign sale_badge = 'products.product.on_sale' | t
          endcase
        %}
        <div class="f-price__badge-sale" data-type="{{ sale_badge_type }}">
          <span class="f-badge f-badge--sale">{{ sale_badge }}</span>
        </div>
      {% endif %}
      {% if show_soldout_badge %}
        <div class="f-price__badge-sold-out">
          <span class="f-badge f-badge--soldout">{{ 'products.product.sold_out' | t }}</span>
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>
