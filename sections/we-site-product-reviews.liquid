{%- comment -%}
  Stamped.io main reviews widget on product pages.
  The buy-box badge scrolls to #stamped-main-widget (Stamped default + stamped-badge-rating.js fallback).
{%- endcomment -%}
<div
  id="WeSiteSection-{{ section.id }}"
  class="we-site-product-reviews section section--padding color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="we-site-product-reviews__inner">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {% render block %}
      {%- endfor -%}
    {%- elsif settings.public_key_stamped != blank and settings.stamped_store_hash != blank -%}
      <div
        id="stamped-main-widget"
        class="stamped-main-widget"
        data-widget-language="{{ request.locale.iso_code | upcase }}"
        data-take-reviews="2"
        data-load-type="pagination"
        data-animation="false"
        data-product-id="{{ product.id }}"
        data-name="{{ product.title | escape }}"
        data-url="{{ shop.url }}{{ product.url }}"
        data-image-url="{{ product.featured_image | image_url: width: 800 }}"
        data-description="{{ product.description | strip_html | escape }}"
        data-product-sku="{{ product.handle | escape }}"
        data-product-type="{{ product.type | escape }}"
      ></div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "[we] Product reviews",
  "tag": "section",
  "class": "we-site-product-reviews-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "[we] Product reviews"
    }
  ]
}
{% endschema %}
