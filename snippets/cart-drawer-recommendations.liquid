{%- if section.settings.enable_cart_recommendations -%}
  <div class="cart-drawer__recs-heading">
    {{ section.settings.cart_recommendations_heading | escape }}
  </div>
  {%- liquid
    assign cart_rec_eligible_count = 0
    for item in cart.items
      assign is_gift_wrap_line = false
      if gift_wrap_id != null and item.id == gift_wrap_id
        assign is_gift_wrap_line = true
      endif
      unless is_gift_wrap_line
        assign cart_rec_eligible_count = cart_rec_eligible_count | plus: 1
      endunless
    endfor
  -%}
  <div class="cart-drawer__recs-body">
    {% render 'cart-drawer-recs-fallback', section: section, gift_wrap_id: gift_wrap_id %}
    {%- if cart_rec_eligible_count > 0 -%}
      {%- liquid
        assign cart_rec_total_cap = section.settings.cart_recommendations_limit | default: 10
        assign cart_rec_base = cart_rec_total_cap | divided_by: cart_rec_eligible_count
        assign cart_rec_rem = cart_rec_total_cap | modulo: cart_rec_eligible_count
        assign cart_rec_eidx = 0
        assign cart_rec_seeds_first = true
        capture cart_rec_seeds_json
          echo '['
          for item in cart.items
            assign is_gift_wrap_line = false
            if gift_wrap_id != null and item.id == gift_wrap_id
              assign is_gift_wrap_line = true
            endif
            if is_gift_wrap_line
              continue
            endif
            assign cart_rec_eidx = cart_rec_eidx | plus: 1
            assign cart_rec_budget = cart_rec_base
            if cart_rec_eidx <= cart_rec_rem
              assign cart_rec_budget = cart_rec_budget | plus: 1
            endif
            if cart_rec_budget < 1
              continue
            endif
            unless cart_rec_seeds_first
              echo ','
            endunless
            assign cart_rec_seeds_first = false
            echo '{"productId":' | append: item.product_id | append: ',"limit":' | append: cart_rec_budget | append: '}'
          endfor
          echo ']'
        endcapture
        assign cart_rec_seeds_trim = cart_rec_seeds_json | strip
        assign cart_rec_exclude_first = true
        capture cart_rec_exclude_json
          echo '['
          for item in cart.items
            unless cart_rec_exclude_first
              echo ','
            endunless
            assign cart_rec_exclude_first = false
            echo item.product_id
          endfor
          echo ']'
        endcapture
        assign cart_rec_heading_id = 'RelatedProductsHeading-cart-' | append: section.id | append: '-combined'
      -%}
      {%- if cart_rec_seeds_trim != '[]' -%}
        <we-cart-combined-recommendations
          class="we-complementary-inline hidden"
          data-seeds="{{ cart_rec_seeds_json | strip | escape }}"
          data-exclude-product-ids="{{ cart_rec_exclude_json | strip | escape }}"
          data-total-limit="{{ cart_rec_total_cap }}"
          data-intent="related"
          data-heading="{{ section.settings.cart_recommendations_heading | escape }}"
          data-heading-id="{{ cart_rec_heading_id }}"
          data-complementary-aria-label="{{ 'accessibility.complementary_products' | t | escape }}"
          data-prev-slide-label="{{ 'general.slider.previous_slide' | t | escape }}"
          data-next-slide-label="{{ 'general.slider.next_slide' | t | escape }}"
          data-recommendations-url="{{ routes.product_recommendations_url | escape }}"
          data-theme-id="{{ theme.id }}"
          data-render-badges="{% if section.settings.cart_combined_render_badges == false %}false{% else %}true{% endif %}"
          data-badges-global-only="{% if section.settings.cart_combined_badges_global_only %}true{% else %}false{% endif %}"
        >
          <div
            class="we-main-product-related__root hidden"
            id="we-main-product-related-{{ section.id }}-cart-combined-root"
          ></div>
        </we-cart-combined-recommendations>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endif -%}
