                {%- render 'we-pdp-first-set-line-variant-id', bundle_product: product, line_product: first_product -%}
              {%- endcapture -%}
              {%- assign we_set_line_vid_str = we_set_line_vid_c | strip -%}
              {%- assign we_set_line_resolved = first_product.selected_or_first_available_variant -%}
              {%- if we_set_line_vid_str != blank -%}
                {%- for v in first_product.variants -%}
                  {%- assign v_id_str = v.id | append: '' -%}
                  {%- if v_id_str == we_set_line_vid_str -%}
                    {%- assign we_set_line_resolved = v -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              {% comment %}
                First set product: same picker treatment as main (embedded set line item — custom dropdown, swatches, inline qty).
                Additional metafield products: checkbox cards below.
              {% endcomment %}
              {% render 'product-variant-picker',
                product: first_product,
                block: block,
                product_form_id: product_form_id,
                update_url: update_browser_history,
                picker_id_suffix: first_product.id,
                option_name_suffix: first_option_name_suffix,
                pdp_set_bundle_context: true,
                pdp_set_line_variant_from_bundle: we_set_line_resolved
              %}
              <script type="application/json" data-set-product-variants="{{ first_product.id }}">
                {{ first_product.variants | json }}
              </script>
              <script type="application/json" data-set-default-variant-id="{{ first_product.id }}">
                {{ we_set_line_resolved.id | json }}
              </script>

              {% if product.metafields.custom.pdp_set_products.value.size > 1 %}
                <details
                  id="Details-set-{{ block.id }}-{{ section.id }}"
                  class="accordion-details product-set-picker__accordion"
                  is="accordion-group"
                  open
                  aria-expanded="true"
                >
                  <summary class="accordion-details__summary flex items-center justify-between">
                    <span class="product-set-picker__heading">
                      {{ block.settings.set_picker_title }}
                    </span>
                    {%- render 'icon-plus-toggle', size: 'small' -%}
                  </summary>
                  <div
                    id="ProductSetAccordionContent-{{ block.id }}-{{ section.id }}"
                    class="accordion-details__content product-set-picker__list"
                  >
                    {% for set_product in product.metafields.custom.pdp_set_products.value offset: 1 %}
                      {%- capture we_set_line_vid_c -%}
                        {%- render 'we-pdp-first-set-line-variant-id', bundle_product: product, line_product: set_product -%}
                      {%- endcapture -%}
                      {%- assign we_set_line_vid_str = we_set_line_vid_c | strip -%}
                      {%- assign we_set_line_resolved = set_product.selected_or_first_available_variant -%}
                      {%- if we_set_line_vid_str != blank -%}
                        {%- for v in set_product.variants -%}
                          {%- assign v_id_str = v.id | append: '' -%}
                          {%- if v_id_str == we_set_line_vid_str -%}
                            {%- assign we_set_line_resolved = v -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}
                      {%- liquid
                        assign we_set_card_title = set_product.title
