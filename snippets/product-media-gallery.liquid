{% comment %}
  Renders a product media gallery. Should be used with 'media-gallery.js'

  Accepts:
  - product: {Object} Product liquid object
  - variant_images: {Array} Product images associated with a variant
  - vertical_thumbs_always: {Boolean} optional — force vertical thumb swiper (e.g. quick view drawer below 768px)
  - gallery_aspect_ratio: {String} optional — main slide aspect ratio CSS value (default 4 / 5)

  Usage:
  {% render 'product-media-gallery' %}
{% endcomment %}

{%- liquid
  assign vertical_thumbs_always = vertical_thumbs_always | default: false
  assign gallery_aspect_ratio = gallery_aspect_ratio | default: '4 / 5'
  assign we_mf_media_list = product.metafields.custom.we_temp_product_media.value
  assign we_use_metafield_gallery = false
  if settings.use_metafield_media and we_mf_media_list != blank and we_mf_media_list.size > 0
    assign we_use_metafield_gallery = true
  endif
  if we_use_metafield_gallery
    assign media_count = we_mf_media_list.size
    if media_count > 180
      assign media_count = 180
    endif
  else
    assign media_count = product.media.size
  endif

  assign color_option_index = 0
  assign we_builtin_color_triggers = 'farbe,color,colour,couleur,kleur,colore,cor,farve,färg,farg,kolor,hinta,szín,väri,barva,culoare,renk'
  if settings.color_swatch_trigger != blank
    assign we_color_trigger_csv = settings.color_swatch_trigger | append: ',' | append: we_builtin_color_triggers
  else
    assign we_color_trigger_csv = we_builtin_color_triggers
  endif
  assign we_color_trigger_list = we_color_trigger_csv | downcase | split: ','
  for option in product.options_with_values
    assign opt_name = option.name | downcase | strip
    assign matched = false
    for trigger in we_color_trigger_list
      assign tr = trigger | strip
      if tr != blank and opt_name == tr
        assign color_option_index = option.position
        assign matched = true
        break
      endif
    endfor
    if matched
      break
    endif
  endfor

  assign has_only_once_media = false
  if media_count < 2
    assign has_only_once_media = true
  endif

  assign media_item_gap = 4

  if section.settings.media_size == 'large'
    assign media_width = 0.585
  elsif section.settings.media_size == 'medium'
    assign media_width = 0.5
  elsif section.settings.media_size == 'small'
    assign media_width = 0.45
  endif

  assign enable_mobile_thumbnails = false
  if mobile_thumbnails == 'show'
    assign enable_mobile_thumbnails = true
  endif

  assign enable_desktop_slider = false
  if has_only_once_media == false
    if media_layout contains 'carousel' or media_layout == 'slider-freemode'
      assign enable_desktop_slider = true
    endif
  endif

  assign we_gallery_overflow_enabled = false
  if media_count > 6 and enable_desktop_slider == false and has_only_once_media == false
    case media_layout
      when 'grid-mix'
        assign we_gallery_overflow_enabled = true
      when 'stacked'
        assign we_gallery_overflow_enabled = true
      when 'columns'
        assign we_gallery_overflow_enabled = true
    endcase
  endif
-%}
{%- capture we_overflow_expand_aria_tpl -%}
  {{- 'products.product.media.expand_remaining_gallery' | t: count: '__N__' -}}
{%- endcapture %}
<media-gallery
  id="MediaGallery-{{ section.id }}"
  role="region"
  class="block product__media-gallery{% if enable_sticky_info %} sticky-element{% endif %}"
  aria-label="{{ 'products.product.media.gallery_viewer' | t }}"
  data-media-layout="{{ media_layout }}"
  data-only-image="{{ has_only_once_media }}"
  data-enable-image-zoom="{{ enable_image_zoom }}"
  data-enable-desktop-slider="{{ enable_desktop_slider }}"
  data-enable-mobile-thumbnails="{{ enable_mobile_thumbnails }}"
  data-media-item-gap="{{ media_item_gap }}"
  data-color-option-index="{{ color_option_index }}"
  {% if vertical_thumbs_always %}data-vertical-thumbs-always="true"{% endif %}
  {% if we_use_metafield_gallery %}data-we-metafield-media="true"{% endif %}
  {% if we_gallery_overflow_enabled %}
    data-we-gallery-overflow="true"
    data-overflow-expand-aria="{{ we_overflow_expand_aria_tpl | strip | escape }}"
  {% endif %}
  style="--media-item-gap: {{ media_item_gap }}px"
>
  <div id="GalleryStatus-{{ section.id }}" class="visually-hidden" role="status"></div>
  <div class="product__media-gallery-viewer-wrap relative">
    <div
      id="GalleryViewer-{{ section.id }}"
      class="product__media-gallery-viewer blocks-radius swiper"
    >
      <a class="skip-to-content-link button visually-hidden" href="#ProductInfo-{{ section.id }}">
        {{ 'accessibility.skip_to_product_info' | t }}
      </a>
      <div
        id="Slider-Gallery-{{ section.id }}"
        class="product__media-list flex swiper-wrapper"
        role="list"
      >
        {%- if we_use_metafield_gallery -%}
          {% paginate we_mf_media_list by 180 %}
            {%- for media_item in we_mf_media_list -%}
              {%- assign we_mf_syn_id = 'we-mf-' | append: forloop.index0 -%}
              {% render 'we-metafield-media-item',
                product: product,
                media_item: media_item,
                synthetic_id: we_mf_syn_id,
                position: forloop.index0,
                media_count: media_count,
                desktop_layout: media_layout,
                mobile_layout: mobile_thumbnails,
                enable_image_zoom: enable_image_zoom,
                media_width: media_width,
                gallery_aspect_ratio: gallery_aspect_ratio
              %}
            {%- endfor -%}
          {% endpaginate %}
        {%- else -%}
          {%- for media in product.media -%}
            {% render 'product-thumbnail',
              media: media,
              media_count: media_count,
              position: forloop.index0,
              desktop_layout: media_layout,
              mobile_layout: mobile_thumbnails,
              enable_image_zoom: enable_image_zoom,
              loop: section.settings.enable_video_looping,
              modal_id: section.id,
              xr_button: true,
              media_width: media_width,
              gallery_aspect_ratio: gallery_aspect_ratio
            %}
          {%- endfor -%}
        {%- endif -%}
      </div>
      {%- if media_count > 1 -%}
        <button
          type="button"
          class="swiper-button-prev swiper-button--blank product__media-gallery-nav-btn product__media-gallery-nav-prev md:hidden"
          aria-label="{{ 'general.slider.previous_slide' | t }}"
        >
          {%- render 'icon-slider-prev', size: 'medium' -%}
        </button>
        <button
          type="button"
          class="swiper-button-next swiper-button--blank product__media-gallery-nav-btn product__media-gallery-nav-next md:hidden"
          aria-label="{{ 'general.slider.next_slide' | t }}"
        >
          {%- render 'icon-slider-next', size: 'medium' -%}
        </button>
      {%- endif -%}
    </div>
  </div>
  {%- if media_count > 1 -%}
    <div class="swiper-pagination product__media-gallery-progress" aria-hidden="true"></div>
  {%- endif -%}
  {%- if media_count > 1 and media_layout contains 'carousel' or mobile_thumbnails == 'show' -%}
    {%- liquid
      assign thumbnail_class = ''
      if enable_desktop_slider and mobile_thumbnails != 'show'
        assign thumbnail_class = ' hidden md:block'
      elsif enable_desktop_slider == false and mobile_thumbnails == 'show'
        assign thumbnail_class = ' block md:hidden'
      endif
    -%}
    <div
      id="GalleryThumbnails-{{ section.id }}"
      class="product__media-gallery-thumbails swiper{{ thumbnail_class }}"
    >
      <div
        id="Slider-Thumbnails-{{ section.id }}"
        class="thumbnail-list swiper-wrapper"
      >
        {%- if we_use_metafield_gallery -%}
          {% paginate we_mf_media_list by 180 %}
            {%- for media_item in we_mf_media_list -%}
              {%- liquid
                assign we_thumb_preview = media_item
                if media_item.preview_image != blank
                  assign we_thumb_preview = media_item.preview_image
                endif
                assign we_thumb_w = we_thumb_preview.width | default: 400
                assign we_syn = 'we-mf-' | append: forloop.index0
              -%}
              <div
                class="product__thumbs-item swiper-slide"
                data-target="{{ we_syn }}"
                data-media-position="{{ forloop.index }}"
              >
                <div class="product__thumbs-container medium-blocks-radius media-wrapper">
                  <div
                    class="product__thumbs-inner"
                    style="--aspect-ratio: {% if vertical_thumbs_always %}4 / 5{% else %}1{% endif %}"
                  >
                    {{
                      we_thumb_preview
                      | image_url: width: we_thumb_w
                      | image_tag:
                        loading: 'lazy',
                        widths: '70, 100, 140, 150, 200, 300, 400',
                        sizes: '(max-width: 767px) calc((100vw - 30px) / 4), (max-width: 1023px) 70px, 150px',
                        is: 'image-lazy',
                        alt: we_thumb_preview.alt
                    }}
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {% endpaginate %}
        {%- else -%}
          {%- for media in product.media -%}
            {%- liquid
              capture media_index
                if media.media_type == 'model'
                  increment model_index
                elsif media.media_type == 'video' or media.media_type == 'external_video'
                  increment video_index
                elsif media.media_type == 'image'
                  increment image_index
                endif
              endcapture
              assign media_index = media_index | plus: 1
            -%}
            <div
              class="product__thumbs-item swiper-slide"
              data-target="{{ media.id }}"
              data-media-position="{{ media_index }}"
            >
              <div class="product__thumbs-container medium-blocks-radius media-wrapper">
                <div
                  class="product__thumbs-inner"
                  style="--aspect-ratio: {% if vertical_thumbs_always %}4 / 5{% else %}1{% endif %}"
                >
                  {{
                    media.preview_image
                    | image_url: width: media.preview_image.width
                    | image_tag:
                      loading: 'lazy',
                      widths: '70, 100, 140, 150, 200, 300, 400',
                      sizes: '(max-width: 767px) calc((100vw - 30px) / 4), (max-width: 1023px) 70px, 150px',
                      id: thumbnail_id,
                      is: 'image-lazy',
                      alt: media.alt
                    | escape
                  }}
                </div>
                {%- if media.media_type == 'model' -%}
                  <span class="product__thumbs-badge" aria-hidden="true">
                    {%- render 'icon-3d-model', size: 'small' -%}
                  </span>
                {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
                  <span class="product__thumbs-badge" aria-hidden="true">
                    {%- render 'icon-video', size: 'small' -%}
                  </span>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
  {% render 'product-image-tooltip-templates', section: section %}
</media-gallery>
