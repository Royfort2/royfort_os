{% assign main_title = product.metafields.newcontent.title %}
{% assign content = product.metafields.newcontent.content %}

<div class="product-detail-row">
    <div class="section-background new-content-block">
        <div class="{{section.settings.usp_section_container}} py-lg-3" style="background-color:{{section.settings.usp_section_container_bg}};">
            <div class="main-block d-flex flex-direction-row flex-wrap justify-content-between">
                {% for aa in content %}
                    {% assign content_index = forloop.index0 %}
                    <div class="single-block {{section.settings.usp_icon_placement}}">
                                <div class="block-content">
                                    {% if main_title[content_index] != blank %}<h2 style="color:{{section.settings.usp_title_main_color}};" class="text-18 mb-3">{{main_title[content_index]}}</h2>{% endif %}
                                    {% if content[content_index] != blank %}<div class="rte text-12">{{content[content_index]}}</div>{% endif %}
                                </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

