{% comment %}
  Outputs a JSON array of color name groups (same hex in swatch_list = one group).
  Used by media-gallery.js so gallery alt tags (e.g. "Weiß") match translated option values (e.g. "White").
{% endcomment %}
{%- liquid
  assign swatch_config = settings.swatch_list | newline_to_br | split: '<br />'
  assign seen_hex_marker = '||'
  assign seen_hexes = seen_hex_marker
-%}
[
{%- assign first_group = true -%}
{%- for swatch in swatch_config -%}
  {%- assign swatch_parts = swatch | strip | split: ':' -%}
  {%- if swatch_parts.size < 2 -%}
    {%- continue -%}
  {%- endif -%}
  {%- assign hex_key = swatch_parts.last | downcase | strip -%}
  {%- assign hex_token = seen_hex_marker | append: hex_key | append: seen_hex_marker -%}
  {%- if seen_hexes contains hex_token -%}
    {%- continue -%}
  {%- endif -%}
  {%- assign seen_hexes = seen_hexes | append: hex_key | append: seen_hex_marker -%}
  {%- unless first_group -%},{%- endunless -%}
  [
  {%- assign first_name = true -%}
  {%- for swatch2 in swatch_config -%}
    {%- assign sp2 = swatch2 | strip | split: ':' -%}
    {%- if sp2.size < 2 -%}
      {%- continue -%}
    {%- endif -%}
    {%- assign hex2 = sp2.last | downcase | strip -%}
    {%- if hex2 != hex_key -%}
      {%- continue -%}
    {%- endif -%}
    {%- assign raw_names = sp2.first | strip -%}
    {%- assign name_parts = raw_names | split: '|' -%}
    {%- for name_part in name_parts -%}
      {%- assign nm = name_part | downcase | strip -%}
      {%- if nm == blank -%}
        {%- continue -%}
      {%- endif -%}
      {%- unless first_name -%},{%- endunless -%}
      {{- nm | json -}}
      {%- assign first_name = false -%}
    {%- endfor -%}
  {%- endfor -%}
  ]
  {%- assign first_group = false -%}
{%- endfor -%}
]
