<div class="ajax-cart__item">

  <div class="ajax-cart__item-wrap">

    <div class="ajax-cart__item-image">
      {% if item.image != blank %}
        <a href="{{ item.url | within: collections.all }}" class="d-block">
          <img data-src="{{ item | img_url: '90x90' }}" alt="item.title" height="90" width="90" class="lazyload">
        </a>
      {% endif %}
    </div>

    <div class="ajax-cart__item-info">

      <div class="ajax-cart__item-name">

        {%- case shop.permanent_domain -%}

          {%- comment %}
            DE store
          {% endcomment -%}
        {%- when 'bw2016.myshopify.com' -%}
          {%- assign duvetcover = ' Deckenbezug' -%}

          {%- comment %}
            CH store
          {% endcomment -%}
        {%- when 'royfort-ch.myshopify.com' -%}
          {%- assign duvetcover = ' Deckenbezug' -%}

          {%- comment %}
            Other store
          {% endcomment -%}
        {%- else -%}
          {%- assign duvetcover = ' Duvet Cover' -%}
        {%- endcase -%}

        {%- capture product_title %}
          {{ item.product.title }}{% endcapture -%}
        {%- if product_title contains ' Set' %}
          {% assign product_title = product_title | replace: ' Set', duvetcover %}{% endif -%}

        <a href="{{ item.url }}" class="title-font text-14">{{ product_title }}</a>
        {% unless item.product.has_only_default_variant %}
          <div class="text-12">{{ item.variant.title }}</div>
        {% endunless %}
      </div>

      <div class="ajax-cart__item-price title-font text-primary text-14" style="flex-direction: column; align-items: unset;">
        {{ item.price | money }}

        <span class="original-price money title-font " style="color: #FFC42F; ">
          {% if item.product.selected_or_first_available_variant.compare_at_price > item.product.selected_or_first_available_variant.price %}
            <span style="text-decoration: line-through;" class="compare-at-price">
              {{item.product.selected_or_first_available_variant.compare_at_price | money }}
            </span>

            {% assign saving = item.product.selected_or_first_available_variant.compare_at_price | minus: item.product.selected_or_first_available_variant.price | times: 100 | divided_by: item.product.selected_or_first_available_variant.compare_at_price %}

            {% assign percentage = saving | at_least: percentage %}


            <span style="margin-left: 20px;" class="compare-at-price-percentage">-{{percentage}}%</span>
          {% endif %}
        </span>
      </div>

    </div>

  </div>

  <div class="ajax-cart__item-controlls">
    <div class="ajax-cart__qty" data-variant-id="{{item.variant_id}}">
      <span class="ajax-cart__qty--minus">
        <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
          <g fill="none" fill-rule="evenodd"><rect stroke="#D9D9D9" fill="#FFF" x=".5" y=".5" width="17" height="17" rx="8.5"/><path d="M5 9h8" stroke="#000000"/></g>
        </svg>
      </span>
      <span class="ajax-cart__qty--number">{{ item.quantity}}</span>
      <span class="ajax-cart__qty--plus">
        <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
          <g fill="none" fill-rule="evenodd"><rect stroke="#D9D9D9" fill="#FFF" x=".5" y=".5" width="17" height="17" rx="8.5"/><g stroke="#000000"><path d="M4 9h10M9 4v10"/></g>
          </g>
        </svg>
      </span>
    </div>
    <div class="ajax-cart__remove">
      <span data-variant-id="{{item.variant_id}}">
        <svg width="20" height="22" viewBox="0 0 20 22" xmlns="http://www.w3.org/2000/svg">
          <g stroke="#000000" fill="none" fill-rule="evenodd" stroke-linecap="round" stroke-linejoin="round"><path d="M1 5.444h18M7.75 9.889v6.667M12.25 9.889v6.667M2.125 5.444L3.25 18.778C3.25 20.005 4.257 21 5.5 21h9c1.243 0 2.25-.995 2.25-2.222l1.125-13.334"/><path d="M6.625 5.444V2.111C6.625 1.497 7.129 1 7.75 1h4.5c.621 0 1.125.497 1.125 1.111v3.333"/></g>
        </svg>
      </span>
    </div>
  </div>

</div>