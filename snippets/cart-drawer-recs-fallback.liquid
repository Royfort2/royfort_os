{%- comment -%} SSR fallback for cart drawer recommendations {%- endcomment -%}
{%- liquid
  assign fallback_collection = collections[section.settings.cart_recommendations_fallback_collection]
  if fallback_collection == blank
    assign fallback_collection = collections.bestseller
  endif

  assign fallback_limit = section.settings.cart_recommendations_limit | default: 8
  assign fallback_count = 0
-%}
{%- if fallback_collection != blank and fallback_collection.products_count > 0 -%}
  <ul class="cart-drawer__recs-fallback list-unstyled" data-recs-fallback role="list">
    {%- for product in fallback_collection.products -%}
      {%- if fallback_count >= fallback_limit -%}
        {%- break -%}
      {%- endif -%}
      {%- assign in_cart = false -%}
      {%- for item in cart.items -%}
        {%- if item.product_id == product.id -%}
          {%- assign in_cart = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if in_cart -%}
        {%- continue -%}
      {%- endif -%}
      {%- assign fallback_count = fallback_count | plus: 1 -%}
      <li class="cart-drawer__recs-fallback-item">
        {%- render 'card-product-list',
          product: product,
          enable_quick_add: false,
          enable_quick_view: false,
          image_sizes: '(max-width: 767px) 72px, 88px',
          section_index: section.index,
          index: forloop.index,
          prefer_catalog_media: true
        -%}
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}
