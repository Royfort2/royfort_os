                    }

                    .btn-custom-1:hover {
                      background-color: unset !important;
                      color: #333 !important;
                    }

                    .exhibitor-stars {
                      margin: .8rem 0 1rem 0;
                    }
                    </style>
             
                        {% else %}
                        {% for image in collection.metafields.exhibitor.image[exhibitor_index] %}
                        <div class="exhibitor-img-collection-{{exhibitor_index}}">
                                {% if collection.metafields.exhibitor.button_link[exhibitor_index] !=blank %}

                         <a href="{{collection.metafields.exhibitor.button_link}}" class="exhibitor-text" style="height: 100%;">
                         {% endif %}
                        <div class="exhibitor-content exhibitor-collection-{{exhibitor_index}}">
                                       {% if collection.metafields.exhibitor.title[exhibitor_index] != blank %}
                        {{collection.metafields.exhibitor.title[exhibitor_index]}}
                        {% endif %}
                        {% if collection.metafields.exhibitor.text[exhibitor_index] != blank %}
                        {{collection.metafields.exhibitor.text[exhibitor_index]}}
                         {% endif %}
                            {% if collection.metafields.exhibitor.button != blank and collection.metafields.exhibitor.disable_button contains 'true' %}
                            {% if collection.metafields.exhibitor.white_button[exhibitor_index] %}
                        <button class="btn btn btn-custom btn-secondary">
                       {{collection.metafields.exhibitor.button[exhibitor_index]}}
                        </button>
                        {% else %}
                    <button class="btn btn btn-tertiary btn-custom-1">
                       {{collection.metafields.exhibitor.button[exhibitor_index]}}
                        </button>
                        {% endif %}
                               {% endif %}
                        {% if collection.metafields.exhibitor.stars[exhibitor_index] contains 'true' %}
                        <div style="display: flex;" class="exhibitor-stars">
                        <i aria-hidden="true" class="stamped-fa fa-star"></i>
                        <i aria-hidden="true" class="stamped-fa fa-star"></i>
                        <i aria-hidden="true" class="stamped-fa fa-star"></i>
                        <i aria-hidden="true" class="stamped-fa fa-star"></i>
                        <i aria-hidden="true" class="stamped-fa fa-star"></i>
                        </div>
                           {% endif%}
                        </div>
                                {% if collection.metafields.exhibitor.button_link[exhibitor_index] !=blank %}
                        </a>
                        {% endif %}
                        <style>

                    .btn-custom {
                          border: unset;
                        }
                    .exhibitor-collection-{{exhibitor_index}}  {
                          color: {{collection.metafields.exhibitor.text_color[exhibitor_index]}};
                        }
                        .exhibitor-collection-{{exhibitor_index}} p {
                          color: {{collection.metafields.exhibitor.text_color[exhibitor_index]}};
                        }

                    .exhibitor-img-collection-{{exhibitor_index}} {
                        background-image: url('{{exhibitorImage[0].src}}');
                        height: 100%;
                        background-size: cover;
                        background-repeat: no-repeat;
                    }

                    .exhibitor-content {
                        display: flex;
                        flex-direction: column;
                        width: 80%;
                        margin: auto;
                        align-items: center;
                        justify-content: center;
                        align-content: center;
                        height: 100%;
                        text-align: center;
           
                    }

                    .exhibitor-content a {
                        text-decoration: none !important;
                        color: white !important;
                    }

                    .exhibitor-text {
                        text-decoration: none !important;
                    }

                    .exhibitor-text:hover {
                        text-decoration: none !important;
                        color: unset !important;
                    }

                    .exhibitor-content a:hover {
                        text-decoration: none !important;
                    }

                    .exhibitor-content button:hover {
                        text-decoration: none !important;
                    }

                    .exhibitor-stars {
                      margin: .4rem 0 1rem 0;
                    }

                    .exhibitor-stars {
                      margin: .8rem 0 1rem 0;
                    }
                    .btn-custom-1:hover {
                      background-color: unset !important;
                    color: #333 !important;
                    }
                    </style>
                        {% endfor %}
                        {% endif %}
                    </div>
            {% endif %}

            <style>

                .pause-button-{{exhibitor_index}} {
                    display: none;
                }

                .video-button {
                    position: relative;
                }

                .button-container {
                    position: absolute;
                    bottom: 15px;
                    left: 5px;
                    display: block;
                }

                .rounded-full {
                    width: 40px;
                    height: 40px;
                    background: white;
                    border-radius: 50%;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                }
                </style>
                        </div>
                                    {% endfor %}
                    </div><!-- row -->
                </section><!-- col -->
            </div><!-- container-fluid -->
        </div><!-- Collection Listing -->
    {% endcapture -%}

    {% if top_product_count > 0 %}
        {{ top_cat }}
    {% endif %}

    {{ other_cats }}

    {% if paginate.pages > 1 %}
    <div class="collection-listing-container mb-lg-5 collection-load-more-container">
        <div class="container-fluid px-3">
            {% if collection.handle == 'royfort-all-products-collection' %}
                {% render 'collection-load-more', paginate: paginate %}
            {% else %}
                {% render 'pagination' with paginate as paginate, class: 'pagination-bottom collection-pagination' %}
            {% endif %}
        </div>
    </div>
    {% endif %}
    
</div>

{% endpaginate %}

{% schema %}
{
  "name": "Collection Master",
  "settings": [
    {
        "type": 		"header",
        "content": 		"Collection title/subtitle styles"
    },
    {
        "type": "color",
        "id": "title_color",
        "label": "Title color",
        "default": "#000000"
    },
    {
        "type":      "range",
        "id":        "title_size",
        "min":       14,
        "max":       60,
        "step":      1,
        "label":     "Title font size",
        "default":   28
    },

    {
        "type": "color",
        "id": "subtitle_color",
        "label": "Subtitle color",
        "default": "#000000"
    },
    {
        "type":      "range",
        "id":        "subtitle_size",
        "min":       14,
        "max":       60,
        "step":      1,
        "label":     "Subtitle font size",
        "default":   14
    },


    {
        "type": 		"header",
        "content": 		"Pagination"
    },

    {
        "type": 	"paragraph",
        "content": 	"How many products should be displayed per page?."
    },
    {
        "type":      "range",
        "id":        "products_per_page",
        "min":       6,
        "max":       50,
        "step":      1,
        "label":     "Products Per Page",
        "info":      "Shopify allows a maximum of 50 products per page.",
        "default":   50
    },
    {
        "type": 		"header",
        "content": 		"Filter(s)"
    },
    {
        "type": "select",
        "id": "filters_open",
        "options": [
            { "value": "first", "label": "Open First"},
            { "value": "open", "label": "Open All"},
            { "value": "close", "label": "Close All"}
        ],
        "label": "Filter Accordion Behaviour"
    },
    {
      	"type": 		"header",
      	"content": 		"Image Ratio"
		},
    {
        "type": 	"paragraph",
        "content": 	"Determine the aspect ratio of the product images"
    },
    {
        "type":         "select",
        "id":           "ratio",
        "label":        "Fixed Ratio?",
        "options": [
            {
                "value": "fixed-ratio square-crop",
                "label": "Square (4x4 Cropped)"
            },
            {
                "value": "fixed-ratio square",
                "label": "Square (4x4)"
            },
            {
                "value": "fixed-ratio portrait-crop",
                "label": "Portrait (4x5 Cropped)"
            },
            {
                "value": "fixed-ratio portrait",
                "label": "Portrait (4x5)"
            },
            {
                "value": "",
                "label": "No Set Ratio"
            }
        ],
        "default":   "fixed-ratio square"
    },
    {
        "type": "checkbox",
        "id": "show_recentlyviewed_section",
        "default": true,
        "label": "Show Recently Viewed?",
        "info": "If user has not viewed any products, this will remain hidden to the user"
    },
    {
        "type": "text",
        "id": "recently_viewed_products_title",
        "default": "Recently Viewed",
        "label": "Recently Viewed Products Title"
    }
    ],
    "blocks": [
		{
			"type": "tag_filters",
			"name": "Tag Filters",
			"settings": [
				{
				   "type":      "text",
				   "id":        "title",
				   "label":     "Filter Name"
                },
				{
                    "type": "textarea",
                    "id": "filter_tags",
                    "default": "product_tag_one, product_tag_two",
                    "label": "Filter Tags",
                    "info": "List the product tag(s) in full above. Seperate each tag with a comma. This also determines the order of the tags."
                },
                {
                    "type": 		"header",
                    "content": 		"Tag Appearance"
                },
                {
                    "type": 	"paragraph",
                    "content": 	"Let's make the tags more user friendly, specify the shared tag prefix below, and we'll remove it. We'll also replace the underscores with spaces. For example, product_tag_smudge_free would simply become 'Smudge Free', if we defined the prefix as 'product_tag_'."
                },
                {
                    "type":      "text",
                    "id":        "prefix_tag",
                    "label":     "Tag Prefix",
                    "default":   "product_tag_"
                },
                {
                    "type": 		"header",
                    "content": 		"Important"
                },
                {
                    "type": 	"paragraph",
                    "content": 	"If none of the products from the collection match the tags entered in 'Filter Tags', then this filter will not display."
                }
			]
        }
    ]
}
{% endschema %}

