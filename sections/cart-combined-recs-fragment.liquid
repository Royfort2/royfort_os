{% comment %}
  Lightweight section for Product Recommendations Section Rendering API only.
  Request: /recommendations/products?section_id=cart-combined-recs-fragment&product_id=…
{% endcomment %}
{%- liquid
  assign rel_img_ratio = settings.pcard_image_ratio | default: '4/5'
-%}
{%- capture rel_image_sizes -%}
  (max-width: 767px) calc((100vw - 3rem) / 1.7), {{ settings.page_width | divided_by: 2 }}px
{%- endcapture -%}
<div id="cart-combined-recs-fetch-root" class="we-main-product-related__root" hidden aria-hidden="true">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    {%- for recommendation in recommendations.products -%}
      <div class="swiper-slide" role="listitem" tabindex="-1">
        {% render 'card-product-list',
          product: recommendation,
          image_sizes: rel_image_sizes,
          image_ratio: rel_img_ratio,
          section_index: section.index,
          index: forloop.index,
          enable_quick_add: false,
          enable_quick_view: false
        %}
      </div>
    {%- endfor -%}
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Cart combined recs",
  "enabled_on": {
    "groups": ["custom.overlay"]
  },
  "settings": []
}
{% endschema %}
