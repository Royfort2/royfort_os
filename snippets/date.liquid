{%- case shop.permanent_domain -%}

{%- comment %}
https://www.shopify.co.uk/partners/blog/liquid-date-format
{% endcomment -%}

{%- comment %}
Date format for DE store
{% endcomment -%}
{%- when 'bw2016.myshopify.com' -%}
{{ article.published_at | date: "%e. %B %Y" | 
replace: 'January', 'Januar' | 
replace: 'February', 'Februar'  | 
replace: 'March', 'März'  | 
replace: 'April', 'April'  | 
replace: 'May', 'Mai'  | 
replace: 'June', 'Juni'  | 
replace: 'July', 'Juli'  | 
replace: 'August', 'August'  | 
replace: 'September', 'September'  | 
replace: 'October', 'Oktober'  | 
replace: 'November', 'November'  | 
replace: 'December', 'Dezember' 
}}

