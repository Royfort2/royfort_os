{% schema %}
{
    "name": "Grey Footer",
    "settings": [
        {
            "type": "text",
            "id": "product_footer_title",
            "label": "Footer Title"
        },
        {
            "type": "text",
            "id": "product_footer_undertitle",
            "label": "Footer Undertitle"
        }
    ],
    "blocks": [
        {
            "type": "product-footer",
            "name": "Product Footer Block",
            "settings": [
                {
                    "type":      "text",
                    "id":        "title",
                    "label":     "Title"
                },
                {
                    "type":      "richtext",
                    "id":        "content",
                    "label":     "Content"
                }
            ]
        }
    ]
}
{% endschema %}
