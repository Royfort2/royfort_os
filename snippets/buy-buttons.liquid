{% comment %}
  Renders product buy-buttons.
  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} product form id.
  - section_id: {String} id of section to which this snippet belongs.

  Usage:
  {% render 'buy-buttons', block: block, product: product, product_form_id: product_form_id, section_id: section.id %}
{% endcomment %}
{%- if product != blank -%}
  {%- liquid
    assign gift_card_recipient_feature_active = false
    if block.settings.show_gift_card_recipient and product.gift_card?
      assign gift_card_recipient_feature_active = true
    endif

    assign show_dynamic_checkout = false
    if block.settings.show_dynamic_checkout and gift_card_recipient_feature_active == false
      assign show_dynamic_checkout = true
    endif

    assign pdp_set_bundle = false
    assign pdp_set_optional_offset = 1
    assign pdp_set_required_count = 2
    assign pdp_zw_omit_main = false
    if product.metafields.custom.pdp_set_products != blank
      assign pdp_set_bundle = true
      assign pdp_set_products_list = product.metafields.custom.pdp_set_products.value
      assign pdp_first_set_product = pdp_set_products_list | first
      assign pdp_first_set_resolved_variant = pdp_first_set_product.selected_or_first_available_variant
      capture pdp_first_set_vid_cap
        render 'we-pdp-first-set-line-variant-id', bundle_product: product, line_product: pdp_first_set_product
      endcapture
      assign pdp_first_set_vid_str = pdp_first_set_vid_cap | strip
      if pdp_first_set_vid_str != blank
        assign pdp_first_set_vid_num = pdp_first_set_vid_str | plus: 0
        for v in pdp_first_set_product.variants
          if v.id == pdp_first_set_vid_num
            assign pdp_first_set_resolved_variant = v
            break
          endif
        endfor
      endif
      assign pdp_section_has_we_variant_picker = false
      assign pdp_section_has_variant_picker = false
      for sb in section.blocks
        if sb.type == 'we_variant_picker'
          assign pdp_section_has_we_variant_picker = true
        endif
        if sb.type == 'variant_picker'
          assign pdp_section_has_variant_picker = true
        endif
      endfor
      if pdp_section_has_we_variant_picker and pdp_section_has_variant_picker == false
        assign pdp_set_required_count = 1
        assign pdp_zw_omit_main = true
      endif
      capture pdp_optional_tag_extra_ids
        render 'we-pdp-bundle-tag-extras', product: product, set_products: pdp_set_products_list, mode: 'ids'
      endcapture
      assign pdp_optional_tag_extra_ids = pdp_optional_tag_extra_ids | strip
      assign pdp_optional_product_ids = ''
      for sp in pdp_set_products_list offset: pdp_set_optional_offset
        if pdp_optional_product_ids != blank
          assign pdp_optional_product_ids = pdp_optional_product_ids | append: ','
        endif
        assign pdp_optional_product_ids = pdp_optional_product_ids | append: sp.id
      endfor
      if pdp_optional_tag_extra_ids != blank
        if pdp_optional_product_ids != blank
          assign pdp_optional_product_ids = pdp_optional_product_ids | append: ','
        endif
        assign pdp_optional_product_ids = pdp_optional_product_ids | append: pdp_optional_tag_extra_ids
      endif
    endif

    assign variant_picker_custom_dropdown = false
    for sb in section.blocks
      if sb.settings.picker_type == 'custom_dropdown'
        if sb.type == 'variant_picker' or sb.type == 'we_variant_picker'
          assign variant_picker_custom_dropdown = true
          break
        endif
      endif
    endfor

    assign hide_qty_in_buy_buttons = false
    if variant_picker_custom_dropdown
      if block.settings.show_quantity_selector and product.quantity_price_breaks_configured? != true and product.has_only_default_variant == false
        assign hide_qty_in_buy_buttons = true
      endif
    endif
  -%}
  <div
    class="product-form"
    data-hide-errors="{{ gift_card_recipient_feature_active }}"
    data-section-id="{{ section.id }}"
  >
    <div class="product-form__error-message-wrapper" role="alert" hidden>
      <svg
        aria-hidden="true"
        focusable="false"
        class="icon icon-error"
        viewBox="0 0 13 13"
      >
        <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
        <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
        <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
        <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
      </svg>
      <div class="product-form__error-message blocks-radius-md alert alert--error" role="alert" hidden></div>
    </div>
    {%- liquid
      assign pdp_current_variant = product.selected_or_first_available_variant
      if product.selected_variant != blank
        assign pdp_current_variant = product.selected_variant
      endif
      assign main_product_form_class = 'main-product-form grid gap-4'
      if pdp_set_bundle
        assign main_product_form_class = main_product_form_class | append: ' pdp-set-bundle'
      endif
    -%}
    {%- form 'product',
      product,
      id: product_form_id,
      class: main_product_form_class,
      data-type: 'add-to-cart-form',
      is: 'product-form',
      data-hide-errors: gift_card_recipient_feature_active,
      data-product-id: product.id
    -%}
      <input
        type="hidden"
        name="id"
        value="{{ pdp_current_variant.id }}"
        {% if pdp_current_variant.available == false
          or pdp_set_bundle
        %}
          disabled
        {% endif %}
        class="product-variant-id"
      >
      {%- if pdp_set_bundle -%}
        <div class="js-pdp-set-line-items" data-pdp-set-line-items aria-hidden="true"></div>
        <script type="application/json" data-pdp-set-config>
          {
            "sectionId": {{ section.id | json }},
            "firstSetProductId": {{ pdp_first_set_product.id | json }},
            "firstVariantFallback": {{ pdp_first_set_resolved_variant.id | json }},
            "setDiscountAmount": {{ product.metafields.custom.set_discount_amount | default: 0 | json }},
            "omitMainProductFromZwischensumme": {{ pdp_zw_omit_main | json }},
            "requiredSetProductIds": [
              {%- for sp in pdp_set_products_list limit: pdp_set_required_count -%}
                {{ sp.id }}{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ],
            "optionalProductIds": [
              {%- assign pdp_optional_id_list = pdp_optional_product_ids | split: ',' -%}
              {%- for oid in pdp_optional_id_list -%}
                {%- if oid != blank -%}
                  {{ oid | plus: 0 }}{%- unless forloop.last -%},{%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
            ]
          }
        </script>
        <script src="{{ 'product-set-cart-items.js' | asset_url }}" defer="defer"></script>
      {%- endif -%}
      {%- if gift_card_recipient_feature_active -%}
        {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
      {%- endif -%}

      {%- if product.quantity_price_breaks_configured? and block.settings.show_quantity_selector -%}
        <div
          id="QuantityForm-{{ section_id }}"
          class="grid gap-4"
        >
          {%- assign cart_qty = cart | item_count_for_variant: pdp_current_variant.id -%}

          <div class="grid gap-2">
            <div class="grid gap-3">
              <label class="quantity__label form__label" for="Quantity-{{ section.id }}">
                <span class="font-body-bold">{{ 'products.product.quantity.label' | t }}</span>

                <span
                  id="QuantityRulesCart-{{ section_id }}"
                  class="quantity__rules-cart{% if cart_qty == 0 %} hidden{% endif %} relative inline-flex items-center"
                >
                  {%- render 'loading-spinner' -%}
                  <span class="quantity-cart font-body-bold"
                    >({{ 'products.product.quantity.in_cart_html' | t: quantity: cart_qty }})</span
                  >
                </span>
              </label>
              <div class="flex items-center gap-4">
                <quantity-input class="quantity" data-section-id="{{ section_id }}" data-product-id="{{ product_id }}">
                  <button class="quantity__button" name="minus" type="button">
                    <span class="visually-hidden">
                      {{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}
                    </span>
                    {% render 'icon-minus' %}
                  </button>
                  <input
                    class="quantity__input"
                    type="number"
                    name="quantity"
                    id="Quantity-{{ section.id }}"
                    data-cart-quantity="{{ cart_qty }}"
                    step="{{ pdp_current_variant.quantity_rule.increment }}"
                    value="{{ pdp_current_variant.quantity_rule.min }}"
                    data-quantity-variant-id="{{ pdp_current_variant.id }}"
                    data-min="{{ pdp_current_variant.quantity_rule.min }}"
                    min="{{ pdp_current_variant.quantity_rule.min }}"
                    {% if pdp_current_variant.quantity_rule.max != null %}
                      data-max="{{ pdp_current_variant.quantity_rule.max }}"
                      max="{{ pdp_current_variant.quantity_rule.max }}"
                    {% endif %}
                    inputmode="numeric"
                    autocomplete="off"
                    form="{{ product_form_id }}"
                    {% if pdp_set_bundle %}
                      disabled
                    {% endif %}
                  >
                  <button class="quantity__button" name="plus" type="button">
                    <span class="visually-hidden">
                      {{- 'products.product.quantity.increase' | t: product: product.title | escape -}}
                    </span>
                    {% render 'icon-plus' %}
                  </button>
                </quantity-input>

                {%- if product.quantity_price_breaks_configured? -%}
                  {%- liquid
                    assign volume_pricing_array = pdp_current_variant.quantity_price_breaks | sort: 'quantity' | reverse
                    assign current_qty_for_volume_pricing = cart_qty | plus: pdp_current_variant.quantity_rule.min
                    if cart_qty > 0
                      assign current_qty_for_volume_pricing = cart_qty | plus: pdp_current_variant.quantity_rule.increment
                    endif
                    assign variant_price_compare = pdp_current_variant.compare_at_price
                  -%}
                  <price-per-item
                    id="PricePerItem-{{ section_id }}"
                    class="price flex flex-wrap items-center gap-2 lg:gap-1d5"
                    data-section-id="{{ section_id }}"
                    data-product-id="{{ product_id }}"
                    data-variant-id="{{ pdp_current_variant.id }}"
                  >
                    {%- if variant_price_compare -%}
                      <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                      <span class="price__sale inline-flex items-center h-auto relative">
                        {%- liquid
                          if settings.currency_code_enabled
                            echo variant_price_compare | money_with_currency
                          else
                            echo variant_price_compare | money
                          endif
                        -%}
                      </span>
                      <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                    {%- endif -%}

                    {%- if pdp_current_variant.quantity_price_breaks.size > 0 -%}
                      {%- if current_qty_for_volume_pricing < volume_pricing_array.last.minimum_quantity -%}
                        {%- liquid
                          if settings.currency_code_enabled
                            assign variant_price = pdp_current_variant.price | money_with_currency
                          else
                            assign variant_price = pdp_current_variant.price | money
                          endif
                        -%}
                        <span class="price-per-item--current price__regular whitespace-nowrap">
                          {{- 'products.product.volume_pricing.price_at_each_html' | t: price: variant_price -}}
                        </span>
                      {%- else -%}
                        {%- for price_break in volume_pricing_array -%}
                          {%- if current_qty_for_volume_pricing >= price_break.minimum_quantity -%}
                            {%- liquid
                              if settings.currency_code_enabled
                                assign price_break_price = price_break.price | money_with_currency
                              else
                                assign price_break_price = price_break.price | money
                              endif
                            -%}
                            <span class="price-per-item--current price__regular whitespace-nowrap">
                              {{- 'products.product.volume_pricing.price_at_each_html' | t: price: price_break_price -}}
                            </span>
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}
                    {%- else -%}
                      <span class="price-per-item--current price__regular whitespace-nowrap">
                        {%- liquid
                          if settings.currency_code_enabled
                            assign variant_price = pdp_current_variant.price | money_with_currency
                          else
                            assign variant_price = pdp_current_variant.price | money
                          endif
                        -%}
                        {{- 'products.product.volume_pricing.price_at_each_html' | t: price: variant_price -}}
                      </span>
                    {%- endif -%}
                  </price-per-item>
                {%- endif -%}
              </div>
            </div>

            <div
              class="quantity__rules text-sm"
              id="QuantityRules-{{ section_id }}"
            >
              {%- if pdp_current_variant.quantity_rule.increment > 1 -%}
                <span class="divider">
                  {{-
                    'products.product.quantity.multiples_of'
                    | t: quantity: pdp_current_variant.quantity_rule.increment
                  -}}
                </span>
              {%- endif -%}
              {%- if pdp_current_variant.quantity_rule.min > 1 -%}
                <span class="divider">
                  {{-
                    'products.product.quantity.minimum_of'
                    | t: quantity: pdp_current_variant.quantity_rule.min
                  -}}
                </span>
              {%- endif -%}
              {%- if pdp_current_variant.quantity_rule.max != null -%}
                <span class="divider font-body-bold">
                  {{-
                    'products.product.quantity.maximum_of'
                    | t: quantity: pdp_current_variant.quantity_rule.max
                  -}}
                </span>
              {%- endif -%}
            </div>
          </div>

          {%- if product.quantity_price_breaks_configured? -%}
            <volume-pricing class="block parent-display blocks-radius-md" id="Volume-{{ section.id }}">
              {%- if pdp_current_variant.quantity_price_breaks.size > 0 -%}
                <span class="caption block">{{ 'products.product.volume_pricing.title' | t }}</span>
                <ul class="list-unstyled">
                  <li class="blocks-radius-md">
                    <span>{{ pdp_current_variant.quantity_rule.min }}+</span>
                    {%- liquid
                      if settings.currency_code_enabled
                        assign price = pdp_current_variant.price | money_with_currency
                      else
                        assign price = pdp_current_variant.price | money
                      endif
                    -%}
                    <span data-text="{{ 'products.product.volume_pricing.price_at_each' | t: price: price }}">
                      {{- 'products.product.volume_pricing.each_html' | t: money: price -}}
                    </span>
                  </li>
                  {%- for price_break in pdp_current_variant.quantity_price_breaks -%}
                    {%- liquid
                      if settings.currency_code_enabled
                        assign price_break_price = price_break.price | money_with_currency
                      else
                        assign price_break_price = price_break.price | money
                      endif
                    -%}
                    <li class="blocks-radius-md{% if forloop.index >= 3 %} show-more-item hidden{% endif %}">
                      <span>
                        {{- price_break.minimum_quantity -}}
                        <span aria-hidden="true">+</span></span
                      >
                      <span data-text="{{ 'products.product.volume_pricing.price_at_each' | t: price: price_break_price }}">
                        {{- 'products.product.volume_pricing.each_html' | t: money: price_break_price -}}
                      </span>
                    </li>
                  {%- endfor -%}
                </ul>
                {%- if pdp_current_variant.quantity_price_breaks.size >= 3 -%}
                  <show-more-button>
                    <button
                      class="button-show-more btn--link"
                      id="Show-More-{{ section.id }}"
                      type="button"
                    >
                      <span class="label-show-more label-text"
                        ><span aria-hidden="true">+ </span>{{ 'products.facets.show_more' | t }}
                      </span>
                    </button>
                  </show-more-button>
                {%- endif -%}
              {%- endif -%}
            </volume-pricing>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="product-form__buttons" id="QuantityForm-{{ section_id }}">
        {%- if block.settings.show_quantity_selector
          and product.quantity_price_breaks_configured? != true
          and hide_qty_in_buy_buttons == false
        -%}
          {%- assign cart_qty = cart | item_count_for_variant: pdp_current_variant.id -%}
          <div class="product-form__quantity">
            <label class="quantity__label form__label visually-hidden" for="Quantity-{{ section.id }}">
              <span class="font-body-bold">{{ 'products.product.quantity.label' | t }}</span>
            </label>
            <quantity-input class="quantity" data-section-id="{{ section_id }}" data-product-id="{{ product_id }}">
              <button class="quantity__button" name="minus" type="button">
                <span class="visually-hidden">
                  {{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}
                </span>
                {% render 'icon-minus' %}
              </button>
              <input
                class="quantity__input"
                type="number"
                name="quantity"
                id="Quantity-{{ section.id }}"
                data-cart-quantity="{{ cart_qty }}"
                step="{{ pdp_current_variant.quantity_rule.increment }}"
                value="{{ pdp_current_variant.quantity_rule.min }}"
                data-quantity-variant-id="{{ pdp_current_variant.id }}"
                data-min="{{ pdp_current_variant.quantity_rule.min }}"
                min="{{ pdp_current_variant.quantity_rule.min }}"
                {% if pdp_current_variant.quantity_rule.max != null %}
                  data-max="{{ pdp_current_variant.quantity_rule.max }}"
                  max="{{ pdp_current_variant.quantity_rule.max }}"
                {% endif %}
                inputmode="numeric"
                autocomplete="off"
                form="{{ product_form_id }}"
                {% if pdp_set_bundle %}
                  disabled
                {% endif %}
              >
              <button class="quantity__button" name="plus" type="button">
                <span class="visually-hidden">
                  {{- 'products.product.quantity.increase' | t: product: product.title | escape -}}
                </span>
                {% render 'icon-plus' %}
              </button>
            </quantity-input>
          </div>
        {%- endif -%}
        <button
          id="ProductSubmitButton-{{ section_id }}"
          type="submit"
          name="add"
          class="product-form__submit btn{% if show_dynamic_checkout %} btn--secondary{% else %} btn--primary{% endif %}"
          {% if pdp_current_variant.available == false %}
            disabled
          {% endif %}
        >
          <span>
            {%- if pdp_current_variant.available == false -%}
              {{ 'products.product.sold_out' | t }}
            {%- else -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- endif -%}
          </span>
          {%- render 'loading-spinner' -%}
        </button>
        {%- if block.settings.show_secondary_button and block.settings.secondary_button_text != blank -%}
          {%- if block.settings.secondary_button_url != blank -%}
            <a
              href="{{ block.settings.secondary_button_url }}"
              class="btn btn--secondary button--secondary product-form__secondary-btn w-full"
            >
              {{- block.settings.secondary_button_text | escape -}}
            </a>
          {%- endif -%}
        {%- endif -%}
        {%- liquid
          if product.quantity_price_breaks_configured? != true
            if show_dynamic_checkout
              echo form | payment_button
            endif
          endif
        -%}
      </div>
      <div class="product-form__error-message blocks-radius-md alert alert--error" role="alert" hidden></div>
    {%- endform -%}
  </div>
{%- else -%}
  <div class="product-form">
    <div class="product-form__buttons form">
      <button
        type="submit"
        name="add"
        class="product-form__submit button button--full-width button--primary"
        disabled
      >
        {{ 'products.product.sold_out' | t }}
      </button>
    </div>
  </div>
{%- endif -%}
