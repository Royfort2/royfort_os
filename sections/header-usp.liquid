				    "id":       "cta_text",
                    "label":    "CTA Text",
                    "default":  "Shop now",
                    "info":     "Sits after countdown"
                },
                {
                    "type":     "url",
                    "id":       "link",
                    "label":    "Link"
                },
                {
                    "type":     "text",
				    "id":       "finshed_text",
