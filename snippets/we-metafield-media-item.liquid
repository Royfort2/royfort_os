{% comment %}
  One main-gallery slide + matching thumb for product.metafields.custom.we_temp_product_media list items.
  @param media_item {File|Media|Image} — list entry (often file_reference image)
  @param synthetic_id {String} — stable id for data-media-id / thumbs data-target (e.g. we-mf-0)
  @param position {Number} — 0-based index
  @param media_count {Number}
  @param desktop_layout, mobile_layout, enable_image_zoom, loop, modal_id, xr_button: false, media_width
  @param product {Product}
{% endcomment %}
{%- liquid
  assign gallery_aspect_ratio = gallery_aspect_ratio | default: '4 / 5'
  assign preview = media_item
  if media_item.preview_image != blank
    assign preview = media_item.preview_image
  endif
  assign psw_w = preview.width | default: 1600
  assign ar = preview.aspect_ratio | default: 0.8
  assign psw_h = psw_w | divided_by: ar | ceil
  assign media_alt_stripped = preview.alt | default: product.title | strip
  assign desktop_columns = 1
  if desktop_layout == 'columns' and media_count > 1
    assign desktop_columns = 2
  endif
  assign loading = 'lazy'
  assign fetchpriority = 'low'
  if position < desktop_columns
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif
-%}
{%- capture sizes -%}
{%- if desktop_columns > 1 -%}
(max-width: 768px) calc(100vw - 3rem), calc(((min({{ settings.page_width | plus: 30 }}px, 100vw) * {{ media_width }}) - 4.5rem - {{ desktop_columns | times: 1 | minus: 1 }}rem) / {{ desktop_columns }})
{%- else -%}
(max-width: 768px) calc(100vw - 3rem), calc(((min({{ settings.page_width | plus: 30 }}px, 100vw) * {{ media_width }}) - 4.5rem) / {{ desktop_columns }})
{%- endif -%}
{%- endcapture -%}
<div
  role="listitem"
  tabindex="-1"
  class="product__media-item swiper-slide"
  data-media-id="{{ synthetic_id }}"
  data-media-type="image"
  data-media-index="{{ position }}"
  data-media-alt="{{ media_alt_stripped | escape }}"
  data-src="{{ preview | image_url: width: 1946 }}"
  data-pswp-width="{{ psw_w }}"
  data-pswp-height="{{ psw_h }}"
>
  <div
    class="product__media-container blocks-radius media-type-image"
    style="--aspect-ratio: {{ gallery_aspect_ratio }};"
  >
    <motion-element data-motion="zoom-out-sm" class="product__media media-wrapper">
      {{
        preview
        | image_url: width: 1946
        | image_tag:
          is: 'image-lazy',
          loading: loading,
          fetchpriority: fetchpriority,
          sizes: sizes,
          widths: '400, 620, 690, 810, 980, 1240, 1380, 1620, 1960',
          alt: media_alt_stripped
      }}
    </motion-element>
    {%- if enable_image_zoom -%}
      <button
        class="product__media-zoom btn--inherit js-photoswipe--zoom"
        type="button"
        aria-haspopup="dialog"
        data-media-id="{{ synthetic_id }}"
        data-media-type="image"
        data-media-index="{{ position }}"
      >
        <span class="visually-hidden">
          {{ 'products.product.media.open_media' | t: index: position }}
        </span>
      </button>
    {%- endif -%}
  </div>
</div>
