{% comment %}
  {% capture left-icon %}
    <svg aria-hidden="true" data-prefix="fal" data-icon="chevron-left" role="img" xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 256 512" style="
      font-weight: bolder;
  ">
      <path
        d="M238.475 475.535l7.071-7.07c4.686-4.686 4.686-12.284 0-16.971L50.053 256 245.546 60.506c4.686-4.686 4.686-12.284 0-16.971l-7.071-7.07c-4.686-4.686-12.284-4.686-16.97 0L10.454 247.515c-4.686 4.686-4.686 12.284 0 16.971l211.051 211.05c4.686 4.686 12.284 4.686 16.97-.001z"></path>
    </svg>
  {% endcapture %}

  {% capture right-icon %}
    <svg aria-hidden="true" data-prefix="fal" data-icon="chevron-right" role="img" xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 256 512">
      <path
        d="M17.525 36.465l-7.071 7.07c-4.686 4.686-4.686 12.284 0 16.971L205.947 256 10.454 451.494c-4.686 4.686-4.686 12.284 0 16.971l7.071 7.07c4.686 4.686 12.284 4.686 16.97 0l211.051-211.05c4.686-4.686 4.686-12.284 0-16.971L34.495 36.465c-4.686-4.687-12.284-4.687-16.97 0z"></path>
    </svg>
  {% endcapture %}
{% endcomment %}

{% unless product.title == 'Aurora Matratze' %}
  <style>
    :root {
        --text-color: #000000;
    }

    .title-formatting {
        color: var(--text-color) !important;
        font-family: "ArizonaMix", serif !important;
    }

    .text-formatting {
        color: var(--text-color) !important;
        font-family: "GTAmericaStandard", serif !important;
    }

    .MattressUSP {
        width: 100%;
        padding: 3rem 1rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        text-rendering: optimizeLegibility !important;
        -webkit-font-smoothing: antialiased !important;
    }

    .MattressUSP--flex {
        flex: 1 0 100%;
        width: 100%;
        max-width: 100%;
    }

    .MattressUSP__header {
        text-align: center;
        max-width: 480px;
        margin-bottom: 35px;
    }

    .MattressUSP__title {
        margin-bottom: 0.625rem;
    }

    .MattressUSP__description {
        font-size: 15px;
    }

    .MattressUSP__image {
        width: 100%;
        height: auto;
    }

    .MattressUSP__slider {
        position: relative;
        width: 100%;
        display: flex;
        justify-content: center;
        flex-direction: column;
        align-items: center;
    }

    .MattressUSP__blocks {
        position: relative;
        display: flex;
        max-width: 1024px;
        width: 100%;
        margin-top: 30px;
        justify-content: space-around;
        height: 130px;
        align-items: flex-start;
    }

    .MattressUSP--block {
        width: 33.333%;
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .MattressUSP--block__title {
        font-weight: 600;
        font-size: 14px;
    }

    .MattressUSP--block__description {
        font-size: 1rem;
        margin-top: 10px;
        max-width: 230px;
    }

    .MattressUSP__slidePointers {
        margin-top: 15px;
        display: none;
        justify-content: center;
        align-items: center;
        column-gap: 21px;
    }

    .MattressUSP__pointers {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #fff;
        border: 1px solid #2d2d2d;
        cursor: pointer;
    }

    .MattressUSP__pointers.active {
        background-color: #2d2d2d;
    }

    .MattressUSP__arrow {
        position: absolute;
        top: 0;
        background: none;
        -webkit-appearance: none;
        height: 100%;
        border: 0;
        border-radius: 0;
        cursor: pointer;
        z-index: 10;
        display: none;
    }

    .MattressUSP__arrow:focus, .MattressUSP__arrow svg:focus {
        border: none;
        outline: none;
    }

    .MattressUSP__arrow svg {
        fill: #000000;
        height: 24px;
        display: block;
        transform: translateY(32px);
    }

    .MattressUSP__arrow.left {
        left: 0;
    }

    .MattressUSP__arrow.right {
        right: 0;
    }

    @media screen and (min-width: 769px) {
        .MattressUSP__blocks {
            width: 100% !important;
            transform: translateX(0) !important;
        }

        .MattressUSP__image {
            max-width: 900px;
            transform: translateX(0) !important;
        }
    }

    @media screen and (max-width: 768px) {
        .MattressUSP__blocks {
            width: 300% !important;
            max-width: 300vw;
            align-self: baseline;
            transition: transform 1.15s cubic-bezier(0.2, 0.4, 0.3, 1);
        }

        .MattressUSP__image {
            max-width: 900px;
            transform: translateX(30%);
            transition: transform .65s ease-in-out;
        }

        .MattressUSP--block {
            display: flex;
            width: 80%;
            max-width: 80%;
            flex: 1;
        }

        .MattressUSP__slidePointers {
            display: flex;
        }

        .MattressUSP__title {
            font-size: 1.875rem;
        }
        .MattressUSP__arrow{
            display: block;
        }
    }
  </style>

  <!--
