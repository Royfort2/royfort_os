<div class="section-background" style="background-color:{{section.settings.hero_container_bg}};">
    <div class="{{section.settings.hero_container}}">
        <div class="hero-slick inline-slick" data-slick='{"adaptiveHeight": true, "slidesToShow": 1, "slidesToScroll": 1, "arrows":{{section.settings.hero_slide_arrows}}, "autoplay":{{section.settings.hero_slide_autoplay}}, "autoplaySpeed": {{section.settings.hero_slide_speed}}0, "dots": false, "infinite": {{section.settings.hero_slide_wraparound}}}'>
        {% for block in section.blocks %}
            {% case block.type %}

                {% when 'big-image' %}

                    <div class="hero-item hero-split {{block.settings.hero_layout}} {{block.settings.hero_mobile_bg}}" data-position="{{forloop.index}}" data-shopify-section-id="{{section.id}}" {{block.shopify_attributes}}>
                        {% if block.settings.hero_link != blank %}
                            <a class="hero-link {{ block.settings.hero_layout_mobile }} {{block.settings.hero_mobile_bg}}" href="{{block.settings.hero_link}}">
                        {% endif %}
                        <div class="hero-link {{ block.settings.hero_layout_mobile }} {{block.settings.hero_mobile_bg}}">
                        <div class="hero-image two-third">
                            <picture>
                                <source media="(max-width: 767px)" srcset="{{ block.settings.hero_mobile_image | img_url: '767x' }}">
                                <source media="(min-width: 768px)" srcset="{{ block.settings.hero_desktop_image | img_url: '1440x' }}">
                                <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ block.settings.hero_desktop_image | img_url: '1440x' }}" class="lazyload img-fluid" alt="{{ block.settings.title | strip_html }}">
                            </picture>
                        </div><!-- hero-image -->
    
                        <div class="hero-content one-third {{block.settings.hero_content_alignment}}" style="background-color:{{block.settings.hero_bg_color}}; color:{{block.settings.hero_text_color}};">
                        {% if block.settings.split_hero_pre_title != blank  %}<div class="pre-title mobile-font-{{block.settings.mobile_pre_font_size}} desktop-font-{{block.settings.desktop_pre_font_size}}">
                        <i aria-hidden="true" class="stamped-fa fa-star"></i>
                        <i aria-hidden="true" class="stamped-fa fa-star"></i>
                        <i aria-hidden="true" class="stamped-fa fa-star"></i>
                        <i aria-hidden="true" class="stamped-fa fa-star"></i>
                        <i aria-hidden="true" class="stamped-fa fa-star"></i>
                        {{block.settings.split_hero_pre_title | replace: "<strong>", "<span class='accent-highlight-one'>" | replace: "</strong>","</span>" | replace: "<em>","<span class='accent-highlight-two'>" | replace: "</em>","</span>"}}</div>
                        {% endif%}
{% if block.settings.title != blank  %}<h2 class="hero-title mobile-font-{{block.settings.mobile_title_font_size}} font_boldness-{{block.settings.header_bold_strength}} font_boldness_mobile-{{block.settings.header_bold_strength_mobile}} desktop-font-{{block.settings.desktop_title_font_size}}">{{block.settings.title   | replace: "<strong>", "<span class='accent-highlight-one'>" | replace: "</strong>","</span>" | replace: "<em>","<span class='accent-highlight-two'>" | replace: "</em>","</span>"}}</h2>{% endif %}
                            {% if block.settings.hero_post_title != blank %}<div class="post-title mobile-font-{{block.settings.mobile_post_font_size}} desktop-font-{{block.settings.desktop_post_font_size}}">{{block.settings.hero_post_title}}</div>{% endif %}
                            {% if block.settings.hero_cta_text != blank and block.settings.hero_link != blank %}<button type="button" class="{{block.settings.hero_button_style}}">{{block.settings.hero_cta_text}}</button>{% endif %}
                        </div><!-- hero-content -->
                        </div>
                        <style>
                        .hero-slick .hero-item .hero-link.content-on-image.mobile-content-bg .hero-content {
                            background-color: {{block.settings.hero_bg_color}} !important;
                        }

                        .hero-slick .hero-item .hero-link.content-on-image.mobile-image-bg .hero-content {
                            background-color: unset !important;
                        }
                        </style>
                        {% if block.settings.hero_link != blank %}
                            </a>
                        {% endif %}
                    </div><!-- hero-item hero-split -->    
    
                {% when 'split' %}

                    <div class="hero-item hero-split {{block.settings.hero_layout}} {{block.settings.hero_mobile_bg}}" data-position="{{forloop.index}}" data-shopify-section-id="{{section.id}}" {{block.shopify_attributes}}>
                        {% if block.settings.hero_link != blank %}
                            <a class="hero-link {{ block.settings.hero_layout_mobile }} {{block.settings.hero_mobile_bg}}" href="{{block.settings.hero_link}}">
                        {% endif %}
                        <div class="hero-link {{ block.settings.hero_layout_mobile }} {{block.settings.hero_mobile_bg}}">
                        <div class="hero-image">
                            <picture>
                                <source media="(max-width: 767px)" srcset="{{ block.settings.hero_mobile_image | img_url: '767x' }}">
                                <source media="(min-width: 768px)" srcset="{{ block.settings.hero_desktop_image | img_url: '1440x' }}">
                                <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ block.settings.hero_desktop_image | img_url: '1440x' }}" class="lazyload img-fluid" alt="{{ block.settings.title | strip_html }}">
                            </picture>
                        </div><!-- hero-image -->
    
                        <div class="hero-content {{block.settings.hero_content_alignment}}" style="background-color:{{block.settings.hero_bg_color}}; color:{{block.settings.hero_text_color}};">
                        {% if block.settings.split_hero_pre_title != blank  %}<div class="pre-title mobile-font-{{block.settings.mobile_pre_font_size}} desktop-font-{{block.settings.desktop_pre_font_size}}">
                        <i aria-hidden="true" class="stamped-fa fa-star"></i>
                        <i aria-hidden="true" class="stamped-fa fa-star"></i>
                        <i aria-hidden="true" class="stamped-fa fa-star"></i>
                        <i aria-hidden="true" class="stamped-fa fa-star"></i>
                        <i aria-hidden="true" class="stamped-fa fa-star"></i>
                        {{block.settings.split_hero_pre_title | replace: "<strong>", "<span class='accent-highlight-one'>" | replace: "</strong>","</span>" | replace: "<em>","<span class='accent-highlight-two'>" | replace: "</em>","</span>"}}</div>
                        {% endif%}
{% if block.settings.title != blank  %}<h2 class="hero-title mobile-font-{{block.settings.mobile_title_font_size}} font_boldness-{{block.settings.header_bold_strength}} font_boldness_mobile-{{block.settings.header_bold_strength_mobile}} desktop-font-{{block.settings.desktop_title_font_size}}">{{block.settings.title   | replace: "<strong>", "<span class='accent-highlight-one'>" | replace: "</strong>","</span>" | replace: "<em>","<span class='accent-highlight-two'>" | replace: "</em>","</span>"}}</h2>{% endif %}
                            {% if block.settings.hero_post_title != blank %}<div class="post-title mobile-font-{{block.settings.mobile_post_font_size}} desktop-font-{{block.settings.desktop_post_font_size}}">{{block.settings.hero_post_title}}</div>{% endif %}
                            {% if block.settings.hero_cta_text != blank and block.settings.hero_link != blank %}<button type="button" class="{{block.settings.hero_button_style}}">{{block.settings.hero_cta_text}}</button>{% endif %}
                        </div><!-- hero-content -->
                        <style>
                        
                        .hero-slick .hero-item .hero-link.content-on-image.mobile-content-bg .hero-content {
                            background-color: {{block.settings.hero_bg_color}} !important;
                        }

                        .hero-slick .hero-item .hero-link.content-on-image.mobile-image-bg .hero-content {
                            background-color: unset !important;
                        }
                        </style>
                        </div>
                        {% if block.settings.hero_link != blank %}
                            </a>
                        {% endif %}
                      
                    </div><!-- hero-item hero-split -->      
          
                {% when 'full' %}
    
                    <div class="hero-item hero-full {{block.settings.hero_layout}}" data-position="{{forloop.index}}" data-shopify-section-id="{{section.id}}" {{block.shopify_attributes}}>
                        {% if block.settings.hero_link != blank %}
                            <a class="hero-link" href="{{block.settings.hero_link}}">
                        {% endif %}
                        {% if block.settings.hero_background_choice == 'background-image' %}
                            <div class="hero-image">
    
                                {% if block.settings.hero_label_text_left != blank %}
                                <span class="hero-label left">{{block.settings.hero_label_text_left}}</span>
                                {% endif %}
    
                                {% if block.settings.hero_label_text_right != blank %}
                                <span class="hero-label right">{{block.settings.hero_label_text_right}}</span>
                                {% endif %}
    
                                <picture>
                                    <source media="(max-width: 767px)" srcset="{{ block.settings.hero_mobile_image | img_url: '767x' }}">
                                    <source media="(min-width: 768px) and (max-width:1399px)" srcset="{{ block.settings.hero_desktop_image | img_url: '1440x' }}">
                                    <source media="(min-width: 1400px)" srcset="{{ block.settings.hero_desktop_image | img_url: '1920x' }}">
                                    <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ block.settings.hero_desktop_image | img_url: '1440x' }}" class="lazyload img-fluid" alt="{{ block.settings.title | strip_html }}">
                                </picture>
                            </div><!-- hero-image -->
                        {% elsif block.settings.hero_background_choice == 'background-colour' %}
                        <div class="hero-bg-colour" style="background-color:{{block.settings.hero_background_color}};">
                            {% if block.settings.hero_label_text_left != blank %}
                            <span class="hero-label left">{{block.settings.hero_label_text_left}}</span>
                            {% endif %}
    
                            {% if block.settings.hero_label_text_right != blank %}
                            <span class="hero-label right">{{block.settings.hero_label_text_right}}</span>
                            {% endif %}
                        </div><!-- hero-bg-colour -->
                        {% endif %}
    
                        <div class="hero-content {{block.settings.hero_content_alignment}}" style="color:{{block.settings.hero_text_color}}; 
{% if block.settings.hero_layout == "content-below-image" or block.settings.hero_layout == "content-above-image"%}background-color:{{block.settings.hero_background_color}};{% endif %}">
    
                            {% if block.settings.hero_pre_title != blank  %}<div class="pre-title mobile-font-{{block.settings.mobile_pre_font_size}} desktop-font-{{block.settings.desktop_pre_font_size}}">
                                <i aria-hidden="true" class="stamped-fa fa-star"></i>
                                <i aria-hidden="true" class="stamped-fa fa-star"></i>
                                <i aria-hidden="true" class="stamped-fa fa-star"></i>
                                <i aria-hidden="true" class="stamped-fa fa-star"></i>
                                <i aria-hidden="true" class="stamped-fa fa-star"></i>
                                {{block.settings.hero_pre_title | replace: "<strong>", "<span class='accent-highlight-one'>" | replace: "</strong>","</span>" | replace: "<em>","<span class='accent-highlight-two'>" | replace: "</em>","</span>"}}</div>
                            {% endif%}
                            {% if block.settings.title != blank  %}<h2 class="hero-title mobile-font-{{block.settings.mobile_title_font_size}} desktop-font-{{block.settings.desktop_title_font_size}}">{{block.settings.title | replace: "<strong>", "<span class='accent-highlight-one'>" | replace: "</strong>","</span>" | replace: "<em>","<span class='accent-highlight-two'>" | replace: "</em>","</span>"}}</h2>{% endif %}
                            {% if block.settings.hero_post_title != blank %}<div class="post-title mobile-font-{{block.settings.mobile_post_font_size}} desktop-font-{{block.settings.desktop_post_font_size}}">{{block.settings.hero_post_title | replace: "<strong>", "<span class='accent-highlight-one'>" | replace: "</strong>","</span>" | replace: "<em>","<span class='accent-highlight-two'>" | replace: "</em>","</span>"}}</div>{% endif %}
                            {% if block.settings.hero_price != blank %}<div class="hero-price mobile-font-{{block.settings.mobile_price_font_size}} desktop-font-{{block.settings.desktop_price_font_size}}">{{block.settings.hero_price | replace: "<strong>", "<span class='accent-highlight-one'>" | replace: "</strong>","</span>" | replace: "<em>","<span class='accent-highlight-two'>" | replace: "</em>","</span>"}}</div>{% endif %}
                            {% if block.settings.hero_cta_text != blank and block.settings.hero_link != blank %}<button type="button" class="{{block.settings.hero_button_style}}">{{block.settings.hero_cta_text}}</button>{% endif %}
    
                        </div><!-- hero-content -->
                        {% if block.settings.hero_link != blank %}
                            </a>
                        {% endif %}
    
                    {% if block.settings.hero_accent_style_one != blank or block.settings.hero_accent_style_two != blank %}
                    <style>
                        {% if block.settings.hero_accent_style_one != blank %}
                        #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .pre-title .accent-highlight-one, #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .hero-title .accent-highlight-one, #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .post-title .accent-highlight-one, #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .hero-price .accent-highlight-one {
                            display:inline-block;
                            {% case block.settings.hero_accent_style_one %}
                            {% when 'text-bg' %}
                            padding:5px;
                            background-color:{{block.settings.hero_accent_color_one}};
                            {% when 'text-color' %}
                            color:{{block.settings.hero_accent_color_one}};
                            {% when 'text-shadow' %}
                            text-shadow:0px 3px 0px {{block.settings.hero_accent_color_one}};
                            {% endcase %}
                        }
                        {% endif %}
                        {% if block.settings.hero_accent_style_two != blank %}
                        #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .pre-title .accent-highlight-two, #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .hero-title .accent-highlight-two, #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .post-title .accent-highlight-two, #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .hero-price .accent-highlight-two {
                            display:inline-block;
                            {% case block.settings.hero_accent_style_two %}
                            {% when 'text-bg' %}
                            padding:5px;
                            background-color:{{block.settings.hero_accent_color_two}};
                            {% when 'text-color' %}
                            color:{{block.settings.hero_accent_color_two}};
                            {% when 'text-shadow' %}
                            text-shadow:0px 3px 0px {{block.settings.hero_accent_color_two}};
                            {% endcase %}
                        }
                        {% endif %}
                    </style>
                    {% endif %}
    
                    </div><!-- hero-item hero-full -->
    
                {% when 'full_2' %}
    
                    <div class="hero-item hero-full hero-full--2 {{block.settings.hero_layout_mobile}} {{block.settings.hero_layout_desktop}}" data-position="{{forloop.index}}" data-shopify-section-id="{{section.id}}" {{block.shopify_attributes}}>
                        {% if block.settings.hero_link != blank %}
                            <a class="hero-link" href="{{block.settings.hero_link}}">
                        {% endif %}
                        <div class="hero-overlay">
                            {% render 'Star_Asset_White' %}
                        </div>
                        {% if block.settings.hero_background_choice == 'background-image' %}
                            <div class="hero-image">
    
                                {% if block.settings.hero_label_text_left != blank %}
                                <span class="hero-label left">{{block.settings.hero_label_text_left}}</span>
                                {% endif %}
    
                                {% if block.settings.hero_label_text_right != blank %}
                                <span class="hero-label right">{{block.settings.hero_label_text_right}}</span>
                                {% endif %}
    
                                <picture>
                                    <source media="(max-width: 767px)" srcset="{{ block.settings.hero_mobile_image | img_url: '767x' }}">
                                    <source media="(min-width: 768px) and (max-width:1399px)" srcset="{{ block.settings.hero_desktop_image | img_url: '1440x' }}">
                                    <source media="(min-width: 1400px)" srcset="{{ block.settings.hero_desktop_image | img_url: '1920x' }}">
                                    <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ block.settings.hero_desktop_image | img_url: '1440x' }}" class="lazyload img-full" alt="{{ block.settings.title | strip_html }}">
                                </picture>
                            </div><!-- hero-image -->
                        {% elsif block.settings.hero_background_choice == 'background-colour' %}
                        <div class="hero-bg-colour" style="background-color:{{block.settings.hero_background_color}};">
                            {% if block.settings.hero_label_text_left != blank %}
                            <span class="hero-label left">{{block.settings.hero_label_text_left}}</span>
                            {% endif %}
    
                            {% if block.settings.hero_label_text_right != blank %}
                            <span class="hero-label right">{{block.settings.hero_label_text_right}}</span>
                            {% endif %}
                        </div><!-- hero-bg-colour -->
                        {% endif %}
    
    
                        <div class="hero-content {{ block.settings.content_alignment_desktop }} {{ block.settings.content_alignment_mobile }}">
    
                            <style>
                              
                              
                              {% if block.settings.hero_layout_desktop == "content-above-image-desktop"%}
                              .hero-slick .hero-item.hero-full .hero-link {
                                    flex-direction: column-reverse;
                                  }
                              {%endif%}
                              {% if block.settings.hero_layout_desktop == "content-below-image-desktop" or block.settings.hero_layout_mobile == "content-below-image-mobile" %}
                              .hero-slick .hero-item.hero-full .hero-link {
                                    flex-direction: column;
                                  }
                              {%endif%}
                              
                              {% if block.settings.hero_layout_mobile == "content-above-image-mobile"%}
                              .hero-slick .hero-item.hero-full .hero-content {position : relative !important; padding:10px 30px;}
                              .hero-slick .hero-item.hero-full.content-above-image-mobile {
                                  flex-direction: column-reverse !important;
                              }
                              
                              {%endif%}
                              
                              
                              
                              
                                #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .hero-content {
                                    {% if block.settings.hero_layout_mobile == "content-below-image-mobile" or block.settings.hero_layout_mobile == "content-above-image-mobile"%}
                                        background-color: {{block.settings.background_color_mobile}};
                                    {% else %}
                                        background-color: transparent;
                                    {% endif %}
                                    color: {{ block.settings.text_color_mobile }}
                                }
                                @media only screen and (min-width: 768px) {
                                    #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .hero-content {
                                        {% if block.settings.hero_layout_desktop == "content-below-image-desktop" or block.settings.hero_layout_desktop == "content-above-image-desktop"%}
                                            background-color: {{block.settings.background_color_desktop}};
                                        {% else %}
                                            background-color: transparent;
                                        {% endif %}
                                        color: {{ block.settings.text_color_desktop }}
                                    }
                                }
                            </style>
    
                            {% if block.settings.hero_pre_title != blank  %}
                                <div class="pre-title mobile-font-{{block.settings.mobile_pre_font_size}} desktop-font-{{block.settings.desktop_pre_font_size}} d-flex align-items-center">
                                    <i aria-hidden="true" class="stamped-fa fa-star"></i>
                                    <i aria-hidden="true" class="stamped-fa fa-star"></i>
                                    <i aria-hidden="true" class="stamped-fa fa-star"></i>
                                    <i aria-hidden="true" class="stamped-fa fa-star"></i>
                                    <i aria-hidden="true" class="stamped-fa fa-star mr-2"></i>
                                    {{block.settings.hero_pre_title | replace: "<strong>", "<span class='accent-highlight-one'>" | replace: "</strong>","</span>" | replace: "<em>","<span class='accent-highlight-two'>" | replace: "</em>","</span>"}}
                                </div>
                            {% endif%}
                            {% if block.settings.title != blank  %}<h2 class="hero-title font_boldness_mobile-{{block.settings.header_bold_strength_full_mobile}} mobile-font-{{block.settings.mobile_title_font_size}} desktop-font-{{block.settings.desktop_title_font_size}} font_boldness-{{block.settings.header_bold_strength_full}}">{{block.settings.title   | replace: "<strong>", "<span class='accent-highlight-one'>" | replace: "</strong>","</span>" | replace: "<em>","<span class='accent-highlight-two'>" | replace: "</em>","</span>"}}</h2>{% endif %}
                            {% if block.settings.hero_post_title != blank %}<div class="post-title mobile-font-{{block.settings.mobile_post_font_size}} desktop-font-{{block.settings.desktop_post_font_size}}">{{block.settings.hero_post_title   | replace: "<strong>", "<span class='accent-highlight-one'>" | replace: "</strong>","</span>" | replace: "<em>","<span class='accent-highlight-two'>" | replace: "</em>","</span>"}}</div>{% endif %}
                            {% if block.settings.hero_price != blank %}<div class="hero-price mobile-font-{{block.settings.mobile_price_font_size}} desktop-font-{{block.settings.desktop_price_font_size}}">{{block.settings.hero_price   | replace: "<strong>", "<span class='accent-highlight-one'>" | replace: "</strong>","</span>" | replace: "<em>","<span class='accent-highlight-two'>" | replace: "</em>","</span>"}}</div>{% endif %}
                            {% if block.settings.hero_cta_text != blank and block.settings.hero_link != blank %}<button type="button" class="{{block.settings.hero_button_style}}">{{block.settings.hero_cta_text}}</button>{% endif %}
    
                        </div><!-- hero-content -->
                        {% if block.settings.hero_link != blank %}
                            </a>
                        {% endif %}
    
                    {% if block.settings.hero_accent_style_one != blank or block.settings.hero_accent_style_two != blank %}
                    <style>
                        {% if block.settings.hero_accent_style_one != blank %}
                        #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .pre-title .accent-highlight-one,
                        #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .hero-title .accent-highlight-one,
                        #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .post-title .accent-highlight-one,
                        #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .hero-price .accent-highlight-one {
                            display:inline-block;
                            {% case block.settings.hero_accent_style_one %}
                            {% when 'text-bg' %}
                            padding:5px;
                            background-color:{{block.settings.hero_accent_color_one}};
                            {% when 'text-color' %}
                            color:{{block.settings.hero_accent_color_one}};
                            {% when 'text-shadow' %}
                            text-shadow:0px 3px 0px {{block.settings.hero_accent_color_one}};
                            {% endcase %}
                        }
                        {% endif %}
                        {% if block.settings.hero_accent_style_two != blank %}
                        #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .pre-title .accent-highlight-two,
                        #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .hero-title .accent-highlight-two,
                        #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .post-title .accent-highlight-two,
                        #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .hero-price .accent-highlight-two {
                            display:inline-block;
                            {% case block.settings.hero_accent_style_two %}
                            {% when 'text-bg' %}
                            padding:5px;
                            background-color:{{block.settings.hero_accent_color_two}};
                            {% when 'text-color' %}
                            color:{{block.settings.hero_accent_color_two}};
                            {% when 'text-shadow' %}
                            text-shadow:0px 3px 0px {{block.settings.hero_accent_color_two}};
                            {% endcase %}
                        }
                        {% endif %}
                    </style>
                    {% endif %}
                      
                    </div><!-- hero-item hero-full-2.0 -->
    
            {% endcase %}
        {% endfor %}
        </div><!-- hero slick -->
    
        <style>
            @media only screen and (max-width: 767px) {
                .hero-slick .hero-item .hero-link.above-background {
                      display: flex !important;
                      flex-direction: column-reverse !important;
                    }
                .hero-slick .hero-item .hero-link.below-background {
                      display: flex !important;
                      flex-direction: column !important;
                    }
                .hero-slick .hero-item .hero-link.above-background .hero-content,
				.hero-slick .hero-item .hero-link.below-background .hero-content {
                    position: relative !important;
                }

