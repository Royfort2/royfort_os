{% comment %}
  Outputs a variant URL: first available variant matching color_variant's color
  option value, or the first variant of that color if none are available.

  Parameters:
  - product: {Object}
  - color_variant: {Variant} Any variant representing the target color (typically the first of that color).
{% endcomment %}
{%- capture we_link_variant_id -%}
  {%- render 'we-first-available-variant-for-color', product: product, color_variant: color_variant -%}
{%- endcapture -%}
{%- assign we_link_variant_id = we_link_variant_id | strip | plus: 0 -%}
{%- assign we_link_url = color_variant.url -%}
{%- for we_v in product.variants -%}
  {%- if we_v.id == we_link_variant_id -%}
    {%- assign we_link_url = we_v.url -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{{- we_link_url -}}
