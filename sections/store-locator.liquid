{{ 'section-store-locator.css' | asset_url | stylesheet_tag }}

{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}

{%- assign motion_delay = 50 -%}

{% style %}
  /* Viewport scrolling is tied to the root element; `body` alone often ignores scroll-behavior. */
  @media (prefers-reduced-motion: no-preference) {
    html:has(.section-{{ section.id }}) {
      scroll-behavior: smooth;
    }
  }
  .store-location__info {
    flex-wrap: wrap;
  }
{% endstyle %}

<div
  class="section section-{{ section.id }} section--padding store-locator color-{{ section.settings.color_scheme }}{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width page-width--narrow">
    {%- for block in section.blocks -%}
      {% liquid
        assign row = 0
        assign col = 1
        assign show_map_block = false
        assign map_embed_stripped = ''
        if block.settings.show_map
          assign map_embed_stripped = block.settings.map_embed_url | strip
          if map_embed_stripped != blank
            assign show_map_block = true
          elsif block.settings.map_latitude != blank and block.settings.map_longitude != blank
            assign show_map_block = true
          endif
        endif
        if block.settings.heading != blank and block.settings.button_label != blank
          assign col = col | plus: 1
        endif
        if block.settings.heading != blank or block.settings.button_label != blank
          assign row = row | plus: 1
        endif
        if block.settings.image != blank or block.settings.text != blank or show_map_block
          assign row = row | plus: 1
        endif
        assign motion_delay = motion_delay | plus: 50
      %}
      <motion-element
        {% if block.settings.location_id != blank %}
          id="{{ block.settings.location_id }}"
        {% endif %}
        data-motion="fade-up"
        data-motion-delay="{{ motion_delay }}"
        class="store-location"
        {{ block.shopify_attributes }}
        style="--total-col:{{ col }};--total-row: {{ row }};{% if row < 2 %}--template-rows: auto;{% endif %}{% if col < 2 %}--template-columns: auto;{% endif %}"
      >
        {% if block.settings.heading != blank %}
          <h2 class="store-location__title {{ block.settings.heading_size }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.image != blank or block.settings.text != blank or show_map_block %}
          {% if block.settings.show_image %}
            <div
              class="store-location__image media-wrapper blocks-radius"
              style="--image-width: 100%;"
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1100
                  | image_tag:
                    loading: 'lazy',
                    class: 'motion-reduce',
                    widths: '165, 360, 535, 750, 940, 1100',
                    is: 'image-lazy'
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          {% endif %}
          <div class="store-location__info flex flex-col md:flex-row md:items-center">
            {% if block.settings.show_map and show_map_block %}
              {%- liquid
                assign map_iframe_title = 'Map'
                if block.settings.heading != blank
                  assign map_iframe_title = block.settings.heading | strip_html | strip | escape
                endif
                assign map_src = ''
                if map_embed_stripped != blank
                  assign map_src = map_embed_stripped
                else
                  assign map_lat = block.settings.map_latitude | strip
                  assign map_lng = block.settings.map_longitude | strip
                  assign map_zoom = block.settings.map_zoom | default: 15
                  assign map_src = 'https://maps.google.com/maps?q='
                  assign map_src = map_src | append: map_lat | append: ',' | append: map_lng
                  assign map_src = map_src | append: '&z=' | append: map_zoom | append: '&output=embed'
                endif
              -%}
              <div class="store-location__map media-wrapper blocks-radius">
                <iframe
                  class="store-location__map-iframe"
                  src="{{ map_src }}"
                  title="{{ map_iframe_title }}"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen
                ></iframe>
              </div>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="store-location__text rte text-lg flex-1">{{ block.settings.text }}</div>
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.button_label != blank %}
          <div class="store-location__cta">
            <a
              {% if block.settings.button_link != blank %}
                href="{{ block.settings.button_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="btn {{ block.settings.button_style }}"
            >
              {{- block.settings.button_label -}}
            </a>
          </div>
        {% endif %}
      </motion-element>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.store-locator.name",
  "tag": "section",
  "class": "section section-store-locator",
  "disabled_on": {
    "groups": ["footer", "header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "[Read How-to](https://foxecom.link/fNh8OHg)"
    },
    {
      "type": "header",
      "content": "t:sections.all.general.name"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:sections.all.divider.content"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": false,
      "label": "t:sections.all.divider.settings.show_divider.label"
    },
    {
      "type": "select",
      "id": "divider_width",
      "options": [
        {
          "value": "fixed",
          "label": "t:sections.all.container.options__fixed.label"
        },
        {
          "value": "full",
          "label": "t:sections.all.container.options__full.label"
        }
      ],
      "default": "fixed",
      "label": "t:sections.all.divider.settings.divider_width.label",
      "visible_if": "{{ section.settings.show_section_divider == true }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.custom_attr.header"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.all.custom_attr.custom_class"
    }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "t:sections.store-locator.blocks.location.name",
      "settings": [
        {
          "type": "text",
          "id": "location_id",
          "label": "Location ID",
          "info": "This ID will be used for page navigation"
        },
        {
          "type": "checkbox",
          "id": "show_image",
          "label": "t:sections.store-locator.blocks.location.settings.show_image.label",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.all.image.label",
          "visible_if": "{{ block.settings.show_image == true }}"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 200,
          "max": 600,
          "step": 5,
          "label": "t:sections.store-locator.blocks.location.settings.image_width.label",
          "default": 210,
          "visible_if": "{{ block.settings.show_image == true }}"
        },
        {
          "type": "checkbox",
          "id": "show_map",
          "label": "Show Google Map",
          "default": false
        },
        {
          "type": "textarea",
          "id": "map_embed_url",
          "label": "Map embed URL",
          "info": "Optional. In Google Maps: Share → Embed a map → copy only the **src** value from the iframe (starts with https://). If set, latitude/longitude below are ignored.",
          "visible_if": "{{ block.settings.show_map == true }}"
        },
        {
          "type": "text",
          "id": "map_latitude",
          "label": "Map latitude",
          "placeholder": "e.g. 52.520008",
          "visible_if": "{{ block.settings.show_map == true }}"
        },
        {
          "type": "text",
          "id": "map_longitude",
          "label": "Map longitude",
          "placeholder": "e.g. 13.404954",
          "visible_if": "{{ block.settings.show_map == true }}"
        },
        {
          "type": "range",
          "id": "map_zoom",
          "min": 10,
          "max": 19,
          "step": 1,
          "label": "Map zoom",
          "default": 15,
          "visible_if": "{{ block.settings.show_map == true }}"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Store name",
          "label": "t:sections.all.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "t:sections.all.text_size.heading.label",
          "default": "h1",
          "options": [
            {
              "value": "h6",
              "label": "t:sections.all.text_size.options__h6.label"
            },
            {
              "value": "h5",
              "label": "t:sections.all.text_size.options__h5.label"
            },
            {
              "value": "h4",
              "label": "t:sections.all.text_size.options__h4.label"
            },
            {
              "value": "h3",
              "label": "t:sections.all.text_size.options__h3.label"
            },
            {
              "value": "h2",
              "label": "t:sections.all.text_size.options__h2.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.text_size.options__h1.label"
            },
            {
              "value": "hd3",
              "label": "t:sections.all.text_size.options__hd3.label"
            },
            {
              "value": "hd2",
              "label": "t:sections.all.text_size.options__hd2.label"
            },
            {
              "value": "hd1",
              "label": "t:sections.all.text_size.options__hd1.label"
            }
          ]
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>shop@yourstore.com</p>",
          "label": "t:sections.all.text.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.all.button.button_label.label",
          "default": "Button label"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "t:sections.all.button.button_style.label",
          "options": [
            {
              "value": "btn--primary",
              "label": "t:sections.all.button.button_style.options__1.label"
            },
            {
              "value": "btn--secondary",
              "label": "t:sections.all.button.button_style.options__2.label"
            },
            {
              "value": "btn--underline",
              "label": "t:sections.all.button.button_style.options__4.label"
            }
          ],
          "default": "btn--primary"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.all.button.button_link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.store-locator.presets.name",
      "blocks": [
        {
          "type": "location"
        },
        {
          "type": "location"
        },
        {
          "type": "location"
        }
      ]
    }
  ]
}
{% endschema %}
