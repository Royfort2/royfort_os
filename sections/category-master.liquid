<header class="page-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                {% render 'full-breadcrumbs' %}
            </div>
        </div>
        <div class="row align-items-end">
            <div class="d-none d-lg-block col-lg-3">
                {% render 'mini-breadcrumbs' %}
            </div>
            <div class="col-12 col-lg-6 text-center">
                {% if current_tags %}
                    <h1 class="t-capital">{{ current_tags }}</h1>
                {% else %}
                    <h1>{{collection.title}}</h1>
                {% endif %}
            </div>
            <div class="d-none d-lg-block col-lg-3"></div>
        </div>
    </div>
</header>
<div id="template-category-container">

{% if section.settings.show_subcategory_section %}
<nav class="category-subcategories category-section" style="order:{{section.settings.subcategory_desktop}};">
    <div class="container-fluid">
    <ul>
    {% for block in section.blocks %}
    {% case block.type %}
    {% when 'subcategory' %}

        <li class="subcategory-listing">
            <a href="{{block.settings.link}}" title="{{block.settings.title}}">
                <span class="subcategory-image-container">
                <picture>
                    <source media="(max-width: 767px)" srcset="{{ block.settings.image | img_url: '75x' }}">
                    <source media="(min-width: 768px)" srcset="{{ block.settings.image | img_url: '150x' }}">
                    <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ block.settings.image | img_url: '150x' }}" class="subcategory-image img-fluid lazyload" alt="{{ block.settings.title }}">
                  </picture>
                </span>
                <span class="subcategory-title">{{block.settings.title}}</span>
            </a>
        </li>

    {% endcase %}
    {% endfor %}
    </ul>
    </div><!-- container-fluid -->
</nav><!-- subcategories-listing -->
{% endif %}

{% if section.settings.show_content_section %}
<div id="category-page-content" class="category-section truncate-content" style="order:{{section.settings.content_desktop}};">
    <div class="container-fluid">
        <div class="row">
            <div class="col-10 col-lg-7 mx-auto text-center">
                <div class="rte">
                    {{collection.description}}
                </div>
                <button type="button" class="btn btn-link truncate-toggle" data-show-more="{{ 'general.phrases.show_more' | t }}" data-show-less="{{ 'general.phrases.show_less' | t }}">{{ 'general.phrases.show_more' | t }}</button>
            </div>
        </div>
    </div>
</div><!-- category-page-content-->
{% endif %}

{% if section.settings.show_bestsellers_section %}
{% if collection.products.size < 5 %}
    {% assign ProductsPerRow = "ppr-four" %}
{% else%}
    {% assign ProductsPerRow = "ppr-five" %}
{% endif %}
<section id="category-best-sellers" class="category-section" style="order:{{section.settings.bestsellers_desktop}}">
    <div class="container-fluid">
    {% if section.settings.best_seller_title != blank %}<h3 class="category-title">{{section.settings.best_seller_title}}</h3>{% endif %}
    <div class="product-list-row {{ProductsPerRow}}" data-image-ratio="{{section.settings.ratio}}">
        {% for product in collection.products limit:8 %}
            {% render 'product-listing' with product as product %}
        {% endfor %}
    </div><!-- collection-listing -->
    </div><!-- container -->
</section><!-- category-best-sellers-->
{% endif %}


{% comment %}
BG: A direct copy from sections / hp-hero.

only removed the split block type.

{% endcomment %}
{% if section.settings.show_hero_section %}
<section id="category-hero" class="category-section section-background" style="background-color:{{section.settings.hero_container_bg}}; order:{{section.settings.banner_desktop}}">
    <div class="{{section.settings.hero_container}}">
    <div class="hero-slick inline-slick" data-slick='{"slidesToShow": 1, "slidesToScroll": 1, "arrows":{{section.settings.hero_slide_arrows}}, "autoplay":{{section.settings.hero_slide_autoplay}}, "autoplaySpeed": {{section.settings.hero_slide_speed}}0, "dots": false, "infinite": {{section.settings.hero_slide_wraparound}}}'>

    {% for block in section.blocks %}
    {% case block.type %}
    {% when 'split' %}

    <div class="hero-item hero-split {{block.settings.hero_layout}} {{block.settings.hero_mobile_bg}}" data-position="{{forloop.index}}" data-shopify-section-id="{{section.id}}" {{block.shopify_attributes}}>
        {% if block.settings.hero_link != blank %}
            <a class="hero-link" href="{{block.settings.hero_link}}">
        {% endif %}
        <div class="hero-image">
            <picture>
                <source media="(max-width: 767px)" srcset="{{ block.settings.hero_mobile_image | img_url: '767x' }}">
                <source media="(min-width: 768px)" srcset="{{ block.settings.hero_desktop_image | img_url: '1440x' }}">
                <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ block.settings.hero_desktop_image | img_url: '1440x' }}" class="lazyload img-fluid" alt="{{ block.settings.title }}">
            </picture>
        </div><!-- hero-image -->

        <div class="hero-content {{block.settings.hero_content_alignment}}" style="background-color:{{block.settings.hero_bg_color}}; color:{{block.settings.hero_text_color}};">
            {% if block.settings.title != blank  %}<h2 class="hero-title mobile-font-{{block.settings.mobile_title_font_size}} desktop-font-{{block.settings.desktop_title_font_size}}">{{block.settings.title}}</h2>{% endif%}
            {% if block.settings.hero_post_title != blank %}<div class="post-title mobile-font-{{block.settings.mobile_post_font_size}} desktop-font-{{block.settings.desktop_post_font_size}}">{{block.settings.hero_post_title}}</div>{% endif %}
            {% if block.settings.hero_cta_text != blank and block.settings.hero_link != blank %}<button type="button" class="{{block.settings.hero_button_style}}">{{block.settings.hero_cta_text}}</button>{% endif %}
        </div><!-- hero-content -->
        {% if block.settings.hero_link != blank %}
            </a>
        {% endif %}
    </div><!-- hero-item hero-split -->

    {% when 'full' %}

    <div class="hero-item hero-full {{block.settings.hero_layout}}" data-position="{{forloop.index}}" data-shopify-section-id="{{section.id}}" {{block.shopify_attributes}}>
        {% if block.settings.hero_link != blank %}
            <a class="hero-link" href="{{block.settings.hero_link}}">
        {% endif %}
        {% if block.settings.hero_background_choice == 'background-image' %}
            <div class="hero-image">

                {% if block.settings.hero_label_text_left != blank %}
                <span class="hero-label left">{{block.settings.hero_label_text_left}}</span>
                {% endif %}

                {% if block.settings.hero_label_text_right != blank %}
                <span class="hero-label right">{{block.settings.hero_label_text_right}}</span>
                {% endif %}

                <picture>
                    <source media="(max-width: 767px)" srcset="{{ block.settings.hero_mobile_image | img_url: '767x' }}">
                    <source media="(min-width: 768px) and (max-width:1399px)" srcset="{{ block.settings.hero_desktop_image | img_url: '1440x' }}">
                    <source media="(min-width: 1400px)" srcset="{{ block.settings.hero_desktop_image | img_url: '1920x' }}">
                    <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ block.settings.hero_desktop_image | img_url: '1440x' }}" class="lazyload img-fluid" alt="{{ block.settings.title }}">
                </picture>
            </div><!-- hero-image -->
        {% elsif block.settings.hero_background_choice == 'background-colour' %}
        <div class="hero-bg-colour" style="background-color:{{block.settings.hero_background_color}};">
            {% if block.settings.hero_label_text_left != blank %}
            <span class="hero-label left">{{block.settings.hero_label_text_left}}</span>
            {% endif %}

            {% if block.settings.hero_label_text_right != blank %}
            <span class="hero-label right">{{block.settings.hero_label_text_right}}</span>
            {% endif %}
        </div><!-- hero-bg-colour -->
        {% endif %}

        <div class="hero-content {{block.settings.hero_content_alignment}}" style="color:{{block.settings.hero_text_color}}; {% if block.settings.hero_layout == "content-below-image"%}background-color:{{block.settings.hero_background_color}};{% endif %}">

            {% if block.settings.hero_pre_title != blank  %}<div class="pre-title mobile-font-{{block.settings.mobile_pre_font_size}} desktop-font-{{block.settings.desktop_pre_font_size}}">{{block.settings.hero_pre_title | replace: "<strong>", "<span class='accent-highlight-one'>" | replace: "</strong>","</span>" | replace: "<em>","<span class='accent-highlight-two'>" | replace: "</em>","</span>"}}</div>{% endif%}
            {% if block.settings.title != blank  %}<h2 class="hero-title mobile-font-{{block.settings.mobile_title_font_size}} desktop-font-{{block.settings.desktop_title_font_size}}">{{block.settings.title | replace: "<strong>", "<span class='accent-highlight-one'>" | replace: "</strong>","</span>" | replace: "<em>","<span class='accent-highlight-two'>" | replace: "</em>","</span>"}}</h2>{% endif %}
            {% if block.settings.hero_post_title != blank %}<div class="post-title mobile-font-{{block.settings.mobile_post_font_size}} desktop-font-{{block.settings.desktop_post_font_size}}">{{block.settings.hero_post_title | replace: "<strong>", "<span class='accent-highlight-one'>" | replace: "</strong>","</span>" | replace: "<em>","<span class='accent-highlight-two'>" | replace: "</em>","</span>"}}</div>{% endif %}
            {% if block.settings.hero_price != blank %}<div class="hero-price mobile-font-{{block.settings.mobile_price_font_size}} desktop-font-{{block.settings.desktop_price_font_size}}">{{block.settings.hero_price | replace: "<strong>", "<span class='accent-highlight-one'>" | replace: "</strong>","</span>" | replace: "<em>","<span class='accent-highlight-two'>" | replace: "</em>","</span>"}}</div>{% endif %}
            {% if block.settings.hero_cta_text != blank and block.settings.hero_link != blank %}<button type="button" class="{{block.settings.hero_button_style}}">{{block.settings.hero_cta_text}}</button>{% endif %}

        </div><!-- hero-content -->
        {% if block.settings.hero_link != blank %}
            </a>
        {% endif %}

    {% if block.settings.hero_accent_style_one != blank or block.settings.hero_accent_style_two != blank %}
    <style>
        {% if block.settings.hero_accent_style_one != blank %}
        #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .pre-title .accent-highlight-one, #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .hero-title .accent-highlight-one, #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .post-title .accent-highlight-one, #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .hero-price .accent-highlight-one {
            display:inline-block;
            {% case block.settings.hero_accent_style_one %}
            {% when 'text-bg' %}
            padding:5px;
            background-color:{{block.settings.hero_accent_color_one}};
            {% when 'text-color' %}
            color:{{block.settings.hero_accent_color_one}};
            {% when 'text-shadow' %}
            text-shadow:0px 3px 0px {{block.settings.hero_accent_color_one}};
            {% endcase %}
        }
        {% endif %}
        {% if block.settings.hero_accent_style_two != blank %}
        #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .pre-title .accent-highlight-two, #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .hero-title .accent-highlight-two, #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .post-title .accent-highlight-two, #shopify-section-{{section.id}} .hero-item.hero-full[data-position="{{forloop.index}}"] .hero-price .accent-highlight-two {
            display:inline-block;
            {% case block.settings.hero_accent_style_two %}
            {% when 'text-bg' %}
            padding:5px;
            background-color:{{block.settings.hero_accent_color_two}};
            {% when 'text-color' %}
            color:{{block.settings.hero_accent_color_two}};
            {% when 'text-shadow' %}
            text-shadow:0px 3px 0px {{block.settings.hero_accent_color_two}};
            {% endcase %}
        }
        {% endif %}
    </style>
    {% endif %}

    </div><!-- hero-item hero-full -->

    {% endcase %}
    {% endfor %}
    </div><!-- hero slick -->

    </div><!-- container -->
</section><!-- section-background -->
{% endif %}

{% comment %}
BG: A direct copy from sections / hp-column-banners
{% endcomment %}
{% if section.settings.show_column_banners_section %}
<section id="category-column-banners" class="category-section column-banners" style="order:{{section.settings.offers_desktop}};">
<div class="section-background{% if section.settings.cb_section_background_colour != "rgba(0,0,0,0)" or section.settings.cb_background_image != blank%} background-padding{% endif %}{% if section.settings.title != blank %} title-visible{% endif %}" style="{% if section.settings.cb_section_background_colour != "rgba(0,0,0,0)" %}background-color:{{section.settings.cb_section_background_colour}};{% endif %}{% if section.settings.cb_background_image %} background-image:url('{{section.settings.cb_background_image | img_url: '1920x'}}');{% endif %}">
<div class="container-fluid {{section.settings.cb_block_guttering_new}} {{section.settings.cb_section_guttering}}">
{% if section.settings.cb_title != blank %}<h2 class="section-title" style="color:{{section.settings.cb_section_title_colour}}">{{section.settings.cb_title}}</h2>{% endif %}
    <div class="banners-row{% if section.settings.cb_block_slide == true %} inline-slick{% endif %}" data-img-orientation="{% if section.blocks.size > 2 %}portrait{% else %}landscape{% endif %}" data-slick='{"slidesToShow": 1, "slidesToScroll": 1, "touchThreshold": 15, "dots":false, "arrows":false, "mobileFirst": true, "responsive":[{"breakpoint": 767,"settings":{"slidesToShow": 3, "slidesToScroll": 1 }}]}'>

    {% for block in section.blocks %}
    {% case block.type %}
    {% when 'content_image' %}

    <div class="banner-item content-image {{section.settings.cb_block_content}} {{block.settings.block_image_position}}{% if block.settings.image %} image-present{% endif %}" data-position="{{forloop.index}}" {{block.shopify_attributes}}>
    {% if block.settings.block_link != blank %}
        <a class="banner-link" href="{{block.settings.block_link}}">
    {% else %}
        <div class="banner-ratio">
    {% endif %}

    {% if block.settings.image %}
    <div class="banner-image">
        {% if section.settings.cb_block_content == "content-on-image" and block.settings.block_image_position != "image-full" and section.blocks.size > 2 %}
            <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{block.settings.image | img_url: '250x'}}" class="lazyload img-fluid" title="{{ block.settings.title | strip_html }}">
        {% elsif section.settings.cb_block_content == "content-on-image" and block.settings.block_image_position != "image-full" and section.blocks.size < 3  %}
            <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{block.settings.image | img_url: '300x'}}" class="lazyload img-fluid" title="{{ block.settings.title | strip_html }}">
            {% elsif section.blocks.size > 2 %}
            <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{block.settings.image | img_url: '550x'}}" class="lazyload img-fluid" title="{{ block.settings.title | strip_html }}">
        {% elsif section.blocks.size < 3 %}
            <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{block.settings.image | img_url: '850x'}}" class="lazyload img-fluid" title="{{ block.settings.title | strip_html }}">
        {% endif %}
        {% if block.settings.block_label_left != blank %}<span class="banner-label left">{{block.settings.block_label_left}}</span>{% endif %}
        {% if block.settings.block_label_right != blank %}<span class="banner-label right">{{block.settings.block_label_right}}</span>{% endif %}
    </div><!-- banner-image -->
    {% endif %}

    <div class="banner-content {{block.settings.block_content_alignment}}" style="background-color:{{block.settings.block_content_bg}}; color:{{block.settings.block_text_color}};">
        {% if block.settings.title != blank  %}<h3 class="banner-title">{{block.settings.title | remove: "<p>" | remove: "</p>" | replace: "<strong>", "<span class='accent-highlight-one'>" | replace: "</strong>","</span>"}}</h3>{% endif%}
        {% if block.settings.block_paragraph != blank %}<p class="banner-paragraph">{{block.settings.block_paragraph}}</p>{% endif %}
        {% if block.settings.block_cta_text != blank and block.settings.block_link != blank %}<button type="button" class="{{block.settings.block_button_style}}">{{block.settings.block_cta_text}}</button>{% endif %}
    </div><!-- banner-content -->

    {% if block.settings.block_link != blank %}
        </a>
    {% else %}
        </div><!-- banner-container-->
    {% endif %}
    </div><!-- banner-item - countent-image -->

    {% when 'multi_content' %}

    <div class="banner-item multi-content {{section.settings.cb_block_content}}{% if block.settings.image %} image-present{% endif %}" data-position="{{forloop.index}}" {{block.shopify_attributes}}>
        {% if block.settings.block_link != blank %}
            <a class="banner-link" href="{{block.settings.block_link}}">
        {% else %}
            <div class="banner-ratio">
        {% endif %}

        {% if block.settings.image %}
        <div class="banner-image">
            {% if section.blocks.size > 2 %}
                <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{block.settings.image | img_url: '550x'}}" class="lazyload img-fluid" title="{{block.settings.title}}">
            {% elsif section.blocks.size < 3 %}
                <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{block.settings.image | img_url: '850x'}}" class="lazyload img-fluid" title="{{block.settings.title}}">
            {% endif %}
        </div><!-- banner-image -->
        {% endif %}

        <div class="banner-content {{block.settings.block_content_alignment}}" style="background-color:{{block.settings.block_content_bg}}; color:{{block.settings.block_text_color}};">
            {% if block.settings.title != blank  %}<h3 class="banner-title">{{block.settings.title}}</h3>{% endif%}
            {% if block.settings.block_paragraph_one != blank %}<p class="banner-paragraph first">{{block.settings.block_paragraph_one | remove: "<p>" | remove: "</p>" | replace: "<strong>", "<span class='accent-highlight-one'>" | replace: "</strong>","</span>" | replace: "<em>","<span class='accent-highlight-two'>" | replace: "</em>","</span>"}}</p>{% endif %}
            {% if block.settings.block_paragraph_two != blank %}<p class="banner-paragraph second">{{block.settings.block_paragraph_two}}</p>{% endif %}
            {% if block.settings.block_cta_text != blank and block.settings.block_link != blank %}<button type="button" class="{{block.settings.block_button_style}}">{{block.settings.block_cta_text}}</button>{% endif %}
        </div><!-- banner-content -->

        <style>
        #shopify-section-{{section.id}} .banner-item.multi-content[data-position="{{forloop.index}}"] .banner-title:after {
            background-color:{{block.settings.block_text_color}};
        }
        </style>

        {% if block.settings.block_link != blank %}
            </a>
        {% else %}
            </div><!-- banner-container-->
        {% endif %}
    </div><!-- banner-item - multi-content -->

    {% when 'big_text' %}

    <div class="banner-item big-text {{section.settings.block_content}}" data-position="{{forloop.index}}" {{block.shopify_attributes}}>
        {% if block.settings.block_link != blank %}
            <a class="banner-link" href="{{block.settings.block_link}}">
        {% else %}
            <div class="banner-ratio">
        {% endif %}


        <div class="banner-content {{block.settings.block_content_alignment}}" style="background-color:{{block.settings.block_content_bg}}; color:{{block.settings.block_text_color}};">
            {% if block.settings.image != blank %}
                <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ block.settings.image | img_url: '50x' }}" class="lazyload content-icon" alt="{{block.settings.title}}" />
            {% endif %}
            {% if block.settings.title != blank  %}<p class="banner-title">{{block.settings.title}}</p>{% endif%}
            {% if block.settings.block_cta_text != blank and block.settings.block_link != blank %}<button type="button" class="{{block.settings.block_button_style}}">{{block.settings.block_cta_text}}</button>{% endif %}
        </div><!-- banner-content -->

        {% if block.settings.block_link != blank %}
            </a>
        {% else %}
            </div><!-- banner-container-->
        {% endif %}
    </div><!-- banner-item - multi-content -->

    {% endcase %}
    {% endfor %}

    </div><!-- banners-slick -->
</div><!-- container-fluid -->
</div><!-- section-background -->
</section><!-- category-section -->
{% endif %}

{% comment %}
BG: A direct copy from sections / hp-site-usp
{% endcomment %}
{% if section.settings.show_usp_section %}
<div id="category-site-usp" class="site-usp category-section" style="order:{{section.settings.usp_desktop}};">
<div class="section-background" style="background-color:{{section.settings.usp_section_container_bg}};">
    <div class="{{section.settings.usp_section_container}}">
    <div class="site-usp-container {% if section.settings.usp_block_slide == true %} inline-slick{% endif %} {{section.settings.usp_icon_placement}}" data-slick='{"slidesToShow": 1, "slidesToScroll": 1, "touchThreshold": 15, "dots":false, "arrows":false, "adaptiveHeight": true, "autoplay":{{section.settings.usp_block_autoplay}}, "autoplaySpeed": {{section.settings.usp_block_speed}}0, "mobileFirst": true, "responsive":[{"breakpoint": 767,"settings":{"slidesToShow": 3, "slidesToScroll": 1 }}]}'>
    {% for block in section.blocks %}
    {% case block.type %}
    {% when 'site_usp' %}
        <div class="usp-item {{section.settings.usp_icon_placement}}">
            {% if block.settings.usp_link != blank %}
            <a href="{{block.settings.usp_link}}" title="{{block.settings.title}}">
            {% endif %}
            <div class="usp-icon">
                <div class="fixed-ratio square">
                    <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ block.settings.image | img_url: '60x' }}" class="lazyload" alt="{{block.settings.title}}" />
                </div><!-- fixed-ratio square -->
            </div><!-- usp-icon-->
            <div class="usp-content">
                <h4>{{block.settings.title}}</h4>
                {% if block.settings.richtext != blank %}<div class="rte">{{block.settings.richtext}}</div>{% endif %}
            </div><!-- usp-content -->
            {% if block.settings.usp_link != blank %}
            </a>
            {% endif %}
        </div><!-- usp-item -->
    {% endcase %}
    {% endfor %}
    </div><!-- site-usp-container-->
</div><!-- container -->
</div><!-- section-background-->
</div><!-- site-usp / category-section -->
{% endif %}


{% if section.settings.show_recentlyviewed_section %}
<section class="product-list-container recently-viewed-products d-none category-section" style="order:{{section.settings.recentlyviewed_desktop}};" data-image-ratio="{{section.settings.ratio}}">
    <h3>{{section.settings.recently_viewed_products_title}}</h3>
    <div class="product-list-row inline-slick" data-slick='{"slidesToShow": 2, "slidesToScroll": 1, "touchThreshold": 15, "dots":false, "arrows":true, "mobileFirst": true, "infinite": true, "responsive":[{"breakpoint": 767,"settings":{"slidesToShow": 3, "slidesToScroll": 1 }},{"breakpoint": 992,"settings":{"slidesToShow": 4, "slidesToScroll": 1 }}]}'>
    </div>
</section>
{% endif %}


</div>

{% schema %}
{
    "name": "Category Master",
    "settings": [
        {
      	    "type": 		"header",
      	    "content": 		"Section Position & Visibility"
        },
        {
            "type": 	"paragraph",
            "content": 	"The below options will determine were the sections will sit within the Category."
        },
        {
            "type": "checkbox",
