{%- comment -%}
  Product info tabs: horizontal tabs on desktop, accordion on mobile.
  Up to 5 tabs from block settings: tab_N_heading, tab_N_content, tab_N_page, tab_N_default_open.
{%- endcomment -%}
{%- liquid
  assign tab_count = 0
  for idx in (1..5)
    assign heading_key = 'tab_' | append: idx | append: '_heading'
    assign content_key = 'tab_' | append: idx | append: '_content'
    assign page_key = 'tab_' | append: idx | append: '_page'
    assign heading = block.settings[heading_key]
    assign content = block.settings[content_key]
    assign page = block.settings[page_key]
    if heading != blank
      if content != blank or page.content != blank or request.design_mode
        assign tab_count = tab_count | plus: 1
      endif
    endif
  endfor
-%}
{%- if tab_count > 0 or request.design_mode -%}
  <div class="product__block product__block--product_info_tabs" {{ block.shopify_attributes }}>
    {%- if tab_count > 0 -%}
      <tabs-component class="we-product-info-tabs we-product-info-tabs--desktop">
        <div class="we-product-info-tabs__titles" role="tablist" aria-label="{{ block.settings.aria_label | default: 'Product information' | escape }}">
          {%- assign tab_index = 0 -%}
          {%- for i in (1..5) -%}
            {%- liquid
              assign heading_key = 'tab_' | append: i | append: '_heading'
              assign content_key = 'tab_' | append: i | append: '_content'
              assign page_key = 'tab_' | append: i | append: '_page'
              assign heading = block.settings[heading_key]
              assign content = block.settings[content_key]
              assign page = block.settings[page_key]
              assign tab_valid = false
              if heading != blank
                if content != blank or page.content != blank or request.design_mode
                  assign tab_valid = true
                endif
              endif
            -%}
            {%- if tab_valid -%}
              <button
                type="button"
                class="we-product-info-tabs__title font-heading btn--plain"
                role="tab"
                id="WeProductTab-{{ block.id }}-{{ tab_index }}"
                aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}"
                data-index="{{ tab_index }}"
              >
                {{ heading | escape }}
              </button>
              {%- assign tab_index = tab_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="we-product-info-tabs__panels">
          {%- assign tab_index = 0 -%}
          {%- for i in (1..5) -%}
            {%- liquid
              assign heading_key = 'tab_' | append: i | append: '_heading'
              assign content_key = 'tab_' | append: i | append: '_content'
              assign page_key = 'tab_' | append: i | append: '_page'
              assign heading = block.settings[heading_key]
              assign content = block.settings[content_key]
              assign page = block.settings[page_key]
              assign tab_valid = false
              if heading != blank
                if content != blank or page.content != blank or request.design_mode
                  assign tab_valid = true
                endif
              endif
            -%}
            {%- if tab_valid -%}
              <div
                class="we-product-info-tabs__panel rte"
                role="tabpanel"
                id="WeProductTabPanel-{{ block.id }}-{{ tab_index }}"
                aria-labelledby="WeProductTab-{{ block.id }}-{{ tab_index }}"
                {% unless tab_index == 0 %}
                  hidden
                {% endunless %}
              >
                {%- if page.content != blank -%}
                  {{ page.content }}
                {%- elsif content != blank -%}
                  {{ content }}
                {%- elsif request.design_mode -%}
                  <p>Add tab content in block settings.</p>
                {%- endif -%}
              </div>
              {%- assign tab_index = tab_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </tabs-component>

      <div class="we-product-info-tabs we-product-info-tabs--mobile accordion-parent accordion-parent--multi">
        {%- for i in (1..5) -%}
          {%- liquid
            assign heading_key = 'tab_' | append: i | append: '_heading'
            assign content_key = 'tab_' | append: i | append: '_content'
            assign page_key = 'tab_' | append: i | append: '_page'
            assign default_open_key = 'tab_' | append: i | append: '_default_open'
            assign heading = block.settings[heading_key]
            assign content = block.settings[content_key]
            assign page = block.settings[page_key]
            assign default_open = block.settings[default_open_key]
            assign tab_valid = false
            if heading != blank
              if content != blank or page.content != blank or request.design_mode
                assign tab_valid = true
              endif
            endif
          -%}
          {%- if tab_valid -%}
            <details
              id="WeProductTabMobile-{{ block.id }}-{{ i }}"
              class="accordion-details"
              is="accordion-details"
              {% if default_open %}
                open
                aria-expanded="true"
              {% else %}
                aria-expanded="false"
              {% endif %}
            >
              <summary class="accordion-details__summary flex items-center justify-between">
                <h2 class="h4 inline-richtext">{{ heading | escape }}</h2>
                {%- render 'icon-plus-toggle', size: 'small' -%}
              </summary>
              <div class="accordion-details__content rte">
                {%- if page.content != blank -%}
                  {{ page.content }}
                {%- elsif content != blank -%}
                  {{ content }}
                {%- elsif request.design_mode -%}
                  <p>Add tab content in block settings.</p>
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="we-product-info-tabs__empty">Add tab headings and content in block settings.</p>
    {%- endif -%}
  </div>
{%- endif -%}
