{% comment %}
  Resolves optional set line products from bundle_* product tags that are not
  already listed in pdp_set_products (e.g. Matratzenschoner on Baumwolle Set).

  Tag format: bundle_{product-handle}_{sort-order}
  Example: bundle_matratzenschoner-wasserdicht_3

  Parameters:
  - product: {Object} bundle / page product
  - set_products: {Array} product.metafields.custom.pdp_set_products.value
  - mode: {String} "ids" | "products" | "titles-json" | "prices-json"
  - block, product_form_id, update_browser_history — required when mode is "products"
{% endcomment %}
{%- liquid
  assign we_tag_extra_mode = mode | default: 'ids'
  assign we_set_id_blob = ','
  if set_products != blank
    for sp in set_products
      assign we_set_id_blob = we_set_id_blob | append: sp.id | append: ','
    endfor
  endif
  assign we_extra_ids = ''
-%}
{%- for we_bundle_order in (1..10) -%}
  {%- for tag in product.tags -%}
    {%- unless tag contains 'bundle_' -%}
      {%- continue -%}
    {%- endunless -%}
    {%- assign we_tag_body = tag | remove_first: 'bundle_' -%}
    {%- assign we_tag_segments = we_tag_body | split: '_' -%}
    {%- assign we_tag_order_str = we_tag_segments | last -%}
    {%- assign we_tag_order_num = we_tag_order_str | plus: 0 -%}
    {%- if we_tag_order_num != we_bundle_order -%}
      {%- continue -%}
    {%- endif -%}
    {%- assign we_tag_suffix = we_tag_order_str | prepend: '_' -%}
    {%- assign we_tag_handle = we_tag_body | remove: we_tag_suffix -%}
    {%- assign we_tag_product = all_products[we_tag_handle] -%}
    {%- if we_tag_product == blank -%}
      {%- continue -%}
    {%- endif -%}
    {%- assign we_tag_id_token = we_tag_product.id | prepend: ',' | append: ',' -%}
    {%- if we_set_id_blob contains we_tag_id_token -%}
      {%- continue -%}
    {%- endif -%}
    {%- if we_tag_extra_mode == 'ids' -%}
      {%- if we_extra_ids != blank -%}
        {%- assign we_extra_ids = we_extra_ids | append: ',' -%}
      {%- endif -%}
      {%- assign we_extra_ids = we_extra_ids | append: we_tag_product.id -%}
    {%- elsif we_tag_extra_mode == 'titles-json' -%}
      ,"{{ we_tag_product.id }}":{{ we_tag_product.title | json }}
    {%- elsif we_tag_extra_mode == 'prices-json' -%}
      ,"{{ we_tag_product.id }}":{{ we_tag_product.price_min }}
    {%- else -%}
      {%- capture we_set_line_vid_c -%}
        {%- render 'we-pdp-first-set-line-variant-id', bundle_product: product, line_product: we_tag_product -%}
      {%- endcapture -%}
      {%- assign we_set_line_vid_str = we_set_line_vid_c | strip -%}
      {%- assign we_set_line_resolved = we_tag_product.selected_or_first_available_variant -%}
      {%- if we_set_line_vid_str != blank -%}
        {%- assign we_set_line_vid_num = we_set_line_vid_str | plus: 0 -%}
        {%- for v in we_tag_product.variants -%}
          {%- if v.id == we_set_line_vid_num -%}
            {%- assign we_set_line_resolved = v -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- liquid
        assign we_set_card_title = we_tag_product.title
        if we_tag_product.metafields.custom.we_pdp_addon_card_title.value != blank
          assign we_set_card_title = we_tag_product.metafields.custom.we_pdp_addon_card_title.value
        elsif we_tag_product.title contains 'Kissenbezug' or we_tag_product.title contains 'kissenbezug'
          assign we_set_card_title = 'Kissenbezug wählen'
        elsif we_tag_product.title contains 'Spannbettlaken'
          if block.settings.set_picker_title != blank
            assign we_set_card_title = block.settings.set_picker_title
          else
            assign we_set_card_title = 'Spannbettlaken hinzufügen'
          endif
        elsif we_tag_product.title contains 'Matratzenschoner' or we_tag_product.title contains 'matratzenschoner'
          assign we_set_card_title = 'Matratzenschoner hinzufügen'
        endif
      -%}
      <div class="product-set-picker__item">
        <script type="application/json" data-set-product-variants="{{ we_tag_product.id }}">
          {{ we_tag_product.variants | json }}
        </script>
        <script type="application/json" data-set-default-variant-id="{{ we_tag_product.id }}">
          {{ we_set_line_resolved.id | json }}
        </script>
        <script type="application/json" data-set-product-variant-images="{{ we_tag_product.id }}">
          {
          {%- for variant in we_tag_product.variants -%}
            {%- liquid
              assign v_thumb = variant.featured_image | default: we_tag_product.featured_image
            -%}
            "{{ variant.id }}":{% if v_thumb != blank %}{{ v_thumb | image_url: width: 360 | json }}{% else %}null{% endif %}{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
          }
        </script>
        <template id="SetWeCardDefaultPrice-{{ block.id }}-{{ section.id }}-{{ we_tag_product.id }}">
          {% render 'price', product: we_tag_product, price_class: 'product-set-picker__f-price', we_force_from_price: true %}
        </template>
        <div class="product-set-picker__card">
          <label class="product-set-picker__card-row">
            <input
              type="checkbox"
              id="SetWeProductToggle-{{ block.id }}-{{ section.id }}-{{ we_tag_product.id }}"
              class="product-set-picker__toggle visually-hidden"
              data-set-optional-product-id="{{ we_tag_product.id }}"
            >
            <span
              class="product-set-picker__thumb"
              {% if we_tag_product.featured_image != blank %}
                data-default-thumb-url="{{ we_tag_product.featured_image | image_url: width: 360 }}"
              {% endif %}
            >
              {%- if we_tag_product.featured_image -%}
                {{
                  we_tag_product.featured_image
                  | image_url: width: 160
                  | image_tag:
                    loading: 'lazy',
                    class: 'product-set-picker__thumb-img',
                    widths: '80,120,160',
                    sizes: '8rem'
                }}
              {%- else -%}
                <span class="product-set-picker__thumb-placeholder" aria-hidden="true"></span>
              {%- endif -%}
            </span>
            <span class="product-set-picker__info">
              <span class="product-set-picker__title">{{ we_set_card_title | escape }}</span>
              <span
                class="product-set-picker__price"
                data-set-card-price
                data-product-id="{{ we_tag_product.id }}"
                data-default-price-template="SetWeCardDefaultPrice-{{ block.id }}-{{ section.id }}-{{ we_tag_product.id }}"
              >
                {% render 'price', product: we_tag_product, price_class: 'product-set-picker__f-price', we_force_from_price: true %}
              </span>
            </span>
            <span class="product-set-picker__checkbox-ui" aria-hidden="true"></span>
          </label>
          <div class="product-set-picker__expand">
            <div class="product-set-picker__expand-inner">
              {% render 'we-product-variant-picker',
                product: we_tag_product,
                block: block,
                product_form_id: product_form_id,
                update_url: update_browser_history,
                picker_id_suffix: we_tag_product.id,
                pdp_set_line_variant_from_bundle: we_set_line_resolved,
                pdp_set_addon_card: true
              %}
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
    {%- break -%}
  {%- endfor -%}
{%- endfor -%}
{%- if we_tag_extra_mode == 'ids' -%}
  {{- we_extra_ids -}}
{%- endif -%}