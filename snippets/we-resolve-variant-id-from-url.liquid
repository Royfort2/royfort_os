{% comment %}
  Outputs the numeric variant id from product.selected_variant or ?variant= in the URL.
  Accepts: product {Object}
{% endcomment %}
{%- liquid
  assign we_resolved_id = ''
  if product.selected_variant != blank
    assign we_resolved_id = product.selected_variant.id
  elsif request.query_string contains 'variant='
    assign we_variant_from_url = request.query_string | split: 'variant=' | last | split: '&' | first | strip
    for v in product.variants
      assign v_id_str = v.id | append: ''
      if v_id_str == we_variant_from_url
        assign we_resolved_id = v.id
        break
      endif
    endfor
  endif
-%}{{- we_resolved_id -}}
