{% paginate collection.products by section.settings.products_per_page %}

<header class="page-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                {% render 'full-breadcrumbs' %}
            </div>
        </div>
        <div class="row align-items-end">
            <div class="d-none d-lg-block col-lg-3">
                {% render 'mini-breadcrumbs' %}
            </div>
            <div class="col-12 col-lg-6 text-center">
                <h1>{{collection.title}}</h1>
            </div>
            <div class="d-none d-lg-block col-lg-3"></div>
        </div>
    </div>
</header>

<div class="collection-listing-container">
	<div class="container-fluid">
        <aside class="collection-sidebar">
            <div class="sidebar-wrapper">
                <h2 class="sidebar-title"><button type="button" class="btn-plain btn-collection-menu">{% render 'icon-close'%}</button>{{'collections.sidebar.title' | t}}{% if current_tags %}<button type="button" href="{{collection.url}}" class="btn-plain btn-link clear-filters" title="Clear all filters">{{'collections.sidebar.clear_filters' | t}}</button>{% endif %}</h2>
                <div class="selected-filters">
                    <ul class="current-tags">
                        {% capture tagPrefix %}{% for block in section.blocks %}{% case block.type %}{% when 'tag_filters' %}{{ block.settings.prefix_tag }}{% endcase %}{% endfor %}{% endcapture %}

                        {% for ftag in current_tags %}
                        {% assign tagHandle = ftag | handleize %}
                            {% if ftag contains tagPrefix %}
                                {% assign label = ftag | remove: tagPrefix | replace: "_"," " | strip | capitalize %}
                            {% else %}
                                {% assign label = ftag | replace: "_"," " | strip | capitalize %}
                            {% endif %}
                        {% capture fullLabel%}<span>{{label}}{% render 'icon-close' %}</span>{% endcapture %}
                        <li>{{ fullLabel | link_to_remove_tag: tagHandle | replace: ' title', ' rel="nofollow" title' }}</li>
                        {% endfor %}
                    </ul>
                    {% if current_tags %}
                    <button type="button" href="{{collection.url}}" class="btn-plain btn-link clear-filters" title="Clear all filters">{{'collections.sidebar.clear_filters' | t}}</button>
                    {% endif %}
                </div><!-- selected-filters -->
                <div class="accordion-container">
                    {% for block in section.blocks %}
                    {% case block.type %}
                    {% when 'tag_filters' %}
                        {% comment %}
                        BG: Let's check to see if any of the tags listed by the client are available on this collection, if they are show them, if not, hide it.
                        {% endcomment %}
                        {% assign showFilter = false %}
                        {% assign filter_tags = block.settings.filter_tags | split: "," %}
                        {% for tag in filter_tags %}
                            {% assign tagHandleCheck = tag | handleize %}
                            {% if collection.all_tags contains tagHandleCheck %}
                                {% assign showFilter = true %}
                                {% break %}
                            {% endif %}
                        {% endfor %}
                    {% if showFilter %}
                    <div class="accordion-item{% if section.settings.filters_open == "first" %}{% if forloop.first %} active{% endif%}{% elsif section.settings.filters_open == "open" %} active{% endif %}" data-prefix="{{block.settings.prefix_tag}}">
                        <div class="accordion-title">
                            <h3>{{ block.settings.title }}</h3>
                            <span class="icon-plusminus"></span>
                        </div><!-- accordion-title -->
                        <div class="accordion-content">

                            
                            <ul class="filter-tags">
                            {% for tag in filter_tags %}
                            {% assign tagHandle = tag | handleize %}
                            {% assign label = tag | remove: block.settings.prefix_tag | replace: "_", " " | strip | capitalize %}
                        
                            {% if current_tags contains tagHandle %}
                                <li class="filter-item active" data-tag-handle="{{tagHandle}}">
                                    {{label | link_to_remove_tag: tagHandle | replace: ' title', ' rel="nofollow" title'}}
                                </li>
                            {% else %}
                                {% if collection.tags contains tagHandle %}
                                <li class="filter-item" data-tag-handle="{{tagHandle}}">
                                    {{label | link_to_add_tag: tagHandle | replace: ' title', ' rel="nofollow" title'}}
                                </li>
                                {% endif %}
                            {% endif %}
                            {% endfor %}
                            </ul>


                        </div><!-- accordion-content -->
                    </div><!-- accordion-item -->
                    {% endif %}
                    {% endcase %}
                    {% endfor%}
                </div><!-- accordion-container-->
                <div class="mobile-info">
                    <span class="product-info">
                    {% if current_tags %}
                        Selected {{collection.products_count}} of {{collection.all_products_count}} products
                    {% else %}
                        {{collection.all_products_count}} products
                    {% endif %}
                    </span><!-- product-info-->
                    <button type="button" class="btn-plain btn-collection-menu">{{'collections.sidebar.apply_btn' | t}}</button>
                </div><!-- mobile-info-->
            </div><!-- sidebar-wrapper-->
        </aside><!-- col -->

        <section id="collection-main" class="collection-main" data-collection-url="{{collection.url}}{% if current_tags %}{% for tag in current_tags %}{% if forloop.first %}/{% endif %}{{tag}}{% unless forloop.last %}+{% endunless %}{% endfor%}{% endif %}">
            <div class="info-sort-row">
                <span class="collection-info">
                    {% if current_tags %}
                        Selected {{collection.products_count}} of {{collection.all_products_count}} products
                    {% else %}
                        {{collection.all_products_count}} products
                    {% endif %}
                </span>
                {% if paginate.current_page > 1 %}
                {% render 'pagination' with paginate as paginate, class: 'pagination-top' %}
                {% endif %}
                <div class="collection-sort-by">
                    <span class="sort-by-selected"><span class="name">{% if collection.sort_by != blank %}{{collection.sort_by}}{% else %}{{collection.default_sort_by}}{% endif %}</span>{% render 'icon-sorting' %}</span>
                    <ul class="sort-by-menu">
                    {% for option in collection.sort_options %}
                        <li data-url="{{option.value}}" class="{% if collection.sort_by != blank %}{% if option.value == collection.sort_by %}current{% endif %}{% else %}{% if option.value == collection.default_sort_by %}current{% endif %}{% endif %}">{{ option.name }}</li>
                    {% endfor %}
                    </ul>
                </div>
                <button type="button" class="btn-plain btn-collection-menu">{{'collections.general.filter_menu' | t}}{% render 'icon-filter'%}</button>
            </div><!-- info-sort-row -->
            <div class="collection-listing" data-image-ratio="{{section.settings.ratio}}" data-soldout-text="{{'products.product.sold_out' | t}}" data-lowstock-text="{{'products.product.low_stock' | t}}">
                {% for product in collection.products %}
                    {% render 'product-listing' with product as product %}
                {% else %}
                    <p>{{ 'collections.general.no_matches' | t }}</p>
                {% endfor %}
            </div><!-- row -->
            {% render 'pagination' with paginate as paginate, class: 'pagination-bottom' %}
        </section><!-- col -->
	</div><!-- container-fluid -->
</div><!-- Collection Listing -->

{% if collection.description != blank %}
<div class="collection-description truncate-content">
    <div class="container-fluid">
        <div class="collection-description-row">
            <div class="rte">
                {{collection.description}}
            </div>
            <button type="button" class="btn btn-link truncate-toggle" data-show-more="{{ 'general.phrases.show_more' | t }}" data-show-less="{{ 'general.phrases.show_less' | t }}">{{ 'general.phrases.show_more' | t }}</button>
        </div><!-- collection-description-row -->
    </div>
</div><!-- collection-description -->
{% endif %}
{% endpaginate %}

{% if section.settings.show_recentlyviewed_section %}
<section class="product-list-container recently-viewed-products d-none" data-image-ratio="{{section.settings.ratio}}">
    <h3>{{section.settings.recently_viewed_products_title}}</h3>
    <div class="product-list-row inline-slick" data-slick='{"slidesToShow": 2, "slidesToScroll": 1, "touchThreshold": 15, "dots":false, "arrows":true, "mobileFirst": true, "infinite": true, "responsive":[{"breakpoint": 767,"settings":{"slidesToShow": 3, "slidesToScroll": 1 }},{"breakpoint": 992,"settings":{"slidesToShow": 4, "slidesToScroll": 1 }}]}'>
    </div>
</section>
{% endif %}



{% schema %}
{
  "name": "Collection Bath-Body",
  "settings": [
    {
        "type": 		"header",
        "content": 		"Pagination"
    },
    {
        "type": 	"paragraph",
        "content": 	"How many products should be displayed per page?."
    },
    {
        "type":      "range",
        "id":        "products_per_page",
        "min":       6,
        "max":       42,
        "step":      3,
        "label":     "Products Per Page",
        "default":   30
    },
    {
        "type": 		"header",
        "content": 		"Filter(s)"
    },
    {
        "type": "select",
        "id": "filters_open",
        "options": [
            { "value": "first", "label": "Open First"},
            { "value": "open", "label": "Open All"},
            { "value": "close", "label": "Close All"}
        ],
        "label": "Filter Accordion Behaviour"
    },
    {
      	"type": 		"header",
      	"content": 		"Image Ratio"
		},
    {
        "type": 	"paragraph",
        "content": 	"Determine the aspect ratio of the product images"
    },
    {
        "type":         "select",
        "id":           "ratio",
        "label":        "Fixed Ratio?",
        "options": [
            {
                "value": "fixed-ratio square-crop",
                "label": "Square (4x4 Cropped)"
            },
            {
                "value": "fixed-ratio square",
                "label": "Square (4x4)"
            },
            {
                "value": "fixed-ratio portrait-crop",
                "label": "Portrait (4x5 Cropped)"
            },
            {
                "value": "fixed-ratio portrait",
                "label": "Portrait (4x5)"
            },
            {
                "value": "",
                "label": "No Set Ratio"
            }
        ],
        "default":   "fixed-ratio square"
    },
    {
        "type": "checkbox",
        "id": "show_recentlyviewed_section",
        "default": true,
        "label": "Show Recently Viewed?",
        "info": "If user has not viewed any products, this will remain hidden to the user"
    },
    {
        "type": "text",
        "id": "recently_viewed_products_title",
        "default": "Recently Viewed",
        "label": "Recently Viewed Products Title"
    }
    ],
    "blocks": [
		{
			"type": "tag_filters",
			"name": "Tag Filters",
			"settings": [
				{
				   "type":      "text",
				   "id":        "title",
				   "label":     "Filter Name"
                },
				{
                    "type": "textarea",
                    "id": "filter_tags",
                    "default": "product_tag_one, product_tag_two",
                    "label": "Filter Tags",
                    "info": "List the product tag(s) in full above. Seperate each tag with a comma. This also determines the order of the tags."
                },
                {
                    "type": 		"header",
                    "content": 		"Tag Appearance"
                },
                {
                    "type": 	"paragraph",
                    "content": 	"Let's make the tags more user friendly, specify the shared tag prefix below, and we'll remove it. We'll also replace the underscores with spaces. For example, product_tag_smudge_free would simply become 'Smudge Free', if we defined the prefix as 'product_tag_'."
                },
                {
                    "type":      "text",
                    "id":        "prefix_tag",
                    "label":     "Tag Prefix",
                    "default":   "product_tag_"
                },
                {
                    "type": 		"header",
                    "content": 		"Important"
                },
                {
                    "type": 	"paragraph",
                    "content": 	"If none of the products from the collection match the tags entered in 'Filter Tags', then this filter will not display."
                }
			]
        }
    ]
}
{% endschema %}