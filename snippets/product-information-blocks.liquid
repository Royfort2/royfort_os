                          assign we_set_card_title = set_product.metafields.custom.we_pdp_addon_card_title.value
                        elsif set_product.title contains 'Kissenbezug' or set_product.title contains 'kissenbezug'
                          assign we_set_card_title = 'Kissenbezug wählen'
                        elsif set_product.title contains 'Spannbettlaken'
                          if block.settings.set_picker_title != blank
                            assign we_set_card_title = block.settings.set_picker_title
                          else
                            assign we_set_card_title = 'Spannbettlaken hinzufügen'
                          endif
                        elsif set_product.title contains 'Matratzenschoner' or set_product.title contains 'matratzenschoner'
                          assign we_set_card_title = 'Matratzenschoner hinzufügen'
                        endif
                        assign we_set_card_title_check = we_set_card_title | downcase
                        unless we_set_card_title_check contains 'hinzufügen' or we_set_card_title_check contains 'wählen'
                          assign we_set_card_title = we_set_card_title | append: ' hinzufügen'
                        endunless
                      -%}
                      <div class="product-set-picker__item">
                        <script type="application/json" data-set-product-variants="{{ set_product.id }}">
                          {{ set_product.variants | json }}
                        </script>
                        <script type="application/json" data-set-default-variant-id="{{ set_product.id }}">
                          {{ we_set_line_resolved.id | json }}
                        </script>
                        <script type="application/json" data-set-product-variant-images="{{ set_product.id }}">
                          {
                          {%- for variant in set_product.variants -%}
                            {%- liquid
                              assign v_thumb = variant.featured_image | default: set_product.featured_image
                            -%}
                            "{{ variant.id }}":{% if v_thumb != blank %}{{ v_thumb | image_url: width: 360 | json }}{% else %}null{% endif %}{%- unless forloop.last -%},{%- endunless -%}
                          {%- endfor -%}
                          }
