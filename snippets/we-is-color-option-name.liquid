{% comment %}
  Outputs 1 when an option label is the storefront color option (any supported locale), else 0.
  Accepts: option_name {String}
{% endcomment %}
{%- liquid
  assign on = option_name | downcase | strip
  assign is_color = false
  assign we_builtin_color_triggers = 'farbe,color,colour,couleur,kleur,colore,cor,farve,färg,farg,kolor,hinta,szín,väri,barva,culoare,renk,farge'
  if settings.color_swatch_trigger != blank
    assign we_color_trigger_csv = settings.color_swatch_trigger | append: ',' | append: we_builtin_color_triggers
  else
    assign we_color_trigger_csv = we_builtin_color_triggers
  endif
  assign we_color_trigger_list = we_color_trigger_csv | downcase | split: ','
  for trigger in we_color_trigger_list
    assign tr = trigger | strip
    if tr != blank and on == tr
      assign is_color = true
      break
    endif
  endfor
-%}{%- if is_color -%}1{%- else -%}0{%- endif -%}
