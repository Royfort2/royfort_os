{% comment %}
  Outputs one variant id (digits): first available variant matching color_variant's color
  option value, or the first variant of that color if none are available.

  Parameters:
  - product: {Object}
  - color_variant: {Variant} Any variant representing the target color (typically the first of that color).
{% endcomment %}
{%- liquid
  assign fallback_id = color_variant.id
  assign color_option_index = nil
  capture we_color_idx_raw
    render 'we-product-color-option-index', product: product
  endcapture
  assign we_color_idx_raw = we_color_idx_raw | strip
  if we_color_idx_raw != blank
    assign color_option_index = we_color_idx_raw | plus: 0
  endif
-%}
{%- if color_option_index == nil -%}
  {{- fallback_id -}}
{%- else -%}
  {%- assign color_value = color_variant.options[color_option_index] -%}
  {%- assign matched_id = nil -%}
  {%- for v in product.variants -%}
    {%- if v.options[color_option_index] == color_value and v.available -%}
      {%- assign matched_id = v.id -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if matched_id == nil -%}
    {%- for v in product.variants -%}
      {%- if v.options[color_option_index] == color_value -%}
        {%- assign matched_id = v.id -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if matched_id == nil -%}
    {{- fallback_id -}}
  {%- else -%}
    {{- matched_id -}}
  {%- endif -%}
{%- endif -%}
