<nav id="site-navigation">
    <ul class="first-level">
    {% for block in blocks %}
    {% case block.type %}
    {% when 'top_level' %}

        <li class="first-level-listing{%if block.settings.submenu != blank %} has-children{% endif %}">
            <a class="title-font" href="{{block.settings.first_level_url}}">{{block.settings.title}} {% render 'icon-chevron-down' %}</a>

            {% if block.settings.submenu != blank %}
                <div class="site-navigation-megamenu {{block.settings.title | handleize}}">
                    <div class="hero-overlay">
                        {% render 'Star_Asset_White' %}
                    </div>
                    <div class="left-menu">
                        <p class="main-title-dropdown-menu">{{ block.settings.menu_title }}</p>
                        <ul class="second-level my-3">
                            <li class="mobile-navigation-header">
                                <span class="mobile-navigate-back"><svg class="icon icon-arrow-left" viewBox="0 0 16 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.59077 6.07471e-05L7.60197 1.07405L2.73958 6.23836L16 6.23836L16 7.76176L2.73958 7.76176L7.60197 12.9261L6.59077 14.0001L3.0598e-07 7.00006L6.59077 6.07471e-05Z" /></svg></span>
                                <span class="mobile-navigation-title"></span>
                            </li>
                            {% for second_level in linklists[block.settings.submenu].links %}
                                <li class="second-level-listing{% if second_level.links != blank%} has-children{% endif %}{% if second_level.active %} current{% endif %}">
                                    {% assign parts = second_level.title | split: "||" %}
                                    {% assign secondLevelTitle = parts[0] %}
                                    <a href="{{ second_level.url }}" class="text-small">
                                        {{ secondLevelTitle }}
                                        {% if parts[1] %}<span class="nav-description">{{ parts[1] }}</span>{% endif %}
                                        {% if parts[2] %}<span class="nav-label">{{ parts[2] }}</span>{% endif %}
                                         {% render 'icon-chevron-down' %}
                                    </a>

                                    {% if second_level.links != blank %}
                                        <ul class="third-level">
                                            <li class="mobile-navigation-header">
                                                <span class="mobile-navigate-back"><svg class="icon icon-arrow-left" viewBox="0 0 16 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.59077 6.07471e-05L7.60197 1.07405L2.73958 6.23836L16 6.23836L16 7.76176L2.73958 7.76176L7.60197 12.9261L6.59077 14.0001L3.0598e-07 7.00006L6.59077 6.07471e-05Z" /></svg></span>
                                                <span class="mobile-navigation-title"></span>
                                            </li>
                                            <li class="third-level-listing"><a href="{{second_level.url}}">All {{second_level.title}}</a></li>
                                            {% for third_level in second_level.links %}
                                            <li class="third-level-listing{% if third_level.links != blank %} has-children{% endif %}{% if third_level.active %} current{% endif %}">
                                                <a href="{{third_level.url}}">
                                                    {{ third_level.title }}
                                                    {% if third_level.links != blank %}
                                                    <svg class="icon icon-chevron-right" viewBox="0 0 6 10" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.20339 10L0 8.74558L3.60169 5L0 1.25442L1.20339 0L6 5L1.20339 10Z" /></svg>
                                                    {% endif %}
                                                </a>
                                                {% if third_level.links != blank %}
                                                {% assign secondLevelCount = second_level.links.size %}
                                                {% assign thirdLevelCount = third_level.links.size | plus: 1%}
                                                {% if thirdLevelCount > secondLevelCount %}
                                                    {% assign linksPerColumn = 6 %}
                                                {% else %}
                                                    {% assign linksPerColumn = secondLevelCount %}
                                                {% endif %}
                                                {% if third_level.links.size > linksPerColumn %}
                                                    {% assign menuClass = ' two-column' %}
                                                {% else %}
                                                    {% assign menuClass = '' %}
                                                {% endif %}
                                                <ul class="fourth-level{{menuClass}}">
                                                    <li class="mobile-navigation-header">
                                                        <span class="mobile-navigate-back"><svg class="icon icon-arrow-left" viewBox="0 0 16 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.59077 6.07471e-05L7.60197 1.07405L2.73958 6.23836L16 6.23836L16 7.76176L2.73958 7.76176L7.60197 12.9261L6.59077 14.0001L3.0598e-07 7.00006L6.59077 6.07471e-05Z" /></svg></span>
                                                        <span class="mobile-navigation-title"></span>
                                                    </li>
                                                    <li class="fourth-level-listing"><a href="{{third_level.url}}">All {{third_level.title}}</a></li>
                                                    {% for fourth_level in third_level.links %}
                                                    <li class="fourth-level-listing{% if fourth_level.active %} current{% endif %}">
                                                        <a href="{{fourth_level.url}}">{{fourth_level.title}}</a>
                                                    </li>
                                                    {% endfor %}
                                                </ul>
                                                {% endif %}

                                            </li>
                                            {% endfor %}
                                        </ul><!-- third-level-->
                                    {% endif %}
                                </li><!-- second-level-listing-->
                            {% endfor %}
                        </ul><!-- second-level -->
                        {% if block.settings.menu_link_button and block.settings.menu_title_button %}
                            <a href="{{ block.settings.menu_link_button }}" class="btn btn-primary">{{ block.settings.menu_title_button }}</a>
                        {% endif %}
                    </div>
                    {% if block.settings.display_featured_menu != blank %}
                        <div class="navigation-featured-menu">
                            <a href="{{block.settings.featured_menu_link}}">
                                <img src="{{ 'empty-image.gif' | asset_img_url: '1x' }}" data-image-path="{{block.settings.image | img_url: '320x'}}" class="img-fluid" data-image-path="" title="{{block.settings.image.alt}}">
                                <span class="featured-menu-title title-font">{{block.settings.featured_menu_title}}</span>
                                {% if block.settings.featured_menu_cta != blank %}
                                <span class="featured-menu-cta">{{block.settings.featured_menu_cta}}</span>
                                {% endif %}
                            </a>
                        </div><!-- site-navigation-featured-menu -->
                    {% endif %}
                    {% if block.settings.display_featured_menu_2 != blank %}
                        <div class="navigation-featured-menu">
                            <a href="{{block.settings.featured_menu_link_2}}">
                                <img src="{{ 'empty-image.gif' | asset_img_url: '1x' }}" data-image-path="{{block.settings.image_2 | img_url: '320x'}}" class="img-fluid" data-image-path="" title="{{block.settings.image_2.alt}}">
                                <span class="featured-menu-title title-font">{{block.settings.featured_menu_title_2}}</span>
                                {% if block.settings.featured_menu_cta != blank %}
                                <span class="featured-menu-cta">{{block.settings.featured_menu_cta_2}}</span>
                                {% endif %}
                            </a>
                        </div><!-- site-navigation-featured-menu -->
                    {% endif %}
                </div>
            {% endif %}
        </li><!-- top-level-listing -->

    {% endcase %}
    {% endfor %}
    </ul>
    {% if settings.hide_account_icons == false %}
    <ul id="mobile-navigation-account">
        {% if customer %}
            <li><a href="/account"> {{ 'customer.account.account' | t }}</a></li>
        {% else %}
            <li><a href="/account"> {{ 'customer.account.sign_in' | t }}</a></li>
        {% endif %}
    </ul>
    {% endif %}
</nav>
