{%- comment -%}
  Stock status label (in-stock / presale / out-of-stock) for PDP variant picker blocks.
  Optional metafield syntax: "farbe | Text" (e.g. orange | Pre-Sale – Versand in 4–6 Wochen).
  Colors: rot/red, orange/presale (default), grün/green/instock.

  Resolution order:
  - Single product: product label → product delivery time → default
  - Set product: set parent label → main set line label → set parent delivery time → main line delivery time → default

  Accepts:
  - product: {Object} PDP product (set parent or single product)
  - fallback_product: {Object} optional — first pdp_set_products entry for set bundles
  - line_available: {Boolean} whether the current variant line is available
{%- endcomment -%}
{%- liquid
  assign we_instock_msg = 'Vorrätig - Versand am nächsten Werktag.'
  assign we_stock_modifier = ''
  assign we_stock_resolved = false

  assign we_primary_stock_label = product.metafields.custom.we_pdp_stock_status_label.value | strip
  assign we_fallback_stock_label = ''
  if fallback_product != blank
    assign we_fallback_stock_label = fallback_product.metafields.custom.we_pdp_stock_status_label.value | strip
  endif

  if we_primary_stock_label != blank
    assign we_stock_label_to_parse = we_primary_stock_label
    assign we_stock_resolved = true
  elsif we_fallback_stock_label != blank
    assign we_stock_label_to_parse = we_fallback_stock_label
    assign we_stock_resolved = true
  endif
-%}
{%- if we_stock_resolved -%}
  {%- capture we_stock_parse_result -%}
    {%- render 'we-pdp-stock-status-parse-label', stock_label: we_stock_label_to_parse -%}
  {%- endcapture -%}
  {%- assign we_stock_parse_parts = we_stock_parse_result | split: '||WE_STOCK||' -%}
  {%- assign we_instock_msg = we_stock_parse_parts[0] -%}
  {%- assign we_stock_modifier = we_stock_parse_parts[1] -%}
{%- else -%}
  {%- liquid
    assign we_delivery_time = product.metafields.custom.we_pdp_estimated_delivery_time.value
    if we_delivery_time == blank and fallback_product != blank
      assign we_delivery_time = fallback_product.metafields.custom.we_pdp_estimated_delivery_time.value
    endif

    if we_delivery_time != blank
      assign we_delivery_lower = we_delivery_time | downcase
      assign we_is_presale = false
      if we_delivery_lower contains 'woche' or we_delivery_lower contains 'week' or we_delivery_lower contains 'maß' or we_delivery_lower contains 'tagen'
        assign we_is_presale = true
      endif
      if we_is_presale
        assign we_instock_msg = 'Maßanfertigung - Lieferzeit: ' | append: we_delivery_time
        assign we_stock_modifier = ' pdp-set-stock--presale'
      endif
    endif
  -%}
{%- endif -%}
<div
  class="pdp-set-stock pdp-set-stock--instock{{ we_stock_modifier }}"
  data-pdp-set-stock-instock
  {% unless line_available %}
    hidden
  {% endunless %}
>
  <span class="pdp-set-stock__dot" aria-hidden="true"></span>
  <span>{{ we_instock_msg }}</span>
</div>
<div
  class="pdp-set-stock pdp-set-stock--oos"
  data-pdp-set-stock-oos
  {% if line_available %}
    hidden
  {% endif %}
>
  <span class="pdp-set-stock__dot" aria-hidden="true"></span>
  <span>Diese Variante ist ausverkauft. Wählen Sie gerne eine andere Farbe oder Größe.</span>
</div>
