{% comment %}
  Inline quantity as native system <select> (same name/form wiring as former we-select radios).

  Accepts:
  - id_ns, product_form_id, option_position: for unique ids/names
  - pdp_q_min, pdp_q_max, pdp_q_inc: quantity_rule derived numbers
  - pdp_set_bundle_context: when true, uses unique name qty-inline-* and omits form= (cart lines built in product-set-cart-items.js)
{% endcomment %}
{%- liquid
  assign qty_field_name = 'qty-inline-' | append: id_ns
  unless pdp_set_bundle_context
    assign qty_field_name = 'quantity'
  endunless
-%}
<div class="select">
  <select
    id="Quantity-{{ id_ns }}-{{ option_position }}"
    class="form-control form-control--select pdp-inline-qty-native-select"
    name="{{ qty_field_name | escape }}"
    {% unless pdp_set_bundle_context %}
      form="{{ product_form_id }}"
    {% endunless %}
    data-pdp-inline-qty-select
  >
    {%- for i in (1..100) -%}
      {%- if i >= pdp_q_min and i <= pdp_q_max -%}
        {%- assign pdp_mod = i | minus: pdp_q_min | modulo: pdp_q_inc -%}
        {%- if pdp_mod == 0 -%}
          <option
            value="{{ i }}"
            {% if i == pdp_q_min %}
              selected
            {% endif %}
          >
            {{ i }}
          </option>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </select>
  {%- render 'icon-caret-down' -%}
</div>
