<div class="product-listing" data-product-id="{{product.id}}" data-test="{{product.type}}">

  {%comment%}
    BG: We use the below markup to find additional variant images, and create a list with the shade name and image path, we then use JS to append it to the assiocated variant list within the prodct swatch listing
  {% endcomment %}
  {% assign variantShadeImages = shadeImages | split: ','%}
  {% assign variantShadeNames = shadeNames | split: ','%}
  {% if variantShadeNames != blank %}
    <div class="variant-shades d-none">
      <ul>
        {% for shade in variantShadeNames %}
          <li data-variant-name="{{shade}}" data-variant-image="{{ variantShadeImages[forloop.index0] }}"></li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
  <div class="product-image {{imageHover}}">
           <a href="{{ product.url }}" 
          onclick="trackSelectItem({
          item_id: '{{product.selected_or_first_available_variant.sku}}',
          item_name: '{{product.title}}',
          affiliation: '{{shop.name}}',
          currency: '{{ shop.currency }}',
          index: {{ index }},
          item_brand: '{{shop.name}}', 
          item_category   : '{{collection.title}}',
          item_variant    : '{{product.selected_or_first_available_variant.title}}',
          price           : {{product.price | money_without_currency | remove: "," }},
          image_url       : 'https:{{product.featured_image.src|img_url: 'grande'}}', 
          stock           : {{product.selected_or_first_available_variant.inventory_quantity}},
          item_product_id : '{{product.id}}',
          item_shopify_id : 'shopify_' + '{{request.locale.iso_code | upcase}}' + '_' + '{{product.id}}' + '_' + '{{product.selected_or_first_available_variant.id}}',
          item_variant_id : '{{product.selected_or_first_available_variant.id}}',
          quantity        : 1
          })">
      <img class="img-fluid lazyload default" data-src="{{ product.featured_image.src | img_url: '365x' }}" {% if imageHover == "product-image-hover" %}data-second-image="{{ product.images[1].src | img_url: 'master' }}"{% endif %} alt="{{ product.title }}" width="600" heigh="600">
      {% if labelLeftContent != blank  %}
        <span class="label-left {{labelLeftClass}}">
          <span class="clamp">{{labelLeftContent}}</span>
        </span>
      {% endif %}
      {% if labelRightContent != blank %}
        <span class="label-right {{labelRightClass}}">{{labelRightContent}}</span>
      {% endif %}
    </a>
  </div>
  <!-- product-image -->
  <div class="product-details">

    <p class="product-title text-secondary text-left">
      <a class="" href="{{ product.url }}" title="{{ product.title }}">{{ product.title }}</a>
    </p>
    {% render 'product-min-swatch' with product as product %}
    {% if product.metafields.global["offer"] != blank %}
      <span class="product-offer-text" title="{{product.metafields.global["offer"]}}">{{product.metafields.global["offer"] | truncatewords: 10}}</span>
    {% endif %}
    {% assign additional_price = product.metafields.bundle.price %}
    {% assign discount_price = product.metafields.bundle.discountedprice %}
    <div class="product-price-container">
      {% if additional_price != blank %}
        <div class="">
          {% if discount_price != blank %}
            {% if product.price_varies %}
              <span class="additional-money-new-style money">{{'products.product.from_price' | t}}</span>
            {% endif %}
            <span class="additional-money-new-style money" style="text-decoration: line-through">{{ cart.currency.symbol | strip }} {{ additional_price | strip }}</span>
            <span class="original-price money " style="text-decoration: unset">{{ cart.currency.symbol | strip }} {{discount_price | strip }}</span>
          {% else %}
            {% if product.price_varies %}
              <span class="additional-money-new-style money">{{'products.product.from_price' | t}}</span>
            {% endif %}
            <span class="additional-money-new-style money">{{ cart.currency.symbol | strip }} {{ additional_price | strip }}</span>
          {% endif %}
        </div>
        <!-- product-price -->
        <span class="price-per-ml">{{ product.metafields.global["price_per"] }}</span>
      {% else %}
        <div class="">
          {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
            <span class="money ">
              {% if product.price_varies %}
                {{'products.product.from_price' | t}}
              {% endif %}
              {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
                <span style="text-decoration: line-through">
                  {{product.selected_or_first_available_variant.compare_at_price | money }}
                </span>
              {% endif %}
              <span class="original-price money " style="text-decoration: unset;">
                {{ product.selected_or_first_available_variant.price | money }}</span>

            </span>
          {%- else -%}


            <span class="money ">
              {% if product.price_varies %}
                {{'products.product.from_price' | t}}
              {% endif %}
              {{ product.selected_or_first_available_variant.price | money }}</span>
            <span class="original-price money ">
              {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
                {{product.selected_or_first_available_variant.compare_at_price | money }}{% endif %}
            </span>

          {% endif %}
        </div>
        <!-- product-price -->
        <span class="price-per-ml">{{ product.metafields.global["price_per"] }}</span>
      {% endif %}

    </div>
    <!-- product-price-container -->

    {% comment %}
      BG: Due to limitations with the mbcBundle app, we have to remove the product actions on the PLP.
    {% endcomment %}

  </div>
  <!-- product-details -->
</div>
