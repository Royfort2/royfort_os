<div id="footer-columns">
    <div class="container-fluid">
        <div id="footer-links-mobile" class="row">
            <ul class="footer-links-parent footer-links-contact col-lg visible-mobile">
                <li class="d-flex footer-logo title-font">{% render 'footer_logo' %}</li>
                <li class="d-flex footer-social title-font">
                    {% if section.settings.footer_facebook_link != blank %}
                        <a target="_blank" href="{{section.settings.footer_facebook_link}}">
                            {% render 'Facebook' %}
                        </a>
                    {% endif %}
                    {% if section.settings.footer_insta_link != blank %}
                        <a target="_blank" href="{{section.settings.footer_insta_link}}">
                            {% render 'Instagram' %}
                        </a>
                    {% endif %}
                    {% if section.settings.footer_pinterest_link != blank %}
                        <a target="_blank" href="{{section.settings.footer_pinterest_link}}">
                            {% render 'Pinterest' %}
                        </a>
                    {% endif %}
                </li>
                <li class="d-flex footer-contact title-font">
                    {% if section.settings.phone_number != blank %}
                        <span class="contact-item">{{ section.settings.phone_number }}</span>
                    {% endif %}
                    {% if settings.hide_contact_banner == false %}
                        <span class="contact-item">{% render 'Contact_chat' %} {{ settings.social_chat }}</span>
                    {% endif %}
                </li>
            </ul>
            {% for block in section.blocks %}
            {% case block.type %}
            {% when 'desktop_menu' %}

                <ul class="footer-links-parent footer-links-menu col-lg{% if block.settings.show_on_mobilenavigation %} visible-mobile{% endif %}">
                    <li>
                        <details open>
                            <summary class="footer-link-title title-font">
                                {{ block.settings.title}}
                            </summary>

                            <ul class="footer-links-child">
                                {%- assign footer_linklist = block.settings.menu -%}
                                {% for link in linklists[footer_linklist].links %}
                                    <li class="footer-links-listing"><a href="{{ link.url }}">{{ link.title }}</a></li>
                                {% endfor %}
                            </ul>
                        </details>
                    </li>
                </ul>


            {% endcase %}
            {% endfor %}
            <ul class="footer-links-parent footer-newsletter col-lg visible-mobile">
                {% if section.settings.footer_newsletter_form %}

                    {% if settings.newsletter_klaviyo != blank %}

                        {%- comment %}
                        <li class="footer-link-title title-font">{{'general.newsletter_form.title' | t}}</li>
                        <li class="newsletter-form-description">{{'general.newsletter_form.description' | t}}</li>
                        {% endcomment -%}
                        <li>

                            <div class="klaviyo-form-{{ settings.newsletter_klaviyo }}"></div>

                            {%- comment %}
                            {% if settings.newsletter_terms != blank %}
                            <div class="gdpr-text">
                            {{ settings.newsletter_terms }}
                            </div>
                            {% endif %}
                            {% endcomment -%}

                            {%- comment %}
                            <form name="UK-CUST-ShopifyNewsletterSignUp" class="elq-form d-flex" id="form114" action="" method="POST">
                                <input type="hidden" name="elqFormName" value="UK-CUST-ShopifyNewsletterSignUp">
                                <input name="elqSiteId" type="hidden" value="">
                                <input type="hidden" name="elqCustomerGUID" value="">
                                <input type="hidden" name="elqCookieWrite" value="0">
                                <input name="elqCampaignId" type="hidden">

                                <div class="d-flex w-full">
                                    <input type="email" name="emailAddress" class="elq-item-input grey text-small" id="fe915" placeholder="{{'general.newsletter_form.placeholder' | t}}" required>
                                    <button type="submit" class="btn btn-grey text-small">{{'general.newsletter_form.submit' | t }}</button>
                                </div>

                                <input name="hiddenField" id="fe921" type="hidden" value="United Kingdom">
                                <input name="hiddenField2" id="fe923" type="hidden" value="Shopify SignUp">
                            </form>
                            {% endcomment -%}

                        </li>
                    {% endif %}

                {% endif %}
            </ul>
        </div><!-- row -->
    </div><!-- container-fluid-->
</div><!-- footer-columns -->
<div id="footer-copy">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-lg mb-3 mb-lg-0 text-center text-md-left footer-copyright-container">
                <p class="site-copyright">&copy; {{ 'now' | date: "%Y" }} Royfort</p>
            </div>
            <div class="col-lg mb-3 mb-lg-0 footer-payment-icons-container">
                <ul class="footer-payment-icons  d-flex-center">
                    {% for block in section.blocks %}
                        {% if block.type == 'payment_icon' %}
                            <li title="{{ block.settings.title }}"><img width="40" src="{{ block.settings.image | img_url: 'master' }}"></li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
            <div class="col-lg mb-3 mb-lg-0 text-center text-md-left text-lg-right footer-copyright-container">
                <!-- <p class="site-copyright">Shopify by Velstar</p> -->
            </div>
        </div>
    </div>
</div>
{% schema %}
{
    "name": "Footer",
    "tag": "footer",
    "class": "site-footer",
    "settings": [
        {
            "type": "header",
            "content": "Social Links"
        },
        {
            "type":     "url",
            "id":       "footer_facebook_link",
            "label":    "Facebook Link"
        },
        {
            "type":     "url",
            "id":       "footer_insta_link",
            "label":    "Instagram Link"
        },
        {
            "type":     "url",
            "id":       "footer_pinterest_link",
            "label":    "Pinterest Link"
        },
        {
            "type": "header",
            "content": "Newsletter"
        },
        {
            "type":      "checkbox",
            "id":        "footer_newsletter_form",
            "label":     "Show Klaviyo Form",
            "info":      "Requires API Key below",
            "default":   true
        },
        {
            "type": "checkbox",
            "id": "show_phonedetails",
            "label": "Show phone details",
            "default": true
        },
        {
            "type": "header",
            "content": "Phone Number"
        },
        {
            "type":     "richtext",
            "id":       "phone_number",
            "label":    "Phone Number",
            "default":    "<p>+49 / (0) 30 2332 7430</p>"
        }
    ],
    "blocks": [
        {
            "type": "desktop_menu",
            "name": "Desktop Footer Menu",
            "limit": 4,
            "settings": [
                {
                    "type": "paragraph",
                    "content": "Menu will only appear on the desktop footer. You can include it within the mobile menu with the checkbox below."
                },
                {
                    "type":		"text",
                    "id":     "title",
                    "label":  "Menu Title"
                },
                {
                    "type": 	"link_list",
                    "id": 		"menu",
                    "label": 	"Menu"
                },
                {
                    "type": "header",
                    "content": "Mobile Menu"
                },
                {
                    "type": "paragraph",
                    "content": "If the below option is checked, this navigation will appear on the mobile menu."
                },
                {
                    "type": "checkbox",
                    "id": "show_on_mobilenavigation",
                    "label": "Show on mobile navigation?",
                    "default": false
                }
            ]
        },
        {
            "type": "payment_icon",
            "name": "Payment Icon",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Payment Icon"
                },
                {
                    "type": "text",
                    "id": "title",
                    "label": "Payment Title"
                }
            ]
        }
    ]
}
{% endschema %}
