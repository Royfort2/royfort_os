{% comment %}
  Outputs the 0-based color option index for a product, or nothing if none found.
  Accepts: product {Object}
{% endcomment %}
{%- for option in product.options_with_values -%}
  {%- capture we_is_color_option -%}
    {%- render 'we-is-color-option-name', option_name: option.name -%}
  {%- endcapture -%}
  {%- if we_is_color_option == '1' -%}
    {{- forloop.index0 -}}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
