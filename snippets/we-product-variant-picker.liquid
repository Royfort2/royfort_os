{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  - update_url: {Boolean} whether or not to update url when changing variants. If false, the url isn't updated. Default: true (optional).
  - picker_id_suffix: {String} optional; defaults to product.id — used for id_ns (unique radio name/id; matches product-variant-picker).
  - pdp_set_line_variant_from_bundle: {Object} optional — first set line variant matching bundle ?variant= (set PDP / quick view).
  Usage:
  {% render 'we-product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
{%- unless product.has_only_default_variant -%}
  {% liquid
    assign picker_id_suffix = picker_id_suffix | default: product.id
    assign id_ns = section.id | append: '-' | append: picker_id_suffix
    assign we_active_variant = product.selected_variant
    if pdp_set_line_variant_from_bundle != blank
      assign we_active_variant = pdp_set_line_variant_from_bundle
    elsif we_active_variant == blank
      assign we_active_variant = product.selected_or_first_available_variant
    endif
    assign we_use_bundle_line_variant = false
    if pdp_set_line_variant_from_bundle != blank
      assign we_use_bundle_line_variant = true
    endif
    assign size_option_name = block.settings.size_title | downcase
    assign size_chart_content = product.metafields.foxtheme.size_chart.value.content
    assign size_chart_modal_id = 'SizeChartModal-' | append: block.id | append: '-' | append: picker_id_suffix

    if size_chart_content == blank and block.settings.size_chart_from_page != blank
      assign size_chart_content = pages[block.settings.size_chart_from_page].content
    endif

    assign qty_unit_short = settings.qty_selector_unit_short | default: 'St.'
    assign qty_unit_long = settings.qty_selector_unit_long | default: 'Stück'

    assign pdp_qty_anchor_position = blank
    for opt in product.options_with_values
      assign od = opt.name | downcase | strip
      assign is_color_by_trigger = false
      if settings.color_swatch_trigger != blank
        assign tr = settings.color_swatch_trigger | downcase | split: ','
        assign hit = tr | where: od | first
        if hit != blank
          assign is_color_by_trigger = true
        elsif od contains 'colour'
          assign tr2 = settings.color_swatch_trigger | replace: 'color', 'colour' | downcase | split: ','
          assign hit2 = tr2 | where: od | first
          if hit2 != blank
            assign is_color_by_trigger = true
          endif
        endif
      endif
      unless is_color_by_trigger
        assign pdp_qty_anchor_position = opt.position
        break
      endunless
    endfor
    if pdp_qty_anchor_position == blank
      assign pdp_qty_anchor_position = product.options_with_values.first.position
    endif

    assign pdp_ov_for_url = ''
    if request.query_string contains 'option_values='
      assign pdp_ov_for_url = request.query_string | split: 'option_values=' | last | split: '&' | first | strip
    endif
    assign pdp_qty_selector_pending = false
    if block.settings.picker_type == 'custom_dropdown' and product.has_only_default_variant == false
      assign pdp_qty_selector_pending = true
      if pdp_ov_for_url != blank
        assign pdp_qty_selector_pending = false
      elsif request.query_string contains 'variant='
        assign pdp_qty_selector_pending = false
      endif
    endif
    assign pdp_set_line_ui_pending = false
    if pdp_set_line_variant_from_bundle != blank
      assign pdp_set_line_ui_pending = true
      if pdp_ov_for_url != blank
        assign pdp_set_line_ui_pending = false
      elsif request.query_string contains 'variant='
        assign pdp_set_line_ui_pending = false
      endif
    endif

    assign line_color_option_index = 0
    if settings.color_swatch_trigger != blank
      assign trigger_list_cc = settings.color_swatch_trigger | downcase | split: ','
      for option in product.options_with_values
        assign opt_name_cc = option.name | downcase | strip
        assign matched_cc = false
        for trigger in trigger_list_cc
          assign tr_cc = trigger | strip
          if opt_name_cc == tr_cc
            assign line_color_option_index = option.position
            assign matched_cc = true
            break
          endif
        endfor
        if matched_cc
          break
        endif
      endfor
    endif
  %}
  <script src="{{ 'variant-selects.js' | asset_url }}" defer="defer"></script>
  <variant-selects
    id="variant-selects-{{ id_ns }}"
    data-section="{{ section.id }}"
    data-url="{{ product.url }}"
    data-product-id="{{ product.id }}"
    data-line-color-option-position="{{ line_color_option_index }}"
    data-selected-variant-id="{% if we_active_variant %}{{ we_active_variant.id }}{% endif %}"
    data-update-url="{% if update_url == false %}false{% else %}true{% endif %}"
    data-we-dropdown-meta="true"
    data-we-low-stock-threshold="{{ block.settings.dropdown_low_inventory_threshold | default: 5 }}"
    data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
  >
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign option_name_downcase = option.name | downcase
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type

        assign attach_size_chart = false
        if size_option_name contains option_name_downcase
          assign attach_size_chart = true
        endif

        if block.settings.picker_type == 'button' or block.settings.picker_type == 'custom_dropdown'
          if settings.color_swatch_trigger != blank
            assign color_swatch_trigger = settings.color_swatch_trigger | downcase | split: ','
            assign has_color = color_swatch_trigger | where: option_name_downcase | first
            unless block.settings.swatch_type == 'text'
              if has_color != blank
                assign picker_type = 'color'
              elsif option_name_downcase contains 'colour'
                assign color_swatch_trigger = color_swatch_trigger | replace: 'color', 'colour'
                assign has_color = color_swatch_trigger | where: option_name_downcase | first
                if has_color != blank
                  assign picker_type = 'color'
                endif
              endif
            endunless
          endif
        endif

        if swatch_count > 0
          if block.settings.picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          else
            if block.settings.swatch_type == 'shopify_swatch'
              assign picker_type = 'swatch'
            elsif block.settings.swatch_type == 'variant_image' or block.settings.swatch_type == 'color_swatch'
              assign picker_type = 'color'
            else
              assign picker_type = 'button'
            endif
          endif
        endif

        assign wrap_class = 'product-form__input product-form__input--' | append: picker_type
        case picker_type
          when 'swatch', 'color', 'button'
            assign is_fieldset_tag = true
            assign wrap_class = wrap_class | append: ' js flex flex-wrap'
            assign button_style = block.settings.button_style | default: 'standard'

            if picker_type == 'button' or picker_type == 'custom_dropdown'
              assign wrap_class = wrap_class | append: ' gap-3'
              assign wrap_class = wrap_class | append: ' product-form__input--button-' | append: button_style
            else
              assign wrap_class = wrap_class | append: ' gap-4'
              assign wrap_class = wrap_class | append: ' product-form__input--button-' | append: button_style
            endif
          else
            assign is_fieldset_tag = false
        endcase

        assign tag_fieldset = 'fieldset'
        assign tag_legend = 'legend'
        unless is_fieldset_tag
          assign tag_fieldset = 'div'
          assign tag_legend = 'label'
        endunless

        assign is_color_swatch_picker = false
        if picker_type == 'swatch' or picker_type == 'color'
          assign is_color_swatch_picker = true
        elsif picker_type == 'button' and settings.color_swatch_trigger != blank
          assign cst_w = settings.color_swatch_trigger | downcase | split: ','
          assign has_cw = cst_w | where: option_name_downcase | first
          if has_cw != blank
            assign is_color_swatch_picker = true
          elsif option_name_downcase contains 'colour'
            assign cst_w = settings.color_swatch_trigger | replace: 'color', 'colour' | downcase | split: ','
            assign has_cw = cst_w | where: option_name_downcase | first
            if has_cw != blank
              assign is_color_swatch_picker = true
            endif
          endif
        endif

        assign is_pdp_qty_option = false
        if option.position == pdp_qty_anchor_position
          assign is_pdp_qty_option = true
        endif

        assign we_option_skip_selected = false
        if is_pdp_qty_option and pdp_qty_selector_pending
          assign we_option_skip_selected = true
        endif
        if pdp_qty_selector_pending and is_color_swatch_picker == false
          assign we_option_skip_selected = true
        endif
        if pdp_set_line_ui_pending and is_color_swatch_picker == false
          assign we_option_skip_selected = true
        endif

        assign show_selected_value_in_label = false
        if picker_type == 'swatch' or picker_type == 'color' or picker_type == 'button'
          assign show_selected_value_in_label = true
        endif

        assign we_select_variant_suffix = block.settings.select_variant_text | strip
        if we_select_variant_suffix != blank
          assign we_placeholder_select_variant_label = we_select_variant_suffix
        else
          assign we_placeholder_select_variant_label = 'Auswählen'
        endif
      -%}
      <{{ tag_fieldset }}
        class="{{ wrap_class }}"
        {% if picker_type == 'color' %}
          data-swatch-type="{{ block.settings.swatch_type }}"
        {% endif %}
        style="--swatch-size: {{ block.settings.button_size | default: '40px' }}px;"
      >
        <{{ tag_legend }}
          {% unless is_fieldset_tag %}
            for="Option-{{ id_ns }}-{{ forloop.index0 }}"
          {% endunless %}
          class="form__label"
        >
          <div class="flex flex-wrap gap-2">
            <span class="option-name">{{ option.name }}:</span>
            {%- if show_selected_value_in_label -%}
              <span data-selected-swatch-value="{{ option.name }}">
                {%- if is_pdp_qty_option and pdp_qty_selector_pending -%}
                  {{- we_placeholder_select_variant_label -}}
                {%- elsif pdp_qty_selector_pending and is_color_swatch_picker == false -%}
                  {{- we_placeholder_select_variant_label -}}
                {%- elsif pdp_set_line_ui_pending and is_color_swatch_picker == false -%}
                  {{- we_placeholder_select_variant_label -}}
                {%- elsif we_use_bundle_line_variant -%}
                  {%- liquid
                    case option.position
                      when 1
                        echo we_active_variant.option1
                      when 2
                        echo we_active_variant.option2
                      when 3
                        echo we_active_variant.option3
                    endcase
                  -%}
                {%- else -%}
                  {%- liquid
                    assign we_opt_show = option.selected_value
                    case option.position
                      when 1
                        assign we_opt_show = we_active_variant.option1
                      when 2
                        assign we_opt_show = we_active_variant.option2
                      when 3
                        assign we_opt_show = we_active_variant.option3
                    endcase
                  -%}
                  {{- we_opt_show -}}
                {%- endif -%}
              </span>
            {%- endif -%}
          </div>
          {%- if size_chart_content != blank and attach_size_chart -%}
            <button
              class="open-size-chart no-js-hidden btn--link tracking-normal"
              aria-controls="{{ size_chart_modal_id }}"
              aria-haspopup="dialog"
            >
              {{ 'products.product.open_size_chart' | t }}
            </button>
          {%- endif -%}
        </{{ tag_legend }}>
        {%- case picker_type -%}
          {%- when 'swatch', 'color', 'button' -%}
            {% if picker_type == 'color' or picker_type == 'swatch' %}
              <div class="variant-options">
            {% endif %}
            {% render 'product-variant-options',
              product: product,
              option: option,
              block: block,
              picker_type: picker_type,
              option_id_namespace: id_ns,
              skip_value_selected: we_option_skip_selected,
              pdp_line_variant_for_selection: we_active_variant,
              we_override_option_selection: we_use_bundle_line_variant
            %}
            {% if picker_type == 'color' or picker_type == 'swatch' %}
              </div>
            {% endif %}
          {%- else -%}
            {% comment %}
              <div class="select">
                {%- if picker_type == 'swatch_dropdown' -%}
                  <span
                    data-selected-value
                    class="dropdown-swatch"
                  >
                    {% render 'swatch', swatch: option.selected_value.swatch %}
                  </span>
                {%- endif -%}
                <select
                  id="Option-{{ id_ns }}-{{ forloop.index0 }}"
                  class="form-control form-control--select"
                  name="options[{{ option.name | escape }}]"
                  form="{{ product_form_id }}"
                >
                  {% render 'product-variant-options',
                    product: product,
                    option: option,
                    block: block,
                    picker_type: picker_type,
                    option_id_namespace: id_ns
                  %}
                </select>
                {%- render 'icon-caret-down' -%}
              </div>
            {% endcomment %}
            {%- liquid
              assign opt_radio_name = 'vs-' | append: id_ns | append: '-o' | append: option.position
            -%}
            <div class="we-variant-picker__dropdown-container">
              <details
                class="we-select-container {% if is_pdp_qty_option and pdp_qty_selector_pending %} we-select-container--placeholder{% elsif pdp_qty_selector_pending and is_color_swatch_picker == false %} we-select-container--placeholder{% elsif pdp_set_line_ui_pending and is_color_swatch_picker == false %} we-select-container--placeholder{% endif %}"
                data-radio-group-name="{{ opt_radio_name | escape }}"
                data-we-option-position="{{ option.position }}"
              >
                <summary class="we-select-container__summary">
                  {% if is_pdp_qty_option and pdp_qty_selector_pending %}
                    <span class="we-select-placeholder-label">{{ we_placeholder_select_variant_label }}</span>
                  {% elsif pdp_qty_selector_pending and is_color_swatch_picker == false %}
                    <span class="we-select-placeholder-label">{{ we_placeholder_select_variant_label }}</span>
                  {% elsif pdp_set_line_ui_pending and is_color_swatch_picker == false %}
                    <span class="we-select-placeholder-label">{{ we_placeholder_select_variant_label }}</span>
                  {% else %}
                    {%- liquid
                      assign we_dd_show = option.selected_value
                      case option.position
                        when 1
                          assign we_dd_show = we_active_variant.option1
                        when 2
                          assign we_dd_show = we_active_variant.option2
                        when 3
                          assign we_dd_show = we_active_variant.option3
                      endcase
                    -%}
                    {{ we_dd_show }}
                  {% endif %}
                </summary>
                <div class="we-select-mobile-portal">
                  <div class="we-select-mobile-backdrop" aria-hidden="true"></div>
                  <div class="we-select-mobile-sheet">
                    <div class="we-select-mobile-sheet__header">
                      <p
                        class="we-select-mobile-sheet__title"
                        id="WeSelectSheetTitle-{{ id_ns }}-{{ option.position }}"
                      >
                        {{ 'products.product.we_select_sheet_title' | t: option_name: option.name }}
                      </p>
                      <button
                        type="button"
                        class="we-select-mobile-sheet__close"
                        aria-label="{{ 'accessibility.close' | t }}"
                      >
                        {% render 'icon-close', size: 'small' %}
                      </button>
                    </div>
                    <div class="we-select">
                      {% for value in option.values %}
                        {%- liquid
                          assign we_dd_checked = false
                          if we_option_skip_selected == false
                            if we_use_bundle_line_variant
                              case option.position
                                when 1
                                  if value == we_active_variant.option1
                                    assign we_dd_checked = true
                                  endif
                                when 2
                                  if value == we_active_variant.option2
                                    assign we_dd_checked = true
                                  endif
                                when 3
                                  if value == we_active_variant.option3
                                    assign we_dd_checked = true
                                  endif
                              endcase
                            elsif value.selected
                              assign we_dd_checked = true
                            endif
                          endif
                        -%}
                        <div class="we-select__item">
                          <input
                            type="radio"
                            id="{{ id_ns }}-{{ option.position }}-{{ forloop.index0 }}"
                            name="{{ opt_radio_name | escape }}"
                            value="{{ value | escape }}"
                            form="{{ product_form_id }}"
                            data-product-url="{{ value.product_url }}"
                            data-option-value-id="{{ value.id }}"
                            {% if we_dd_checked %}
                              checked
                            {% endif %}
                            {% if value.available == false %}
                              class="disabled"
                            {% endif %}
                          >
                          <label
                            class="we-select__label we-select__label--with-meta"
                            for="{{ id_ns }}-{{ option.position }}-{{ forloop.index0 }}"
                          >
                            <span class="we-select__label-primary">
                              <span class="we-select__value-text">{{ value }}</span>
                            </span>
                            <span class="we-select__meta" hidden>
                              <span class="we-select__price-block"></span>
                              <span
                                class="we-select__stock-marker"
                                data-stock-level=""
                                aria-hidden="true"
                              ></span>
                            </span>
                          </label>
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                </div>
              </details>
              {% if is_pdp_qty_option %}
                <div
                  class="we-quantity-selector"
                  data-qty-unit-short="{{ qty_unit_short | escape }}"
                >
                  <details
                    class="we-select-container"
                    data-radio-group-name="quantity-{{ product.id }}"
                  >
                    <summary class="we-select-container__summary">
                      1&nbsp;{{ qty_unit_short }}
                    </summary>
                    <div class="we-select-mobile-portal">
                      <div class="we-select-mobile-backdrop" aria-hidden="true"></div>
                      <div class="we-select-mobile-sheet">
                        <div class="we-select-mobile-sheet__header">
                          <p
                            class="we-select-mobile-sheet__title"
                            id="WeSelectSheetTitle-{{ product.id }}-quantity"
                          >
                            {{ 'products.product.quantity.label' | t }}
                          </p>
                          <button
                            type="button"
                            class="we-select-mobile-sheet__close"
                            aria-label="{{ 'accessibility.close' | t }}"
                          >
                            {% render 'icon-close', size: 'small' %}
                          </button>
                        </div>
                        <div class="we-select">
                          {% for i in (1..10) %}
                            <div class="we-select__item">
                              <input
                                type="radio"
                                id="quantity-{{ product.id }}-{{ forloop.index0 }}"
                                name="quantity-{{ product.id }}"
                                value="{{ i }}"
                                data-we-qty-selector
                              >
                              <label
                                class="we-select__label we-select__label--qty"
                                for="quantity-{{ product.id }}-{{ forloop.index0 }}"
                              >
                                <span class="we-select__label-primary">
                                  <span class="we-select__qty-line we-select__qty-line--short"
                                    >{{ i }}&nbsp;{{ qty_unit_short -}}
                                  </span>
                                  <span class="we-select__qty-line we-select__qty-line--long"
                                    >{{ i }}&nbsp;{{ qty_unit_long -}}
                                  </span>
                                </span>
                              </label>
                            </div>
                          {% endfor %}
                        </div>
                      </div>  
                    </div>
                  </details>
                </div>
              {% endif %}
            </div>
        {%- endcase -%}
      </{{ tag_fieldset }}>
    {%- endfor -%}
    <script type="application/json" data-selected-variant>
      {%- if pdp_qty_selector_pending or pdp_set_line_ui_pending -%}
        null
      {%- else -%}
        {{- we_active_variant | json -}}
      {%- endif -%}
    </script>
    {%- if pdp_qty_selector_pending or pdp_set_line_ui_pending -%}
      <script type="application/json" data-pdp-bootstrap-variant>
        {{- product.selected_or_first_available_variant | json -}}
      </script>
    {%- endif -%}
  </variant-selects>
  {%- if size_chart_content != blank -%}
    <div id="SizeChart-{{ id_ns }}">
      <basic-modal id="{{ size_chart_modal_id }}" class="drawer modal" style="--modal-width: 77rem;">
        <div class="fixed-overlay" aria-controls="{{ size_chart_modal_id }}"></div>
        <div class="drawer__inner">
          <button
            class="drawer__close-btn"
            aria-controls="{{ size_chart_modal_id }}"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {% render 'icon-close' %}
          </button>
          <div class="drawer__body v-scrollable h-full rte">
            {{ size_chart_content }}
          </div>
        </div>
      </basic-modal>
    </div>
  {%- endif -%}
{%- endunless -%}
