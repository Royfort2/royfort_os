{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  - update_url: {Boolean} whether or not to update url when changing variants. If false, the url isn't updated. Default: true (optional).
  - picker_id_suffix: {String} optional; defaults to product.id — used for id_ns (unique radio name/id; matches product-variant-picker).
  - pdp_set_line_variant_from_bundle: {Object} optional — first set line variant matching bundle ?variant= (set PDP / quick view).
  - pdp_set_bundle_context: {Boolean} when true, inline quantity uses qty-inline-* radios (set bundle embedded pickers).
  Usage:
  {% render 'we-product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
{%- unless product.has_only_default_variant -%}
  {% liquid
    assign picker_id_suffix = picker_id_suffix | default: product.id
    assign id_ns = section.id | append: '-' | append: picker_id_suffix
    assign we_active_variant = product.selected_variant
    capture we_url_vid_raw
      render 'we-variant-id-from-query', product: product
    endcapture
    assign we_url_vid_raw = we_url_vid_raw | strip
    if we_url_vid_raw != blank
      for v in product.variants
        assign v_id_str = v.id | append: ''
        if v_id_str == we_url_vid_raw
          assign we_active_variant = v
          break
        endif
      endfor
    endif
    if we_active_variant == blank
      capture we_active_vid_raw
        render 'we-resolve-variant-id-from-url', product: product
      endcapture
      assign we_active_vid_raw = we_active_vid_raw | strip
      if we_active_vid_raw != blank
        for v in product.variants
          assign v_id_str = v.id | append: ''
          if v_id_str == we_active_vid_raw
            assign we_active_variant = v
            break
          endif
        endfor
      endif
    endif
    if pdp_set_line_variant_from_bundle != blank
      assign we_active_variant = pdp_set_line_variant_from_bundle
    elsif we_active_variant == blank
      assign we_active_variant = product.selected_or_first_available_variant
    endif
    assign we_use_bundle_line_variant = false
    if pdp_set_line_variant_from_bundle != blank
      assign we_use_bundle_line_variant = true
    endif
    assign pdp_set_bundle_context = pdp_set_bundle_context | default: false
    assign pdp_set_addon_card = pdp_set_addon_card | default: false
    assign size_option_name = block.settings.size_title | downcase
    assign size_chart_content = product.metafields.foxtheme.size_chart.value.content
    assign size_chart_modal_id = 'SizeChartModal-' | append: block.id | append: '-' | append: picker_id_suffix

    if size_chart_content == blank and block.settings.size_chart_from_page != blank
      assign size_chart_content = pages[block.settings.size_chart_from_page].content
    endif

    assign we_builtin_color_triggers = 'farbe,color,colour,couleur,kleur,colore,cor,farve,färg,farg,kolor,hinta,szín,väri,barva,culoare,renk'
    if settings.color_swatch_trigger != blank
      assign we_color_trigger_csv = settings.color_swatch_trigger | append: ',' | append: we_builtin_color_triggers
    else
      assign we_color_trigger_csv = we_builtin_color_triggers
    endif
    assign we_color_trigger_list = we_color_trigger_csv | downcase | split: ','

    assign pdp_qty_anchor_position = blank
    for opt in product.options_with_values
      assign od = opt.name | downcase | strip
      assign is_color_by_trigger = false
      for trigger in we_color_trigger_list
        assign tr_hit = trigger | strip
        if tr_hit != blank and od == tr_hit
          assign is_color_by_trigger = true
          break
        endif
      endfor
      unless is_color_by_trigger
        assign pdp_qty_anchor_position = opt.position
        break
      endunless
    endfor
    if pdp_qty_anchor_position == blank
      assign pdp_qty_anchor_position = product.options_with_values.first.position
    endif

    assign we_non_color_dropdown_count = 0
    assign we_pdp_qty_layout = 'none'
    if block.settings.picker_type == 'custom_dropdown'
      for we_count_opt in product.options_with_values
        assign we_count_name = we_count_opt.name | downcase | strip
        assign we_count_is_color = false
        for trigger in we_color_trigger_list
          assign tr_hit = trigger | strip
          if tr_hit != blank and we_count_name == tr_hit
            assign we_count_is_color = true
            break
          endif
        endfor
        unless we_count_is_color
          assign we_non_color_dropdown_count = we_non_color_dropdown_count | plus: 1
        endunless
      endfor
    endif
    if pdp_set_addon_card
      assign we_pdp_qty_layout = 'addon'
    elsif we_non_color_dropdown_count == 1
      assign we_pdp_qty_layout = 'paired'
    elsif we_non_color_dropdown_count >= 2
      assign we_pdp_qty_layout = 'separate'
    endif

    assign line_color_option_index = 0
    for option in product.options_with_values
      assign opt_name_cc = option.name | downcase | strip
      assign matched_cc = false
      for trigger in we_color_trigger_list
        assign tr_cc = trigger | strip
        if tr_cc != blank and opt_name_cc == tr_cc
          assign line_color_option_index = option.position
          assign matched_cc = true
          break
        endif
      endfor
      if matched_cc
        break
      endif
    endfor

    assign we_pas_size_option_position = 0
    if product.metafields.custom.we_pdp_preis_nach_grose == true
      for option in product.options_with_values
        assign we_pas_opt_name = option.name | downcase | strip
        assign we_pas_is_size = false
        if we_pas_opt_name == size_option_name
          assign we_pas_is_size = true
        elsif we_pas_opt_name contains size_option_name
          assign we_pas_is_size = true
        elsif size_option_name contains we_pas_opt_name and we_pas_opt_name != blank
          assign we_pas_is_size = true
        elsif we_pas_opt_name == 'größe' or we_pas_opt_name == 'grose' or we_pas_opt_name == 'size'
          assign we_pas_is_size = true
        endif
        if we_pas_is_size
          assign we_pas_size_option_position = option.position
          break
        endif
      endfor
    endif
  %}
  <script src="{{ 'variant-selects.js' | asset_url }}" defer="defer"></script>
  <variant-selects
    id="variant-selects-{{ id_ns }}"
    data-section="{{ section.id }}"
    data-url="{{ product.url }}"
    data-product-id="{{ product.id }}"
    data-line-color-option-position="{{ line_color_option_index }}"
    {% if we_pas_size_option_position > 0 %}
      data-we-pdp-preis-nach-grose="true"
      data-we-size-option-position="{{ we_pas_size_option_position }}"
    {% endif %}
    data-selected-variant-id="{% if we_active_variant %}{{ we_active_variant.id }}{% endif %}"
    data-update-url="{% if update_url == false %}false{% else %}true{% endif %}"
    data-we-dropdown-meta="true"
    data-we-low-stock-threshold="{{ block.settings.dropdown_low_inventory_threshold | default: 5 }}"
    data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
    {% if pdp_set_addon_card %}
      data-pdp-set-addon-card="true"
    {% endif %}
    {% if we_pdp_qty_layout != 'none' and we_pdp_qty_layout != 'addon' %}
      data-pdp-qty-layout="{{ we_pdp_qty_layout }}"
      data-pdp-qty-anchor-position="{{ pdp_qty_anchor_position }}"
    {% endif %}
  >
    {%- liquid
      assign pdp_set_addon_card = pdp_set_addon_card | default: false
      assign we_color_pos_str = ''
      assign we_other_pos_str = ''
      unless pdp_set_addon_card
        for we_ord_opt in product.options_with_values
          assign we_ord_name = we_ord_opt.name | downcase | strip
          assign we_ord_is_color = false
          for trigger in we_color_trigger_list
            assign tr_hit = trigger | strip
            if tr_hit != blank and we_ord_name == tr_hit
              assign we_ord_is_color = true
              break
            endif
          endfor
          if we_ord_is_color
            assign we_color_pos_str = we_color_pos_str | append: we_ord_opt.position | append: ','
          else
            assign we_other_pos_str = we_other_pos_str | append: we_ord_opt.position | append: ','
          endif
        endfor
      endunless
      if we_color_pos_str == blank and we_other_pos_str == blank
        for we_ord_opt in product.options_with_values
          assign we_other_pos_str = we_other_pos_str | append: we_ord_opt.position | append: ','
        endfor
      endif
      assign we_ordered_option_positions = we_color_pos_str | append: we_other_pos_str | split: ','
    -%}
    {%- for we_pos_token in we_ordered_option_positions -%}
      {%- if we_pos_token == blank -%}
        {%- continue -%}
      {%- endif -%}
      {%- assign we_pos_num = we_pos_token | plus: 0 -%}
      {%- for option in product.options_with_values -%}
        {%- if option.position != we_pos_num -%}
          {%- continue -%}
        {%- endif -%}
      {%- liquid
        assign option_name_downcase = option.name | downcase
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type

        assign attach_size_chart = false
        if size_option_name contains option_name_downcase
          assign attach_size_chart = true
        endif

        if block.settings.picker_type == 'button' or block.settings.picker_type == 'custom_dropdown'
          unless block.settings.swatch_type == 'text'
            for trigger in we_color_trigger_list
              assign tr_hit = trigger | strip
              if tr_hit != blank and option_name_downcase == tr_hit
                assign picker_type = 'color'
                break
              endif
            endfor
          endunless
        endif

        if swatch_count > 0
          if block.settings.picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          else
            if block.settings.swatch_type == 'shopify_swatch'
              assign picker_type = 'swatch'
            elsif block.settings.swatch_type == 'variant_image' or block.settings.swatch_type == 'color_swatch'
              assign picker_type = 'color'
            else
              assign picker_type = 'button'
            endif
          endif
        endif

        if pdp_set_addon_card
          if picker_type == 'color' or picker_type == 'swatch' or picker_type == 'button'
            assign picker_type = 'dropdown'
          endif
        endif

        assign wrap_class = 'product-form__input product-form__input--' | append: picker_type
        case picker_type
          when 'swatch', 'color', 'button'
            assign is_fieldset_tag = true
            assign button_style = block.settings.button_style | default: 'standard'

            if picker_type == 'color' or picker_type == 'swatch'
              assign wrap_class = wrap_class | append: ' js'
              assign wrap_class = wrap_class | append: ' product-form__input--button-' | append: button_style
            else
              assign wrap_class = wrap_class | append: ' js flex flex-wrap gap-3'
              assign wrap_class = wrap_class | append: ' product-form__input--button-' | append: button_style
            endif
          else
            assign is_fieldset_tag = false
        endcase

        assign tag_fieldset = 'fieldset'
        assign tag_legend = 'legend'
        unless is_fieldset_tag
          assign tag_fieldset = 'div'
          assign tag_legend = 'label'
        endunless

        assign is_color_swatch_picker = false
        if picker_type == 'swatch' or picker_type == 'color'
          assign is_color_swatch_picker = true
        elsif picker_type == 'button'
          for trigger in we_color_trigger_list
            assign tr_hit = trigger | strip
            if tr_hit != blank and option_name_downcase == tr_hit
              assign is_color_swatch_picker = true
              break
            endif
          endfor
        endif

        assign show_selected_value_in_label = false
        if picker_type == 'swatch' or picker_type == 'color' or picker_type == 'button'
          assign show_selected_value_in_label = true
        endif
      -%}
      <{{ tag_fieldset }}
        class="{{ wrap_class }}"
        {% if picker_type == 'color' %}
          data-swatch-type="{{ block.settings.swatch_type }}"
        {% endif %}
        style="--swatch-size: {{ block.settings.button_size | default: '40px' }}px;"
      >
        <{{ tag_legend }}
          {% unless is_fieldset_tag %}
            for="Option-{{ id_ns }}-{{ forloop.index0 }}"
          {% endunless %}
          class="form__label"
        >
          <div class="flex flex-wrap gap-2">
            <span class="option-name">{{ option.name }}:</span>
            {%- if show_selected_value_in_label -%}
              <span data-selected-swatch-value="{{ option.name }}">
                {%- liquid
                  case option.position
                    when 1
                      assign we_opt_show = we_active_variant.option1
                    when 2
                      assign we_opt_show = we_active_variant.option2
                    when 3
                      assign we_opt_show = we_active_variant.option3
                  endcase
                -%}
                {{- we_opt_show -}}
              </span>
            {%- endif -%}
          </div>
          {%- if size_chart_content != blank and attach_size_chart -%}
            <button
              class="open-size-chart no-js-hidden btn--link tracking-normal"
              aria-controls="{{ size_chart_modal_id }}"
              aria-haspopup="dialog"
            >
              {{ 'products.product.open_size_chart' | t }}
            </button>
          {%- endif -%}
        </{{ tag_legend }}>
        {%- case picker_type -%}
          {%- when 'swatch', 'color', 'button' -%}
            {% if picker_type == 'color' or picker_type == 'swatch' %}
              <div class="variant-options">
            {% endif %}
            {% render 'product-variant-options',
              product: product,
              option: option,
              block: block,
              picker_type: picker_type,
              option_id_namespace: id_ns,
              pdp_line_variant_for_selection: we_active_variant,
              we_override_option_selection: true,
              pdp_allow_sold_out_selection: pdp_set_addon_card
            %}
            {% if picker_type == 'color' or picker_type == 'swatch' %}
              </div>
            {% endif %}
          {%- else -%}
            <div class="select">
              <select
                id="Option-{{ id_ns }}-{{ option.position }}"
                class="form-control form-control--select"
                name="options[{{ option.name | escape }}]"
                form="{{ product_form_id }}"
                data-we-option-position="{{ option.position }}"
              >
                {% render 'product-variant-options',
                  product: product,
                  option: option,
                  block: block,
                  picker_type: 'dropdown',
                  option_id_namespace: id_ns,
                  pdp_line_variant_for_selection: we_active_variant,
                  we_override_option_selection: true,
                  pdp_allow_sold_out_selection: pdp_set_addon_card
                %}
              </select>
              {%- render 'icon-caret-down' -%}
            </div>
        {%- endcase -%}
      </{{ tag_fieldset }}>
      {%- if we_pdp_qty_layout == 'paired' and option.position == pdp_qty_anchor_position -%}
        {%- liquid
          assign pdp_qr = we_active_variant.quantity_rule
          assign pdp_q_min = pdp_qr.min | default: 1
          if pdp_q_min < 1
            assign pdp_q_min = 1
          endif
          assign pdp_q_max = pdp_qr.max | default: 10
          if pdp_q_max == blank or pdp_q_max == 0
            assign pdp_q_max = 10
          endif
          if pdp_q_max > 10
            assign pdp_q_max = 10
          endif
          if pdp_q_max < pdp_q_min
            assign pdp_q_max = pdp_q_min
          endif
          assign pdp_q_inc = pdp_qr.increment | default: 1
          if pdp_q_inc < 1
            assign pdp_q_inc = 1
          endif
        -%}
        <div class="product-form__input product-form__input--quantity pdp-we-main-qty pdp-we-main-qty--paired">
          <label class="form__label">
            <span class="option-name">{{ 'products.product.quantity.label' | t }}:</span>
          </label>
          <div class="pdp-inline-quantity pdp-we-main-qty__select">
            {% render 'pdp-inline-quantity-we-select',
              id_ns: id_ns,
              product_form_id: product_form_id,
              option_position: 'qty',
              pdp_q_min: pdp_q_min,
              pdp_q_max: pdp_q_max,
              pdp_q_inc: pdp_q_inc,
              pdp_set_bundle_context: pdp_set_bundle_context
            %}
          </div>
        </div>
      {%- endif -%}
        {%- break -%}
      {%- endfor -%}
    {%- endfor -%}
    {%- if we_pdp_qty_layout == 'separate' -%}
      {%- liquid
        assign pdp_qr = we_active_variant.quantity_rule
        assign pdp_q_min = pdp_qr.min | default: 1
        if pdp_q_min < 1
          assign pdp_q_min = 1
        endif
        assign pdp_q_max = pdp_qr.max | default: 10
        if pdp_q_max == blank or pdp_q_max == 0
          assign pdp_q_max = 10
        endif
        if pdp_q_max > 10
          assign pdp_q_max = 10
        endif
        if pdp_q_max < pdp_q_min
          assign pdp_q_max = pdp_q_min
        endif
        assign pdp_q_inc = pdp_qr.increment | default: 1
        if pdp_q_inc < 1
          assign pdp_q_inc = 1
        endif
      -%}
      <div class="product-form__input product-form__input--quantity pdp-we-main-qty pdp-we-main-qty--separate">
        <label class="form__label">
          <span class="option-name">{{ 'products.product.quantity.label' | t }}:</span>
        </label>
        <div class="pdp-inline-quantity pdp-we-main-qty__select">
          {% render 'pdp-inline-quantity-we-select',
            id_ns: id_ns,
            product_form_id: product_form_id,
            option_position: 'qty',
            pdp_q_min: pdp_q_min,
            pdp_q_max: pdp_q_max,
            pdp_q_inc: pdp_q_inc,
            pdp_set_bundle_context: pdp_set_bundle_context
          %}
        </div>
      </div>
    {%- endif -%}
    {%- if pdp_set_addon_card -%}
      <div class="product-form__input product-form__input--quantity pdp-set-addon-qty">
        <label class="form__label visually-hidden" for="AddonQty-{{ id_ns }}">
          {{ 'products.product.quantity.label' | t }}
        </label>
        <div class="we-quantity-selector">
          <div class="select">
            <select
              id="AddonQty-{{ id_ns }}"
              class="form-control form-control--select"
              name="quantity-{{ product.id }}"
              data-we-qty-selector
            >
              {% for i in (1..10) %}
                <option
                  value="{{ i }}"
                  {% if forloop.first %}
                    selected
                  {% endif %}
                >
                  {{ i }}
                </option>
              {% endfor %}
            </select>
            {%- render 'icon-caret-down' -%}
          </div>
        </div>
      </div>
      <div
        class="pdp-set-addon-oos-msg pdp-set-stock pdp-set-stock--oos"
        data-pdp-set-addon-oos-msg
        hidden
      >
        <span class="pdp-set-stock__dot" aria-hidden="true"></span>
        <span>Diese Variante ist ausverkauft. Wählen Sie gerne eine andere Farbe oder Größe.</span>
      </div>
      <button
        type="button"
        class="btn btn--secondary pdp-set-addon-bis"
        data-pdp-set-addon-bis
        hidden
      >
        Senden Sie mir eine E-Mail
      </button>
    {%- endif -%}
    <script type="application/json" data-selected-variant>
      {{- we_active_variant | json -}}
    </script>
  </variant-selects>
  {%- if size_chart_content != blank -%}
    <div id="SizeChart-{{ id_ns }}">
      <basic-modal id="{{ size_chart_modal_id }}" class="drawer modal" style="--modal-width: 77rem;">
        <div class="fixed-overlay" aria-controls="{{ size_chart_modal_id }}"></div>
        <div class="drawer__inner">
          <button
            class="drawer__close-btn"
            aria-controls="{{ size_chart_modal_id }}"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {% render 'icon-close' %}
          </button>
          <div class="drawer__body v-scrollable h-full rte">
            {{ size_chart_content }}
          </div>
        </div>
      </basic-modal>
    </div>
  {%- endif -%}
{%- endunless -%}
