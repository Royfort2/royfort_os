<div class="section-background usp-desktop">
    <div class="{{section.settings.usp_section_container}}" style="background-color:{{section.settings.usp_section_container_bg}};">
    <h2 style="color:{{section.settings.usp_title_main_color}};" class="text-title text-center">{{ section.settings.usp_title_main }}</h2>
    <div class="site-usp-container {% if section.settings.usp_block_slide == true %} inline-slick{% endif %} {{section.settings.usp_icon_placement}}" data-slick='{"slidesToShow": 1, "slidesToScroll": 1, "dots":false, "arrows":false, "adaptiveHeight": true, "autoplay":{{section.settings.usp_block_autoplay}}, "autoplaySpeed": {{section.settings.usp_block_speed}}0, "mobileFirst": true, "responsive":[{"breakpoint": 767,"settings":{"slidesToShow": 4, "slidesToScroll": 1 }}]}'>
    {% for block in section.blocks %}
    {% case block.type %}
    {% when 'site_usp' %}
        <div class="usp-item {{section.settings.usp_icon_placement}}">
            {% if block.settings.usp_link != blank %}
            <a href="{{block.settings.usp_link}}" title="{{block.settings.title}}">
            {% endif %}
            <div class="usp-icon">
                <div class="fixed-ratio square">
                    <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ block.settings.image | img_url: 'master' }}" class="lazyload" alt="{{block.settings.title}}" />
                </div><!-- fixed-ratio square -->
            </div><!-- usp-icon-->
            <div class="usp-content">
                <h3 style="color:{{section.settings.usp_content_color}};" class="text-bold-600 text-18 mb-3">{{block.settings.title}}</h3>
                {% if block.settings.richtext != blank %}<div class="rte text-small text-secondary text-12" >{{block.settings.richtext}}</div>{% endif %}
            </div><!-- usp-content -->
            {% if block.settings.usp_link != blank %}
            </a>
            {% endif %}
        </div><!-- usp-item -->
    {% endcase %}
    {% endfor %}
    </div><!-- site-usp-container-->
</div><!-- container -->
</div><!-- section-background-->

<div class="section-background usp-mobile">
{% if section.settings.usp_title_main != "blank" %}
    <h2 class="text-center my-5 text-23 text-secondary">{{ section.settings.usp_title_main }}</h2>
    {% endif %}
    <div class="accordion-container">
        {% for block in section.blocks %}
        {% case block.type %}
        {% when 'site_usp' %}

        <div class="accordion-parent" style="background-color:{{section.settings.usp_section_container_bg}};"
            data-group="shared-usp">
            <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
                data-src="{{ block.settings.image | img_url: 'master' }}" class="lazyload"
                alt="{{block.settings.title}}" />
            <div class="accordion-item" data-group="shared-usp">
                <div class="accordion-title" data-group="shared-usp">
                    <h3>{{block.settings.title}}</h3>
                    <span class="icon-plusminus"></span>
                </div><!-- accordion-title -->
                <div class="accordion-content" data-group="shared-usp">
                    <div class="rte">
                        {{block.settings.richtext}}
                    </div>
                </div><!-- accordion-content -->
            </div><!-- accordion-item -->
        </div>

        {% endcase %}
        {% endfor %}
    </div><!-- accordion-container -->
</div>

{% schema %}
{
    "name": "Site USP",
    "tag": "div",
    "class": "site-usp usp-accordion",
    "settings": [
        {
            "type": "header",
            "content": "Layout / Appearance"
        },
        {
            "type": "paragraph",
            "content": "Choose whether or not this section will be full width, or contained to the guttering of the website."
        },
        {
            "type":      "select",
            "id":        "usp_section_container",
            "label":     "Container",
            "options": [
                {
                    "value": "container-full",
                    "label": "Full Width"
                },
                {
                    "value": "container-fluid",
                    "label": "Contained"
                }
                ],
                "default":   "container-full"
        },
        {
            "type": "color",
            "id": "usp_section_container_bg",
            "label": "Background Colour",
            "default": "#FDF7FA"
        },
        {
            "type": "text",
            "id": "usp_title_main",
            "label": "Main Title"
        },
        {
            "type": "color",
            "id": "usp_title_main_color",
            "label": "Title Colour",
            "default": "#000000"
        },
        {
            "type": "color",
            "id": "usp_content_color",
            "label": "USP Text Color",
            "default": "#000000"
        },
        {
            "type":      "select",
            "id":        "usp_icon_placement",
            "label":     "Icon Placement",
            "options": [
                {
                    "value": "icon-above",
                    "label": "Icon above text"
                },
                {
                    "value": "icon-inline",
                    "label": "Icon inline with text"
                },
                {
                    "value": "icon-inline-slim",
                    "label": "Icon inline with just title"
                }
                ],
                "default":   "icon-above"
        },
        {
            "type": "header",
            "content": "Mobile Carousel"
        },
        {
            "type": "checkbox",
            "id": "usp_block_slide",
            "label": "Apply Carousel to the blocks?",
            "default": true,
            "info": "if unchecked, the content will simply stack upon each other."
        },
        {
            "type": "checkbox",
            "id": "usp_block_autoplay",
            "label": "Autoplay Carousel?",
            "default": true,
            "info": "Automatically scroll through blocks?"
        },
        {
            "type": "range",
            "id": "usp_block_speed",
            "label": "Autoplay Speed",
            "min": 150,
            "max": 2000,
            "step": 50,
            "default": 500,
            "info": "100 = 1 Second"
        }
	],
    "blocks": [
        {
            "type": "site_usp",
            "name": "USP",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Icon"
                },
                {
                    "type":      "text",
                    "id":        "title",
                    "label":     "Title"
                },
                {
                    "type":      "richtext",
                    "id":        "richtext",
                    "label":     "Content"
                },
                {
                    "id": "usp_link",
                    "type": "url",
                    "label": "USP Link",
                    "info": "Optional link"
                }
            ]
        }
	],
	"presets": [
    {
      "name": "Site USP",
      "category": "Images"
    }
  ]

}
{% endschema %}
