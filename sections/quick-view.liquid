{%- liquid
  # Show the first product when it is not a product page.
  if request.page_type != 'product' and request.design_mode
    assign collection_all = collections.all
    assign product = collection_all.products | first
  endif
-%}
{%- if product != blank -%}
  {%- liquid
    assign media_layout = 'vertical-carousel'
    assign mobile_thumbnails = 'hide'
    assign enable_image_zoom = false

    assign we_qv_mf = product.metafields.custom.we_temp_product_media.value
    assign we_qv_media_count = product.media.size
    if settings.use_metafield_media and we_qv_mf != blank and we_qv_mf.size > 0
      assign we_qv_media_count = we_qv_mf.size
      if we_qv_media_count > 180
        assign we_qv_media_count = 180
      endif
    endif

    assign product_class = 'product--' | append: section.settings.media_size
    assign product_class = product_class | append: ' product--' | append: media_layout
    assign product_class = product_class | append: ' product--media-has-' | append: we_qv_media_count
    if we_qv_media_count > 1
      assign product_class = product_class | append: ' product--media-has-many'
    endif
  -%}
  <quick-view-modal
    id="MainProductQuickView-{{ section.id }}-{{ product.id }}"
    class="quick-view drawer drawer--right"
    data-product-url="{{ product.url }}"
    shopify-design-mode
    hidden
  >
    {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
    {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
    {% unless product.has_only_default_variant %}
      {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {% endunless %}
    <div class="fixed-overlay" aria-controls="MainProductQuickView-{{ section.id }}-{{ product.id }}"></div>
    <div class="drawer__inner">
      <button
        class="drawer__close-btn"
        aria-label="{{ 'accessibility.close' | t }}"
        aria-controls="MainProductQuickView-{{ section.id }}-{{ product.id }}"
      >
        {% render 'icon-close' %}
      </button>
      <div class="drawer__body v-scrollable h-full quick-view__content">
        <template id="MainProduct-quick-view__content">
          {{ 'we-details-select.css' | asset_url | stylesheet_tag }}
          {% style %}
            .quick-view__product-heading {
              flex: 0 0 auto;
              width: 100%;
              padding: 0;
            }
            .quick-view__product-heading .product__blocks {
              display: flex;
              flex-direction: column;
            }
            .quick-view__product-heading .product__block {
              margin-block: 0 !important;
            }
            .quick-view__product-heading .product__block--title {
              margin: 0 !important;
            }
            .quick-view__product-heading .product__block--price {
              margin: 0 !important;
            }
            .product-form__input:not(:first-child) {
              margin-top: 1.2rem !important;
            }
            .product__block--we_variant_picker .product-form__input > label,
            .product__block--we_variant_picker .product-form__input > .form__label {
              font-size: 1.4rem;
              font-style: normal;
              font-weight: 400;
              line-height: 130%;
              text-transform: uppercase;
              margin-bottom: 0.6rem !important;
            }
            .product__block--we_variant_picker .variant-options__row:has(.swatch-color) {
              display: grid;
              grid-template-columns: repeat(8, 1fr);
              gap: 0.6rem;
              width: 100%;
            }
            .product__block--we_variant_picker > variant-selects:not([data-pdp-set-addon-card]) .product-form__input--color .swatch-color,
            .product__block--we_variant_picker > variant-selects:not([data-pdp-set-addon-card]) .product-form__input--swatch .swatch-color {
              width: 3.2rem !important;
              height: 3.2rem !important;
              min-width: 3.2rem !important;
              min-height: 3.2rem !important;
              border-radius: 50% !important;
              border: 0.1rem solid #b3b3b3;
              padding: 0.2rem;
              box-sizing: border-box;
            }
            .product-form__input--color .swatch-color:before,
            .product-form__input--swatch .swatch-color:before {
              content: none !important;
            }
            .product-form__input--color input[type='radio']:checked + label .swatch-color:after,
            .product-form__input--swatch input[type='radio']:checked + label .swatch-color:after {
              box-shadow: 0px 0px 0px 0.1rem var(--active-shadow-color) !important;
            }
            .product__block--we_variant_picker .product-form__input .option-name {
              color: #525252;
            }
            .product__block--we_variant_picker {
              display: flex;
              flex-direction: column;
              gap: 2rem;
            }
            .product__block--we_variant_picker > variant-selects:not([data-pdp-set-addon-card]),
            .product__block--variant_picker > variant-selects:not([data-pdp-set-addon-card]) {
              display: flex;
              flex-wrap: wrap;
              margin-inline: -0.5rem;
              width: calc(100% + 1rem);
            }
            .product__block--we_variant_picker > variant-selects:not([data-pdp-set-addon-card]) > .product-form__input,
            .product__block--variant_picker > variant-selects:not([data-pdp-set-addon-card]) > .product-form__input {
              flex: 1 1 35%;
              min-width: 35%;
              padding-inline: 0.5rem;
              margin-top: 0 !important;
              margin-bottom: 1rem !important;
              box-sizing: border-box;
            }
            .product__block--we_variant_picker > variant-selects:not([data-pdp-set-addon-card]) > .product-form__input--color,
            .product__block--we_variant_picker > variant-selects:not([data-pdp-set-addon-card]) > .product-form__input--swatch,
            .product__block--variant_picker > variant-selects:not([data-pdp-set-addon-card]) > .product-form__input--color,
            .product__block--variant_picker > variant-selects:not([data-pdp-set-addon-card]) > .product-form__input--swatch {
              flex: 1 1 100%;
              min-width: 100%;
            }
            .product__block--we_variant_picker > variant-selects:not([data-pdp-set-addon-card]) > .product-form__input--quantity.pdp-we-main-qty--separate,
            .product__block--variant_picker > variant-selects:not([data-pdp-set-addon-card]) > .product-form__input--quantity.pdp-we-main-qty--separate {
              flex: 1 1 100%;
              min-width: 100%;
            }
            .product__block--we_variant_picker > variant-selects:not([data-pdp-set-addon-card]) .we-variant-picker__dropdown-container,
            .product__block--variant_picker > variant-selects:not([data-pdp-set-addon-card]) .we-variant-picker__dropdown-container {
              display: block;
              width: 100%;
            }
            .product__block--we_variant_picker > variant-selects:not([data-pdp-set-addon-card]) > .product-form__input--quantity .pdp-inline-quantity,
            .product__block--variant_picker > variant-selects:not([data-pdp-set-addon-card]) > .product-form__input--quantity .pdp-inline-quantity {
              flex: none;
              width: 100%;
              min-width: 0;
              max-width: none;
            }
            .product__block--we_variant_picker:has(details.we-select-container[open]) {
              position: relative;
              z-index: 25;
            }
            .product__block--we_variant_picker:has(.pdp-inline-quantity details.we-select-container[open]) {
              position: relative;
              z-index: 25;
            }
            .pdp-variant-qty-row:has(details.we-select-container[open]) {
              overflow: visible;
            }
            .pdp-variant-qty-row {
              display: flex;
              flex-direction: row;
              align-items: stretch;
              gap: 0.6rem;
              width: 100%;
            }
            .pdp-variant-qty-row__picker {
              flex: 1;
              min-width: 0;
            }
            .pdp-inline-quantity {
              flex: 0 0 8rem;
              align-self: stretch;
              box-sizing: border-box;
              width: 8rem;
              min-width: 8rem;
              max-width: 8rem;
              overflow: visible;
            }
            .pdp-inline-quantity:has(details.we-select-container[open]) {
              overflow: visible;
              z-index: 26;
            }
            .product-set-picker__expand-inner .pdp-inline-quantity,
            .product-set-picker__card .pdp-inline-quantity {
              contain: none;
            }
            .pdp-inline-quantity .pdp-inline-qty-we-select.we-select-container {
              width: 100%;
              display: inline-block;
            }
            .product-set-picker__accordion {
              margin-top: 0;
              border: none;
            }
            .product-set-picker__accordion .accordion-details__summary {
              padding-block: 0 0.6rem;
            }
            .product-set-picker__heading {
              margin: 0;
              font-size: 1.4rem;
              font-style: normal;
              font-weight: 400;
              line-height: 150%;
              letter-spacing: -0.14px;
              text-transform: uppercase;
            }
            .product-set-picker__list {
              padding-block-end: 0.8rem;
              padding-inline: 0;
            }
            .product__info-container .product__blocks:has(.product-set-picker__accordion) {
              overflow: visible;
            }
            .product-set-picker__item {
              margin-block-end: 0.4rem;
            }
            .product-set-picker__item:last-child {
              margin-block-end: 0;
            }
            .product-set-picker__card {
              display: flex;
              flex-direction: column;
              align-items: stretch;
              width: 100%;
              margin: 0;
              border: 0.1rem solid rgb(var(--color-border));
              border-radius: 0.2rem;
              background: rgb(var(--color-background));
              overflow: visible;
            }
            .product-set-picker__card-row {
              display: flex;
              flex-direction: row;
              align-items: center;
              gap: 1.2rem;
              width: 100%;
              margin: 0;
              padding: 1.2rem;
              cursor: pointer;
              text-align: start;
            }
            .product-set-picker__thumb {
              flex-shrink: 0;
              aspect-ratio: 4 / 5;
              max-height: 6rem;
              display: flex;
              align-items: center;
              justify-content: center;
              overflow: hidden;
              background: rgb(var(--color-foreground) / 0.04);
            }
            .product-set-picker__thumb-img {
              width: 100%;
              height: 100%;
              object-fit: cover;
            }
            .product-set-picker__thumb-placeholder {
              display: block;
              width: 100%;
              height: 100%;
              background: rgb(var(--color-foreground) / 0.06);
            }
            .product-set-picker__info {
              flex: 1;
              min-width: 0;
              display: flex;
              flex-direction: column;
            }
            .product-set-picker__title {
              font-size: 1.4rem;
              font-weight: 400;
              line-height: 150%;
              letter-spacing: -0.14px;
              text-transform: uppercase;
              color: rgb(var(--color-foreground));
            }
            .product-set-picker__price {
              line-height: 1.2;
            }
            .product-set-picker__price .f-price {
              font-size: 1.4rem;
              font-weight: 400;
              text-transform: uppercase;
              letter-spacing: -0.35px;
            }
            .product-set-picker__price .f-price-item--regular {
              color: rgb(var(--color-button));
            }
            .product-set-picker__checkbox-ui {
              flex-shrink: 0;
              width: 2.4rem;
              height: 2.4rem;
              border: 0.1rem solid rgb(var(--color-border));
              border-radius: 0.2rem;
              display: inline-flex;
              align-items: center;
              justify-content: center;
              transition: background-color var(--animation-default), border-color var(--animation-default);
            }
            .product-set-picker__card:has(.product-set-picker__toggle:checked) .product-set-picker__checkbox-ui {
              background-color: rgb(var(--color-foreground));
              border-color: rgb(var(--color-foreground));
            }
            .product-set-picker__card:has(.product-set-picker__toggle:checked) .product-set-picker__checkbox-ui::after {
              content: '';
              width: 1rem;
              height: 0.55rem;
              border: 0 solid rgb(var(--color-background));
              border-inline-start-width: 0.15rem;
              border-block-end-width: 0.15rem;
              transform: rotate(-45deg) translate(0.05rem, -0.05rem);
            }
            .product-set-picker__expand {
              display: grid;
              grid-template-rows: 0fr;
              width: 100%;
              box-sizing: border-box;
              transition: grid-template-rows 0.35s cubic-bezier(0.3, 1, 0.3, 1);
            }
            .product-set-picker__card:has(.product-set-picker__toggle:checked) .product-set-picker__expand {
              grid-template-rows: 1fr;
              overflow: visible;
            }
            .product-set-picker__expand-inner {
              min-height: 0;
              overflow: hidden;
              padding-inline: 1.2rem;
              box-sizing: border-box;
            }
            .product-set-picker__expand-inner variant-selects {
              padding-block-end: 1.2rem;
            }
            .product-set-picker__card:has(.product-set-picker__toggle:checked) .product-set-picker__expand-inner {
              overflow: visible;
            }
            .product-set-picker__card:has(.product-set-picker__toggle:checked) {
              position: relative;
              z-index: 2;
            }
            .product-set-picker__card:has(.product-set-picker__toggle:checked):has(details.we-select-container[open]) {
              z-index: 20;
            }
            .product-set-picker__card.product-set-picker__card--options-visible .product-set-picker__expand {
              grid-template-rows: 1fr;
              overflow: visible;
            }
            .product-set-picker__card.product-set-picker__card--options-visible .product-set-picker__expand-inner {
              overflow: visible;
              padding-block-end: 0;
            }
            .product-set-picker__card.product-set-picker__card--options-visible .product-set-picker__expand-inner variant-selects {
              padding-block-end: 0;
            }
            .product-set-picker__card-row + .product-set-picker__expand .product-set-picker__expand-inner .product-form__input:first-child {
              margin-top: 0 !important;
            }

            /* Gallery: main swipe horizontal, vertical 4:5 thumbs on the right */
            .quick-view .product__media-gallery {
              position: relative;
            }
            .quick-view .product--vertical-carousel {
              --thumbnails-width: 5.6rem;
              --thumbnails-spacing: 0.4rem;
            }
            @media (min-width: 768px) {
              .quick-view .product--vertical-carousel {
                --thumbnails-width: 6.4rem;
                --thumbnails-spacing: 0.6rem;
              }
            }
            @media (min-width: 1024px) {
              .quick-view .product--vertical-carousel {
                --thumbnails-spacing: 0.6rem;
                --thumbnails-width: 7.2rem;
              }
            }
            @media (min-width: 1280px) {
              .quick-view .product--vertical-carousel {
                --thumbnails-width: 7.2rem;
              }
            }
            .quick-view .product--vertical-carousel.product--media-has-many .product__media-gallery-viewer-wrap {
              margin-inline-start: 0;
              margin-inline-end: calc(var(--thumbnails-width) + var(--thumbnails-spacing));
            }
            /* Global vertical-carousel layout is md+ only; quick view needs the same at all widths. */
            .quick-view .product--vertical-carousel.product--media-has-many .product__media-gallery-thumbails {
              position: absolute;
              top: 0;
              inset-inline-start: auto;
              inset-inline-end: 0;
              width: var(--thumbnails-width);
              height: 100%;
              margin: 0;
            }
            .quick-view .product--vertical-carousel.product--media-has-many .product__media-gallery-thumbails .swiper-wrapper {
              flex-direction: column;
            }
            .quick-view .product--vertical-carousel.product--media-has-many .product__media-gallery-thumbails .swiper-slide {
              width: 100%;
              max-width: 100%;
              box-sizing: border-box;
              height: auto !important;
              margin-inline-end: 0;
              margin-bottom: var(--media-item-gap);
            }
            .quick-view .product--vertical-carousel .product__media-gallery-thumbails.swiper {
              overflow: hidden;
            }
            .quick-view .product--vertical-carousel .product__media-item {
              width: 100% !important;
              max-width: 100%;
            }
            @media (max-width: 767.98px) {
              .quick-view .product--vertical-carousel.product--media-has-many .product__media-gallery-viewer-wrap {
                margin-inline-end: 0;
              }
            }
            .quick-view .product--vertical-carousel .product__media-gallery-viewer-wrap,
            .quick-view .product--vertical-carousel .product__media-gallery-viewer.swiper {
              max-width: 100%;
            }
            .quick-view .product--vertical-carousel .product__media-gallery-viewer,
            .quick-view .product--vertical-carousel .product__media-container {
              border-radius: 0;
            }
            .quick-view .product--vertical-carousel .product__thumbs-container {
              border-radius: 0;
            }
            .quick-view .product--vertical-carousel .product__media-gallery-thumbails .swiper-slide.swiper-slide-thumb-active .product__thumbs-container {
              padding: 0;
            }

            /* Sticky footer: primary ATC + full-details link (see product-information-blocks quick-view sticky bar) */
            .quick-view .product__info-container {
              flex: 1 1 auto;
              min-height: 0;
              justify-content: flex-start;
            }
            .quick-view .product__info-container .product__blocks {
              display: flex;
              flex-direction: column;
              flex: 1;
              min-height: 0;
            }
            .quick-view .quick-view__sticky-actions {
              position: sticky;
              bottom: 0;
              z-index: 6;
              flex-shrink: 0;
              margin-top: auto;
              margin-inline: calc(var(--quick-view-gap) * -1);
              width: calc(100% + var(--quick-view-gap) * 2);
              max-width: none;
              box-sizing: border-box;
              padding: 1.6rem var(--quick-view-gap) calc(1.6rem + env(safe-area-inset-bottom, 0px));
              background: rgb(var(--color-background));
              border-top: 1px solid rgb(var(--color-border));
            }
            .quick-view .quick-view__sticky-actions form {
              gap: 0 !important;
            }
            .quick-view .quick-view__sticky-actions__inner {
              display: flex;
              flex-direction: column;
              align-items: stretch;
              gap: 1.2rem;
              width: 100%;
            }
            .quick-view .quick-view__sticky-actions .product__block--buy_buttons {
              margin: 0 !important;
            }
            .quick-view .quick-view__sticky-actions .product-form__buttons {
              width: 100%;
            }
            .quick-view .quick-view__sticky-actions .product-form__submit {
              width: 100%;
              border-radius: 999px;
              justify-content: center;
            }
            .quick-view .quick-view__sticky-actions shopify-accelerated-checkout,
            .quick-view .quick-view__sticky-actions .shopify-payment-button {
              width: 100%;
            }
            .quick-view .quick-view__view-details-link {
              display: block;
              text-align: center;
              font-size: 1.2rem;
              font-weight: 400;
              line-height: 1.3;
              letter-spacing: 0.04em;
              text-transform: uppercase;
              text-decoration: underline;
              text-underline-offset: 0.25em;
              color: rgb(var(--color-foreground));
            }
            .quick-view .quick-view__view-details-link[aria-disabled='true'] {
              opacity: 0.5;
              pointer-events: none;
            }
          {% endstyle %}
          {%- assign has_models = product.media | where: 'media_type', 'model' | first -%}
          {%- if has_models -%}
            <link
              id="ModelViewerStyle"
              rel="stylesheet"
              href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
              media="print"
              onload="this.media='all'"
            >
            <link
              id="ModelViewerOverride"
              rel="stylesheet"
              href="{{ 'component-model-viewer-ui.css' | asset_url }}"
              media="print"
              onload="this.media='all'"
            >
          {%- endif -%}
          {%- if enable_image_zoom -%}
            <link
              id="Photoswipe"
              rel="stylesheet"
              href="{{ 'photoswipe-component.css' | asset_url }}"
              media="print"
              onload="this.media='all'"
            >
          {%- endif -%}

          {%- if product.quantity_price_breaks_configured? -%}
            {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
            <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
            <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
          {%- endif -%}

          <script src="{{ 'product-form-line-items.js' | asset_url }}" defer="defer"></script>
          <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
          <script src="{{ 'we-details-select.js' | asset_url }}" defer="defer"></script>
          <script src="{{ 'we-variant-dropdown-meta.js' | asset_url }}" defer="defer"></script>
          <script src="{{ 'we-quantity-selector-cap.js' | asset_url }}" defer="defer"></script>

          {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
          <product-info
            data-section="{{ section.id }}"
            data-product-id="{{ product.id }}"
            data-update-url="false"
            data-url="{{ product.url }}"
            data-view-mode="quick-view"
            class="product flex flex-wrap {{ product_class }}"
          >
            {%- unless product.has_only_default_variant -%}
              <script type="application/json" data-product-variants-for-url>
                {{- product.variants | json -}}
              </script>
            {%- endunless -%}
            {% render 'product-information-blocks',
              section: section,
              update_browser_history: false,
              show_details_link: false,
              context: 'quick-view',
              blocks_render_mode: 'title_price_only',
              compact_header_wrapper: true
            %}
            <div class="product__media-wrapper w-full relative">
              {% render 'product-media-gallery',
                media_layout: media_layout,
                mobile_thumbnails: mobile_thumbnails,
                variant_images: variant_images,
                enable_image_zoom: enable_image_zoom,
                vertical_thumbs_always: true
              %}
            </div>
            <div class="product__info-wrapper w-full">
              {% render 'product-information-blocks',
                section: section,
                update_browser_history: false,
                show_details_link: true,
                context: 'quick-view',
                blocks_render_mode: 'exclude_title_price'
              %}
            </div>
          </product-info>
          <product-recently-viewed data-product-id="{{ product.id }}" class="hidden"></product-recently-viewed>
          {%- if enable_image_zoom -%}
            <script src="{{ 'photoswipe.js' | asset_url }}" defer="defer"></script>
          {%- endif -%}

          {%- liquid
            assign we_qv_show_gallery = false
            if product.media.size > 0
              assign we_qv_show_gallery = true
            endif
            if settings.use_metafield_media and we_qv_mf != blank and we_qv_mf.size > 0
              assign we_qv_show_gallery = true
            endif
          -%}
          {%- if we_qv_show_gallery -%}
            <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
          {%- endif -%}

          {%- if has_models -%}
            <script type="application/json" id="ProductJSON-{{ product.id }}">
              {{ product.media | where: 'media_type', 'model' | json }}
            </script>
            <script src="{{ 'product-model.js' | asset_url }}" defer></script>
          {%- endif -%}
        </template>
      </div>
    </div>
  </quick-view-modal>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.quick-view.name",
  "class": "section-group-overlay-quick-view",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "text",
      "name": "t:sections.main-product.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Text block",
          "label": "t:sections.main-product.blocks.text.settings.text.label"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "body",
              "label": "t:sections.main-product.blocks.text.settings.text_style.options__1.label"
