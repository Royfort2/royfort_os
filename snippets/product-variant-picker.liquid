{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  - update_url: {Boolean} whether or not to update url when changing variants. If false, the url isn't updated. Default: true (optional).
  - picker_id_suffix: {String} optional suffix for DOM ids when multiple pickers share a section (e.g. set products).
  - option_name_suffix: {String} optional suffix for option input names (e.g. product id) to avoid collisions in one form.
  - pdp_qty_metafield_source: {Object} optional product used to read pdp_option_for_quantity_selector (bundle product on set PDPs).
  - pdp_set_bundle_context: {Boolean} when true, inline quantity is non-submitting (embedded set pickers; avoids duplicate name="quantity").
  - pdp_qty_embedded_picker: {Boolean} when true, placeholder clears only when product.selected_variant is set or a section fetch includes option_values (set child pickers).
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
{%- unless product.has_only_default_variant -%}
  {% liquid
    assign picker_id_suffix = picker_id_suffix | default: product.id
    assign option_name_suffix = option_name_suffix | default: ''
    assign id_ns = section.id | append: '-' | append: picker_id_suffix

    assign pdp_qty_metafield_source = pdp_qty_metafield_source | default: product
    assign pdp_set_bundle_context = pdp_set_bundle_context | default: false
    assign pdp_qty_embedded_picker = pdp_qty_embedded_picker | default: false
    assign pdp_qty_option_raw = pdp_qty_metafield_source.metafields.custom.pdp_option_for_quantity_selector.value | default: pdp_qty_metafield_source.metafields.custom.pdp_option_for_quantity_selector
    assign pdp_qty_option_name = pdp_qty_option_raw | strip
    assign pdp_qty_selector_pending = false
    if pdp_qty_option_name != blank
      assign pdp_qty_selector_pending = true
      assign ov_part = ''
      if request.query_string contains 'option_values='
        assign ov_part = request.query_string | split: 'option_values=' | last | split: '&' | first | strip
      endif
      assign is_section_fetch = false
      if request.query_string contains 'section_id='
        assign is_section_fetch = true
      endif
      if pdp_qty_embedded_picker
        if product.selected_variant != blank
          assign pdp_qty_selector_pending = false
        elsif is_section_fetch and ov_part != blank
          assign pdp_qty_selector_pending = false
        endif
      else
        if product.selected_variant != blank
          assign pdp_qty_selector_pending = false
        elsif ov_part != blank
          assign pdp_qty_selector_pending = false
        endif
      endif
    endif

    assign size_option_name = block.settings.size_title | downcase
    assign size_chart_content = product.metafields.foxtheme.size_chart.value.content
    assign size_chart_modal_id = 'SizeChartModal-' | append: block.id | append: '-' | append: picker_id_suffix

    if size_chart_content == blank and block.settings.size_chart_from_page != blank
      assign size_chart_content = pages[block.settings.size_chart_from_page].content
    endif

    assign ov_part_global = ''
    if request.query_string contains 'option_values='
      assign ov_part_global = request.query_string | split: 'option_values=' | last | split: '&' | first | strip
    endif
    assign is_section_fetch_global = false
    if request.query_string contains 'section_id='
      assign is_section_fetch_global = true
    endif
    assign pdp_embedded_variant_pending = false
    if pdp_qty_embedded_picker and product.selected_variant == blank
      assign pdp_embedded_variant_pending = true
      if is_section_fetch_global and ov_part_global != blank
        assign pdp_embedded_variant_pending = false
      endif
    endif
  %}
  <script src="{{ 'variant-selects.js' | asset_url }}" defer="defer"></script>
  <variant-selects
    id="variant-selects-{{ id_ns }}"
    data-section="{{ section.id }}"
    data-url="{{ product.url }}"
    data-product-id="{{ product.id }}"
    data-update-url="{% if update_url == false %}false{% else %}true{% endif %}"
    {% if pdp_qty_option_name != blank %}
      data-pdp-qty-option="{{ pdp_qty_option_name | escape }}"
      data-pdp-qty-pending="{% if pdp_qty_selector_pending %}true{% else %}false{% endif %}"
    {% endif %}
    {% if pdp_qty_embedded_picker %}
      data-pdp-embedded-pending="{% if pdp_embedded_variant_pending %}true{% else %}false{% endif %}"
    {% endif %}
  >
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign option_name_downcase = option.name | downcase
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type

        assign attach_size_chart = false
        if size_option_name contains option_name_downcase
          assign attach_size_chart = true
        endif

        if block.settings.picker_type == 'custom_dropdown'
          assign picker_type = 'dropdown'
          if swatch_count > 0
            assign picker_type = 'swatch_dropdown'
          endif

          assign is_color_option = false
          if settings.color_swatch_trigger != blank
            assign color_swatch_trigger_cd = settings.color_swatch_trigger | downcase | split: ','
            assign has_color_cd = color_swatch_trigger_cd | where: option_name_downcase | first
            if has_color_cd != blank
              assign is_color_option = true
            elsif option_name_downcase contains 'colour'
              assign color_swatch_trigger_cd = color_swatch_trigger_cd | replace: 'color', 'colour'
              assign has_color_cd = color_swatch_trigger_cd | where: option_name_downcase | first
              if has_color_cd != blank
                assign is_color_option = true
              endif
            endif
          endif

          if is_color_option
            if block.settings.swatch_type == 'text'
              assign picker_type = 'button'
            else
              assign picker_type = 'color'
              if swatch_count > 0
                if block.settings.swatch_type == 'shopify_swatch'
                  assign picker_type = 'swatch'
                elsif block.settings.swatch_type == 'variant_image' or block.settings.swatch_type == 'color_swatch'
                  assign picker_type = 'color'
                else
                  assign picker_type = 'button'
                endif
              endif
            endif
          endif
        elsif block.settings.picker_type == 'button' and settings.color_swatch_trigger != blank
          assign color_swatch_trigger = settings.color_swatch_trigger | downcase | split: ','
          assign has_color = color_swatch_trigger | where: option_name_downcase | first
          unless block.settings.swatch_type == 'text'
            if has_color != blank
              assign picker_type = 'color'
            elsif option_name_downcase contains 'colour'
              assign color_swatch_trigger = color_swatch_trigger | replace: 'color', 'colour'
              assign has_color = color_swatch_trigger | where: option_name_downcase | first
              if has_color != blank
                assign picker_type = 'color'
              endif
            endif
          endunless
        endif

        unless block.settings.picker_type == 'custom_dropdown'
          if swatch_count > 0
            if block.settings.picker_type == 'dropdown'
              assign picker_type = 'swatch_dropdown'
            else
              if block.settings.swatch_type == 'shopify_swatch'
                assign picker_type = 'swatch'
              elsif block.settings.swatch_type == 'variant_image' or block.settings.swatch_type == 'color_swatch'
                assign picker_type = 'color'
              else
                assign picker_type = 'button'
              endif
            endif
          endif
        endunless

        assign wrap_class = 'product-form__input product-form__input--' | append: picker_type
        case picker_type
          when 'swatch', 'color', 'button'
            assign is_fieldset_tag = true
            assign wrap_class = wrap_class | append: ' js flex flex-wrap'
            assign button_style = block.settings.button_style | default: 'standard'

            if picker_type == 'button'
              assign wrap_class = wrap_class | append: ' gap-3'
              assign wrap_class = wrap_class | append: ' product-form__input--button-' | append: button_style
            else
              assign wrap_class = wrap_class | append: ' gap-4'
              assign wrap_class = wrap_class | append: ' product-form__input--button-' | append: button_style
            endif
          else
            assign is_fieldset_tag = false
        endcase

        assign tag_fieldset = 'fieldset'
        assign tag_legend = 'legend'
        unless is_fieldset_tag
          assign tag_fieldset = 'div'
          assign tag_legend = 'label'
        endunless

        assign is_pdp_qty_option = false
        if pdp_qty_option_name != blank
          assign opt_cmp = option.name | strip | downcase
          assign pdp_cmp = pdp_qty_option_name | strip | downcase
          assign opt_h = option.name | handleize
          assign pdp_h = pdp_qty_option_name | handleize
          if opt_cmp == pdp_cmp or opt_h == pdp_h
            assign is_pdp_qty_option = true
          endif
        endif
        if pdp_qty_embedded_picker and pdp_qty_option_name != blank and is_pdp_qty_option == false
          assign opt_l = option.name | strip | downcase
          assign pdp_l = pdp_qty_option_name | strip | downcase
          if pdp_l != blank and opt_l != blank
            if opt_l contains pdp_l or pdp_l contains opt_l
              assign is_pdp_qty_option = true
            endif
          endif
        endif
        assign is_color_swatch_picker = false
        if picker_type == 'swatch' or picker_type == 'color'
          assign is_color_swatch_picker = true
        elsif picker_type == 'button' and settings.color_swatch_trigger != blank
          assign cst_emb = settings.color_swatch_trigger | downcase | split: ','
          assign has_c_emb = cst_emb | where: option_name_downcase | first
          if has_c_emb != blank
            assign is_color_swatch_picker = true
          elsif option_name_downcase contains 'colour'
            assign cst_emb = settings.color_swatch_trigger | replace: 'color', 'colour' | downcase | split: ','
            assign has_c_emb = cst_emb | where: option_name_downcase | first
            if has_c_emb != blank
              assign is_color_swatch_picker = true
            endif
          endif
        endif

        assign pdp_skip_value_selected = false
        if is_pdp_qty_option and pdp_qty_selector_pending
          assign pdp_skip_value_selected = true
        endif
        if pdp_embedded_variant_pending
          assign pdp_skip_value_selected = true
          if is_color_swatch_picker
            assign pdp_skip_value_selected = false
          endif
        endif
        assign pdp_qty_row_active = false
        if is_pdp_qty_option and pdp_qty_option_name != blank
          assign pdp_qty_row_active = true
        endif
      -%}
      <{{ tag_fieldset }}
        class="{{ wrap_class }}"
        {% if picker_type == 'color' %}
          data-swatch-type="{{ block.settings.swatch_type }}"
        {% endif %}
        style="--swatch-size: {{ block.settings.button_size | default: '40px' }}px;"
      >
        <{{ tag_legend }}
          {% unless is_fieldset_tag %}
            for="Option-{{ id_ns }}-{{ forloop.index0 }}"
          {% endunless %}
          class="form__label"
        >
          <div class="flex flex-wrap gap-2">
            <span class="option-name">{{ option.name }}:</span>
            <span data-selected-swatch-value="{{ option.name }}">
              {%- if is_pdp_qty_option and pdp_qty_selector_pending -%}
                {{- option.name -}}
              {%- elsif pdp_embedded_variant_pending and is_color_swatch_picker == false -%}
                {{- option.name -}}
              {%- else -%}
                {{- option.selected_value -}}
              {%- endif -%}
            </span>
          </div>
          {%- if size_chart_content != blank and attach_size_chart -%}
            <button
              class="open-size-chart no-js-hidden btn--link tracking-normal"
              aria-controls="{{ size_chart_modal_id }}"
              aria-haspopup="dialog"
            >
              {{ 'products.product.open_size_chart' | t }}
            </button>
          {%- endif -%}
        </{{ tag_legend }}>
        {%- case picker_type -%}
          {%- when 'swatch', 'color', 'button' -%}
            {% if picker_type == 'color' or picker_type == 'swatch' %}
              <div class="variant-options">
            {% endif %}
            {% render 'product-variant-options',
              product: product,
              option: option,
              block: block,
              picker_type: picker_type,
              option_id_namespace: id_ns,
              option_name_suffix: option_name_suffix,
              skip_value_selected: pdp_skip_value_selected
            %}
            {% if picker_type == 'color' or picker_type == 'swatch' %}
              </div>
            {% endif %}
          {%- else -%}
            {% comment %}
              <div class="select">
                {%- if picker_type == 'swatch_dropdown' -%}
                  <span
                    data-selected-value
                    class="dropdown-swatch"
                  >
                    {% comment %} {% render 'swatch', swatch: option.selected_value.swatch %} {% endcomment %}
                  </span>
                {%- endif -%}
                <select
                  id="Option-{{ id_ns }}-{{ forloop.index0 }}"
                  class="form-control form-control--select"
                  name="options[{{ option.name | escape }}]"
                  form="{{ product_form_id }}"
                >
                  {% render 'product-variant-options',
                    product: product,
                    option: option,
                    block: block,
                    picker_type: picker_type,
                    option_id_namespace: id_ns,
                    option_name_suffix: option_name_suffix,
                    skip_value_selected: pdp_skip_value_selected
                  %}
                </select>
                {%- render 'icon-caret-down' -%}
              </div>
            {% endcomment %}
            {%- liquid
              assign opt_radio_name = 'vs-' | append: id_ns | append: '-o' | append: option.position
            -%}
            {%- if pdp_qty_row_active -%}
              <div
                class="pdp-variant-qty-row{% unless pdp_qty_selector_pending or pdp_embedded_variant_pending %} pdp-variant-qty-row--has-variant{% endunless %}"
              >
                <div class="pdp-variant-qty-row__picker">
            {%- endif -%}
            <details
              class="we-select-container{% if is_pdp_qty_option and pdp_qty_selector_pending %} we-select-container--placeholder{% elsif pdp_embedded_variant_pending and is_color_swatch_picker == false %} we-select-container--placeholder{% endif %}"
              data-radio-group-name="{{ opt_radio_name | escape }}"
            >
              <summary class="we-select-container__summary">
                {%- if is_pdp_qty_option and pdp_qty_selector_pending -%}
                  <span class="we-select-placeholder-label">{{ option.name }}</span>
                {%- elsif pdp_embedded_variant_pending and is_color_swatch_picker == false -%}
                  <span class="we-select-placeholder-label">{{ option.name }}</span>
                {%- else -%}
                  {% assign handle = option.selected_value | handleize %}
                  {% if metaobjects.logo[handle] %}
                    {% if metaobjects.logo[handle].bild != blank %}
                      <span class="we-variant-logo">
                        {{-
                          metaobjects.logo[handle].bild
                          | image_url: width: 16
                          | image_tag:
                            widths: '200,300,400,500,600,700,800,900,1000,1100,1200,1300,1400,1500',
                            loading: 'lazy'
                        -}}
                      </span>
                    {% endif %}
                  {% endif %}
                  {{ option.selected_value }}
                {%- endif -%}
              </summary>
              <div class="we-select-mobile-portal">
                <div class="we-select-mobile-backdrop" aria-hidden="true"></div>
                <div class="we-select-mobile-sheet">
                <div class="we-select-mobile-sheet__header">
                  <p
                    class="we-select-mobile-sheet__title"
                    id="WeSelectSheetTitle-{{ id_ns }}-{{ option.position }}"
                  >
                    {{ 'products.product.we_select_sheet_title' | t: option_name: option.name }}
                  </p>
                  <button
                    type="button"
                    class="we-select-mobile-sheet__close"
                    aria-label="{{ 'accessibility.close' | t }}"
                  >
                    {% render 'icon-close', size: 'small' %}
                  </button>
                </div>
                <div class="we-select">
                {% for value in option.values %}
                  <div class="we-select__item">
                    <input
                      type="radio"
                      id="{{ id_ns }}-{{ option.position }}-{{ forloop.index0 }}"
                      name="{{ opt_radio_name | escape }}"
                      value="{{ value | escape }}"
                      form="{{ product_form_id }}"
                      data-product-url="{{ value.product_url }}"
                      data-option-value-id="{{ value.id }}"
                      {% if value.selected and pdp_skip_value_selected == false %}
                        checked
                      {% endif %}
                      {% if value.available == false %}
                        class="disabled"
                      {% endif %}
                    >
                    <label for="{{ id_ns }}-{{ option.position }}-{{ forloop.index0 }}">
                      {% assign handle = value | handleize %}
                      {% if metaobjects.logo[handle] %}
                        {% if metaobjects.logo[handle].bild != blank %}
                          <span class="we-variant-logo">
                            {{-
                              metaobjects.logo[handle].bild
                              | image_url: width: 16
                              | image_tag:
                                widths: '200,300,400,500,600,700,800,900,1000,1100,1200,1300,1400,1500',
                                loading: 'lazy'
                            -}}
                          </span>
                        {% endif %}
                      {% endif %}
                      {{ value }}
                    </label>
                  </div>
                {% endfor %}
                </div>
                </div>
              </div>
            </details>
            {%- if pdp_qty_row_active -%}
                </div>
                {%- liquid
                  assign pdp_qr = product.selected_or_first_available_variant.quantity_rule
                  assign pdp_q_min = pdp_qr.min | default: 1
                  if pdp_q_min < 1
                    assign pdp_q_min = 1
                  endif
                  assign pdp_q_max = pdp_qr.max | default: 10
                  if pdp_q_max == blank or pdp_q_max == 0
                    assign pdp_q_max = 10
                  endif
                  if pdp_q_max > 10
                    assign pdp_q_max = 10
                  endif
                  if pdp_q_max < pdp_q_min
                    assign pdp_q_max = pdp_q_min
                  endif
                  assign pdp_q_inc = pdp_qr.increment | default: 1
                  if pdp_q_inc < 1
                    assign pdp_q_inc = 1
                  endif
                -%}
                <div
                  class="pdp-inline-quantity"
                  aria-hidden="{% if pdp_qty_selector_pending or pdp_embedded_variant_pending %}true{% else %}false{% endif %}"
                >
                  {% render 'pdp-inline-quantity-we-select',
                    id_ns: id_ns,
                    product_form_id: product_form_id,
                    option_position: option.position,
                    pdp_q_min: pdp_q_min,
                    pdp_q_max: pdp_q_max,
                    pdp_q_inc: pdp_q_inc,
                    pdp_set_bundle_context: pdp_set_bundle_context,
                    pdp_qty_selector_pending: pdp_qty_selector_pending,
                    pdp_embedded_variant_pending: pdp_embedded_variant_pending
                  %}
                </div>
              </div>
            {%- endif -%}
        {%- endcase -%}
      </{{ tag_fieldset }}>
    {%- endfor -%}
    <script type="application/json" data-selected-variant>
      {%- if pdp_qty_selector_pending or pdp_embedded_variant_pending -%}
        null
      {%- else -%}
        {{- product.selected_or_first_available_variant | json -}}
      {%- endif -%}
    </script>
    {%- comment -%}
      When no variant is selected in the URL, expose first available variant so the gallery can match default media
      (see product-info getInitialVariantForGallery). Main picker only — embedded set pickers use their own gallery context.
    {%- endcomment -%}
    {%- unless pdp_qty_embedded_picker -%}
      {%- if product.selected_variant == blank -%}
        <script type="application/json" data-pdp-bootstrap-variant>
          {{- product.selected_or_first_available_variant | json -}}
        </script>
      {%- endif -%}
    {%- endunless -%}
  </variant-selects>
  {%- if size_chart_content != blank -%}
    <div id="SizeChart-{{ id_ns }}">
      <basic-modal id="{{ size_chart_modal_id }}" class="drawer modal" style="--modal-width: 77rem;">
        <div class="fixed-overlay" aria-controls="{{ size_chart_modal_id }}"></div>
        <div class="drawer__inner">
          <button
            class="drawer__close-btn"
            aria-controls="{{ size_chart_modal_id }}"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {% render 'icon-close' %}
          </button>
          <div class="drawer__body v-scrollable h-full rte">
            {{ size_chart_content }}
          </div>
        </div>
      </basic-modal>
    </div>
  {%- endif -%}
{%- endunless -%}
