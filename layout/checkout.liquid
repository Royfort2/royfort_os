<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ direction }}" class="{{ checkout_html_classes }}">

  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, user-scalable=0">
    <meta name="referrer" content="origin">


    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-PQRRW3J');</script>
    <!-- End Google Tag Manager -->

    <title>{{ page_title }}</title>

    {{ content_for_header }}

    {{ checkout_stylesheets }}
    {{ checkout_scripts }}
    <style>
      .breadcrumb li:first-of-type {
        display: none
      }
      .step__footer__previous-link {
        display: none;
      }
      .step__footer .btn {
        color: #fff !important;
      }
      .step__footer .btn:hover {
        color: #fff !important;
      }
    </style>
  
  {% render 'shogun-head' %}
</head>

  <body>
    {{ skip_to_content_link }}

    <header class="banner" data-header role="banner">
      <div class="wrap">
        {{ content_for_logo }}
      </div>
    </header>

    {{ order_summary_toggle }}
    <div class="content" data-content>
      <div class="wrap">
        <div class="main">
          <header class="main__header" role="banner">
            {{ content_for_logo }}
            {{ breadcrumb }}
            {{ alternative_payment_methods }}
          </header>
          <main class="main__content" role="main">
            {{ content_for_layout }}
          </main>
          <footer class="main__footer" role="contentinfo">
            {{ content_for_footer }}
          </footer>
        </div>
        <aside class="sidebar" role="complementary">
          <div class="sidebar__header">
            {{ content_for_logo }}
          </div>
          <div class="sidebar__content">
            {% capture sidebar_content %}
              {{ content_for_order_summary }}
            {% endcapture %}

            {%- case shop.permanent_domain -%}

              {%- comment %}
                DE store
              {% endcomment -%}
            {%- when 'bw2016.myshopify.com' -%}
              {%- assign duvetcover = ' Deckenbezug' -%}

              {%- comment %}
                CH store
              {% endcomment -%}
            {%- when 'royfort-ch.myshopify.com' -%}
              {%- assign duvetcover = ' Deckenbezug' -%}

              {%- comment %}
                Other store
              {% endcomment -%}
            {%- else -%}
              {%- assign duvetcover = ' Duvet Cover' -%}
            {%- endcase -%}

            {{ sidebar_content | replace: ' Set', duvetcover }}

          </div>
        </aside>
      </div>
    </div>

    {{ tracking_code }}

    {% comment %}
      <script>
      document.querySelector(".order-summary-toggle").click();
      </script>
    {% endcomment %}

  </body>
  {% render 'dataLayer' %}

  <script>
    function injectCompareAtPrice(event) {
      var priceWithoutDiscount = 0;
      var line_items = [{% for line in checkout.line_items %}{% if line.variant.compare_at_price > 0 %}{
              'variant_id':'{{ line.variant_id }}',
              'compare_at_price':'{{ line.variant.compare_at_price }}',
              'quantity': {{ line.quantity }}
            },{% endif %}{% endfor %}]
      line_items.forEach(function(item) {
        try {
          var el = document.querySelector(`[data-variant-id='${
            item.variant_id
          }'] .product__price`);
          if (! el) {
            return;
          }
          var content = el.innerHTML;
          var amount = (parseFloat(item.quantity) * parseFloat(item.compare_at_price) / 100).toFixed(2);
          var shop = window.location.origin;
          if (shop == 'https://royfort.fr') { // FR store
            var moneyAmount = amount + ' €';
          } else if (shop == 'https://www.royfort.co.uk') { // UK store
            var moneyAmount = '£' + amount
          } else if (shop == 'https://royfort.de') { // DE store
            var moneyAmount = amount + ' €';
          } else if (shop == 'https://royfort.ch') {
            var moneyAmount = 'CHF ' + amount
          }
          el.innerHTML = `<del class='order-summary__small-text'>${moneyAmount}</del><br>${content}`;
        } catch (ex) {
          console.error('Error rendering compare_at_price', ex);
        }
      })
      document.querySelectorAll('.product__price').forEach(function(button) {
        if (button.querySelector('.order-summary__small-text') !== null) {
          priceWithoutDiscount += parseInt(button
            .querySelector('.order-summary__small-text')
            .innerHTML
            .match(/\d+/g)
            .join(''))
        } else {
          priceWithoutDiscount += parseInt(button
            .querySelector('.order-summary__emphasis')
            .innerHTML
            .match(/\d+/g)
            .join(''))
        }
      });
      var priceWithDiscountTotal = (priceWithoutDiscount / 100).toFixed(2)
      var shop = window.location.origin;
      if (shop == 'https://royfort.fr') { // FR store
        var priceWithDiscountString = priceWithDiscountTotal + ' €';
      } else if (shop == 'https://www.royfort.co.uk') { // UK store
        var priceWithDiscountString = '£' + priceWithDiscountTotal
      } else if (shop == 'https://royfort.de') { // DE store
        var priceWithDiscountString = priceWithDiscountTotal + ' €';
      } else if (shop == 'https://royfort.ch') {
        var priceWithDiscountString = 'CHF ' + priceWithDiscountTotal
      }
      document.querySelector('.total-line__price').innerHTML = `<del class="order-summary__small-text" >${priceWithDiscountString}</del><br />` + document.querySelector('.total-line__price').innerHTML
    }
    document.addEventListener('page:load', injectCompareAtPrice);
    document.addEventListener('page:change', injectCompareAtPrice);
    document.addEventListener('rebuy.refresh', injectCompareAtPrice);
  </script>

</html>