                      assign v_thumb = variant.featured_image | default: set_product.featured_image
                    -%}
                    "{{ variant.id }}":{% if v_thumb != blank %}{{ v_thumb | image_url: width: 360 | json }}{% else %}null{% endif %}{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                  }
                </script>
              {%- endfor -%}

              {%- assign we_set_main_line_available = we_set_line_resolved.available | default: true -%}
              {%- assign we_set_main_line_product = we_set_products | first -%}
              {%- render 'we-pdp-stock-status',
                product: product,
                fallback_product: we_set_main_line_product,
                line_available: we_set_main_line_available
              -%}

              <button
                type="button"
                class="btn btn--secondary pdp-set-main-bis"
