{% if settings.hide_contact_banner == false %}
<div class="container-fluid">
    <div class="product-footer py-5">
        <div class="product-footer-row">
            <h3 class="mb-3 text-secondary text-center text-20">{{section.settings.product_footer_title}}</h3>
            <p class="mb-5 text-secondary text-center text-12">{{section.settings.product_footer_undertitle}}</p>
            <div class="row">
                {% for block in section.blocks %}
                    {% case block.type %}
                        {% when 'product-footer' %}
                        <div class="product-footer-block">
                            <h4 class="text-secondary">{{block.settings.title}}</h4>
                            <div class="rte">{{ block.settings.content }}</div>
                        </div>
                    {% endcase %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endif %}

