<span
  class="stamped-badge we-stamped-badge-zero"
  data-rating="0"
  data-reviews="0"
  data-we-stamped-zero-fallback="true"
>
  <span class="stamped-badge-starrating" aria-hidden="true">
    {%- for i in (1..5) -%}
      <i class="stamped-fa stamped-fa-star-o" aria-hidden="true"></i>
    {%- endfor -%}
  </span>
  <span class="stamped-badge-rating-value" aria-hidden="true">0.0</span>
  <span class="stamped-badge-caption" data-reviews="0" data-label="reviews" data-version="2">
    <span>0</span>
  </span>
</span>
