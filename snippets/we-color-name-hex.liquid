{% comment %}
  Outputs lowercase hex (or empty) for a color label via settings.swatch_list aliases.
  Accepts: color_name {String}
{% endcomment %}
{%- liquid
  assign query_name = color_name | downcase | strip
  assign result_hex = ''
  if query_name != blank
    assign swatch_config = settings.swatch_list | newline_to_br | split: '<br />'
    for swatch in swatch_config
      assign swatch_parts = swatch | strip | split: ':'
      if swatch_parts.size < 2
        continue
      endif
      assign name_parts = swatch_parts.first | split: '|'
      for name_part in name_parts
        assign nm = name_part | downcase | strip
        if nm == query_name
          assign result_hex = swatch_parts.last | downcase | strip
          break
        endif
      endfor
      if result_hex != blank
        break
      endif
    endfor
  endif
-%}{{- result_hex -}}
