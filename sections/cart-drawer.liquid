  {%- if request.page_type != 'cart' and settings.cart_type == 'drawer' -%}
  {{ 'cart.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'we-main-product-related.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'we-cart-combined-recommendations.js' | asset_url }}" defer="defer"></script>
  {%- if linklists['gift-wrapping'].links != blank and linklists['gift-wrapping'].links.first.type == 'product_link' -%}
    <script src="{{ 'gift-wrapping.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  <cart-drawer
    id="CartDrawer"
    class="drawer cart-drawer drawer--right"
    data-section-id="{{ section.id }}"
    shopify-design-mode
    hidden
  >
    <div class="fixed-overlay" aria-controls="CartDrawer"></div>
    <div class="drawer__inner">
      <div id="CartDrawer-{{ section.id }}" class="drawer__content flex flex-col h-full w-full">
        <div class="drawer__header cart-drawer__header">
          <h2 class="drawer__heading cart-drawer__heading">
            {{ 'general.cart.title' | t }} (<cart-count
              class="cart-count cart-count--drawer"
              aria-label="{{ 'general.cart.cart_count' | t: count: cart.item_count | escape }}"
            >
              {%- if cart.item_count < 100 -%}
                {{- cart.item_count -}}
              {%- else -%}
                <span class="text-sm">99+</span>
              {%- endif -%}
            </cart-count>)
          </h2>
          <button
            class="drawer__close-btn cart-drawer__close-btn z-1"
            aria-controls="CartDrawer"
            type="button"
            aria-label="{{ 'templates.cart.cart' | t }}"
          >
            {% render 'icon-close', size: 'large' %}
          </button>
        </div>

        {%- liquid
          if linklists['gift-wrapping'].links != blank and linklists['gift-wrapping'].links.first.type == 'product_link'
            assign gift_wrapping = linklists['gift-wrapping'].links.first
            assign gift_wrap_id = gift_wrapping.object.variants.first.id
          else
            assign gift_wrap_id = null
          endif
        -%}

        <div class="cart-drawer__layout">
          <div class="cart-drawer__main">
            <div id="CartDrawerSummary-{{ section.id }}" class="cart-drawer__summary-wrap">
              {% render 'cart-drawer-summary' %}
            </div>

            <div
              id="CartDrawerBody-{{ section.id }}"
              class="cart-drawer__items-area cart-drawer__body v-scrollable{% if cart == empty %} hidden{% endif %}"
            >
              <cart-items>
                <ul role="list" class="cart-drawer__items-list">
                  {%- assign cart_gift_wrap_item = blank -%}
                  {%- for item in cart.items -%}
                    {%- liquid
                      assign is_gift_wrap_item = false
                      if gift_wrap_id != null and item.id == gift_wrap_id
                        assign is_gift_wrap_item = true
                      endif
                    -%}
                    {%- if is_gift_wrap_item -%}
                      {%- capture cart_gift_wrap_item -%}
                        {% render 'cart-drawer-line-item', item: item, section: section, gift_wrap_id: gift_wrap_id %}
                      {%- endcapture -%}
                    {%- else -%}
                      {% render 'cart-drawer-line-item', item: item, section: section, gift_wrap_id: gift_wrap_id %}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if cart_gift_wrap_item != blank -%}
                    {{ cart_gift_wrap_item }}
                  {%- endif -%}
                </ul>
              </cart-items>
            </div>
          </div>

          <div id="CartDrawerRecs-{{ section.id }}" class="cart-drawer__recs v-scrollable">
            {% render 'cart-drawer-recommendations', section: section, gift_wrap_id: gift_wrap_id %}
          </div>
        </div>
      </div>
    </div>
  </cart-drawer>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.cart-drawer.name",
  "settings": [
    {
      "type": "paragraph",
      "content": "[Read How-to](https://foxecom.link/wdOue47)"
    },
    {
      "type": "header",
      "content": "t:sections.all.general.name"
    },
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "label": "t:sections.cart-drawer.settings.show_cart_note.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart_discount",
      "label": "t:sections.cart-drawer.settings.show_cart_discount.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shipping_rates_calculator",
      "label": "t:sections.cart-drawer.settings.show_shipping_rates_calculator.label"
    },
    {
      "type": "checkbox",
      "id": "show_free_shipping_goal",
      "label": "t:sections.cart-drawer.settings.show_free_shipping_goal.label",
      "default": true,
      "info": "t:settings_schema.cart.settings.free_shipping_minimum_amount.info"
    },
    {
      "type": "header",
      "content": "t:sections.cart-drawer.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_cart_recommendations",
      "label": "t:sections.cart-drawer.settings.enable_cart_recommendations.label",
      "default": true
    },
    {
      "type": "text",
      "id": "cart_recommendations_heading",
      "label": "t:sections.cart-drawer.settings.cart_recommendations_heading.label",
      "default": "You may also like",
      "visible_if": "{{ section.settings.enable_cart_recommendations == true }}"
    },
    {
      "type": "collection",
      "id": "cart_recommendations_fallback_collection",
      "label": "Recommendations fallback collection",
      "info": "Shown when personalized recommendations are unavailable (e.g. theme preview). Defaults to Bestseller."
    },
    {
      "type": "range",
      "id": "cart_recommendations_limit",
      "label": "t:sections.cart-drawer.settings.cart_recommendations_limit.label",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.enable_cart_recommendations == true }}"
    },
    {
      "type": "checkbox",
      "id": "cart_combined_render_badges",
      "label": "Render badges",
      "default": true,
      "visible_if": "{{ section.settings.enable_cart_recommendations == true }}"
    },
    {
      "type": "checkbox",
      "id": "cart_combined_badges_global_only",
      "label": "Render only global badges",
      "default": false,
      "visible_if": "{{ section.settings.enable_cart_recommendations == true }}"
    }
  ]
}
{% endschema %}
