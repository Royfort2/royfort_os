        },
        {
            "type":      "url",
            "id":        "method2_url",
            "label":     "Method 2 URL"
        },
        {
            "type":      "richtext",
            "id":        "method2_description",
            "label":     "Method 2 Description",
            "default":   "<p>Anytime between<br/>0am - 0pm</p>"
        },
        {
            "type":      "text",
            "id":        "method3_title",
            "label":     "Method 3 Title",
            "default":   "Our Headquarters"
        },
        {
            "type":      "richtext",
            "id":        "method3_description",
            "label":     "Method 3 Description",
            "default":   "<p>Royfort UG (limited liability)<br/>Ebertystrasse 27<br/>10249 Berlin</p>"
        },
        {
            "type": 	"header",
            "content": 	"FAQ"
        },
        {
            "type":      "text",
            "id":        "faq_title",
            "label":     "Title",
            "default":   "Having trouble?"
        },
        {
            "type":      "text",
            "id":        "faq_description",
            "label":     "Description",
            "default":   "Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Aenean commodo ligula eget dolor. Aenean massa. Cu sociis natoque penatibus et magnis dis parturient montes, nascetur ridiculus mus."
        },
        {
            "type":      "text",
            "id":        "faq_link",
