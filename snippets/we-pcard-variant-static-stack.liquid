{% comment %}
  Main + optional second image for non-swiper product cards (variant swatch hover).
  Same media rules as we-pcard-variant-slides, at most two images (mirrors theme hover stack).
  @param we_pcard_append_second {Boolean}
  @param we_static_single_image {Boolean} If true, only the first variant image (no second layer). Use for
    swatch preview so theme hover rules do not hide the main image while swatches are hovered.
{% endcomment %}
{%- liquid
  assign slide_count = 0
  assign included_ids = ''
  assign we_pcard_append_second = we_pcard_append_second | default: false
  assign we_static_single_image = we_static_single_image | default: false
-%}
{%- for media in product.media -%}
  {%- if media.media_type == 'image' -%}
    {%- liquid
      assign show_media = false
      if media.variant_ids.size == 0
        assign show_media = true
      elsif media.variant_ids contains variant.id
        assign show_media = true
      endif
    -%}
    {%- if show_media -%}
      {%- assign slide_count = slide_count | plus: 1 -%}
      {%- assign included_ids = included_ids | append: ',' | append: media.id | append: ',' -%}
      {%- assign slide_widths = image_widths | append: ', ' | append: media.width -%}
      {%- if slide_count == 1 -%}
        <div
          class="media-wrapper product-card__image product-card__image--main"
          style="--aspect-ratio: {{ image_ratio }}"
        >
          {{
            media
            | image_url: width: media.width
            | image_tag:
              loading: loading,
              fetchpriority: fetchpriority,
              class: 'motion-reduce',
              widths: slide_widths,
              sizes: image_sizes,
              is: 'image-lazy'
          }}
        </div>
        {%- if we_static_single_image -%}
          {%- break -%}
        {%- endif -%}
      {%- elsif slide_count == 2 -%}
        {%- unless we_static_single_image -%}
          <div
            class="media-wrapper product-card__image product-card__image--second inset-full hidden md:block"
            style="--aspect-ratio: {{ image_ratio }}"
          >
            {{
              media
              | image_url: width: media.width
              | image_tag:
                loading: loading,
                fetchpriority: fetchpriority,
                class: 'motion-reduce',
                widths: slide_widths,
                sizes: image_sizes,
                is: 'image-lazy'
            }}
          </div>
        {%- endunless -%}
        {%- break -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if slide_count == 0 -%}
  {%- if variant.featured_media != blank and variant.featured_media.media_type == 'image' -%}
    {%- assign included_ids = included_ids | append: ',' | append: variant.featured_media.id | append: ',' -%}
    {%- assign slide_widths = image_widths | append: ', ' | append: variant.featured_media.width -%}
    <div
      class="media-wrapper product-card__image product-card__image--main"
      style="--aspect-ratio: {{ image_ratio }}"
    >
      {{
        variant.featured_media
        | image_url: width: variant.featured_media.width
        | image_tag:
          loading: loading,
          fetchpriority: fetchpriority,
          class: 'motion-reduce',
          widths: slide_widths,
          sizes: image_sizes,
          is: 'image-lazy'
      }}
    </div>
  {%- elsif variant.image != blank -%}
    {%- assign included_ids = included_ids | append: ',' | append: variant.image.id | append: ',' -%}
    {%- assign slide_widths = image_widths | append: ', ' | append: variant.image.width -%}
    <div
      class="media-wrapper product-card__image product-card__image--main"
      style="--aspect-ratio: {{ image_ratio }}"
    >
      {{
        variant.image
        | image_url: width: variant.image.width
        | image_tag:
          loading: loading,
          fetchpriority: fetchpriority,
          class: 'motion-reduce',
          widths: slide_widths,
          sizes: image_sizes,
          is: 'image-lazy'
      }}
    </div>
  {%- elsif product.featured_media != blank -%}
    {%- assign fm = product.featured_media -%}
    {%- if fm.media_type == 'image' -%}
      {%- assign included_ids = included_ids | append: ',' | append: fm.id | append: ',' -%}
      {%- assign slide_widths = image_widths | append: ', ' | append: fm.width -%}
      <div
        class="media-wrapper product-card__image product-card__image--main"
        style="--aspect-ratio: {{ image_ratio }}"
      >
        {{
          fm
          | image_url: width: fm.width
          | image_tag:
            loading: loading,
            fetchpriority: fetchpriority,
            class: 'motion-reduce',
            widths: slide_widths,
            sizes: image_sizes,
            is: 'image-lazy'
        }}
      </div>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- liquid
  assign append_second = false
  unless we_static_single_image
    if we_pcard_append_second and product.images.size > 1 and product.images[1] != blank
      assign second_pid = product.images[1].id
      assign second_token = ',' | append: second_pid | append: ','
      unless included_ids contains second_token
        assign append_second = true
      endunless
    endif
  endunless
-%}
{%- if append_second -%}
  {%- assign second_img = product.images[1] -%}
  {%- assign slide_widths = image_widths | append: ', ' | append: second_img.width -%}
  <div
    class="media-wrapper product-card__image product-card__image--second inset-full hidden md:block"
    style="--aspect-ratio: {{ image_ratio }}"
  >
    {{
      second_img
      | image_url: width: second_img.width
      | image_tag:
        loading: loading,
        fetchpriority: fetchpriority,
        class: 'motion-reduce',
        widths: slide_widths,
        sizes: image_sizes,
        is: 'image-lazy'
    }}
  </div>
{%- endif -%}
