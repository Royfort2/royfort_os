{%- comment %}
Date format for FR store
{% endcomment -%}
{%- when 'royfort-fr.myshopify.com' -%}
{{ article.published_at | date: "%e %B %Y" | 
replace: 'January', 'janvier' | 
replace: 'February', 'février'  | 
replace: 'March', 'mars'  | 
replace: 'April', 'avril'  | 
replace: 'May', 'mai'  | 
replace: 'June', 'juin'  | 
replace: 'July', 'juillet'  | 
replace: 'August', 'août'  | 
replace: 'September', 'septembre'  | 
replace: 'October', 'octobre'  | 
replace: 'November', 'novembre'  | 
replace: 'December', 'décembre' 
}}

{%- else -%}

{%- comment %}
Date format for other stores
{% endcomment -%}
{{ article.published_at | date: "%B %e, %Y" }}
{%- endcase -%}