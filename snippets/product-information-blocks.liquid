{%- liquid
  assign product_form_id = 'product-form-' | append: section.id

  if context == 'main-product'
    assign title_tag = 'h1'
  else
    assign title_tag = 'h2'
  endif

  assign blocks_render_mode = blocks_render_mode | default: 'all'
  assign compact_header_wrapper = compact_header_wrapper | default: false

  assign qv_sticky_footer = false
  if context == 'quick-view' and blocks_render_mode == 'exclude_title_price'
    assign qv_sticky_footer = true
  endif
  assign qv_buy_buttons_block = false
-%}
{%- if blocks_render_mode == 'title_price_only' and compact_header_wrapper -%}
  <div class="quick-view__product-heading w-full">
{%- else -%}
  <div
    id="ProductInfo-{{ section.id }}"
    data-section="{{ section.id }}"
    data-url="{{ product.url }}"
    class="product__info-container{% if enable_sticky_info %} sticky-element{% endif %}"
  >
{%- endif -%}
  <div class="product__blocks accordion-parent">
    {%- for block in section.blocks -%}
      {%- if blocks_render_mode == 'title_price_only' -%}
        {%- unless block.type == 'title' or block.type == 'price' -%}
          {%- continue -%}
        {%- endunless -%}
      {%- elsif blocks_render_mode == 'exclude_title_price' -%}
        {%- if block.type == 'title' or block.type == 'price' -%}
          {%- continue -%}
        {%- endif -%}
      {%- endif -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          <div class="product__block product__block--{{ block.type }}">
            {% render block %}
          </div>
        {%- when 'usp_swiper' -%}
          <script src="{{ 'we-usp-swiper.js' | asset_url }}" defer="defer"></script>
          {%- liquid
            assign usp_slide_count = 0
            for idx in (1..5)
              assign icon_key = 'icon_' | append: idx
              assign usp_key = 'usp_' | append: idx
              if block.settings[icon_key] != blank and block.settings[usp_key] != blank
                assign usp_slide_count = usp_slide_count | plus: 1
              endif
            endfor
          -%}
          <we-usp-swiper class="product__block product__block--{{ block.type }} {% if block.settings.hide_on_desktop %}block md:hidden{% endif %}" {{ block.shopify_attributes }}>
            <div class="swiper we-usp-swiper">
              <div class="swiper-wrapper">
                {% for i in (1..5) %}
                  {% assign icon = 'icon_' | append: i %}
                  {% assign usp = 'usp_' | append: i %}
                  {% if block.settings[icon] != blank and block.settings[usp] != blank %}
                    <div class="swiper-slide">
                      <div class="product__usp-swiper-item">
                        {{ block.settings[icon] | image_url: width: 100 | image_tag }}
                        <span class="product__usp-swiper-item-title">{{ block.settings[usp] }}</span>
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
              <button class="we-usp-swiper-button we-usp-swiper-button-next">
                <svg xmlns="http://www.w3.org/2000/svg" width="7" height="16" viewBox="0 0 7 16" fill="none">
                  <g clip-path="url(#clip0_3601_3632)">
                    <path d="M0.0693364 15.6542L5.3208 7.93258L0.0693359 0.110481H1.44003L6.67435 7.85034L1.38007 15.6542H0.0693364Z" fill="#231F20"/>
                  </g>
                  <defs>
                    <clipPath id="clip0_3601_3632">
                      <rect width="7" height="16" fill="white"/>
                    </clipPath>
                  </defs>
                </svg>
              </button>
              <button class="we-usp-swiper-button we-usp-swiper-button-prev">
                <svg xmlns="http://www.w3.org/2000/svg" width="7" height="16" viewBox="0 0 7 16" fill="none">
                  <g clip-path="url(#clip0_3601_3626)">
                    <path d="M6.93066 0.345817L1.6792 8.06742L6.93066 15.8895L5.55997 15.8895L0.32565 8.14966L5.61994 0.345817L6.93066 0.345817Z" fill="#231F20"/>
                  </g>
                  <defs>
                    <clipPath id="clip0_3601_3626">
                      <rect width="7" height="16" fill="white" transform="translate(7 16) rotate(-180)"/>
                    </clipPath>
                  </defs>
                </svg>
              </button>
              {%- if usp_slide_count > 1 -%}
                <div class="swiper-pagination product__media-gallery-progress" aria-hidden="true"></div>
              {%- endif -%}
            </div>
          </we-usp-swiper>
        {%- when 'usp_icon_grid' -%}
          {% render 'we-product-usp-icons', block: block %}
        {%- when 'product_info_tabs' -%}
          {% render 'we-product-info-tabs', block: block %}
        {%- when 'usp_list' -%}
          <div class="product__block product__block--{{ block.type }}">
            <div class="product__usp-list-container">
              {% if block.settings.title != blank %}
                <span class="product__usp-list-title">{{ block.settings.title }}</span>
              {% endif %}
              <ul class="product__usp-list-items">
                {%- if block.settings.use_usp_metafield and product.metafields.custom.we_pdp_usp_list_items.value != blank -%}
                  {% assign usp_list_items = product.metafields.custom.we_pdp_usp_list_items.value %}
                  {% for item in usp_list_items %}
                    {% assign item_array = item | split: '|' %}
                    {% assign item_title = item_array[0] %}
                    {% assign item_description = item_array[1] %}
                    {% if item_title != blank and item_description != blank %}
                      <li class="product__usp-list-item">
                        <span class="product__usp-list-item-title">{{ item_title }}</span>
                        <span class="product__usp-list-item-description">{{ item_description }}</span>
                      </li>
                    {% endif %}
                  {% endfor %}
                {% else %}
                  {% for i in (1..3) %}
                    {% assign item_title = 'item_title_' | append: i %}
                    {% assign item_description = 'item_description_' | append: i %}
                    {% if block.settings[item_title] != blank and block.settings[item_description] != blank %}
                      <li class="product__usp-list-item">
                        <span class="product__usp-list-item-title">{{ block.settings[item_title] }}</span>
                        <span class="product__usp-list-item-description">{{ block.settings[item_description] }}</span>
                      </li>
                    {% endif %}
                  {% endfor %}
                {%- endif -%}
              </ul>
            </div>
          </div>
        {%- when 'stamped_reviews' -%}
          <div
            class="product__block product__block--{{ block.type }} product-card__stamped we-product-card__stamped text-left"
            {{ block.shopify_attributes }}
          >
            {%- if settings.public_key_stamped != blank and settings.stamped_store_hash != blank -%}
              {%- comment -%}
                Collection / grid badge (Stamped docs): class stamped-product-reviews-badge only — not stamped-main-badge (product page) or stamped-toggle.
              {%- endcomment -%}
              <span
                class="stamped-product-reviews-badge"
                data-id="{{ product.id }}"
                data-product-sku="{{ product.handle }}"
                data-product-type="{{ product.type | escape }}"
                data-product-title="{{ product.title | escape }}"
                style="display: block;"
              >
                {% render 'stamped-reviews-badge-zero' %}
              </span>
            {%- endif -%}
          </div>
        {%- when 'icon_info_text' -%}
          {%- if block.settings.icon != blank
            or block.settings.title != blank
            or block.settings.short_description != blank
            or block.settings.description != blank
            or block.settings.page != blank
          -%}
            <div
              class="product__block product__block--icon_info_text"
              {{ block.shopify_attributes }}
            >
              {% render 'we-product-icon-info-text', block: block, section: section %}
            </div>
          {%- endif -%}
        {%- when 'text' -%}
          <div
            class="product__block rte product__block--{{ block.type }}"
            {{ block.shopify_attributes }}
          >
            <p class="product__text inline-richtext m-0{% if block.settings.text_style == 'uppercase' %} text-upper{% elsif block.settings.text_style == 'subtitle' %} text-upper text-subtext{% endif %}">
              {{- block.settings.text -}}
            </p>
          </div>
        {%- when 'title' -%}
          <div
            class="product__block product__block--{{ block.type }}"
            {{ block.shopify_attributes }}
          >
            <{{title_tag}} class="product__title {{ block.settings.heading_size }}">{{ product.title | escape }}</{{title_tag}}>
            <a href="{{ product.url }}" class="product__title">
              <h2 class="h1">
                {{ product.title | escape }}
              </h2>
            </a>
          </div>
        {%- when 'price' -%}
          {%- liquid
            capture we_pdp_ov_count_str
              render 'we-pdp-url-option-value-count'
            endcapture
            assign we_pdp_ov_count = we_pdp_ov_count_str | strip | plus: 0
            assign we_pdp_option_count = product.options_with_values.size
            assign we_pdp_all_options_in_url = false
            if request.query_string contains 'variant='
              assign we_pdp_all_options_in_url = true
            elsif we_pdp_ov_count >= we_pdp_option_count and we_pdp_option_count > 0
              assign we_pdp_all_options_in_url = true
            endif
            assign pdp_main_price_use_variant = true
            if product.metafields.custom.we_pdp_preis_nach_grose == true
              assign pdp_main_price_use_variant = false
            elsif product.selected_variant == blank and product.price_varies
              assign pdp_main_price_use_variant = false
            elsif we_pdp_all_options_in_url == false and product.price_varies
              assign pdp_main_price_use_variant = false
            endif
          -%}
          <div
            class="product__block product__block--{{ block.type }}"
            {{ block.shopify_attributes }}
          >
            <div id="price-{{ section.id }}" role="status">
              {%- render 'price',
                product: product,
                section: section,
                use_variant: pdp_main_price_use_variant,
                show_sale_badge: false,
                price_class: 'f-price--large'
              -%}
            </div>
            {%- if product.quantity_price_breaks_configured? -%}
              <div class="volume-pricing-note" id="VolumeNote-{{ section.id }}">
                <span class="text-sm text-subtext">{{ 'products.product.volume_pricing.note' | t }}</span>
              </div>
            {%- endif -%}
            {% if block.settings.show_tax_and_shipping %}
              <div class="product__tax rte">
                {%- if cart.taxes_included -%}
                  {{ 'products.product.include_taxes' | t }}
                {%- endif -%}
                {%- if shop.shipping_policy.body != blank -%}
                  {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                {%- endif -%}
              </div>
            {% endif %}
            {% comment %} {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
            {%- form 'product', product, id: product_form_installment_id, class: 'installment' -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              {{ form | payment_terms }}
            {%- endform -%} {% endcomment %}
          </div>
        {%- when 'inventory' -%}
          <div
            class="product__block product__block--{{ block.type }}{% if block.settings.text_style == 'uppercase' %} text-upper{% elsif block.settings.text_style == 'subtitle' %} text-upper text-subtext{% endif %}{% if product.selected_or_first_available_variant.inventory_management != 'shopify' %} hidden{% endif %}"
            {{ block.shopify_attributes }}
            id="Inventory-{{ section.id }}"
            role="status"
          >
            {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
              {%- liquid
                assign inventory_quantity = product.selected_or_first_available_variant.inventory_quantity

                if inventory_quantity > 0
                  if inventory_quantity <= block.settings.inventory_threshold
                    assign inventory_status = 'low-stock'
                    if block.settings.show_inventory_quantity
                      if inventory_quantity == 1
                        assign inventory_message = 'products.product.inventory_low_stock_one_item_html' | t: quantity: inventory_quantity
                      else
                        assign inventory_message = 'products.product.inventory_low_stock_many_items_html' | t: quantity: inventory_quantity
                      endif
                    else
                      assign inventory_message = 'products.product.inventory_low_stock' | t
                    endif
                  else
                    assign inventory_status = 'in-stock'
                    if block.settings.show_inventory_quantity
                      assign inventory_message = 'products.product.inventory_in_stock_show_count_html' | t: quantity: inventory_quantity
                    else
                      assign inventory_message = 'products.product.inventory_in_stock' | t
                    endif
                  endif
                else
                  if product.selected_or_first_available_variant.inventory_policy == 'continue'
                    assign inventory_status = 'in-stock'
                    assign inventory_message = 'products.product.inventory_out_of_stock_continue_selling' | t
                  else
                    assign inventory_status = 'out-of-stock'
                    assign inventory_message = 'products.product.inventory_out_of_stock' | t
                  endif
                endif
              %}
              <p class="product__inventory product__inventory--{{ inventory_status }}">
                <span class="product__inventory-icon"></span>
                <span class="product__inventory-text">{{- inventory_message -}}</span>
              </p>
              {%- if inventory_status == 'low-stock' and inventory_quantity < block.settings.inventory_threshold -%}
                <progress-bar
                  class="product__inventory-stock-bar progress-bar"
                  data-value="{{ inventory_quantity }}"
                  data-max="{{ block.settings.inventory_threshold }}"
                ></progress-bar>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- when 'description' -%}
          {%- if product.description != blank -%}
            <div
              class="product__block product__block--{{ block.type }} rte"
              {{ block.shopify_attributes }}
            >
              {{ product.description }}
            </div>
          {%- endif -%}
        {%- when 'sku' -%}
          <div
            class="product__block product__block--{{ block.type }}{% if product.selected_or_first_available_variant.sku.size == 0 %} hidden{% endif %}"
            id="Sku-{{ section.id }}"
            {{ block.shopify_attributes }}
          >
            <p
              class="product__sku{% if block.settings.text_style == 'uppercase' %} text-upper{% elsif block.settings.text_style == 'subtitle' %} text-upper text-subtext{% endif %}"
              role="status"
            >
              <span class="visually-hidden">{{ 'products.product.sku' | t }}:</span>
              {{- product.selected_or_first_available_variant.sku -}}
            </p>
          </div>
        {%- when 'custom_liquid' -%}
          <div
            class="product__block product__block--{{ block.type }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.custom_liquid }}
          </div>
        {%- when 'collapsible_tab' -%}
          {% if block.settings.content != blank or block.settings.custom_liquid != blank or block.settings.page.content != blank %}
            <div
              class="product__block product__block--{{ block.type }}"
              {{ block.shopify_attributes }}
            >
              <details
                id="Details-{{ block.id }}-{{ section.id }}"
                class="accordion-details"
                is="accordion-group"
                {% if block.settings.default_open %}
                  open
                  aria-expanded="true"
                {% else %}
                  aria-expanded="false"
                {% endif %}
              >
                {% if block.settings.heading_styling == 'body' %}
                  {% style %}
                    #Details-{{ block.id }}-{{ section.id }} .accordion-details__summary .h4 {
                      font-family: 'GT America', Arial, sans-serif !important;
                    }
                  {% endstyle %}
                {% endif %}
                <summary class="accordion-details__summary flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    {% render 'icons', icon: block.settings.icon %}
                    <h2 class="h4 inline-richtext">
                      {{ block.settings.heading | default: block.settings.page.title | escape }}
                    </h2>
                  </div>
                  {%- render 'icon-plus-toggle', size: 'small' -%}
                </summary>
                <div class="accordion-details__content rte">
                  {{ block.settings.content }}
                  {{ block.settings.custom_liquid }}
                  {{ block.settings.page.content }}
                </div>
              </details>
            </div>
          {% endif %}
        {%- when 'popup' -%}
          <div
            class="product__block product__block--{{ block.type }}"
            {{ block.shopify_attributes }}
          >
            <button
              class="btn--underline"
              aria-controls="PopupModal-{{ block.id }}"
              aria-haspopup="dialog"
            >
              {{ block.settings.text | default: block.settings.page.title | escape }}
            </button>
            <basic-modal id="PopupModal-{{ block.id }}" class="drawer modal" style="--modal-width: 77rem;">
              <div class="fixed-overlay" aria-controls="PopupModal-{{ block.id }}"></div>
              <div class="drawer__inner">
                <button
                  class="drawer__close-btn"
                  aria-controls="PopupModal-{{ block.id }}"
                  aria-label="{{ 'accessibility.close' | t }}"
                >
                  {% render 'icon-close' %}
                </button>
                <div class="drawer__body v-scrollable h-full">
                  <h1 class="h2">{{ block.settings.page.title | escape }}</h1>
                  {{ block.settings.page.content }}
                </div>
              </div>
            </basic-modal>
          </div>
        {%- when 'addons' -%}
          {%- if block.settings.show_share or block.settings.show_ask_question -%}
            <div
              class="product__block product__block--{{ block.type }} flex items-center"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.show_share -%}
                <script src="{{ 'product-share.js' | asset_url }}" defer="defer"></script>
                {%- liquid
                  assign share_modal_id = 'PopupModal-Sharing-' | append: section.id
                  assign share_url = product.selected_or_first_available_variant.url | default: product.url | prepend: request.origin
                -%}
                <button
                  class="btn btn--with-icon btn--plain"
                  aria-controls="{{ share_modal_id }}"
                  aria-haspopup="dialog"
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 20 20"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                    focusable="false"
                    role="presentation"
                    class="rtl-flip-x"
                  >
                    <path d="M2.4168 15.525C3.70274 14.1555 7.07852 11.25 11.8754 11.25V15L18.1254 8.75L11.8754 2.5V6.25C7.7504 6.25 2.46212 10.1914 1.8754 15.2766C1.86728 15.3424 1.88032 15.4091 1.91265 15.4671C1.94498 15.525 1.99491 15.5712 2.05522 15.5988C2.11552 15.6265 2.18307 15.6343 2.24807 15.621C2.31308 15.6077 2.37218 15.5741 2.4168 15.525Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span class="font-body text-normal tracking-normal">
                    {{- 'products.product.share_label' | t -}}
                  </span>
                </button>
                <basic-modal id="{{ share_modal_id }}" class="drawer modal">
                  <div class="fixed-overlay" aria-controls="{{ share_modal_id }}"></div>
                  <div class="drawer__inner">
                    <button
                      class="drawer__close-btn"
                      aria-controls="{{ share_modal_id }}"
                      aria-label="{{ 'accessibility.close' | t }}"
                    >
                      {% render 'icon-close' %}
                    </button>
                    <div class="drawer__body v-scrollable h-full">
                      <div class="product__sharing">
                        <h3 class="product__sharing--title h5">{{ 'products.product.share' | t }}</h3>
                        <product-share class="product__sharing--inputs" id="ProductShare-{{ section.id }}">
                          <label for="ProductShare-{{ section.id }}" class="visually-hidden">
                            {{- 'products.product.share_label' | t -}}
                          </label>
                          <input
                            id="ProductShare-{{ section.id }}"
                            type="text"
                            class="form-control"
                            value="{{ share_url }}"
                            readonly
                          >
                          <button class="btn btn-copy" data-copied-text="{{ 'general.share.copied' | t }}">
                            {{ 'general.share.copy' | t }}
                          </button>
                        </product-share>
                        {% render 'social-sharing',
                          url: product.url,
                          share_image: product.featured_media.preview_image
                        %}
                      </div>
                    </div>
                  </div>
                </basic-modal>
              {%- endif -%}
              {%- if block.settings.show_ask_question -%}
                {%- assign ask_question_modal_id = 'PopupModal-AskQuestionForm-' | append: section.id -%}
                <button
                  class="btn btn--with-icon btn--plain"
                  aria-controls="{{ ask_question_modal_id }}"
                  aria-haspopup="dialog"
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 20 20"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                    focusable="false"
                    role="presentation"
                  >
                    <path d="M10 15C10.5178 15 10.9375 14.5803 10.9375 14.0625C10.9375 13.5447 10.5178 13.125 10 13.125C9.48223 13.125 9.0625 13.5447 9.0625 14.0625C9.0625 14.5803 9.48223 15 10 15Z" fill="currentColor"/>
                    <path d="M10 11.25V10.625C11.3805 10.625 12.5 9.64531 12.5 8.4375C12.5 7.22969 11.3805 6.25 10 6.25C8.61953 6.25 7.5 7.22969 7.5 8.4375V8.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M10 17.5C14.1421 17.5 17.5 14.1421 17.5 10C17.5 5.85786 14.1421 2.5 10 2.5C5.85786 2.5 2.5 5.85786 2.5 10C2.5 14.1421 5.85786 17.5 10 17.5Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span class="font-body text-normal tracking-normal">
                    {{- 'products.product.question_form.label' | t -}}
                  </span>
                </button>
                <basic-modal id="{{ ask_question_modal_id }}" class="drawer modal">
                  <div class="fixed-overlay" aria-controls="{{ ask_question_modal_id }}"></div>
                  <div class="drawer__inner">
                    <button
                      class="drawer__close-btn"
                      aria-controls="{{ ask_question_modal_id }}"
                      aria-label="{{ 'accessibility.close' | t }}"
                    >
                      {% render 'icon-close' %}
                    </button>
                    <div class="drawer__body v-scrollable h-full">
                      {% render 'ask-question-form' %}
                    </div>
                  </div>
                </basic-modal>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- when 'we_variant_picker' -%}
          <div
            class="product__block product__block--{{ block.type }}"
            {{ block.shopify_attributes }}
          >
            {%- if product.metafields.custom.pdp_set_products != blank -%}
              {%- assign we_set_products = product.metafields.custom.pdp_set_products.value -%}
              {%- assign we_set_inline_count = 1 -%}
              {%- comment -%}
                First set product: inline picker (main line — e.g. Deckenbezug).
                Remaining set products: optional checkbox cards (e.g. Kissenbezug, Spannbettlaken).
              {%- endcomment -%}
              {%- for set_product in we_set_products limit: we_set_inline_count -%}
                {%- capture we_set_line_vid_c -%}
                  {%- render 'we-pdp-first-set-line-variant-id', bundle_product: product, line_product: set_product -%}
                {%- endcapture -%}
                {%- assign we_set_line_vid_str = we_set_line_vid_c | strip -%}
                {%- assign we_set_line_resolved = set_product.selected_or_first_available_variant -%}
                {%- if we_set_line_vid_str != blank -%}
                  {%- for v in set_product.variants -%}
                    {%- assign v_id_str = v.id | append: '' -%}
                    {%- if v_id_str == we_set_line_vid_str -%}
                      {%- assign we_set_line_resolved = v -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
                {%- assign we_set_main_line_title = set_product.title -%}
                {% render 'we-product-variant-picker',
                  product: set_product,
                  block: block,
                  product_form_id: product_form_id,
                  update_url: update_browser_history,
                  picker_id_suffix: set_product.id,
                  pdp_set_line_variant_from_bundle: we_set_line_resolved,
                  pdp_set_bundle_context: true
                %}
                <script type="application/json" data-set-product-variants="{{ set_product.id }}">
                  {{ set_product.variants | json }}
                </script>
                <script type="application/json" data-set-default-variant-id="{{ set_product.id }}">
                  {{ we_set_line_resolved.id | json }}
                </script>
                <script type="application/json" data-set-product-variant-images="{{ set_product.id }}">
                  {
                  {%- for variant in set_product.variants -%}
