{%- comment -%}
  Icon-above USP grid (legacy product-usp-upper / site-usp-container).
  Renders up to 6 items from block settings: icon_N + label_N.
{%- endcomment -%}
{%- liquid
  assign item_count = 0
  for idx in (1..6)
    assign label_key = 'label_' | append: idx
    if block.settings[label_key] != blank
      assign item_count = item_count | plus: 1
    endif
  endfor
-%}
{%- if item_count > 0 or request.design_mode -%}
  <div
    class="product__block product__block--usp_icon_grid{% if block.settings.hide_on_mobile %} hidden md:block{% endif %}{% if block.settings.hide_on_desktop %} md:hidden{% endif %}"
    {{ block.shopify_attributes }}
  >
    {%- if item_count > 0 -%}
      <div class="product__usp-icon-grid" role="list">
        {%- for i in (1..6) -%}
          {%- liquid
            assign icon_setting = 'icon_' | append: i
            assign label_setting = 'label_' | append: i
            assign icon = block.settings[icon_setting]
            assign label = block.settings[label_setting]
          -%}
          {%- if label != blank -%}
            <div class="product__usp-icon-grid-item" role="listitem">
              <div class="product__usp-icon-grid-icon">
                {%- if icon != blank -%}
                  {{
                    icon
                    | image_url: width: 200
                    | image_tag:
                      loading: 'lazy',
                      widths: '70, 100, 140, 200',
                      sizes: '(min-width: 992px) 100px, 70px',
                      alt: label
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'product__usp-icon-grid-placeholder' }}
                {%- endif -%}
              </div>
              <p class="product__usp-icon-grid-label">{{ label | escape }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="product__usp-icon-grid-empty">Add USP labels (and optional icons) in block settings.</p>
    {%- endif -%}
  </div>
{%- endif -%}
