{% comment %}
  Renders swiper-slide elements for a product card variant (images from variant-associated media).
  @param product {Product}
  @param variant {Variant}
  @param variant_color_name {String} Optional. When set, take up to two images whose alt text matches this color.
  @param we_pcard_append_second {Boolean} Appends product.images[1] when not already included (2-slide UX).
{% endcomment %}
{%- liquid
  assign we_mf_temp_media = product.metafields.custom.we_temp_product_media.value
  assign we_mf_pcard_slides = false
  if settings.use_metafield_media and we_mf_temp_media != blank and we_mf_temp_media.size > 0
    assign we_mf_pcard_slides = true
  endif
-%}
{%- if we_mf_pcard_slides -%}
  {%- liquid
    assign color_key = variant_color_name | default: '' | downcase | strip
    assign slide_count = 0
  -%}
  {%- if color_key != blank -%}
    {%- for media_item in we_mf_temp_media -%}
      {%- if slide_count >= 2 -%}
        {%- break -%}
      {%- endif -%}
      {%- liquid
        assign preview = media_item
        if media_item.preview_image != blank
          assign preview = media_item.preview_image
        endif
        assign alt_key = preview.alt | default: '' | downcase | strip
        assign alt_matches = false
        if alt_key != blank and color_key != blank and alt_key == color_key
          assign alt_matches = true
        endif
      -%}
      {%- if alt_matches -%}
        {%- assign slide_widths = image_widths | append: ', ' | append: preview.width -%}
        <div class="swiper-slide" data-media-id="we-mf-{{ slide_count }}">
          <div
            class="media-wrapper product-card__image"
            style="--aspect-ratio: {{ image_ratio }}"
          >
            {{
              preview
              | image_url: width: preview.width
              | image_tag:
                loading: loading,
                fetchpriority: fetchpriority,
                class: 'motion-reduce',
                widths: slide_widths,
                sizes: image_sizes,
                is: 'image-lazy'
            }}
          </div>
        </div>
        {%- assign slide_count = slide_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if slide_count == 0 -%}
    {%- for media_item in we_mf_temp_media -%}
      {%- if slide_count >= 2 -%}
        {%- break -%}
      {%- endif -%}
      {%- liquid
        assign preview = media_item
        if media_item.preview_image != blank
          assign preview = media_item.preview_image
        endif
        assign slide_widths = image_widths | append: ', ' | append: preview.width
      -%}
      <div class="swiper-slide" data-media-id="we-mf-{{ slide_count }}">
        <div
          class="media-wrapper product-card__image"
          style="--aspect-ratio: {{ image_ratio }}"
        >
          {{
            preview
            | image_url: width: preview.width
            | image_tag:
              loading: loading,
              fetchpriority: fetchpriority,
              class: 'motion-reduce',
              widths: slide_widths,
              sizes: image_sizes,
              is: 'image-lazy'
          }}
        </div>
      </div>
      {%- assign slide_count = slide_count | plus: 1 -%}
    {%- endfor -%}
  {%- endif -%}
{%- else -%}
{%- liquid
  assign slide_count = 0
  assign included_ids = ''
  assign we_pcard_append_second = we_pcard_append_second | default: false
  assign color_key = variant_color_name | default: '' | downcase | strip
-%}
{%- if color_key != blank -%}
  {%- for media in product.media -%}
    {%- if media.media_type == 'image' -%}
      {%- liquid
        assign alt_key = media.alt | default: '' | downcase | strip
        assign alt_matches = false
        if alt_key != blank and color_key != blank
          if alt_key == color_key
            assign alt_matches = true
          endif
        endif
      -%}
      {%- if alt_matches and slide_count < 2 -%}
        {%- assign slide_count = slide_count | plus: 1 -%}
        {%- assign included_ids = included_ids | append: ',' | append: media.id | append: ',' -%}
        {%- assign slide_widths = image_widths | append: ', ' | append: media.width -%}
        <div class="swiper-slide" data-media-id="{{ media.id }}">
          <div
            class="media-wrapper product-card__image"
            style="--aspect-ratio: {{ image_ratio }}"
          >
            {{
              media
              | image_url: width: media.width
              | image_tag:
                loading: loading,
                fetchpriority: fetchpriority,
                class: 'motion-reduce',
                widths: slide_widths,
                sizes: image_sizes,
                is: 'image-lazy'
            }}
          </div>
        </div>
        {%- if slide_count >= 2 -%}
          {%- break -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if slide_count == 0 -%}
{%- for media in product.media -%}
  {%- if media.media_type == 'image' -%}
    {%- liquid
      assign show_media = false
      if media.variant_ids.size == 0
        assign show_media = true
      elsif media.variant_ids contains variant.id
        assign show_media = true
      endif
    -%}
    {%- if show_media -%}
      {%- assign slide_count = slide_count | plus: 1 -%}
      {%- assign included_ids = included_ids | append: ',' | append: media.id | append: ',' -%}
      {%- assign slide_widths = image_widths | append: ', ' | append: media.width -%}
      <div class="swiper-slide" data-media-id="{{ media.id }}">
        <div
          class="media-wrapper product-card__image"
          style="--aspect-ratio: {{ image_ratio }}"
        >
          {{
            media
            | image_url: width: media.width
            | image_tag:
              loading: loading,
              fetchpriority: fetchpriority,
              class: 'motion-reduce',
              widths: slide_widths,
              sizes: image_sizes,
              is: 'image-lazy'
          }}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- if slide_count == 0 -%}
  {%- if variant.featured_media != blank and variant.featured_media.media_type == 'image' -%}
    {%- assign included_ids = included_ids | append: ',' | append: variant.featured_media.id | append: ',' -%}
    {%- assign slide_widths = image_widths | append: ', ' | append: variant.featured_media.width -%}
    <div class="swiper-slide" data-media-id="{{ variant.featured_media.id }}">
      <div
        class="media-wrapper product-card__image"
        style="--aspect-ratio: {{ image_ratio }}"
      >
        {{
          variant.featured_media
          | image_url: width: variant.featured_media.width
          | image_tag:
            loading: loading,
            fetchpriority: fetchpriority,
            class: 'motion-reduce',
            widths: slide_widths,
            sizes: image_sizes,
            is: 'image-lazy'
        }}
      </div>
    </div>
  {%- elsif variant.image != blank -%}
    {%- assign included_ids = included_ids | append: ',' | append: variant.image.id | append: ',' -%}
    {%- assign slide_widths = image_widths | append: ', ' | append: variant.image.width -%}
    <div class="swiper-slide" data-media-id="fallback-{{ variant.id }}">
      <div
        class="media-wrapper product-card__image"
        style="--aspect-ratio: {{ image_ratio }}"
      >
        {{
          variant.image
          | image_url: width: variant.image.width
          | image_tag:
            loading: loading,
            fetchpriority: fetchpriority,
            class: 'motion-reduce',
            widths: slide_widths,
            sizes: image_sizes,
            is: 'image-lazy'
        }}
      </div>
    </div>
  {%- elsif product.featured_media != blank -%}
    {%- assign fm = product.featured_media -%}
    {%- if fm.media_type == 'image' -%}
      {%- assign included_ids = included_ids | append: ',' | append: fm.id | append: ',' -%}
      {%- assign slide_widths = image_widths | append: ', ' | append: fm.width -%}
      <div class="swiper-slide" data-media-id="{{ fm.id }}">
        <div
          class="media-wrapper product-card__image"
          style="--aspect-ratio: {{ image_ratio }}"
        >
          {{
            fm
            | image_url: width: fm.width
            | image_tag:
              loading: loading,
              fetchpriority: fetchpriority,
              class: 'motion-reduce',
              widths: slide_widths,
              sizes: image_sizes,
              is: 'image-lazy'
          }}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- liquid
  assign append_second = false
  if color_key == blank and we_pcard_append_second and product.images.size > 1 and product.images[1] != blank
    assign second_pid = product.images[1].id
    assign second_token = ',' | append: second_pid | append: ','
    unless included_ids contains second_token
      assign append_second = true
    endunless
  endif
-%}
{%- if append_second -%}
  {%- assign second_img = product.images[1] -%}
  {%- assign slide_widths = image_widths | append: ', ' | append: second_img.width -%}
  <div class="swiper-slide" data-media-id="{{ second_img.id }}">
    <div
      class="media-wrapper product-card__image"
      style="--aspect-ratio: {{ image_ratio }}"
    >
      {{
        second_img
        | image_url: width: second_img.width
        | image_tag:
          loading: loading,
          fetchpriority: fetchpriority,
          class: 'motion-reduce',
          widths: slide_widths,
          sizes: image_sizes,
          is: 'image-lazy'
      }}
    </div>
  </div>
{%- endif -%}
{%- endif -%}
