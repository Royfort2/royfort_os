                        align-items: center;
                        justify-content: center;
                        align-content: center;
                        height: 100%;
                        text-align: center;
                        color: white;
                    }

                    .exhibitor-content a {
                        text-decoration: none !important;
                        color: white !important;
                    }

                    .exhibitor-text {
                        text-decoration: none !important;
                    }

