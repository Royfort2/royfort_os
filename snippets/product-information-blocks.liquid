                Senden Sie mir eine E-Mail
              </button>

              <script src="{{ 'product-set-picker-price.js' | asset_url }}" defer="defer"></script>

              {%- if we_set_products.size > we_set_inline_count -%}
                <div
                  id="ProductSetWeOptionalList-{{ block.id }}-{{ section.id }}"
                  class="product-set-picker__list"
                >
                    {%- for set_product in we_set_products offset: we_set_inline_count -%}
                      {%- capture we_set_line_vid_c -%}
                        {%- render 'we-pdp-first-set-line-variant-id', bundle_product: product, line_product: set_product -%}
                      {%- endcapture -%}
                      {%- assign we_set_line_vid_str = we_set_line_vid_c | strip -%}
                      {%- assign we_set_line_resolved = set_product.selected_or_first_available_variant -%}
                      {%- if we_set_line_vid_str != blank -%}
                        {%- for v in set_product.variants -%}
                          {%- assign v_id_str = v.id | append: '' -%}
                          {%- if v_id_str == we_set_line_vid_str -%}
                            {%- assign we_set_line_resolved = v -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}
                      {%- liquid
                        assign we_set_card_title = set_product.title
                        if set_product.metafields.custom.we_pdp_addon_card_title.value != blank
                          assign we_set_card_title = set_product.metafields.custom.we_pdp_addon_card_title.value
                        elsif set_product.title contains 'Kissenbezug' or set_product.title contains 'kissenbezug'
                          assign we_set_card_title = 'Kissenbezug wählen'
                        elsif set_product.title contains 'Spannbettlaken'
                          if block.settings.set_picker_title != blank
                            assign we_set_card_title = block.settings.set_picker_title
                          else
                            assign we_set_card_title = 'Spannbettlaken hinzufügen'
                          endif
                        elsif set_product.title contains 'Matratzenschoner' or set_product.title contains 'matratzenschoner'
                          if set_product.metafields.custom.we_pdp_addon_card_title.value != blank
                            assign we_set_card_title = set_product.metafields.custom.we_pdp_addon_card_title.value
                          else
                            assign we_set_card_title = 'Matratzenschoner hinzufügen'
                          endif
                        endif
                        assign we_set_card_title_check = we_set_card_title | downcase
                        unless we_set_card_title_check contains 'hinzufügen' or we_set_card_title_check contains 'wählen'
                          assign we_set_card_title = we_set_card_title | append: ' hinzufügen'
                        endunless
                      -%}
                      <div class="product-set-picker__item">
                        <script type="application/json" data-set-product-variants="{{ set_product.id }}">
                          {{ set_product.variants | json }}
                        </script>
                        <script type="application/json" data-set-default-variant-id="{{ set_product.id }}">
                          {{ we_set_line_resolved.id | json }}
                        </script>
                        <script type="application/json" data-set-product-variant-images="{{ set_product.id }}">
                          {
                          {%- for variant in set_product.variants -%}
                            {%- liquid
                              assign v_thumb = variant.featured_image | default: set_product.featured_image
                            -%}
                            "{{ variant.id }}":{% if v_thumb != blank %}{{ v_thumb | image_url: width: 360 | json }}{% else %}null{% endif %}{%- unless forloop.last -%},{%- endunless -%}
                          {%- endfor -%}
                          }
                        </script>
                        <template id="SetWeCardDefaultPrice-{{ block.id }}-{{ section.id }}-{{ set_product.id }}">
                          {% render 'price', product: set_product, price_class: 'product-set-picker__f-price', we_force_from_price: true %}
                        </template>
                        <div class="product-set-picker__card">
                          <label class="product-set-picker__card-row">
                            <input
                              type="checkbox"
                              id="SetWeProductToggle-{{ block.id }}-{{ section.id }}-{{ set_product.id }}"
                              class="product-set-picker__toggle visually-hidden"
                              data-set-optional-product-id="{{ set_product.id }}"
                              {% if forloop.first %}
                                checked
                              {% endif %}
                            >
                            <span
                              class="product-set-picker__thumb"
                              {% if set_product.featured_image != blank %}
                                data-default-thumb-url="{{ set_product.featured_image | image_url: width: 360 }}"
                              {% endif %}
                            >
                              {%- if set_product.featured_image -%}
                                {{
                                  set_product.featured_image
                                  | image_url: width: 160
                                  | image_tag:
                                    loading: 'lazy',
                                    class: 'product-set-picker__thumb-img',
                                    widths: '80,120,160',
                                    sizes: '8rem'
                                }}
                              {%- else -%}
                                <span class="product-set-picker__thumb-placeholder" aria-hidden="true"></span>
                              {%- endif -%}
                            </span>
                            <span class="product-set-picker__info">
                              <span class="product-set-picker__title">{{ we_set_card_title | escape }}</span>
                              <span
                                class="product-set-picker__price"
                                data-set-card-price
                                data-product-id="{{ set_product.id }}"
                                data-default-price-template="SetWeCardDefaultPrice-{{ block.id }}-{{ section.id }}-{{ set_product.id }}"
                              >
                                {% render 'price', product: set_product, price_class: 'product-set-picker__f-price', we_force_from_price: true %}
                              </span>
                            </span>
                            <span class="product-set-picker__checkbox-ui" aria-hidden="true"></span>
                          </label>
                          <div class="product-set-picker__expand">
                            <div class="product-set-picker__expand-inner">
                              {% render 'we-product-variant-picker',
                                product: set_product,
                                block: block,
                                product_form_id: product_form_id,
                                update_url: update_browser_history,
                                picker_id_suffix: set_product.id,
                                pdp_set_line_variant_from_bundle: we_set_line_resolved,
                                pdp_set_addon_card: true
                              %}
                            </div>
                          </div>
                        </div>
                      </div>
                    {%- endfor -%}
                    {%- render 'we-pdp-bundle-tag-extras',
                      product: product,
                      set_products: we_set_products,
                      mode: 'products',
                      block: block,
                      product_form_id: product_form_id,
                      update_browser_history: update_browser_history
                    -%}
                </div>
              {%- endif -%}

              {%- unless context == 'quick-view' -%}
                {%- assign set_products_zw = we_set_products -%}
                {%- assign zw_sale_cents = 0 -%}
                {%- assign zw_compare_cents = 0 -%}
                {%- assign zw_min_sum = 0 -%}
                {%- for sp in set_products_zw limit: we_set_inline_count -%}
                  {%- capture we_set_line_vid_c -%}
                    {%- render 'we-pdp-first-set-line-variant-id', bundle_product: product, line_product: sp -%}
                  {%- endcapture -%}
                  {%- assign we_set_line_vid_str = we_set_line_vid_c | strip -%}
                  {%- assign zw_v = sp.selected_or_first_available_variant -%}
                  {%- if we_set_line_vid_str != blank -%}
                    {%- for v in sp.variants -%}
                      {%- assign v_id_str = v.id | append: '' -%}
                      {%- if v_id_str == we_set_line_vid_str -%}
                        {%- assign zw_v = v -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                  {%- assign zw_qr = zw_v.quantity_rule -%}
                  {%- assign zw_q_min = zw_qr.min | default: 1 -%}
                  {%- if zw_q_min < 1 -%}
                    {%- assign zw_q_min = 1 -%}
                  {%- endif -%}
                  {%- assign zw_line_sale = zw_v.price | times: zw_q_min -%}
                  {%- assign zw_sale_cents = zw_sale_cents | plus: zw_line_sale -%}
                  {%- assign unit_cmp = zw_v.price -%}
                  {%- if zw_v.compare_at_price > zw_v.price -%}
                    {%- assign unit_cmp = zw_v.compare_at_price -%}
                  {%- endif -%}
                  {%- assign zw_line_cmp = unit_cmp | times: zw_q_min -%}
                  {%- assign zw_compare_cents = zw_compare_cents | plus: zw_line_cmp -%}
                  {%- assign zw_line_min = sp.price_min | times: zw_q_min -%}
                  {%- assign zw_min_sum = zw_min_sum | plus: zw_line_min -%}
                {%- endfor -%}
                {%- assign zw_line_sale_sum = zw_sale_cents -%}
                {%- assign zw_line_compare_sum = zw_compare_cents -%}
                {%- assign zw_has_compare = false -%}
                {%- assign zw_discount_pct = 0 -%}
                {%- if product.metafields.custom.pdp_set_products != blank and product.metafields.custom.set_discount_amount > 0 -%}
                  {%- comment -%} SSR: sum of price_min × qty; bundle % off that sum. JS replaces when pickers resolve. {%- endcomment -%}
                  {%- assign zw_bundle_discount = product.metafields.custom.set_discount_amount | plus: 0 -%}
                  {%- assign zw_amount_difference = 100 | minus: zw_bundle_discount -%}
                  {%- assign zw_compare_cents = zw_min_sum -%}
                  {%- assign zw_sale_cents = zw_min_sum | times: zw_amount_difference | divided_by: 100 -%}
                  {%- assign zw_has_compare = true -%}
                  {%- assign zw_discount_pct = zw_bundle_discount -%}
                {%- elsif zw_line_compare_sum > zw_line_sale_sum -%}
                  {%- assign zw_has_compare = true -%}
                  {%- assign zw_discount_pct = zw_line_compare_sum | minus: zw_line_sale_sum | times: 100 | divided_by: zw_line_compare_sum -%}
                {%- endif -%}
                <div class="pdp-set-zwischensumme" data-pdp-set-zwischensumme>
                  <script type="application/json" data-pdp-set-zwischensumme-meta>
                    {
                      "titles":{
                        "{{ product.id }}":{{ product.title | json }},
                        {%- for sp in set_products_zw -%}
                          "{{ sp.id }}":{{ sp.title | json }}{%- unless forloop.last -%},{%- endunless -%}
                        {%- endfor -%}
                        {%- render 'we-pdp-bundle-tag-extras', product: product, set_products: set_products_zw, mode: 'titles-json' -%}
                      },
                      "fromPrefix": {{ 'products.product.price.from_price_html' | t: price: '' | json }},
                      "priceMinById":{
                        {%- for sp in set_products_zw -%}
                          "{{ sp.id }}":{{ sp.price_min }}{%- unless forloop.last -%},{%- endunless -%}
                        {%- endfor -%}
                        {%- render 'we-pdp-bundle-tag-extras', product: product, set_products: set_products_zw, mode: 'prices-json' -%}
                      }
                    }
                  </script>
                  <div class="pdp-set-zwischensumme__header">
                    <span class="pdp-set-zwischensumme__title">{{ block.settings.set_zwischensumme_title }}</span>
                    <div class="pdp-set-zwischensumme__prices">
                      <span
                        class="pdp-set-zwischensumme__compare {%unless zw_has_compare %}visually-hidden{% endunless %}"
                        {% unless zw_has_compare %}hidden{% endunless %}
                      >
                        {%- if zw_has_compare -%}
                          {{- zw_compare_cents | money -}}
                        {%- endif -%}
                      </span>
                      <span class="pdp-set-zwischensumme__sale">
                        {%- if product.metafields.custom.pdp_set_products != blank and product.metafields.custom.set_discount_amount > 0 -%}
                          {%- assign zw_zw_sale_m = zw_sale_cents | money -%}
                          {{- 'products.product.price.from_price_html' | t: price: zw_zw_sale_m -}}
                        {%- else -%}
                          {{- zw_sale_cents | money -}}
                        {%- endif -%}
                      </span>
                      <span
                        class="pdp-set-zwischensumme__badge {% unless zw_has_compare %}visually-hidden{% endunless %}"
                        {% unless zw_has_compare %}hidden{% endunless %}
                      >
                        {%- if zw_has_compare -%}-{{ zw_discount_pct }}%{%- endif -%}
                      </span>
                    </div>
                  </div>
                  <p class="pdp-set-zwischensumme__breakdown">
                    {%- for sp in set_products_zw limit: we_set_inline_count -%}
                      {%- capture we_set_line_vid_c -%}
                        {%- render 'we-pdp-first-set-line-variant-id', bundle_product: product, line_product: sp -%}
                      {%- endcapture -%}
                      {%- assign we_set_line_vid_str = we_set_line_vid_c | strip -%}
                      {%- assign zw_v = sp.selected_or_first_available_variant -%}
                      {%- if we_set_line_vid_str != blank -%}
                        {%- for v in sp.variants -%}
                          {%- assign v_id_str = v.id | append: '' -%}
                          {%- if v_id_str == we_set_line_vid_str -%}
                            {%- assign zw_v = v -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}
                      {%- assign zw_qr = zw_v.quantity_rule -%}
                      {%- assign zw_q_min = zw_qr.min | default: 1 -%}
                      {%- if zw_q_min < 1 -%}
                        {%- assign zw_q_min = 1 -%}
                      {%- endif -%}
                      {%- assign zw_br_line = sp.price_min | times: zw_q_min | money -%}
                      {%- unless forloop.first -%}
                        +
                      {%- endunless -%}
                      {{- zw_q_min }}x {{ sp.title }} (
                      {%- if product.metafields.custom.set_discount_amount > 0 -%}
                        {{- 'products.product.price.from_price_html' | t: price: zw_br_line -}}
                      {%- else -%}
                        {{- zw_br_line -}}
                      {%- endif -%}
                      )
                    {%- endfor -%}
                  </p>
                </div>
              {%- endunless -%}
            {%- else -%}
              {%- liquid
                assign we_pdp_set_addon_card_ctx = false
                if request.query_string contains 'pdp_set_addon_card=1'
                  assign we_pdp_set_addon_card_ctx = true
                endif
              -%}
              {% render 'we-product-variant-picker',
                product: product,
                block: block,
                product_form_id: product_form_id,
                update_url: update_browser_history,
                picker_id_suffix: product.id,
                pdp_set_addon_card: we_pdp_set_addon_card_ctx
              %}
              {%- unless context == 'quick-view' -%}
                {% render 'we-pdp-simple-summary',
                  product: product,
                  block: block,
                  product_form_id: product_form_id,
                  update_browser_history: update_browser_history
                %}
              {%- endunless -%}
            {%- endif -%}
          </div>
        {%- when 'variant_picker' -%}
          <div
            class="product__block product__block--{{ block.type }}"
            {{ block.shopify_attributes }}
          >
            {%- liquid
              assign pdp_set_active = false
              if product.metafields.custom.pdp_is_set == true and product.metafields.custom.pdp_set_products != blank
                assign pdp_set_active = true
              endif
            -%}
            {%- if pdp_set_active -%}
              {% render 'product-variant-picker',
                product: product,
                block: block,
                product_form_id: product_form_id,
