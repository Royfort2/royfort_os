{% render 'header-messages' %}

<div class="container-fluid">

    <div id="header-row">

        <div id="header-nav-toggle">
            <span class="menu-burger"></span>
        </div><!-- main-nav-toggle -->

        <div id="header-logo">
            <a href="/" alt="return to homepage">
                {% render 'Logo' %}
            </a>
        </div><!-- header-logo -->

        <div id="header-navigation-desktop">
            {% render 'site-navigation' with section.blocks as blocks %}
        </div><!-- site-navigation-desktop -->

        <div id="header-actions-group">
            {% render 'site-navigation-right' with section.blocks as blocks %}

            {% if settings.hide_account_icons == false %}
            <div id="header-account" class="header-action{% if customer %} customer-logged-in{% endif %}">
                {% if customer %}
                    <a href="/account">{%render 'icon-account'%}</a>
                    {% comment %}
                    <ul class="header-account-dropdown">
                        <li class="customer-details">
                            <div class="left-icon"><div class="customer-icon">{% render 'Account' %}</div></div>
                            <div class="right-content">
                                <span class="customer-name">{{ 'customer.account.welcome_text' | t }} {{customer.first_name}}</span>
                                <span class="customer-email">{{customer.email}}</span>
                            </div>
                        </li>
                        <li class="action-link">
                            <a href="/account/">
                                <span class="left-icon">{% render 'icon-my-orders' %}</span>
                                <span class="right-content">
                                    {{ 'customer.account.orders' | t }}
                                </span>
                            </a>
                        </li>
                        <li class="action-link">
                            <a href="/account/addresses">
                                <span class="left-icon">{% render 'icon-my-address-book' %}</span>
                                <span class="right-content">
                                    {{'customer.account.my_address' | t }}
                                </span>
                            </a>
                        </li>
                        <li class="action-link sign-out">
                            <a href="/account/logout">
                                <span class="left-icon">{% render 'icon-sign-out' %}</span>
                                <span class="right-content">
                                    {{ 'customer.account.sign_out' | t }}
                                </span>
                            </a>
                        </li>
                    </ul>
                    {% endcomment %}
                {% else %}
                    <a href="/account/login">{% render 'Account' %}</a>
                {% endif %}
            </div>
            {% endif %}
            <div id="header-bag" class="header-action header-basket">
                <a href="#">{% render 'Basket' %}<span class="cart-count ajax-cart__count{% if cart.item_count == 0 %} no-items{% endif %}">{{ cart.item_count }}</span></a>
                {% render 'ajax-cart' %}
            </div>
        </div><!-- header-actions-group -->

    </div>
</div><!-- container-fluid -->
<div id="header-navigation-mobile">
    {% render 'site-navigation-mobile' with section.blocks as blocks %}
</div><!-- site-navigation-mobile -->

