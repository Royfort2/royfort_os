{%- liquid
  assign s = block.settings
  assign promo_cs_m = s.col_span_mobile | plus: 0
  assign promo_cs_d = s.col_span_desktop | plus: 0
  assign grid_cm = columns_mobile | default: 2
  assign grid_ctl = columns_tablet_large | default: 4
  assign grid_cd = columns_desktop | default: 4
  assign grid_cd_sidebar = grid_cd | plus: 1
  assign enable_filtering = enable_filtering | default: false

  assign promo_mobile_sm = 'calc((100vw - 38px) / ' | append: grid_cm | append: ' * ' | append: promo_cs_m | append: ')'
  assign promo_mobile_md = 'calc((100vw - 90px) / ' | append: grid_cm | append: ' * ' | append: promo_cs_m | append: ')'
  assign promo_sizes_mobile = '(max-width: 767px) ' | append: promo_mobile_sm | append: ', (max-width: 1023px) ' | append: promo_mobile_md | append: ', 1px'
  if enable_filtering
    assign promo_desktop_xl = 'calc(' | append: settings.page_width | append: 'px / ' | append: grid_cd_sidebar | append: ' * ' | append: promo_cs_d | append: ')'
  else
    assign promo_desktop_xl = 'calc(' | append: settings.page_width | append: 'px / ' | append: grid_cd | append: ' * ' | append: promo_cs_d | append: ')'
  endif
  assign promo_desktop_lg = 'calc((100vw - 90px) / ' | append: grid_ctl | append: ' * ' | append: promo_cs_d | append: ')'
  assign promo_sizes_desktop = '(min-width: 1280px) ' | append: promo_desktop_xl | append: ', (min-width: 1024px) ' | append: promo_desktop_lg | append: ', 1px'

  assign m_video = s.video_mobile
  assign m_video_url = s.video_url_mobile
  assign m_image = s.image_mobile
  if m_video == blank and m_video_url == blank and m_image == blank
    assign m_video = s.video_desktop
    assign m_video_url = s.video_url_desktop
    assign m_image = s.image_desktop
  endif

  assign d_video = s.video_desktop
  assign d_video_url = s.video_url_desktop
  assign d_image = s.image_desktop
  if d_video == blank and d_video_url == blank and d_image == blank
    assign d_video = s.video_mobile
    assign d_video_url = s.video_url_mobile
    assign d_image = s.image_mobile
  endif

  assign show_mobile_slot = false
  if m_video != blank or m_video_url != blank or m_image != blank
    assign show_mobile_slot = true
  endif
  assign show_desktop_slot = false
  if d_video != blank or d_video_url != blank or d_image != blank
    assign show_desktop_slot = true
  endif

  assign has_text = false
  if s.title != blank or s.description != blank or s.button_label != blank
    assign has_text = true
  endif

  assign has_any_media = false
  if show_mobile_slot or show_desktop_slot
    assign has_any_media = true
  endif

  unless show_mobile_slot or show_desktop_slot or has_text
    assign skip = true
  else
    assign skip = false
  endunless
-%}
{%- unless skip -%}
  {% style %}
    #we-collection-promo-{{ block.id }} {
      --we-promo-cs-m: {{ s.col_span_mobile }};
      --we-promo-rs-m: {{ s.row_span_mobile }};
      --we-promo-cs-xl: {{ s.col_span_desktop }};
      --we-promo-rs-xl: {{ s.row_span_desktop }};

      grid-column: span var(--we-promo-cs-xl);
      grid-row: span var(--we-promo-rs-xl);
    }
    @media (max-width: 1023.98px) {
      #we-collection-promo-{{ block.id }} {
          grid-column: span var(--we-promo-cs-m);
          grid-row: span var(--we-promo-rs-m);
      }
    }
  {% endstyle %}
  <div
    id="we-collection-promo-{{ block.id }}"
    class="f-column we-collection-promo"
    style="
      --we-promo-cs-m: {{ s.col_span_mobile }};
      --we-promo-rs-m: {{ s.row_span_mobile }};
      --we-promo-cs-xl: {{ s.col_span_desktop }};
      --we-promo-rs-xl: {{ s.row_span_desktop }};
    "
    {{ block.shopify_attributes }}
  >
    <div
      class="we-collection-promo__card blocks-radius color-{{ s.color_scheme | default: 'scheme-1' }}"
      {% if s.text_color != blank %}
        style="--we-promo-text: {{ s.text_color }};"
      {% endif %}
    >
      <div class="we-collection-promo__frame">
        {%- if show_mobile_slot -%}
          <div class="we-collection-promo__media-layer we-collection-promo__media--mobile lg:hidden" aria-hidden="true">
            {%- if m_video != blank or m_video_url != blank -%}
              <div class="we-collection-promo__media-fill">
                {%- render 'video',
                  sizes: promo_sizes_mobile,
                  video: m_video,
                  video_url: m_video_url,
                  cover_image: m_image,
                  muted: true,
                  autoplay: true,
                  loop: true,
                  controls: false,
                  description: s.title,
                  show_play_button: true
                -%}
              </div>
            {%- elsif m_image != blank -%}
              <div class="we-collection-promo__media-fill">
                {{
                  m_image
                  | image_url: width: m_image.width
                  | image_tag:
                    loading: 'lazy',
                    class: 'we-collection-promo__cover',
                    sizes: promo_sizes_mobile,
                    is: 'image-lazy',
                    alt: m_image.alt
                  | default: s.title
                  | escape
                }}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if show_desktop_slot -%}
          <div
            class="we-collection-promo__media-layer we-collection-promo__media--desktop hidden lg:block"
            aria-hidden="true"
          >
            {%- if d_video != blank or d_video_url != blank -%}
              <div class="we-collection-promo__media-fill">
                {%- render 'video',
                  sizes: promo_sizes_desktop,
                  video: d_video,
                  video_url: d_video_url,
                  cover_image: d_image,
                  muted: true,
                  autoplay: true,
                  loop: true,
                  controls: false,
                  description: s.title,
                  show_play_button: true
                -%}
              </div>
            {%- elsif d_image != blank -%}
              <div class="we-collection-promo__media-fill">
                {{
                  d_image
                  | image_url: width: d_image.width
                  | image_tag:
                    loading: 'lazy',
                    class: 'we-collection-promo__cover',
                    sizes: promo_sizes_desktop,
                    is: 'image-lazy',
                    alt: d_image.alt
                  | default: s.title
                  | escape
                }}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if has_text -%}
          <div
            class="we-collection-promo__overlay{% if has_any_media %} we-collection-promo__overlay--on-media{% endif %}"
          >
            {%- if s.title != blank -%}
              <span class="we-collection-promo__title h5 m-0">{{ s.title }}</span>
            {%- endif -%}
            {%- if s.description != blank -%}
              <div class="we-collection-promo__description desktop rte">{{ s.description }}</div>
            {%- endif -%}
            {%- if s.description_mobile != blank -%}
              <div class="we-collection-promo__description mobile rte">{{ s.description_mobile }}</div>
            {%- endif -%}
            {%- if s.button_label != blank -%}
              <div class="we-collection-promo__actions">
                <a
                  {% if s.button_url != blank %}
                    href="{{ s.button_url }}"
                  {% else %}
                    role="link" aria-disabled="true"
                  {% endif %}
                  class="btn btn--underline"
                >
                  {{- s.button_label -}}
                </a>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endunless -%}
