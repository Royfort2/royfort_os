<script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    window.theme = {
        strings: {
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        unavailable: {{ 'products.product.unavailable' | t | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        shopCurrency: {{ cart.currency.symbol | json }}
    };
</script>

{% if template.directory == 'customers' %}
    <script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer="defer"></script>
{% endif %}

{% if template contains 'product' or template contains 'bundle' %}
    <script src="{{ 'vendor-product.min.js' | asset_url }}" defer="defer"></script>
{% else %}
    <script src="{{ 'vendor.min.js' | asset_url }}" defer="defer"></script>
{% endif %}

<script src="{{ 'theme.min.js' | asset_url }}" defer="defer"></script>

<!-- Stamped - Begin Script-->
<script async type="text/javascript" data-api-key="{{ settings.public_key_stamped }}" id="stamped-script-widget" src="https://cdn-stamped-io.azureedge.net/files/widget.min.js"></script>
<!-- Stamped - End Script -->

<script>
    const stampedDetails = {
        {% capture stamped_token %}{{ settings.public_key_stamped }}:{{ settings.private_key_stamped }}{% endcapture %}
        {% assign stamped_token = stamped_token | base64_endcode %}
        public_key: "{{ settings.public_key_stamped }}",
        domain: "{{ shop.domain }}",
        product: "{{ product.id }}"
    }
</script>
