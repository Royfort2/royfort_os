<!-- COMBINED OPTION -->
<div class="product-options-combined">
    <div class="product-combined-swatch">
        <div class="product-swatch">
            <h4 class="text-secondary text-14">Farbe: <span class="swatch-title-combined-{{ prefix }}">{{ page.metafields.combined.product_colour_name | first }}</span></h4>
            {% assign n = 0 %}
            {% for handle in combo_products %}
                {% assign n = n | plus: 1 %}
                {% assign color_name = color_tags[forloop.index0] %}
                {% for swatch_value in shop.metafields.swatches.swatch_colour_title %}
                    {% if swatch_value == color_name %}
                        {% assign color_value = shop.metafields.swatches.swatch_colour[forloop.index0] %}
                    {% endif %}
                {% endfor %}
                {% assign product_value = all_products[handle].id %}
                {% assign checked = '' %}
                {% assign checked_class = '' %}
                {% if forloop.first %}
                    {% assign checked = 'checked=true' %}
                    {% assign checked_class = 'active' %}
                {% endif %}
                {% assign border_circle = '' %}
                {% assign downcase_colour_val = color_value | downcase %}
                {% if downcase_colour_val == '#ffffff' or downcase_colour_val == '#fff' or downcase_colour_val == blank %}
                    {% assign border_circle = 'border-color: #b3b3b3' %}
                {% endif %}
                <label data-pos="{{ n }}" class="swatch-value combined-option-selector-label-{{ prefix }} {{ checked_class }}"><div class="swatch-image" style="background-color: {{ color_value }};{{ border_circle }}"></div><input type="radio" class="combined-option-selector-{{ prefix }} hide swatch-value" name="combined-colour-{{ prefix }}" data-name="{{ color_name }}" value="{{ product_value }}" {{ checked }}></label>
            {% endfor %}
        </div>
    </div>
    {% for handle in combo_products %}
        {% assign combo_product = all_products[handle] %}
        <div class="product-options-combined-sub product-options-combined-sub-{{ prefix }} product-options-combined-sub-{{ prefix }}-{{ combo_product.id }} {% unless forloop.first %}hide{% endunless %}">
            {% assign current_variant_loop = combo_product.selected_or_first_available_variant %}
            {% assign current_inventory = current_variant_loop.inventory %}
            {% if current_variant_loop.inventory_policy == 'continue' %}
                {% assign current_inventory = 999 %}
            {% endif %}
            {% if current_inventory == blank %}
                {% assign current_inventory = 0 %}
            {% endif %}
            {% assign swatch_html = '' %}
            {% assign options_html = '' %}
            {% unless combo_product.has_only_default_variant %}
                {% for product_option in combo_product.options_with_values %}
                    {% assign option_index = product_option.position%}

                    {% assign swatch_translation_title = 'swatch_option.title' | t %}
                    {% assign swatch_translation_slug = 'swatch_option.slug' | t %}
                    
                    {% if product_option.name == swatch_translation_title or product_option.name == swatch_translation_slug %}
                        {% capture swatch_capture %}
                            <div class="product-swatch">
                                <h4 class="text-secondary text-14">{{ product_option.name }}: <span class="swatch-title-{{ option_index }}">{{ product_option.selected_value }}</span></h4>
                                {% assign n = 0 %}
                                {% for value in product_option.values %}
                                    {% assign n = n | plus: 1 %}
                                    {% assign checked = '' %}
                                    {% assign checked_class = '' %}
                                    {% if option_index == 1 %}
                                        {% if current_variant_loop.option1 == value %}
                                            {% assign checked = 'checked=true' %}
                                            {% assign checked_class = 'active' %}
                                        {% endif %}
                                    {% elsif option_index == 2 %}
                                        {% if current_variant_loop.option2 == value %}
                                            {% assign checked = 'checked=true' %}
                                            {% assign checked_class = 'active' %}
                                        {% endif %}
                                    {% elsif option_index == 3 %}
                                        {% if current_variant_loop.option3 == value %}
                                            {% assign checked = 'checked=true' %}
                                            {% assign checked_class = 'active' %}
                                        {% endif %}
                                    {% endif %}
                                    {% assign colour_value = '#fff' %}
                                    {% assign swatches_array = '' %}
                                    {% for swatch_value in shop.metafields.swatches.swatch_colour_title %}
                                        {% if swatch_value == value %}
                                            
                                            {% comment %}
                                            SH: Check that there is no duplication of swatch names/labels
                                            {% endcomment %}
                                            {% unless swatches_array contains swatch_value %}
                                                {% assign colour_value = shop.metafields.swatches.swatch_colour[forloop.index0] %}
                                                {% assign colour_img = shop.metafields.swatches.swatch_sample[forloop.index0] %}
                                                {% if colour_img == blank %}{% assign colour_img = '' %}{% else %}{% capture colour_img %}background-image: url('{{ colour_img | file_img_url: '30x30' }}');background-position: center;{% endcapture %}{% endif %}
                                            {% endunless %}
                                            {% assign swatches_array = swatches_array | append: swatch_value | append: ', '  %}

                                        {% endif %}
                                    {% endfor %}
                                    {% assign border_circle = '' %}
                                    {% assign downcase_colour_val = colour_value | downcase %}
                                    {% if downcase_colour_val == '#ffffff' or downcase_colour_val == '#fff' or downcase_colour_val == blank %}
                                        {% assign border_circle = 'border-color: #b3b3b3' %}
                                    {% endif %}
                                    <label data-pos="{{ n }}" class="swatch-value option{{ option_index }}-selector-label {{ checked_class }}"><div class="swatch-image" style="background-color: {{ colour_value }};{{ colour_img }}"></div><input type="radio" class="option-selector product-options-{{ combo_product.id }} hide swatch-value" name="option{{ option_index }}" value="{{ value }}" {{ checked }}></label>
                                {% endfor %}
                            </div>
                        {% endcapture %}
                        {% assign swatch_html = swatch_html | append: swatch_capture %}
                    {% else %}
                        {% capture option_capture %}
                            <div class="product-option-container">
                                <h4 class="text-secondary text-14">{{ product_option.name }}:</h4>
                                <select class="option-selector product-options-{{ combo_product.id }}" name="option{{ option_index }}">
                                    {% for value in product_option.values %}
                                        {% assign checked = '' %}
                                        {% if option_index == 1 %}
                                            {% if current_variant_loop.option1 == value %}
                                                {% assign checked = 'selected=true' %}
                                            {% endif %}
                                        {% elsif option_index == 2 %}
                                            {% if current_variant_loop.option2 == value %}
                                                {% assign checked = 'selected=true' %}
                                            {% endif %}
                                        {% elsif option_index == 3 %}
                                            {% if current_variant_loop.option3 == value %}
                                                {% assign checked = 'selected=true' %}
                                            {% endif %}
                                        {% endif %}
                                        <option value="{{ value }}" {{ checked }} >{{ value }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endcapture %}
                        {% assign options_html = options_html | append: option_capture %}
                    {% endif %}
                {% endfor %}
            {% endunless %}
            {{ swatch_html }}
            {{ options_html }}
        </div>
    {% endfor %}
    <div class="product-option-container">
        <h4 class="text-secondary text-14">{{ 'products.product.quantity' | t }}</h4>
        <select class="product-quantity" max="{{current_inventory}}" {% if current_inventory <= 0 %} disabled {% endif %}>
            {% for i in (1..10) %}
                <option value={{i}}>{{i}}</option>
            {% endfor %}
        </select>
    </div><!-- product-quantity-container -->
</div>