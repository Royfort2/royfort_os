{% assign swatch_translation_title = 'swatch_option.title' | t %}
{% assign swatch_translation_slug = 'swatch_option.slug' | t %}

<div class="container-fluid">
  <div class="row product-detail-row">
    <div class=" product-col-left">
      <div id="product-images-container">
        <div id="product-thumbnails">
          {% render 'product-thumbnails', product: product, imgpre: 'main-', combo_products: '' %}
        </div>
        <!-- product-thumbnails -->

        {% render 'product-large-images', product: product %}
      </div>
      <!-- product-images-container -->
    </div>
    <div class="product-col-right  sticky-top">
      <div id="product-detail">
        {% assign current_variant = product.selected_or_first_available_variant %}
        {% assign additional_price = product.metafields.bundle.price %}

        <h1 class="product-title main-product-title text-secondary text-46">{{ product.title }}</h1>
        <div class="product-price-container d-flex">
          <div class="main-product-price d-none" data-price="{{ current_variant.price }}">
            <span class="money text-18 title-font current-price">{{ current_variant.price | money }}</span>
            <span class="original-price text-18 title-font">
              {% if current_variant.compare_at_price > current_variant.price %}
                {{ current_variant.compare_at_price | money -}}
              {%- endif %}
            </span>
          </div>
          <!-- product-price -->

          <div class="main-product-additional-price">
            <span class="additional-money text-18 title-font" data-additional-price="{{ current_variant.price }}">
              {{- current_variant.price | money -}}
            </span>
            <span class="additional-money-compare-price original-price text-18 title-font">
              {% if current_variant.compare_at_price > current_variant.price %}
                {{ current_variant.compare_at_price | money -}}
              {%- endif %}
            </span>
            <span class="discount-perc text-18 title-font">
              {% if current_variant.compare_at_price > current_variant.price %}
                -
                {{-
                  current_variant.compare_at_price
                  | minus: current_variant.price
                  | times: 100.0
                  | divided_by: current_variant.compare_at_price
                  | money_without_currency
                  | times: 100
                  | remove: '.0'
                -}}
                %
              {% endif %}
            </span>
          </div>
        </div>
        <!-- product-price-container -->

        {% render 'product-discount-code' %}

        <span
          class="stamped-toggle stamped-product-reviews-badge stamped-main-badge"
          data-id="{{ product.id }}"
          data-product-sku="{{ product.handle }}"
          style="display: inline-block;"
        ></span>

        <div class="product-form-main">
          <div id="product-swatch-desktop">
            {% render 'product-options', product: product, prefix: 'main-' %}
          </div>
          <!-- product-swatch-desktop -->

          {% comment %}
            <a class="klaviyo-bis-trigger" href="#">Notify Me When Available</a>
          {% endcomment %}

          {% render 'product-form-bundle', product: product, prefix: 'main-', use_instock_indicator: true %}

          {%- comment -%}
            SH: Message under add to cart button now set per product
          {%- endcomment -%}
          {% capture under_cart_message %}
            {{ product.metafields.product.under_button_message }}{% endcapture %}
          <div class="under-cart-message">{{ under_cart_message }}</div>

          {% comment %}
            {% if product.metafields.out_of_stock.show_stock_notice %}
            {% render 'product-form-bundle', product: product, prefix: 'main-', use_instock_indicator: true %}
            {% else %}
            {% render 'product-form-bundle', product: product, prefix: 'main-', use_instock_indicator: false %}
            {% endif %}
            <div class="under-cart-message" data-instock="{{ section.settings.under_button_message | escape }}" data-outofstock="{{ product.metafields.out_of_stock.add_to_cart_footnote | escape }}">{{section.settings.under_button_message}}</div>
          {% endcomment %}
        </div>
        {% assign additional_product = all_products[product.metafields.product.additional_product] %}
        {% if additional_product != blank %}
          <div class="additional-products my-5 p-3">
            <div class="d-flex w-full">
              <div class=""><img src="{{ additional_product.featured_image | img_url }}"></div>
              <div class="top">
                <h4 class="text-secondary">Add a {{ additional_product.title }}</h4>
                <div class="product-description">{{ additional_product.description | strip_html | truncate: 50 }}</div>
                <div class="additional-product-price">
                  <span class="money text-14 title-font text-secondary">{{ current_variant.price | money }}</span>
                  <span class="original-price money text-14 title-font text-secondary">
                    {% if current_variant.compare_at_price > current_variant.price %}
                      {{ current_variant.compare_at_price | money -}}
                    {%- endif %}
                  </span>
                </div>
                <!-- product-price -->
              </div>
              <div class="top d-flex justify-content-end">
                {% assign add_to_cart_short = 'products.product.add_to_cart_short' | t %}
                {% render 'product-form',
                  product: additional_product,
                  prefix: 'additional-',
                  add_to_cart_override: add_to_cart_short
                %}
              </div>
            </div>
            {% render 'product-options', product: additional_product, prefix: 'additional-' %}
          </div>
        {% endif %}
      </div>
      <!-- product-detail -->
    </div>
  </div>
  <!-- row -->
</div>
{% if product.metafields.product.usp_title.size > 0 and product.metafields.product.usp_title[0] != blank %}
  <div class="section-background product-usp-upper">
    <div class="container-fluid">
      <div class="site-usp-container product-unique-usp icon-above">
        {% for usp_title in product.metafields.product.usp_title %}
          <div class="usp-item icon-above">
            <div class="usp-icon">
              {% assign usp_image = product.metafields.product.usp_image[forloop.index0] %}
              <div class="">
                <img
                  src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
                  data-src="{{ usp_image }}"
                  class="lazyload"
                  alt="{{usp_title}}"
                >
              </div>
              <!-- fixed-ratio square -->
            </div>
            <!-- usp-icon -->
            <div class="usp-content">
              <h4 style="color:{{section.settings.usp_content_color}};" class="mb-0 text-14">{{ usp_title }}</h4>
            </div>
            <!-- usp-content -->
          </div>
          <!-- usp-item -->
        {% endfor %}
      </div>
      <!-- site-usp-container -->
    </div>
    <!-- container -->
  </div>
  <!-- section-background -->
{% endif %}
<div class="position-relative">
  <div class="product-overlay">
    {% render 'Star_Asset_White' %}
  </div>
</div>
<div class="container-fluid">
  {% render 'product-tabs' %}
  {% if media == ' ' %}
    <div class="product-video py-5 py-lg-0">
      {% for media in product.media %}
        {% if media.media_type == 'external_video' or media.media_type == 'video' %}
          {{ media | video_tag }}
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
  {% comment %}
    {% render 'product-reviews-carousel' %}
  {% endcomment %}
</div>

{% schema %}
{
  "name": "Product pages",
  "settings": [
    {
      "type": "header",
      "content": "Main Image"
    },
    {
      "type": "select",
      "id": "main_ratio",
      "label": "Main Image - Fixed Ratio?",
      "options": [
        {
          "value": "fixed-ratio square-crop",
          "label": "Square (4x4 Cropped)"
        }, {
          "value": "fixed-ratio square",
          "label": "Square (4x4)"
        }, {
          "value": "",
          "label": "No Set Ratio"
        }
      ],
      "default": "fixed-ratio square"
    },
    {
      "type": "header",
      "content": "Thumbnail Image"
    },
    {
      "type": "select",
      "id": "thumbnail_ratio",
      "label": "Thumbnail Image - Fixed Ratio?",
      "options": [
        {
          "value": "fixed-ratio square-crop",
          "label": "Square (4x4 Cropped)"
        }, {
          "value": "fixed-ratio square",
          "label": "Square (4x4)"
        }, {
          "value": "",
          "label": "No Set Ratio"
        }
      ],
      "default": "fixed-ratio square"
    }, {
      "type": "text",
      "id": "under_button_message",
      "label": "Under add to cart message",
      "default": "*Kostenloser Versand*"
    }, {
      "type": "color",
      "id": "pdc_color",
      "label": "Product discount code font color",
      "default": "#000000"
    }, {
      "type": "text",
      "id": "product_discount_code",
      "label": "Product discount code (visible on all PDPs)"
    }
  ]
}
{% endschema %}
