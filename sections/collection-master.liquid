{% paginate collection.products by section.settings.products_per_page %}

{% assign collections_found = '' %}
{% for product in collection.products %}
    {% for collection_test in product.collections %}
        {% if collection_test.metafields.collection.Parent == collection.handle or collection_test.metafields.collection.parent_type_in == collection.handle %}
            {% unless collections_found contains collection_test.handle %}
                {% assign collections_found = collections_found | append: collection_test.handle | append: '|' %}
            {% endunless %}
        {% endif %}
    {% endfor %}
{% endfor %}
{% assign collections_found = collections_found | split: '|' %}
{% assign collections_count = collections_found.size %}
{% assign used_products = '' %}


{% if collection.metafields.exhibitor.image != blank %}
 {% assign exhibitorImagecontent = collection.metafields.exhibitor.image %}
{% else %}

{% if collection.metafields.exhibitor.video !=  blank %}

 {% assign exhibitorImagecontent = collection.metafields.exhibitor.video %}

{% else %}

 {% assign exhibitorImagecontent = collection.metafields.exhibitor.background_color %}

{% endif %}
{% endif %}

{%- comment %} https://my.accentuate.io/c/field-definitions/media-v2-fields {% endcomment -%}
{%- capture collection_image_mobile %}{% for image in collection.metafields.collection.mobile_collection_image %}{{ image.src }}{% endfor %}{% endcapture -%}

<div class="position-relative">
    {% comment %} <div class="hero-overlay-category">
        {% render 'Star_Asset_White' %}
    </div> {% endcomment %}
    {% comment %} <header class="page-header px-0 px-lg-4 mb-1 mb-lg-5" style="background-image:url('{{collection.image | img_url: '1920x'}}')">
        <div class="container-fluid p-relative py-4 pb-2 pb-lg-8 py-lg-9 px-4 px-lg-3" style="background-image:url('{{ collection_image_mobile }}')">
            <div class="breadcrumbs d-none d-lg-block">{% render 'mini-breadcrumbs' %}</div>
            <div class="row align-items-end">
                <div class="col-12 col-lg-6 text-center">
                    <h1 class="collection-title mb-3 text-uppercase">{{ collection.title }}</h1>
                    <h4 class="collection-description body-font">{{ collection.description }}</h4>
                </div>
            </div>
        </div>
    </header> {% endcomment %}


<div class="collection-listing-container mb-lg-5 mb-md-10 mt-lg-3">
    <div class="container-fluid px-3">
        <div class="collection-sidebar">
            <h1 style="color:{{section.settings.title_color}};font-size:{{section.settings.title_size}}px" class="sub-collection mb-3">{{ collection.title }}</h1>
            <div style="color:{{section.settings.subtitle_color}};font-size:{{section.settings.subtitle_size}}px">{{collection.description}}</div>
        </div>
        <div class="collection-main pl-lg-4 pl-1 no-border">
            <picture>
                <source style="width: 100%" media="(orientation: portrait)" srcset="{{ collection_image_mobile }}">
                <source style="width: 100%" media="(orientation: landscape)" srcset="{{ collection.image | image_url: width: 2048 }}">
                <img style="width: 100%" src="{{ collection.image | image_url: width: 2048 }}" alt="Collection image">
            </picture>
        </div>
    </div>
</div>

    {%- capture other_cats %}
        <!-- Other Collection --> 
        {% for found_collection in collections_found %}
            {% assign other_collection = collections[found_collection] %}
            <div class="collection-listing-container mb-lg-5 mb-md-10 ddd" data-collection-section="{{ found_collection }}">

                <div class="container-fluid px-3">
                    
                            {% capture sidebar %}

                               {% if collection.metafields.collection.sub_collection %}
                                <h2 style="color:{{section.settings.title_color}};font-size:{{section.settings.title_size}}px" class="sub-collection mb-3">{{ collection.metafields.collection.sub_collection }}</h2>
                                <h4 class="text-secondary sub-description body-font text-14">{{ collection.metafields.collection.sub_description }}</h4>
                                {% endif %} 
                                 {% if collection.handle == 'alle-bettwasche-sets' or collection.handle == 'royfort-all-products-collection' or collection.handle == 'hotelbettwaesche' %}
                                    {% if other_collection.title %}
                                        <a class="remove-decoration" href="{{ other_collection.url }}">
                                            {% if other_collection.metafields.collection.sub_collection != blank %}
                                                <h2 style="color:{{section.settings.title_color}};font-size:{{section.settings.title_size}}px" class="sub-collection mb-3">{{ other_collection.metafields.collection.sub_collection }}</h2>
                                            {% else %}
                                                <h2 style="color:{{section.settings.title_color}};font-size:{{section.settings.title_size}}px" class="sub-collection mb-3">{{ other_collection.title }}</h2>
                                            {% endif %}
                                        </a>
                                        {% if other_collection.metafields.collection.sub_description != blank %}
                                            <p class="text-secondary sub-description body-font text-14">{{ other_collection.metafields.collection.sub_description }}</p>
                                        {% else %}
                                            <p class="text-secondary sub-description body-font text-14">{{ other_collection.description }}</p>
                                        {% endif %}
                                    {% endif %}
                                {% endif %} 

                            {% endcapture %}
                    
                            <aside class="collection-sidebar">
                    {% if sidebar contains 'text-secondary' %}
                            <div class="sidebar-wrapper">
                                {{ sidebar }}
                            </div><!-- sidebar-wrapper-->
                            {% else %}
                            {% assign no_sidebar = 'nosidebar ' %}
                        {% endif %}
                        </aside><!-- col -->

                    <section id="collection-main" class="{{ no_sidebar }}collection-main pl-lg-4" data-collection-url="{{collection.url}}{% if current_tags %}{% for tag in current_tags %}{% if forloop.first %}/{% endif %}{{tag}}{% unless forloop.last %}+{% endunless %}{% endfor%}{% endif %}">
                        <div class="collection-listing" data-image-ratio="{{section.settings.ratio}}" data-soldout-text="{{'products.product.sold_out' | t}}" data-lowstock-text="{{'products.product.low_stock' | t}}">
                            {% for product in collection.products %}
                                {% assign in_coll = false %}
                                {% for coll in product.collections %}
                                    {% if coll.handle == found_collection %}
                                        {% assign in_coll = true %}
                                    {% endif %}
                                {% endfor %}
                                {% if in_coll == true %}
                                    {% render 'product-listing' with product as product, index: forloop.index0, exhibitor: true %}
                                    {% assign used_products = used_products | append: product.id %}
                                {% endif %}
                            {% else %}
                                <p>{{ 'collections.general.no_matches' | t }}</p>
                            {% endfor %}

                            {% for exhibitorImage in exhibitorImagecontent %}
                            {% assign exhibitor_index = forloop.index0 %}
                            <div class="product-listing">
                        {% if collection.metafields.exhibitor.video[exhibitor_index] !=  blank %}
                        			<div class="video-button">
		                        <video autoplay="" playsinline="" muted="" loop="" class="w-full my-video" id="video-exhibitor-{{exhibitor_index}}">
                        <source src="{{collection.metafields.exhibitor.video[exhibitor_index]}}" 	type="video/mp4"/>
                        </video>
				<span class="button-container"><div id="Play_Pause-{{exhibitor_index}}" role="button" aria-label="Play video" class="w-large h-large rounded-full flex items-center bg-surface justify-center border-0 text-center">
					<img class="play-button-{{exhibitor_index}}" style="cursor: pointer" src="{{ 'playbutton.svg' | asset_url }}" width="20" height="20" />
				    <img class="pause-button-{{exhibitor_index}}" style="cursor: pointer" src="{{ 'pauseButton.svg' | asset_url }}" width="20" height="20" />
				</div></span>
                <script>
window.addEventListener ("DOMContentLoaded",handleWindowLoad) 
function handleWindowLoad ()
{
    let Video = document.getElementById( "video-exhibitor-{{exhibitor_index}}" );
    let PlayButton = document.getElementById( "Play_Pause-{{exhibitor_index}}" );
	let playBtn = document.querySelector(".play-button-{{exhibitor_index}}");
	let pauseBtn = document.querySelector(".pause-button-{{exhibitor_index}}");
    PlayButton.addEventListener ( "click", Play_Pause_Video ) ;
    function Play_Pause_Video () {
        if (Video.paused === true)
        {
            Video.play();
			playBtn.style.display = "flex"
			pauseBtn.style.display = "none";
        }
        else
        {
            Video.pause();
			playBtn.style.display = "none"
			pauseBtn.style.display = "flex";
        }
    }
}
</script>
				</div>
                                              {% else %}
                         
